+module Test
+public atom F(list<bool> xs)
+F(xs) -> xs switch {
+    [] => :empty,
+    [true] => :true
+}
+
+public atom G(list<bool> xs)
+G(xs) -> xs switch {
+    [] => :empty,
+    [true, ..] => :true,
+    [false, ..] => :false
+}
