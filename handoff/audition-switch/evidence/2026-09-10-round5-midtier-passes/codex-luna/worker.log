diff --git a/.check-test.bs b/.check-test.bs
new file mode 100644
index 0000000000000000000000000000000000000000..61f8db1ff9cf5b526d27bd04d7feda320eef9571
--- /dev/null
+++ b/.check-test.bs
@@ -0,0 +1,31 @@
+module Test
+public atom F(list<bool> xs)
+F(xs) -> xs switch {
+    [] => :empty,
+    [true] => :true
+}
+
+public atom G(list<bool> xs)
+G(xs) -> xs switch {
+    [] => :empty,
+    [true, ..] => :true,
+    [false, ..] => :false
+}
+
+public atom H(bool x)
+H(x) -> x switch {
+    == x => :same
+}
+
+public atom I(bool x)
+I(x) -> x switch {
+    true => :yes,
+    == x => :same
+}
+
+record Order { Id: int, Status: atom }
+public atom J(Order o)
+J(o) -> o.Status switch {
+    :placed => :new,
+    _ => :other
+}
