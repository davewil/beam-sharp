+
+def max_bound(a, b):
+    if a is None:
+        return b
+    if b is None:
+        return a
+    return max(a, b)
+
+
+def min_bound(a, b):
+    if a is None:
+        return b
+    if b is None:
+        return a
+    return min(a, b)
