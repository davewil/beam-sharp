+TAGS = {
+    "switch_inexhaustive",
+    "unreachable_arm",
+    "vacuous_arm",
+    "unsatisfiable_arm_guard",
+    "rebinding",
+    "unbound_variable",
+    "return_not_declared",
+    "arg_not_accepted",
+    "switch_in_guard",
