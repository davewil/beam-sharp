   900	        for field in split_top(match.group(2)):
   901	            if ":" not in field:
   902	                continue
   903	            field_name, field_type = field.split(":", 1)
   904	            fields.append((field_name.strip(), parse_type(field_type)))
   905	        aliases[match.group(1)] = ("record", tuple(fields))
   906	
   907	    signatures = {}
   908	    signature_pattern = re.compile(
   909	        r"(?m)^public\s+([^\s]+)\s+([A-Z][A-Za-z0-9_]*)\s*\(([^\n]*)\)\s*$"
   910	    )
   910	    )
   911	    for match in signature_pattern.finditer(source):
   912	        return_type = parse_type(match.group(1))
   913	        argument_types = []
   914	        for argument in split_top(match.group(3)):
   915	            pieces = argument.rsplit(None, 1)
   916	            if len(pieces) == 2:
   917	                argument_types.append(parse_type(pieces[0]))
   918	        signatures[match.group(2)] = (return_type, tuple(argument_types))
   919	    return aliases, signatures
