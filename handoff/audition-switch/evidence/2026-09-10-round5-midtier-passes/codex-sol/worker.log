+#!/usr/bin/env python3
+"""Clean-room checker for the switch rules described in PACKET.md."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from itertools import product
+from pathlib import Path
+import re
+import sys
+
+
+NEG_INF = float("-inf")
+POS_INF = float("inf")
+
+
+@dataclass(frozen=True)
+class Pattern:
+    kind: str
+    value: object = None
+
+
+@dataclass(frozen=True)
