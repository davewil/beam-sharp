+#!/usr/bin/env python3
+"""Boundary tests for the switchcheck command."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).parent
+
+
+class SwitchcheckCases(unittest.TestCase):
+    CASES = {
+        "c01-exhaustive-closed/Verdict/in.bs": set(),
+        "c02-catchall-open/Open/in.bs": set(),
+        "c03-inexhaustive/Missing/in.bs": {"switch_inexhaustive"},
+        "c04-unreachable/Shadowed/in.bs": {"unreachable_arm"},
+        "c05-tuple-exhaustive/Decide/in.bs": set(),
+        "c06-tuple-inexhaustive/Partial/in.bs": {"switch_inexhaustive"},
+        "c07-guarded/Retry/in.bs": {"rebinding"},
+        "c08-wrong-return/Wrong/in.bs": {"return_not_declared"},
+        "c09-arg-not-accepted/Calls/in.bs": {"arg_not_accepted"},
+        "c10-switch-in-guard/Guarded/in.bs": {"switch_in_guard"},
+        "c11-unbound-variable/Scopes/in.bs": {
+            "switch_inexhaustive",
+            "unbound_variable",
+        },
+        "c12-vacuous-arm/Scored/in.bs": {"vacuous_arm"},
+        "c13-unsatisfiable-guard/Graded/in.bs": {
+            "unsatisfiable_arm_guard"
+        },
+    }
+
+    def test_packet_cases(self):
+        for relative_path, expected in self.CASES.items():
+            with self.subTest(case=relative_path):
+                completed = subprocess.run(
+                    [ROOT / "switchcheck", ROOT / "cases" / relative_path],
+                    check=False,
+                    capture_output=True,
+                    text=True,
+                )
+                actual = set(completed.stdout.splitlines())
+                self.assertEqual(actual, expected)
+                self.assertEqual(completed.stderr, "")
+
+    def assert_source_tags(self, source, expected):
+        with tempfile.TemporaryDirectory() as directory:
+            source_path = Path(directory) / "input.bs"
+            source_path.write_text(source)
+            completed = subprocess.run(
+                [ROOT / "switchcheck", source_path],
+                check=False,
+                capture_output=True,
+                text=True,
+            )
+        self.assertEqual(set(completed.stdout.splitlines()), set(expected))
+        self.assertEqual(completed.stderr, "")
+
+    def test_matched_name_does_not_credit_finite_coverage(self):
+        self.assert_source_tags(
+            """\
+module MatchName
+public atom Pick(bool expected, bool candidate)
+Pick(expected, candidate) -> candidate switch {
+    == expected => :same
+}
+""",
+            {"switch_inexhaustive"},
+        )
+
+    def test_empty_and_nonempty_prefixes_cover_a_list(self):
+        self.assert_source_tags(
+            """\
+module Lists
+public atom Shape(list<bool> xs)
+Shape(xs) -> xs switch {
+    []       => :empty,
+    [_, ..]  => :nonempty
+}
+""",
+            set(),
+        )
+
+    def test_named_list_rest_is_bound_in_its_arm(self):
+        self.assert_source_tags(
+            """\
+module ListRest
+public term Tail(list<int> xs)
+Tail(xs) -> xs switch {
+    []           => :empty,
+    [_, ..rest]  => rest
+}
+""",
+            set(),
+        )
+
+    def test_relational_guard_does_not_require_spaces(self):
+        self.assert_source_tags(
+            """\
+module CompactGuard
+public atom Classify(int n)
+Classify(n) -> n switch {
+    m when m<5 => :low,
+    >=5        => :high
+}
+""",
+            set(),
+        )
+
+    def test_closed_tuple_axis_can_make_an_open_product_exhaustive(self):
+        self.assert_source_tags(
+            """\
+module MixedTuple
+public atom Describe(int n, bool b)
+Describe(n, b) -> (n, b) switch {
+    (x, true)  => :yes,
+    (x, false) => :no
+}
+""",
+            set(),
+        )
+
+    def test_open_union_members_remain_possible(self):
+        self.assert_source_tags(
+            """\
+module OpenUnion
+type MaybeInt = int | :nothing
+public atom Describe(MaybeInt value)
+Describe(value) -> value switch {
+    :nothing => :none,
+    _        => :some
+}
+""",
+            set(),
+        )
+
+    def test_record_field_supplies_the_switch_subject_type(self):
+        self.assert_source_tags(
+            """\
+module Records
+type Status = :placed | :shipped
+record Order { Id: int, Status: Status }
+public atom Describe(Order order)
+Describe(order) -> order.Status switch {
+    :placed  => :new,
+    :shipped => :gone
+}
+""",
+            set(),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()

