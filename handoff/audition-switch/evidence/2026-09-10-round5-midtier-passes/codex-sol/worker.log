+        "<": [(NEG_INF, value - 1)],
+        "<=": [(NEG_INF, value)],
+        ">": [(value + 1, POS_INF)],
+        ">=": [(value, POS_INF)],
+        "==": [(value, value)],
+        "!=": [(NEG_INF, value - 1), (value + 1, POS_INF)],
+    }[operator]
+
