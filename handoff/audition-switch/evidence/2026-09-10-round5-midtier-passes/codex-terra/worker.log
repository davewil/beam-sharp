+#!/usr/bin/env python3
+"""Black-box regression cases for the switchcheck command-line contract."""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).parent
+EXPECTED = {
+    "c01-exhaustive-closed": set(),
+    "c02-catchall-open": set(),
+    "c03-inexhaustive": {"switch_inexhaustive"},
+    "c04-unreachable": {"unreachable_arm"},
+    "c05-tuple-exhaustive": set(),
+    "c06-tuple-inexhaustive": {"switch_inexhaustive"},
+    "c07-guarded": {"rebinding"},
+    "c08-wrong-return": {"return_not_declared"},
+    "c09-arg-not-accepted": {"arg_not_accepted"},
+    "c10-switch-in-guard": {"switch_in_guard"},
+    "c11-unbound-variable": {"unbound_variable"},
+    "c12-vacuous-arm": {"vacuous_arm"},
+    "c13-unsatisfiable-guard": {"unsatisfiable_arm_guard"},
+}
+
+PROBES = {
+    "list-bool-prefixes": (
+        """public atom F(list<bool> xs)
+F(xs) -> xs switch {
+    [] => :empty,
+    [true, ..] => :truthy,
+    [false, ..] => :falsey
+}
+""",
+        set(),
+    ),
+    "untagged-tuple-union": (
+        """type Reading = (:ok, int) | (:error, atom)
+public atom F(Reading reading)
+F(reading) -> reading switch {
+    (:ok, value) => :ok,
+    (:error, value) => :error
+}
+""",
+        set(),
+    ),
+    "closed-atom-return": (
+        """type State = :placed | :shipped
+public State F(bool b)
+F(b) -> b switch {
+    true => :placed,
+    false => :shipped
+}
+""",
+        set(),
+    ),
+    "tuple-parameter": (
+        """public atom F((bool, bool) pair)
+F(pair) -> pair switch {
+    (true, _) => :yes,
+    (false, true) => :also_yes,
+    (false, false) => :no
+}
+""",
+        set(),
+    ),
+}
+
+
+def main() -> int:
+    failures: list[str] = []
+    for case, expected in EXPECTED.items():
+        source = next((ROOT / "cases" / case).rglob("*.bs"))
+        completed = subprocess.run(
+            [str(ROOT / "switchcheck"), str(source)],
+            check=False,
+            capture_output=True,
+            text=True,
+        )
+        actual = {line for line in completed.stdout.splitlines() if line}
+        if completed.stderr or actual != expected:
+            failures.append(f"{case}: expected {expected}, got {actual}; stderr={completed.stderr!r}")
+    for name, (source_text, expected) in PROBES.items():
+        probe = ROOT / f".{name}.bs"
+        try:
+            probe.write_text(source_text)
+            completed = subprocess.run(
+                [str(ROOT / "switchcheck"), str(probe)],
+                check=False,
+                capture_output=True,
+                text=True,
+            )
+            actual = {line for line in completed.stdout.splitlines() if line}
+            if completed.stderr or actual != expected:
+                failures.append(f"{name}: expected {expected}, got {actual}; stderr={completed.stderr!r}")
+        finally:
+            probe.unlink(missing_ok=True)
+    if failures:
+        print("\n".join(failures), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

