{"type":"tool_use","timestamp":1788997937583,"sessionID":"ses_f776f37faffeE0oEMA1j7aJKmO","part":{"type":"tool","tool":"write","callID":"toolu_0155kX4wXqnc2zAAT6PhQwEP","state":{"status":"completed","input":{"filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-sonnet5/switchcheck","content":"#!/usr/bin/env python3\n\"\"\"\nswitchcheck: exhaustiveness / switch well-formedness checker for the\n'.bs' language described in PACKET.md.\n\nReads a single .bs file and prints one lowercase diagnostic tag per line.\nA well-formed file prints nothing.\n\"\"\"\nimport sys\nimport re\n\nTAGS = set()\n\n\ndef emit(tag):\n    TAGS.add(tag)\n\n\n# ---------------------------------------------------------------------------\n# Tokenizer\n# ---------------------------------------------------------------------------\n\nTOKEN_RE = re.compile(r\"\"\"\n    (?P<ws>\\s+)\n  | (?P<comment>//[^\\n]*)\n  | (?P<arrow>->)\n  | (?P<fatarrow>=>)\n  | (?P<dotdot>\\.\\.)\n  | (?P<atom>:[A-Za-z_][A-Za-z0-9_]*)\n  | (?P<ge>>=)\n  | (?P<le><=)\n  | (?P<ne>!=)\n  | (?P<eq>==)\n  | (?P<num>-?[0-9]+)\n  | (?P<ident>[A-Za-z_][A-Za-z0-9_]*)\n  | (?P<punct>[(){}\\[\\],.<>|=])\n\"\"\", re.VERBOSE)\n\nKEYWORDS = {\"module\", \"type\", \"record\", \"public\", \"when\", \"and\", \"or\",\n            \"switch\", \"true\", \"false\"}\n\n\ndef tokenize(src):\n    toks = []\n    pos = 0\n    n = len(src)\n    while pos < n:\n        m = TOKEN_RE.match(src, pos)\n        if not m:\n            pos += 1\n            continue\n        pos = m.end()\n        kind = m.lastgroup\n        text = m.group()\n        if kind in (\"ws\", \"comment\"):\n            continue\n        toks.append((kind, text))\n    toks.append((\"eof\", \"\"))\n    return toks\n\n\n# ---------------------------------------------------------------------------\n# Parser\n# ---------------------------------------------------------------------------\n\nclass Parser:\n    def __init__(self, toks):\n        self.toks = toks\n        self.i = 0\n\n    def peek(self, k=0):\n        return self.toks[self.i + k]\n\n    def kind(self, k=0):\n        return self.peek(k)[0]\n\n    def text(self, k=0):\n        return self.peek(k)[1]\n\n    def at_eof(self):\n        return self.kind() == \"eof\"\n\n    def advance(self):\n        t = self.peek()\n        self.i += 1\n        return t\n\n    def expect_text(self, text):\n        if self.text() != text:\n            raise SyntaxError(f\"expected {text!r} got {self.text()!r} at {self.i}\")\n        return self.advance()\n\n    def is_text(self, text):\n        return self.text() == text\n\n    # -- top level ----------------------------------------------------\n\n    def parse_program(self):\n        types = {}\n        records = {}\n        functions = {}\n        order = []\n        while not self.at_eof():\n            if self.is_text(\"module\"):\n                self.advance()\n                self.advance()  # name\n                continue\n            if self.is_text(\"type\"):\n                name, variants = self.parse_type_decl()\n                types[name] = variants\n                continue\n            if self.is_text(\"record\"):\n                name, fields = self.parse_record_decl()\n                records[name] = fields\n                continue\n            if self.is_text(\"public\"):\n                fn = self.parse_function()\n                if fn.name in functions:\n                    functions[fn.name].clauses.extend(fn.clauses)\n                else:\n                    functions[fn.name] = fn\n                    order.append(fn.name)\n                continue\n            # unknown token at top level; skip it defensively\n            self.advance()\n        return types, records, functions, order\n\n    def parse_type_decl(self):\n        self.expect_text(\"type\")\n        name = self.advance()[1]\n        self.expect_text(\"=\")\n        variants = [self.parse_type_variant()]\n        while self.is_text(\"|\"):\n            self.advance()\n            variants.append(self.parse_type_variant())\n        return name, variants\n\n    def parse_type_variant(self):\n        if self.kind() == \"atom\":\n            return (\"atomlit\", self.advance()[1])\n        if self.is_text(\"(\"):\n            self.advance()\n            parts = []\n            if not self.is_text(\")\"):\n                parts.append(self.parse_type_expr())\n                while self.is_text(\",\"):\n                    self.advance()\n                    parts.append(self.parse_type_expr())\n            self.expect_text(\")\")\n            return (\"tuple\", parts)\n        # bare type name used as variant (rare)\n        return self.parse_type_expr()\n\n    def parse_type_expr(self):\n        if self.kind() == \"atom\":\n            return (\"atomlit\", self.advance()[1])\n        if self.is_text(\"(\"):\n            self.advance()\n            parts = []\n            if not self.is_text(\")\"):\n                parts.append(self.parse_type_expr())\n                while self.is_text(\",\"):\n                    self.advance()\n                    parts.append(self.parse_type_expr())\n            self.expect_text(\")\")\n            return (\"tuple\", parts)\n        name = self.advance()[1]\n        if self.is_text(\"<\"):\n            self.advance()\n            inner = self.parse_type_expr()\n            self.expect_text(\">\")\n            return (\"list\", inner) if name == \"list\" else (\"generic\", name, inner)\n        return (\"ref\", name)\n\n    def parse_record_decl(self):\n        self.expect_text(\"record\")\n        name = self.advance()[1]\n        self.expect_text(\"{\")\n        fields = {}\n        while not self.is_text(\"}\"):\n            fname = self.advance()[1]\n            self.expect_text(\":\")\n            ftype = self.parse_type_expr()\n            fields[fname] = ftype\n            if self.is_text(\",\"):\n                self.advance()\n        self.expect_text(\"}\")\n        return name, fields\n\n    def parse_function(self):\n        self.expect_text(\"public\")\n        rettype = self.parse_type_expr()\n        name = self.advance()[1]\n        self.expect_text(\"(\")\n        params = []\n        if not self.is_text(\")\"):\n            params.append(self.parse_param())\n            while self.is_text(\",\"):\n                self.advance()\n                params.append(self.parse_param())\n        self.expect_text(\")\")\n        fn = Function(name, rettype, params)\n        # parse clauses that belong to this function (same name)\n        while self.is_text(name) and self.kind() == \"ident\":\n            clause = self.parse_clause(name)\n            fn.clauses.append(clause)\n        return fn\n\n    def parse_param(self):\n        ptype = self.parse_type_expr()\n        pname = self.advance()[1]\n        return (ptype, pname)\n\n    def parse_clause(self, name):\n        self.expect_text(name)\n        self.expect_text(\"(\")\n        pats = []\n        if not self.is_text(\")\"):\n            pats.append(self.parse_pattern())\n            while self.is_text(\",\"):\n                self.advance()\n                pats.append(self.parse_pattern())\n        self.expect_text(\")\")\n        guard = None\n        if self.is_text(\"when\"):\n            self.advance()\n            guard = self.parse_guard_expr()\n        self.expect_text(\"->\")\n        body = self.parse_expr()\n        return Clause(pats, guard, body)\n\n    # -- patterns -------------------------------------------------------\n\n    def parse_pattern(self):\n        if self.is_text(\"_\"):\n            self.advance()\n            return (\"wildcard\",)\n        if self.is_text(\"==\"):\n            self.advance()\n            n = self.advance()[1]\n            return (\"eqname\", n)\n        if self.kind() == \"atom\":\n            return (\"atomlit\", self.advance()[1])\n        if self.text() in (\">=\", \"<=\", \">\", \"<\"):\n            return self.parse_relational_pattern()\n        if self.kind() == \"num\":\n            return (\"intlit\", int(self.advance()[1]))\n        if self.is_text(\"true\"):\n            self.advance()\n            return (\"boollit\", True)\n        if self.is_text(\"false\"):\n            self.advance()\n            return (\"boollit\", False)\n        if self.is_text(\"(\"):\n            self.advance()\n            subs = []\n            if not self.is_text(\")\"):\n                subs.append(self.parse_pattern())\n                while self.is_text(\",\"):\n                    self.advance()\n                    subs.append(self.parse_pattern())\n            self.expect_text(\")\")\n            return (\"tuple\", subs)\n        if self.is_text(\"[\"):\n            self.advance()\n            prefix = []\n            rest = None\n            has_rest = False\n            if not self.is_text(\"]\"):\n                while True:\n                    if self.is_text(\"..\"):\n                        self.advance()\n                        has_rest = True\n                        if self.kind() == \"ident\":\n                            rest = self.advance()[1]\n                        break\n                    prefix.append(self.parse_pattern())\n                    if self.is_text(\",\"):\n                        self.advance()\n                        continue\n                    break\n            self.expect_text(\"]\")\n            return (\"list\", prefix, has_rest, rest)\n        if self.kind() == \"ident\":\n            return (\"name\", self.advance()[1])\n        raise SyntaxError(f\"unexpected pattern token {self.peek()}\")\n\n    def parse_relational_pattern(self):\n        parts = []\n        while self.text() in (\">=\", \"<=\", \">\", \"<\"):\n            op = self.advance()[1]\n            val = int(self.advance()[1])\n            parts.append((op, val))\n            if self.is_text(\"and\"):\n                self.advance()\n                continue\n            break\n        return (\"relational\", parts)\n\n    # -- guards -----------------------------------------------------------\n    # Guard grammar (subset): comparisons joined by 'and'/'or', calls,\n    # nested switch (illegal -> flagged), literals, names.\n\n    def parse_guard_expr(self):\n        return self.parse_guard_or()\n\n    def parse_guard_or(self):\n        left = self.parse_guard_and()\n        while self.is_text(\"or\"):\n            self.advance()\n            right = self.parse_guard_and()\n            left = (\"or\", left, right)\n        return left\n\n    def parse_guard_and(self):\n        left = self.parse_guard_atom()\n        while self.is_text(\"and\"):\n            self.advance()\n            right = self.parse_guard_atom()\n            left = (\"and\", left, right)\n        return left\n\n    def parse_guard_atom(self):\n        if self.is_text(\"(\"):\n            self.advance()\n            e = self.parse_guard_or()\n            self.expect_text(\")\")\n            return e\n        # leading relational operator against the bound var (rare in guards)\n        if self.text() in (\">=\", \"<=\", \">\", \"<\", \"==\"):\n            op = self.advance()[1]\n            rhs = self.parse_guard_operand()\n            return (\"cmpimplicit\", op, rhs)\n        # primary operand, possibly followed by comparator\n        left = self.parse_guard_primary()\n        if self.text() in (\">=\", \"<=\", \">\", \"<\", \"==\", \"!=\"):\n            op = self.advance()[1]\n            right = self.parse_guard_operand()\n            return (\"cmp\", op, left, right)\n        return (\"truthy\", left)\n\n    def parse_guard_operand(self):\n        if self.kind() == \"num\":\n            return (\"intlit\", int(self.advance()[1]))\n        if self.is_text(\"true\"):\n            self.advance()\n            return (\"boollit\", True)\n        if self.is_text(\"false\"):\n            self.advance()\n            return (\"boollit\", False)\n        if self.kind() == \"atom\":\n            return (\"atomlit\", self.advance()[1])\n        if self.kind() == \"ident\":\n            return (\"name\", self.advance()[1])\n        raise SyntaxError(f\"unexpected guard operand {self.peek()}\")\n\n    def parse_guard_primary(self):\n        if self.is_text(\"switch\"):\n            # a switch used inside a guard - illegal; consume it fully\n            self.consume_switch_block()\n            return (\"switch\",)\n        if self.kind() == \"ident\":\n            name = self.advance()[1]\n            if self.is_text(\"(\"):\n                self.advance()\n                args = []\n                if not self.is_text(\")\"):\n                    args.append(self.parse_expr())\n                    while self.is_text(\",\"):\n                        self.advance()\n                        args.append(self.parse_expr())\n                self.expect_text(\")\")\n                if self.is_text(\"switch\"):\n                    self.consume_switch_suffix()\n                    return (\"switch\",)\n                return (\"call\", name, args)\n            if self.is_text(\"switch\"):\n                self.consume_switch_suffix()\n                return (\"switch\",)\n            return (\"name\", name)\n        return self.parse_guard_operand()\n\n    def consume_switch_suffix(self):\n        self.expect_text(\"switch\")\n        self.consume_switch_body()\n\n    def consume_switch_block(self):\n        self.expect_text(\"switch\")\n        self.consume_switch_body()\n\n    def consume_switch_body(self):\n        self.expect_text(\"{\")\n        depth = 1\n        while depth > 0:\n            t = self.advance()\n            if t[1] == \"{\":\n                depth += 1\n            elif t[1] == \"}\":\n                depth -= 1\n\n    # -- expressions (bodies) --------------------------------------------\n\n    def parse_expr(self):\n        # primary\n        e = self.parse_primary()\n        if self.is_text(\"switch\"):\n            self.advance()\n            arms = self.parse_switch_arms()\n            e = (\"switch\", e, arms)\n        return e\n\n    def parse_primary(self):\n        if self.kind() == \"num\":\n            return (\"intlit\", int(self.advance()[1]))\n        if self.is_text(\"true\"):\n            self.advance()\n            return (\"boollit\", True)\n        if self.is_text(\"false\"):\n            self.advance()\n            return (\"boollit\", False)\n        if self.kind() == \"atom\":\n            return (\"atomlit\", self.advance()[1])\n        if self.is_text(\"(\"):\n            self.advance()\n            parts = [self.parse_expr()]\n            while self.is_text(\",\"):\n                self.advance()\n                parts.append(self.parse_expr())\n            self.expect_text(\")\")\n            if len(parts) == 1:\n                return parts[0]\n            return (\"tupleexpr\", parts)\n        if self.kind() == \"ident\":\n            name = self.advance()[1]\n            if self.is_text(\"(\"):\n                self.advance()\n                args = []\n                if not self.is_text(\")\"):\n                    args.append(self.parse_expr())\n                    while self.is_text(\",\"):\n                        self.advance()\n                        args.append(self.parse_expr())\n                self.expect_text(\")\")\n                return (\"call\", name, args)\n            if self.is_text(\".\"):\n                # field access, e.g. o.Status - treat as opaque atom-ish\n                self.advance()\n                field = self.advance()[1]\n                return (\"field\", name, field)\n            return (\"name\", name)\n        # fallback: relational used as an expression body (rare)\n        if self.text() in (\">=\", \"<=\", \">\", \"<\"):\n            op = self.advance()[1]\n            val = int(self.advance()[1])\n            return (\"cmpexpr\", op, val)\n        raise SyntaxError(f\"unexpected expr token {self.peek()}\")\n\n    def parse_switch_arms(self):\n        self.expect_text(\"{\")\n        arms = []\n        while not self.is_text(\"}\"):\n            pat = self.parse_pattern()\n            guard = None\n            if self.is_text(\"when\"):\n                self.advance()\n                guard = self.parse_guard_expr()\n            self.expect_text(\"=>\")\n            body = self.parse_expr()\n            arms.append(Clause([pat], guard, body))\n            if self.is_text(\",\"):\n                self.advance()\n        self.expect_text(\"}\")\n        return arms\n\n\nclass Function:\n    def __init__(self, name, rettype, params):\n        self.name = name\n        self.rettype = rettype\n        self.params = params  # list of (type, name)\n        self.clauses = []\n\n\nclass Clause:\n    def __init__(self, pats, guard, body):\n        self.pats = pats\n        self.guard = guard\n        self.body = body\n\n\n# ---------------------------------------------------------------------------\n# Type resolution\n# ---------------------------------------------------------------------------\n\nclass SumType:\n    def __init__(self, variants):\n        # variants: list of (\"atomlit\", tag) or (\"tuple\", [type_exprs])\n        self.variants = variants\n        self.atom_tags = set()\n        self.payload = {}  # tag -> list of type exprs\n        for v in variants:\n            if v[0] == \"atomlit\":\n                self.atom_tags.add(v[1])\n            elif v[0] == \"tuple\":\n                parts = v[1]\n                if parts and parts[0][0] == \"atomlit\":\n                    tag = parts[0][1]\n                    self.payload[tag] = parts[1:]\n                else:\n                    # anonymous tuple variant without atom tag: ignore (rare)\n                    pass\n\n    def is_pure_atoms(self):\n        return len(self.payload) == 0\n\n\n# ---------------------------------------------------------------------------\n# Domains (for exhaustiveness)\n# ---------------------------------------------------------------------------\n\nNEG_INF = float(\"-inf\")\nPOS_INF = float(\"inf\")\n\n\nclass IntDomain:\n    def __init__(self, intervals=None):\n        self.intervals = intervals if intervals is not None else [(NEG_INF, POS_INF)]\n\n    def is_empty(self):\n        return len(self.intervals) == 0\n\n    def subtract(self, lo, hi):\n        new = []\n        for (a, b) in self.intervals:\n            if hi < a or lo > b:\n                new.append((a, b))\n                continue\n            if lo > a:\n                new.append((a, lo - 1))\n            if hi < b:\n                new.append((hi + 1, b))\n        self.intervals = new\n\n    def intersects(self, lo, hi):\n        for (a, b) in self.intervals:\n            if not (hi < a or lo > b):\n                return True\n        return False\n\n    def example(self):\n        if not self.intervals:\n            return None\n        a, b = self.intervals[0]\n        if a == NEG_INF and b == POS_INF:\n            return (\"full\",)\n        if a == NEG_INF:\n            return (\"le\", b)\n        if b == POS_INF:\n            return (\"ge\", a)\n        return (\"range\", a, b)\n\n\ndef interval_from_relational(parts):\n    \"\"\"parts: list of (op, val) joined by 'and' -> single interval intersection.\"\"\"\n    lo, hi = NEG_INF, POS_INF\n    for op, val in parts:\n        if op == \">=\":\n            lo = max(lo, val)\n        elif op == \">\":\n            lo = max(lo, val + 1)\n        elif op == \"<=\":\n            hi = min(hi, val)\n        elif op == \"<\":\n            hi = min(hi, val - 1)\n    return lo, hi\n\n\ndef guard_truth_intervals(guard):\n    \"\"\"Evaluate a readable int guard to a list of (lo,hi) intervals representing\n    the set of values (of the single free int variable) satisfying it.\n    Returns None if guard is not readable (as an int predicate).\"\"\"\n    if guard is None:\n        return [(NEG_INF, POS_INF)]\n    tag = guard[0]\n    if tag == \"cmp\":\n        _, op, left, right = guard\n        if left[0] != \"name\" or right[0] != \"intlit\":\n            return None\n        val = right[1]\n        if op == \">=\":\n            return [(val, POS_INF)]\n        if op == \">\":\n            return [(val + 1, POS_INF)]\n        if op == \"<=\":\n            return [(NEG_INF, val)]\n        if op == \"<\":\n            return [(NEG_INF, val - 1)]\n        if op == \"==\":\n            return [(val, val)]\n        if op == \"!=\":\n            return [(NEG_INF, val - 1), (val + 1, POS_INF)]\n        return None\n    if tag == \"and\":\n        _, a, b = guard\n        ia = guard_truth_intervals(a)\n        ib = guard_truth_intervals(b)\n        if ia is None or ib is None:\n            return None\n        out = []\n        for (a1, b1) in ia:\n            for (a2, b2) in ib:\n                lo = max(a1, a2)\n                hi = min(b1, b2)\n                if lo <= hi:\n                    out.append((lo, hi))\n        return merge_intervals(out)\n    if tag == \"or\":\n        _, a, b = guard\n        ia = guard_truth_intervals(a)\n        ib = guard_truth_intervals(b)\n        if ia is None or ib is None:\n            return None\n        return merge_intervals(ia + ib)\n    return None\n\n\ndef merge_intervals(intervals):\n    if not intervals:\n        return []\n    ivs = sorted(intervals)\n    out = [ivs[0]]\n    for a, b in ivs[1:]:\n        la, lb = out[-1]\n        if a <= lb + 1:\n            out[-1] = (la, max(lb, b))\n        else:\n            out.append((a, b))\n    return out\n\n\ndef guard_contains_switch(guard):\n    if guard is None:\n        return False\n    if guard[0] == \"switch\":\n        return True\n    if guard[0] in (\"and\", \"or\"):\n        return guard_contains_switch(guard[1]) or guard_contains_switch(guard[2])\n    return False\n\n\ndef guard_free_name(pat):\n    \"\"\"Given the pattern (bare name) that a guard refines, return its name.\"\"\"\n    if pat[0] == \"name\":\n        return pat[1]\n    return None\n\n\n# ---------------------------------------------------------------------------\n# Main analysis\n# ---------------------------------------------------------------------------\n\nclass Analyzer:\n    def __init__(self, types, records, functions):\n        self.types = types  # name -> SumType\n        self.records = records\n        self.functions = functions\n\n    def base_kind(self, texpr):\n        \"\"\"Classify a resolved type expression into a coarse kind string.\"\"\"\n        if texpr[0] == \"ref\":\n            name = texpr[1]\n            if name in self.types:\n                st = self.types[name]\n                return \"sum\"\n            if name in self.records:\n                return \"record\"\n            if name == \"int\":\n                return \"int\"\n            if name == \"bool\":\n                return \"bool\"\n            if name in (\"atom\",):\n                return \"atom\"\n            if name in (\"term\",):\n                return \"term\"\n            if name in (\"string\",):\n                return \"string\"\n            return \"unknown\"\n        if texpr[0] == \"tuple\":\n            return \"tuple\"\n        if texpr[0] == \"list\":\n            return \"list\"\n        return \"unknown\"\n\n    def sum_of(self, texpr):\n        if texpr[0] == \"ref\" and texpr[1] in self.types:\n            return self.types[texpr[1]]\n        return None\n\n    def tuple_parts(self, texpr):\n        if texpr[0] == \"tuple\":\n            return texpr[1]\n        return None\n\n    # ---- pattern type-shape checks (vacuous) ---------------------------\n\n    def pattern_kind(self, pat):\n        return pat[0]\n\n    def is_binding_only(self, pat):\n        return pat[0] in (\"name\", \"wildcard\", \"eqname\")\n\n    def pattern_vacuous(self, pat, texpr):\n        \"\"\"Return True if pat cannot possibly be a member of texpr's type.\"\"\"\n        kind = self.base_kind(texpr)\n        if self.is_binding_only(pat):\n            return False\n        if kind == \"term\":\n            return False\n        if kind == \"unknown\" or kind == \"record\" or kind == \"string\":\n            return False\n        if kind == \"sum\":\n            st = self.sum_of(texpr)\n            if pat[0] == \"atomlit\":\n                tag = pat[1]\n                return tag not in st.atom_tags and tag not in st.payload\n            if pat[0] == \"tuple\":\n                # must correspond to a payload tag as (:tag, ...)\n                subs = pat[1]\n                if not subs or subs[0][0] != \"atomlit\":\n                    return True\n                tag = subs[0][1]\n                if tag not in st.payload:\n                    return True\n                expected_arity = len(st.payload[tag])\n                got_arity = len(subs) - 1\n                return expected_arity != got_arity\n            # relational/intlit/boollit/list patterns against a sum type: not a member\n            return True\n        if kind == \"atom\":\n            if pat[0] == \"atomlit\":\n                return False\n            return True\n        if kind == \"bool\":\n            if pat[0] == \"boollit\":\n                return False\n            return True\n        if kind == \"int\":\n            if pat[0] in (\"intlit\", \"relational\"):\n                return False\n            return True\n        if kind == \"tuple\":\n            if pat[0] != \"tuple\":\n                return True\n            parts = self.tuple_parts(texpr)\n            if parts is None or len(parts) != len(pat[1]):\n                return True\n            for sp, st_ in zip(pat[1], parts):\n                if self.pattern_vacuous(sp, st_):\n                    return True\n            return False\n        if kind == \"list\":\n            if pat[0] != \"list\":\n                return True\n            return False\n        return False\n\n    # ---- domain-based exhaustiveness for supported subject shapes ------\n\n    def make_domain(self, texpr):\n        kind = self.base_kind(texpr)\n        if kind == \"bool\":\n            return (\"bool\", {True, False})\n        if kind == \"int\":\n            return (\"int\", IntDomain())\n        if kind == \"sum\":\n            st = self.sum_of(texpr)\n            if st.is_pure_atoms():\n                return (\"atomset\", set(st.atom_tags))\n            # sum with payload: track remaining per tag\n            remaining = {}\n            for tag in st.atom_tags:\n                remaining[tag] = (\"unit\", True)  # present/absent\n            for tag, ptypes in st.payload.items():\n                if len(ptypes) == 1:\n                    remaining[tag] = (\"payload1\", self.make_domain(ptypes[0]))\n                else:\n                    remaining[tag] = (\"present\", True)\n            return (\"sumpayload\", remaining, st)\n        if kind == \"tuple\":\n            parts = self.tuple_parts(texpr)\n            comps = [self.make_domain(p) for p in parts]\n            # only support enumeration if all comps are bool/atomset (finite)\n            if all(c[0] in (\"bool\", \"atomset\") for c in comps):\n                return (\"ftuple\", self.enumerate_domain(comps))\n            return (\"open\", None)\n        return (\"open\", None)\n\n    def enumerate_domain(self, comps):\n        def values(c):\n            if c[0] == \"bool\":\n                return list(c[1])\n            if c[0] == \"atomset\":\n                return list(c[1])\n            return []\n        import itertools\n        vals = [values(c) for c in comps]\n        return set(itertools.product(*vals))\n\n    def domain_is_empty(self, dom):\n        k = dom[0]\n        if k == \"bool\":\n            return len(dom[1]) == 0\n        if k == \"atomset\":\n            return len(dom[1]) == 0\n        if k == \"int\":\n            return dom[1].is_empty()\n        if k == \"ftuple\":\n            return len(dom[1]) == 0\n        if k == \"sumpayload\":\n            remaining = dom[1]\n            for tag, v in remaining.items():\n                if v[0] == \"unit\" and v[1]:\n                    return False\n                if v[0] == \"present\" and v[1]:\n                    return False\n                if v[0] == \"payload1\" and not self.domain_is_empty(v[1]):\n                    return False\n            return True\n        if k == \"open\":\n            return False  # never claim closed-empty for open domains\n        return False\n\n    def domain_supported(self, dom):\n        return dom[0] != \"open\"\n\n    # Determine the \"matched set\" of a pattern (+ optional guard) against a\n    # domain, without yet subtracting. Returns (readable: bool, matched_repr)\n    # matched_repr is domain-shaped description of what this arm covers.\n\n    def pattern_match_and_subtract(self, dom, pat, guard):\n        \"\"\"Attempt to subtract pat(+guard)'s matched values from dom in place.\n        Returns (matched_any: bool or None-if-unknown, guard_unreadable: bool,\n                 guard_unsat: bool)\"\"\"\n        k = dom[0]\n        if self.is_binding_only(pat):\n            if pat[0] == \"eqname\":\n                # credits nothing towards coverage\n                return (False, False, False)\n            # bare name or wildcard: may carry a guard (only meaningful for int)\n            if guard is not None:\n                truth = guard_truth_intervals(guard)\n                if truth is None:\n                    return (None, True, False)\n                if not truth:\n                    return (False, False, True)\n                if k == \"int\":\n                    before_empty = dom[1].is_empty()\n                    matched = dom[1].intersects(*self._span(truth))\n                    for lo, hi in truth:\n                        dom[1].subtract(lo, hi)\n                    return (matched, False, False)\n                # guard on non-int bare name: unsupported, treat unreadable-ish\n                return (None, True, False)\n            # no guard: full match, clears domain\n            was_nonempty = not self.domain_is_empty(dom)\n            self._clear_domain(dom)\n            return (was_nonempty, False, False)\n        if k == \"int\":\n            if pat[0] == \"intlit\":\n                v = pat[1]\n                matched = dom[1].intersects(v, v)\n                dom[1].subtract(v, v)\n                return (matched, False, False)\n            if pat[0] == \"relational\":\n                lo, hi = interval_from_relational(pat[1])\n                matched = dom[1].intersects(lo, hi)\n                dom[1].subtract(lo, hi)\n                return (matched, False, False)\n            return (None, True, False)\n        if k == \"bool\":\n            if pat[0] == \"boollit\":\n                v = pat[1]\n                matched = v in dom[1]\n                dom[1].discard(v)\n                return (matched, False, False)\n            return (None, True, False)\n        if k == \"atomset\":\n            if pat[0] == \"atomlit\":\n                v = pat[1]\n                matched = v in dom[1]\n                dom[1].discard(v)\n                return (matched, False, False)\n            return (None, True, False)\n        if k == \"ftuple\":\n            if pat[0] == \"tuple\":\n                matched_set = self._tuple_pattern_matches(dom[1], pat[1])\n                matched = len(matched_set) > 0\n                dom[1] -= matched_set\n                return (matched, False, False)\n            return (None, True, False)\n        if k == \"sumpayload\":\n            remaining, st = dom[1], dom[2]\n            if pat[0] == \"atomlit\":\n                tag = pat[1]\n                if tag in remaining and remaining[tag][0] == \"unit\":\n                    matched = remaining[tag][1]\n                    remaining[tag] = (\"unit\", False)\n                    return (matched, False, False)\n                return (False, False, False)\n            if pat[0] == \"tuple\" and pat[1] and pat[1][0][0] == \"atomlit\":\n                tag = pat[1][0][1]\n                subpat = pat[1][1] if len(pat[1]) > 1 else None\n                if tag not in remaining:\n                    return (False, False, False)\n                entry = remaining[tag]\n                if entry[0] == \"present\":\n                    matched = entry[1]\n                    remaining[tag] = (\"present\", False)\n                    return (matched, False, False)\n                if entry[0] == \"payload1\":\n                    subdom = entry[1]\n                    if subpat is None:\n                        return (False, False, False)\n                    return self.pattern_match_and_subtract(subdom, subpat, guard)\n                return (False, False, False)\n            return (None, True, False)\n        return (None, True, False)\n\n    def _span(self, intervals):\n        lo = min(a for a, b in intervals)\n        hi = max(b for a, b in intervals)\n        return lo, hi\n\n    def _clear_domain(self, dom):\n        k = dom[0]\n        if k == \"bool\":\n            dom[1].clear() if isinstance(dom[1], set) else None\n            dom = (\"bool\", set())\n        if k == \"int\":\n            dom[1].intervals = []\n        if k == \"atomset\":\n            dom[1].clear()\n        if k == \"ftuple\":\n            dom[1].clear()\n        if k == \"sumpayload\":\n            remaining = dom[1]\n            for tag in list(remaining.keys()):\n                v = remaining[tag]\n                if v[0] in (\"unit\", \"present\"):\n                    remaining[tag] = (v[0], False)\n                elif v[0] == \"payload1\":\n                    self._clear_domain(v[1])\n\n    def _tuple_pattern_matches(self, universe, subpats):\n        out = set()\n        for tup in universe:\n            ok = True\n            for val, sp in zip(tup, subpats):\n                if self.is_binding_only(sp):\n                    continue\n                if sp[0] == \"boollit\" and val == sp[1]:\n                    continue\n                if sp[0] == \"atomlit\" and val == sp[1]:\n                    continue\n                ok = False\n                break\n            if ok:\n                out.add(tup)\n        return out\n\n    # ---- expression type inference (best-effort) -----------------------\n\n    def infer_expr_type(self, expr, scope):\n        if expr is None:\n            return None\n        tag = expr[0]\n        if tag == \"atomlit\":\n            return (\"atomexpr\", expr[1])\n        if tag == \"intlit\":\n            return (\"ref\", \"int\")\n        if tag == \"boollit\":\n            return (\"ref\", \"bool\")\n        if tag == \"name\":\n            return scope.get(expr[1])\n        if tag == \"call\":\n            fn = self.functions.get(expr[1])\n            if fn is None:\n                return None\n            return fn.rettype\n        if tag == \"field\":\n            return None\n        if tag == \"tupleexpr\":\n            return None\n        return None\n\n    def type_accepts(self, decl_type, value_type):\n        \"\"\"Return True/False/None(unknown) for whether decl_type accepts a\n        value of value_type.\"\"\"\n        if value_type is None:\n            return None\n        kind = self.base_kind(decl_type)\n        if kind == \"term\":\n            return True\n        if value_type[0] == \"atomexpr\":\n            tag = value_type[1]\n            if kind == \"atom\":\n                return True\n            if kind == \"sum\":\n                st = self.sum_of(decl_type)\n                return tag in st.atom_tags\n            return False\n        if value_type[0] == \"ref\":\n            vname = value_type[1]\n            if decl_type[0] == \"ref\":\n                dname = decl_type[1]\n                if dname == vname:\n                    return True\n                # both builtins mismatched, or one is sum type\n                if dname in (\"int\", \"bool\", \"atom\", \"term\", \"string\") or \\\n                   vname in (\"int\", \"bool\", \"atom\", \"term\", \"string\"):\n                    return dname == vname\n                return None\n            return None\n        return None\n\n    def type_name_for_message(self, texpr):\n        if texpr[0] == \"ref\":\n            return texpr[1]\n        if texpr[0] == \"atomexpr\":\n            return texpr[1]\n        return \"?\"\n\n    # ---- collecting used names in an expression / guard -----------------\n\n    def names_used(self, expr):\n        out = set()\n        if expr is None:\n            return out\n\n        def walk(e):\n            if e is None:\n                return\n            if e[0] == \"name\":\n                out.add(e[1])\n            elif e[0] == \"call\":\n                for a in e[2]:\n                    walk(a)\n            elif e[0] == \"tupleexpr\":\n                for a in e[1]:\n                    walk(a)\n            elif e[0] == \"field\":\n                out.add(e[1])\n            elif e[0] == \"switch\":\n                walk(e[1])\n                for arm in e[2]:\n                    # arm bodies have their own scope; still walk guard/body\n                    # but exclude names bound by arm pattern (approx: skip)\n                    walk(arm.guard) if False else None\n                    walk(arm.body)\n            elif e[0] in (\"and\", \"or\"):\n                walk(e[1])\n                walk(e[2])\n            elif e[0] == \"cmp\":\n                walk(e[2])\n                walk(e[3])\n            elif e[0] == \"truthy\":\n                walk(e[1])\n        walk(expr)\n        return out\n\n    def pattern_bound_names(self, pat):\n        out = []\n\n        def walk(p):\n            if p[0] == \"name\":\n                out.append(p[1])\n            elif p[0] == \"tuple\":\n                for sp in p[1]:\n                    walk(sp)\n            elif p[0] == \"list\":\n                prefix, has_rest, restname = p[1], p[2], p[3]\n                for sp in prefix:\n                    walk(sp)\n                if restname:\n                    out.append(restname)\n        walk(pat)\n        return out\n\n    def pattern_bound_types(self, pat, texpr):\n        \"\"\"Return dict name->type for names bound in pat, given subject type texpr.\"\"\"\n        out = {}\n        kind = self.base_kind(texpr)\n\n        def walk(p, t):\n            if p[0] == \"name\":\n                out[p[1]] = t\n            elif p[0] == \"tuple\" and t is not None:\n                parts = None\n                k = self.base_kind(t)\n                if k == \"tuple\":\n                    parts = self.tuple_parts(t)\n                elif k == \"sum\":\n                    st = self.sum_of(t)\n                    if p[1] and p[1][0][0] == \"atomlit\":\n                        tag = p[1][0][1]\n                        parts = [(\"atomlit_tag\",)] + list(st.payload.get(tag, []))\n                if parts:\n                    for sp, st_ in zip(p[1], parts):\n                        if st_ == (\"atomlit_tag\",):\n                            continue\n                        walk(sp, st_)\n            elif p[0] == \"list\":\n                pass\n        walk(pat, texpr)\n        return out\n\n    # ---- guard name usage (for unbound check) ---------------------------\n\n    def guard_names_used(self, guard):\n        out = set()\n\n        def walk(g):\n            if g is None:\n                return\n            if g[0] == \"name\":\n                out.add(g[1])\n            elif g[0] == \"cmp\":\n                walk(g[2])\n                walk(g[3])\n            elif g[0] == \"cmpimplicit\":\n                walk(g[1])\n            elif g[0] in (\"and\", \"or\"):\n                walk(g[1])\n                walk(g[2])\n            elif g[0] == \"truthy\":\n                walk(g[1])\n            elif g[0] == \"call\":\n                for a in g[2]:\n                    walk(a)\n        walk(guard)\n        return out\n\n    def guard_calls(self, guard):\n        out = []\n\n        def walk(g):\n            if g is None:\n                return\n            if g[0] == \"call\":\n                out.append(g)\n                for a in g[2]:\n                    walk(a)\n            elif g[0] in (\"and\", \"or\"):\n                walk(g[1])\n                walk(g[2])\n            elif g[0] == \"truthy\":\n                walk(g[1])\n            elif g[0] == \"cmp\":\n                walk(g[2])\n                walk(g[3])\n        walk(guard)\n        return out\n\n    def body_calls(self, expr):\n        out = []\n\n        def walk(e):\n            if e is None:\n                return\n            if e[0] == \"call\":\n                out.append(e)\n                for a in e[2]:\n                    walk(a)\n            elif e[0] == \"tupleexpr\":\n                for a in e[1]:\n                    walk(a)\n            elif e[0] == \"switch\":\n                walk(e[1])\n                for arm in e[2]:\n                    walk(arm.body)\n        walk(expr)\n        return out\n\n    # ---- main per-function analysis --------------------------------------\n\n    def check_arg_not_accepted(self, callexpr, scope):\n        fname = callexpr[1]\n        fn = self.functions.get(fname)\n        if fn is None:\n            return\n        args = callexpr[2]\n        for (ptype, pname), argexpr in zip(fn.params, args):\n            vtype = self.infer_expr_type(argexpr, scope)\n            accepted = self.type_accepts(ptype, vtype)\n            if accepted is False:\n                emit(\"arg_not_accepted\")\n\n    def check_return(self, rettype, body, scope):\n        # only checks simple literal/call bodies; nested switch handled\n        # per-arm elsewhere.\n        if body[0] == \"switch\":\n            return\n        vtype = self.infer_expr_type(body, scope)\n        accepted = self.type_accepts(rettype, vtype)\n        if accepted is False:\n            emit(\"return_not_declared\")\n\n    def analyze_arm_list(self, subject_type, arms, outer_scope, rettype,\n                          check_return_types=True):\n        \"\"\"arms: list of Clause with .pats (len 1 wrapping the arm/clause\n        pattern for this subject), .guard, .body\"\"\"\n        dom = self.make_domain(subject_type) if subject_type is not None else (\"open\", None)\n        supported = self.domain_supported(dom)\n        idx = 0\n        for clause in arms:\n            idx += 1\n            pat = clause.pats[0]\n            guard = clause.guard\n\n            if guard_contains_switch(guard):\n                emit(\"switch_in_guard\")\n                guard = None  # don't analyze further\n\n            # rebinding check: names newly introduced by this pattern that\n            # already exist in outer scope, or duplicated within the pattern.\n            bound_names = self.pattern_bound_names(pat)\n            seen = set()\n            rebinding_found = False\n            for n in bound_names:\n                if n in outer_scope or n in seen:\n                    rebinding_found = True\n                seen.add(n)\n            if rebinding_found:\n                emit(\"rebinding\")\n\n            local_types = self.pattern_bound_types(pat, subject_type) if subject_type else {}\n            scope = dict(outer_scope)\n            scope.update(local_types)\n\n            # unbound variable check in body + guard (best effort names)\n            used = self.names_used(clause.body) | self.guard_names_used(guard)\n            bound_here = set(bound_names) | set(outer_scope.keys())\n            for n in used:\n                if n not in bound_here and n not in self.functions:\n                    emit(\"unbound_variable\")\n\n            # vacuous arm check (structural)\n            vacuous = False\n            if subject_type is not None and not self.is_binding_only(pat):\n                if self.pattern_vacuous(pat, subject_type):\n                    vacuous = True\n                    emit(\"vacuous_arm\")\n\n            unsat = False\n            if not vacuous and guard is not None:\n                truth = guard_truth_intervals(guard)\n                if truth is not None and len(truth) == 0:\n                    unsat = True\n                    emit(\"unsatisfiable_arm_guard\")\n\n            if not vacuous and not unsat and supported:\n                matched, unreadable, _ = self.pattern_match_and_subtract(dom, pat, guard)\n                if matched is False:\n                    emit(\"unreachable_arm\")\n\n            # arg_not_accepted checks (guard calls + body calls)\n            if guard is not None:\n                for c in self.guard_calls(guard):\n                    self.check_arg_not_accepted(c, scope)\n            for c in self.body_calls(clause.body):\n                self.check_arg_not_accepted(c, scope)\n\n            # return type check\n            if check_return_types and rettype is not None:\n                if clause.body[0] == \"switch\":\n                    # recurse into nested switch arms with same rettype\n                    inner_subject = clause.body[1]\n                    inner_type = self.infer_expr_type(inner_subject, scope)\n                    self.analyze_arm_list(inner_type, clause.body[2], scope,\n                                          rettype, check_return_types=True)\n                else:\n                    self.check_return(rettype, clause.body, scope)\n\n        if supported and not self.domain_is_empty(dom):\n            emit(\"switch_inexhaustive\")\n\n    def analyze_function(self, fn):\n        outer_scope = {pname: ptype for (ptype, pname) in fn.params}\n        clauses = fn.clauses\n        if len(clauses) == 0:\n            return\n        if len(clauses) > 1:\n            # multi-clause head: virtual switch over tuple of params (or\n            # single param type if exactly one param)\n            if len(fn.params) == 1:\n                subject_type = fn.params[0][0]\n            elif len(fn.params) > 1:\n                subject_type = (\"tuple\", [p[0] for p in fn.params])\n            else:\n                subject_type = None\n\n            virt_arms = []\n            for cl in clauses:\n                if len(fn.params) == 1:\n                    pat = cl.pats[0]\n                else:\n                    pat = (\"tuple\", cl.pats)\n                virt_arms.append(Clause([pat], cl.guard, cl.body))\n            self.analyze_arm_list(subject_type, virt_arms, outer_scope, fn.rettype)\n        else:\n            cl = clauses[0]\n            # bind clause's own pattern names (typically bare names == params)\n            scope = dict(outer_scope)\n            body = cl.body\n            if cl.guard is not None and guard_contains_switch(cl.guard):\n                emit(\"switch_in_guard\")\n            if body[0] == \"switch\":\n                subject_expr = body[1]\n                subject_type = self.infer_expr_type(subject_expr, scope)\n                self.analyze_arm_list(subject_type, body[2], scope, fn.rettype)\n            else:\n                for c in self.body_calls(body):\n                    self.check_arg_not_accepted(c, scope)\n                self.check_return(fn.rettype, body, scope)\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.exit(1)\n    path = sys.argv[1]\n    with open(path, \"r\") as f:\n        src = f.read()\n    try:\n        toks = tokenize(src)\n        p = Parser(toks)\n        types_raw, records, functions, order = p.parse_program()\n    except Exception:\n        # Parsing failed entirely; say nothing rather than guess.\n        return\n\n    types = {}\n    for name, variants in types_raw.items():\n        types[name] = SumType(variants)\n\n    analyzer = Analyzer(types, records, functions)\n    for name in order:\n        fn = functions[name]\n        try:\n            analyzer.analyze_function(fn)\n        except Exception:\n            # Be conservative: never guess on internal errors.\n            continue\n\n    for tag in TAGS:\n        print(tag)\n\n\nif __name__ == \"__main__\":\n    main()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-sonnet5/switchcheck","exists":false,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-sonnet5/switchcheck","time":{"start":1788997937424,"end":1788997937560}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_088947d180019fpduK0YvC4NM6","sessionID":"ses_f776f37faffeE0oEMA1j7aJKmO","messageID":"msg_088947596001Wv3xua2viA2hDa"}}
