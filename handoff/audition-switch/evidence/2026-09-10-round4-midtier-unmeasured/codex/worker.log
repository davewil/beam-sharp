+# A type is a union of cells. Products carry a union at each coordinate.
+EMPTY = ()
+ANY = (("any",),)
+INT = (("int", float("-inf"), float("inf")),)
+
+
+def union(*sets):
+    out = []
+    for s in sets:
+        for cell in s:
+            if cell not in out:
+                out.append(cell)
+    return tuple(out)
+
+
+def scalar(kind, values=None):
+    return (("scalar", kind, values is not None,
+             frozenset(values or ())),)
+
