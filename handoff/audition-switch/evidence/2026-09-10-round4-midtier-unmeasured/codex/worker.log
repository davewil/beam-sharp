+def scalar_op(a, b, difference=False):
+    _, kind, af, av = a
+    _, _, bf, bv = b
+    if difference:
+        bf = not bf
+    if af and bf:
+        finite, values = True, av & bv
+    elif af:
+        finite, values = True, av - bv
+    elif bf:
