+                       if not t.isspace() and not t.startswith(("//", "/*"))]
+        self.tokens.append("<eof>")
+        self.i = 0
+        self.aliases = {}
+        self.records = {}
+        self.signatures = {}
+        self.clauses = []
+
+    def peek(self):
+        return self.tokens[self.i]
+
+    def take(self):
+        t = self.peek()
+        self.i += 1
+        return t
+
+    def accept(self, t):
