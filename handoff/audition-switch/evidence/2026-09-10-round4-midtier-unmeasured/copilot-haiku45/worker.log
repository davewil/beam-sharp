match = re.search(r'switch\\s*\\{(.*)\\}', switch_text, re.DOTALL)\n        if not arms_match:\n            return idx\n        \n        arms_text = arms_match.group(1)\n        arms = self.split_switch_arms(arms_text)\n        \n        if func_name not in self.switches:\n            self.switches[func_name] = []\n        \n        for i, arm_text in enumerate(arms):\n            arm_text = arm_text.strip()\n            if not arm_text:\n                continue\n            \n            arm_match = re.match(r'(.*?)\\s*(?:when\\s+(.+?))?\\s*=>\\s*(.*)', arm_text)\n            if arm_match:\n                pattern = arm_match.group(1).strip()\n                guard = arm_match.group(2).strip() if arm_match.group(2) else None\n                body = arm_match.group(3).strip()\n                \n                switch_arm = SwitchArm(pattern, guard, body, i)\n                self.switches[func_name].append(switch_arm)\n        \n        return idx\n    \n    def split_switch_arms(self, text: str) -> List[str]:\n        arms = []\n        current = \"\"\n        depth = 0\n        \n        for char in text:\n            if char in '({[':\n                depth += 1\n            elif char in ')}]':\n                depth -= 1\n            elif char == ',' and depth == 0:\n                arms.append(current)\n                current = \"\"\n                continue\n            \n            current += char\n        \n        if current:\n            arms.append(current)\n        \n        return arms\n\nclass Checker:","lineStart":136,"lineEnd":195,"totalLines":665,"truncated":true}},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck","time":{"start":1788997963895,"end":1788997963901}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_088968e36001K7DYGKBr0j0XD7","sessionID":"ses_f776f37c6ffeLHNTo5P39JtFVe","messageID":"msg_088968930001Aatz0L42wjGYSx"}}
