{"type":"tool_use","timestamp":1788997717461,"sessionID":"ses_f776f37c6ffeLHNTo5P39JtFVe","part":{"type":"tool","tool":"write","callID":"toolu_01Mbm3p3gPLga97gXiPkLWJ3","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\nimport sys\nimport re\nfrom typing import List, Dict, Set, Tuple, Optional\nfrom dataclasses import dataclass, field\n\n@dataclass\nclass Type:\n    \"\"\"Represents a type definition\"\"\"\n    name: str\n    variants: List[str] = field(default_factory=list)\n    \n    def is_closed(self) -> bool:\n        \"\"\"Closed types have enumerable variants\"\"\"\n        return len(self.variants) > 0\n    \n    def is_open(self) -> bool:\n        \"\"\"Open types are atom, term, int, etc\"\"\"\n        return not self.is_closed()\n\n@dataclass\nclass FunctionDef:\n    \"\"\"Represents a function definition\"\"\"\n    name: str\n    param_type: str\n    return_type: str\n    param_names: List[str]  # The actual parameter names\n    clauses: List[Tuple[str, Optional[str]]] = field(default_factory=list)  # (pattern, guard)\n\n@dataclass  \nclass SwitchArm:\n    \"\"\"Represents one arm of a switch\"\"\"\n    pattern: str\n    guard: Optional[str]\n    body: str\n    index: int\n\nclass TokenStream:\n    def __init__(self, text: str):\n        self.text = text\n        self.pos = 0\n    \n    def peek(self, n: int = 1) -> str:\n        \"\"\"Peek at next n characters\"\"\"\n        return self.text[self.pos:self.pos + n]\n    \n    def consume(self, n: int = 1) -> str:\n        \"\"\"Consume and return next n characters\"\"\"\n        result = self.text[self.pos:self.pos + n]\n        self.pos += n\n        return result\n    \n    def skip_whitespace(self):\n        \"\"\"Skip whitespace\"\"\"\n        while self.pos < len(self.text) and self.text[self.pos] in ' \\t\\n':\n            self.pos += 1\n    \n    def at_end(self) -> bool:\n        return self.pos >= len(self.text)\n\nclass Parser:\n    def __init__(self, content: str):\n        self.content = content\n        self.lines = content.split('\\n')\n        self.types: Dict[str, Type] = {}\n        self.functions: Dict[str, FunctionDef] = {}\n        self.switches: Dict[str, List[SwitchArm]] = {}  # func_name -> list of arms\n        self.parse()\n    \n    def parse(self):\n        \"\"\"Parse the file\"\"\"\n        i = 0\n        while i < len(self.lines):\n            line = self.lines[i].strip()\n            \n            if not line or line.startswith('module'):\n                i += 1\n                continue\n            \n            if line.startswith('type '):\n                self.parse_type_def(line)\n                i += 1\n            elif line.startswith('public '):\n                # Parse signature and its clause(s)\n                i = self.parse_function(i)\n            else:\n                i += 1\n    \n    def parse_type_def(self, line: str):\n        \"\"\"Parse: type State = :placed | :shipped | :lost\"\"\"\n        match = re.match(r'type\\s+(\\w+)\\s*=\\s*(.*)', line)\n        if match:\n            name = match.group(1)\n            variants_str = match.group(2)\n            variants = [v.strip() for v in variants_str.split('|')]\n            self.types[name] = Type(name, variants)\n    \n    def parse_function(self, line_idx: int) -> int:\n        \"\"\"Parse a function starting at line_idx. Returns index after function.\"\"\"\n        sig_line = self.lines[line_idx].strip()\n        \n        # Parse signature: public <return_type> <name>(<param_type> <param_names>)\n        match = re.match(r'public\\s+(\\S+)\\s+(\\w+)\\s*\\((.*)\\)', sig_line)\n        if not match:\n            return line_idx + 1\n        \n        return_type = match.group(1)\n        func_name = match.group(2)\n        params_str = match.group(3)\n        \n        # Parse parameters\n        param_types = []\n        param_names = []\n        \n        # Handle multi-param like \"bool ok, bool permanent, bool redelivered\"\n        if ',' in params_str:\n            parts = params_str.split(',')\n            for part in parts:\n                parts2 = part.strip().split()\n                if len(parts2) >= 2:\n                    param_types.append(parts2[0])\n                    param_names.append(parts2[1])\n        else:\n            parts = params_str.strip().split()\n            if len(parts) >= 2:\n                param_types.append(parts[0])\n                param_names.append(parts[1])\n        \n        # For now, join param_types (simplified)\n        if len(param_types) == 1:\n            param_type = param_types[0]\n        else:\n            param_type = f\"({','.join(param_types)})\"\n        \n        func_def = FunctionDef(func_name, param_type, return_type, param_names)\n        self.functions[func_name] = func_def\n        \n        # Parse clauses for this function\n        idx = line_idx + 1\n        while idx < len(self.lines):\n            line = self.lines[idx].strip()\n            \n            if not line:\n                idx += 1\n                continue\n            \n            # Check if this line starts a clause for this function\n            if line.startswith(func_name + '('):\n                idx = self.parse_clause(func_name, idx, func_def)\n            else:\n                # Next function or end\n                break\n        \n        return idx\n    \n    def parse_clause(self, func_name: str, line_idx: int, func_def: FunctionDef) -> int:\n        \"\"\"Parse a clause and any switch it contains. Returns index after clause.\"\"\"\n        clause_line = self.lines[line_idx].strip()\n        \n        # Parse: FunctionName(pattern) [when guard] -> body\n        match = re.match(r'(\\w+)\\((.*?)\\)\\s*(?:when\\s+(.+?))?\\s*->', clause_line)\n        if not match:\n            return line_idx + 1\n        \n        pattern = match.group(2)\n        guard = match.group(3) if match.group(3) else None\n        \n        # Add clause to function\n        func_def.clauses.append((pattern, guard))\n        \n        # Now find and parse the switch body\n        idx = line_idx\n        # Look for the switch keyword\n        while idx < len(self.lines):\n            line_content = self.lines[idx]\n            if 'switch' in line_content:\n                idx = self.parse_switch(func_name, idx)\n                break\n            idx += 1\n        \n        return idx\n    \n    def parse_switch(self, func_name: str, start_idx: int) -> int:\n        \"\"\"Parse a switch statement and its arms. Returns index after switch.\"\"\"\n        # Collect all lines of the switch\n        switch_text = \"\"\n        idx = start_idx\n        \n        while idx < len(self.lines):\n            switch_text += self.lines[idx] + \" \"\n            if '}' in self.lines[idx]:\n                idx += 1\n                break\n            idx += 1\n        \n        # Parse switch arms\n        # Format: switch { pattern => body, pattern => body, ... }\n        arms_match = re.search(r'switch\\s*\\{(.*)\\}', switch_text, re.DOTALL)\n        if not arms_match:\n            return idx\n        \n        arms_text = arms_match.group(1)\n        \n        # Split arms by comma (but not commas inside nested structures)\n        arms = self.split_switch_arms(arms_text)\n        \n        if func_name not in self.switches:\n            self.switches[func_name] = []\n        \n        for i, arm_text in enumerate(arms):\n            arm_text = arm_text.strip()\n            if not arm_text:\n                continue\n            \n            # Parse: pattern [when guard] => body\n            arm_match = re.match(r'(.*?)\\s*(?:when\\s+(.+?))?\\s*=>\\s*(.*)', arm_text)\n            if arm_match:\n                pattern = arm_match.group(1).strip()\n                guard = arm_match.group(2).strip() if arm_match.group(2) else None\n                body = arm_match.group(3).strip()\n                \n                switch_arm = SwitchArm(pattern, guard, body, i)\n                self.switches[func_name].append(switch_arm)\n        \n        return idx\n    \n    def split_switch_arms(self, text: str) -> List[str]:\n        \"\"\"Split switch arms by comma, respecting nesting\"\"\"\n        arms = []\n        current = \"\"\n        depth = 0\n        \n        for char in text:\n            if char in '({[':\n                depth += 1\n            elif char in ')}]':\n                depth -= 1\n            elif char == ',' and depth == 0:\n                arms.append(current)\n                current = \"\"\n                continue\n            \n            current += char\n        \n        if current:\n            arms.append(current)\n        \n        return arms\n\nclass Checker:\n    def __init__(self, parser: Parser):\n        self.parser = parser\n        self.diagnostics: List[str] = []\n    \n    def check(self):\n        \"\"\"Run all checks\"\"\"\n        for func_name, arms in self.parser.switches.items():\n            func_def = self.parser.functions.get(func_name)\n            if not func_def:\n                continue\n            \n            # Check for switch in guard\n            self.check_switch_in_guard(func_name, arms, func_def)\n            \n            # Check for unbound variables\n            self.check_unbound_variables(func_name, arms, func_def)\n            \n            # Check for rebinding\n            self.check_rebinding(func_name, arms, func_def)\n            \n            # Check vacuous arms\n            self.check_vacuous_arms(func_name, arms, func_def)\n            \n            # Check unreachable arms\n            self.check_unreachable_arms(func_name, arms, func_def)\n            \n            # Check unsatisfiable guards\n            self.check_unsatisfiable_guards(func_name, arms)\n            \n            # Check return types\n            self.check_return_types(func_name, arms, func_def)\n            \n            # Check arg not accepted\n            self.check_arg_not_accepted(func_name, arms, func_def)\n            \n            # Check exhaustiveness\n            self.check_exhaustiveness(func_name, arms, func_def)\n    \n    def check_switch_in_guard(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check for switch in guards of clauses\"\"\"\n        for pattern, guard in func_def.clauses:\n            if guard and 'switch' in guard:\n                self.diagnostics.append('switch_in_guard')\n    \n    def check_unbound_variables(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check for unbound variables in arm bodies\"\"\"\n        for arm in arms:\n            # Variables bound by this arm's pattern\n            bound = self.extract_bound_vars(arm.pattern)\n            \n            # Variables used in body\n            used = self.extract_used_vars(arm.body)\n            \n            # Parameter names are also in scope\n            bound.update(func_def.param_names)\n            \n            for var in used:\n                if var not in bound and not self.is_literal(var):\n                    self.diagnostics.append('unbound_variable')\n                    return\n    \n    def check_rebinding(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check for rebinding of parameters in arm patterns\"\"\"\n        for arm in arms:\n            bound = self.extract_bound_vars(arm.pattern)\n            for var in bound:\n                if var in func_def.param_names:\n                    self.diagnostics.append('rebinding')\n                    return\n    \n    def check_vacuous_arms(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check for arms that can never match\"\"\"\n        param_type = func_def.param_type\n        \n        # Get type definition\n        type_def = self.parser.types.get(param_type)\n        \n        for arm in arms:\n            pattern = arm.pattern.strip()\n            \n            if pattern == '_':\n                continue\n            \n            # Check if pattern is a valid member of the type\n            if type_def and type_def.is_closed():\n                # For closed types, pattern must be one of the variants\n                is_valid = False\n                \n                for variant in type_def.variants:\n                    if self.pattern_matches_variant(pattern, variant):\n                        is_valid = True\n                        break\n                \n                if not is_valid:\n                    self.diagnostics.append('vacuous_arm')\n    \n    def check_unreachable_arms(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check for unreachable arms (earlier arms cover it)\"\"\"\n        for i in range(1, len(arms)):\n            current = arms[i]\n            \n            # Check if any earlier arm covers this one\n            for j in range(i):\n                earlier = arms[j]\n                \n                if self.pattern_covers(earlier.pattern, current.pattern):\n                    self.diagnostics.append('unreachable_arm')\n                    return\n    \n    def check_unsatisfiable_guards(self, func_name: str, arms: List[SwitchArm]):\n        \"\"\"Check for guards that can never be true\"\"\"\n        for arm in arms:\n            if arm.guard and not self.is_satisfiable(arm.guard):\n                self.diagnostics.append('unsatisfiable_arm_guard')\n                return\n    \n    def check_return_types(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check if all arm bodies return the declared type\"\"\"\n        for arm in arms:\n            body = arm.body.strip()\n            \n            # Check if body matches return type\n            if not self.value_matches_type(body, func_def.return_type):\n                self.diagnostics.append('return_not_declared')\n                return\n    \n    def check_arg_not_accepted(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check if function calls pass acceptable argument types\"\"\"\n        for arm in arms:\n            body = arm.body.strip()\n            \n            # Look for function calls\n            calls = re.findall(r'(\\w+)\\((.*?)\\)', body)\n            for called_func, args in calls:\n                called_def = self.parser.functions.get(called_func)\n                if not called_def:\n                    continue\n                \n                # Get the argument type (simplified - take first arg)\n                arg = args.split(',')[0].strip()\n                \n                # Check if argument type matches expected\n                arg_type = self.infer_type(arg, arm.pattern, func_def)\n                \n                if not self.type_compatible(arg_type, called_def.param_type):\n                    self.diagnostics.append('arg_not_accepted')\n                    return\n    \n    def check_exhaustiveness(self, func_name: str, arms: List[SwitchArm], func_def: FunctionDef):\n        \"\"\"Check if switch covers all cases\"\"\"\n        param_type = func_def.param_type\n        type_def = self.parser.types.get(param_type)\n        \n        if not type_def or not type_def.is_closed():\n            # Open type - only okay if there's a catch-all\n            if not any(a.pattern.strip() == '_' for a in arms):\n                # For tuples, need to check manually\n                if param_type.startswith('('):\n                    # Check tuple exhaustiveness\n                    self.check_tuple_exhaustiveness(arms, param_type)\n            return\n        \n        # Closed type - check all variants are covered\n        covered = set()\n        has_catchall = False\n        \n        for arm in arms:\n            if arm.pattern.strip() == '_':\n                has_catchall = True\n                break\n            \n            for variant in type_def.variants:\n                if self.pattern_matches_variant(arm.pattern, variant):\n                    covered.add(variant)\n        \n        if not has_catchall and len(covered) < len(type_def.variants):\n            self.diagnostics.append('switch_inexhaustive')\n    \n    def check_tuple_exhaustiveness(self, arms: List[SwitchArm], tuple_type: str):\n        \"\"\"Check exhaustiveness for tuple types\"\"\"\n        # Parse tuple type: \"(bool, bool, bool)\"\n        parts = tuple_type.strip('()').split(',')\n        types = [p.strip() for p in parts]\n        \n        # For bool tuple, enumerate all possibilities\n        if all(t == 'bool' for t in types):\n            import itertools\n            total_cases = 2 ** len(types)\n            covered = 0\n            \n            for arm in arms:\n                pattern = arm.pattern.strip()\n                if pattern == '_':\n                    # Catch-all covers everything\n                    return\n                \n                # Check how many cases this pattern covers\n                if self.covers_k_bools(pattern, len(types)):\n                    covered += self.count_matching_bools(pattern, len(types))\n            \n            if covered < total_cases:\n                self.diagnostics.append('switch_inexhaustive')\n    \n    # Helper methods\n    \n    def extract_bound_vars(self, pattern: str) -> Set[str]:\n        \"\"\"Extract variable names bound by pattern\"\"\"\n        vars = set()\n        tokens = re.findall(r'\\b[a-z_]\\w*\\b', pattern)\n        \n        for token in tokens:\n            if not token.startswith(':') and token not in ['when', 'and', 'or']:\n                # Exclude literals like literals\n                if not self.is_literal(token):\n                    vars.add(token)\n        \n        return vars\n    \n    def extract_used_vars(self, body: str) -> Set[str]:\n        \"\"\"Extract variables used in body\"\"\"\n        vars = set()\n        tokens = re.findall(r'\\b[a-z_]\\w*\\b', body)\n        \n        for token in tokens:\n            if not self.is_literal(token) and token not in ['switch', 'when', 'and', 'or']:\n                vars.add(token)\n        \n        return vars\n    \n    def is_literal(self, val: str) -> bool:\n        \"\"\"Check if value is a literal\"\"\"\n        return val.startswith(':') or val.isdigit() or val == '_'\n    \n    def pattern_matches_variant(self, pattern: str, variant: str) -> bool:\n        \"\"\"Check if pattern could match variant\"\"\"\n        pattern = pattern.strip()\n        \n        if pattern == '_':\n            return True\n        \n        if pattern == variant:\n            return True\n        \n        # Handle tuple patterns like (:pass, n)\n        if '(' in pattern and variant.startswith('('):\n            # Both are tuples\n            return True\n        \n        return False\n    \n    def pattern_covers(self, pattern1: str, pattern2: str) -> bool:\n        \"\"\"Check if pattern1 covers pattern2\"\"\"\n        p1 = pattern1.strip()\n        p2 = pattern2.strip()\n        \n        if p1 == '_':\n            return True\n        \n        if p1 == p2:\n            return True\n        \n        return False\n    \n    def is_satisfiable(self, guard: str) -> bool:\n        \"\"\"Check if guard is satisfiable\"\"\"\n        # Look for obvious contradictions\n        # x > 5 and x < 3\n        \n        parts = guard.split('and')\n        if len(parts) < 2:\n            return True\n        \n        for i in range(len(parts)):\n            for j in range(i + 1, len(parts)):\n                if self.are_contradictory(parts[i].strip(), parts[j].strip()):\n                    return False\n        \n        return True\n    \n    def are_contradictory(self, cond1: str, cond2: str) -> bool:\n        \"\"\"Check if two conditions contradict\"\"\"\n        # x > 5 and x < 3\n        m1 = re.match(r'(\\w+)\\s*>\\s*(\\d+)', cond1)\n        m2 = re.match(r'(\\w+)\\s*<\\s*(\\d+)', cond2)\n        \n        if m1 and m2:\n            var1, val1 = m1.group(1), int(m1.group(2))\n            var2, val2 = m2.group(1), int(m2.group(2))\n            \n            if var1 == var2 and val1 >= val2:\n                return True\n        \n        return False\n    \n    def value_matches_type(self, value: str, type_name: str) -> bool:\n        \"\"\"Check if a value matches the declared type\"\"\"\n        value = value.strip()\n        \n        if type_name == 'atom':\n            return value.startswith(':')\n        elif type_name == 'int':\n            return value.isdigit() or value.startswith('-')\n        elif type_name == 'bool':\n            return value in ['true', 'false']\n        elif type_name == 'term':\n            return True\n        \n        return True\n    \n    def infer_type(self, arg: str, pattern: str, func_def: FunctionDef) -> str:\n        \"\"\"Infer the type of an argument\"\"\"\n        if arg in func_def.param_names:\n            return func_def.param_type\n        \n        if arg.isdigit():\n            return 'int'\n        \n        if arg.startswith(':'):\n            return 'atom'\n        \n        return 'term'\n    \n    def type_compatible(self, actual: str, expected: str) -> bool:\n        \"\"\"Check if actual type is compatible with expected\"\"\"\n        if expected == 'term':\n            return True\n        \n        return actual == expected\n    \n    def covers_k_bools(self, pattern: str, k: int) -> bool:\n        \"\"\"Check if pattern covers some bool tuples\"\"\"\n        return True\n    \n    def count_matching_bools(self, pattern: str, k: int) -> int:\n        \"\"\"Count how many bool tuples match pattern\"\"\"\n        # Simplified\n        if pattern.strip() == '_':\n            return 2 ** k\n        \n        # Count wildcards\n        wilds = pattern.count('_')\n        if wilds > 0:\n            return 2 ** wilds\n        \n        return 1\n\ndef main():\n    if len(sys.argv) < 2:\n        sys.exit(1)\n    \n    filepath = sys.argv[1]\n    \n    try:\n        with open(filepath, 'r') as f:\n            content = f.read()\n    except:\n        sys.exit(1)\n    \n    parser = Parser(content)\n    checker = Checker(parser)\n    checker.check()\n    \n    # Remove duplicates and print sorted\n    diagnostics = sorted(set(checker.diagnostics))\n    for diag in diagnostics:\n        print(diag)\n\nif __name__ == '__main__':\n    main()\n","filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck","exists":true,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck","time":{"start":1788997716651,"end":1788997717282}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_0889202fb001cWvdrm5pYE7TCU","sessionID":"ses_f776f37c6ffeLHNTo5P39JtFVe","messageID":"msg_08891f9cb001k0m4Pay0pV050q"}}
