  \n        elif type_name == 'int':\n            if value.isdigit() or (value.startswith('-') and value[1:].isdigit()):\n                return True\n            # Function call returning int\n            if '(' in value:\n                func_name = value.split('(')[0]\n                func = self.parser.functions.get(func_name)\n                if func and func.return_type == 'int':\n                    return True\n            # Variable - could be int\n            if value in self.extract_bound_vars(arm.pattern):\n                return True\n            return False\n        \n        elif type_name == 'bool':\n            return value in ['true', 'false']\n        \n        elif type_name == 'term':\n            return True\n        \n        return True\n    \n    def arm_covers_variant(self, arm: SwitchArm, variant: str) -> bool:\n        \"\"\"Does this arm cover the variant?\"\"\"\n        pattern = arm.pattern.strip()","lineStart":539,"lineEnd":578,"totalLines":671,"truncated":true}},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck","time":{"start":1788997999481,"end":1788997999487}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_0889718b8001YP6TWzySi8K5Qt","sessionID":"ses_f776f37c6ffeLHNTo5P39JtFVe","messageID":"msg_088971441001OQjG5rP9oScWSY"}}
