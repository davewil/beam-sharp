closed():\n            if has_catchall:\n                # Catch-all on closed type is illegal, but we're checking exhaustiveness\n                return\n            \n            # Count covered variants\n            covered = set()\n            for arm in arms:\n                for variant in type_def.variants:\n                    if self.arm_covers_variant(arm, variant):\n                        covered.add(variant)\n            \n            if len(covered) < len(type_def.variants):\n                self.diagnostics.append('switch_inexhaustive')\n        else:\n            # Open type - need catch-all or exhaustive patterns\n            if not has_catchall and param_type.startswith('('):\n                # Tuple type - check exhaustiveness\n                if not self.is_tuple_exhaustive(arms, param_type):\n                    self.diagnostics.append('switch_inexhaustive')"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck\n===================================================================\n--- /Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck\n+++ /Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-10-round4/copilot-haiku45/switchcheck\n@@ -373,15 +373,15 @@\n \n has_catchall = any(a.pattern.strip() == '_' for a in arms)\n \n if type_def and type_def.is_closed():\n-    if has_catchall:\n-        # Catch-all on closed type is illegal, but we're checking exhaustiveness\n-        return\n-    \n     # Count covered variants\n     covered = set()\n     for arm in arms:\n+        # Skip catch-all for coverage counting on closed types\n+        if arm.pattern.strip() == '_':\n+            continue\n+            \n         for variant in type_def.variants:\n             if self.arm_covers_variant(arm, variant):\n                 covered.add(variant)\n     \n","filediff":{"