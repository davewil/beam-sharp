# Type environment / resolution
# ---------------------------------------------------------------------------

BUILTIN = {
    "int": INT(),
    "bool": BOOL(),
    "atom": ATOM_OPEN(),
    "term": TermTy(),
    "string": StrTy(False, frozenset()),
}


def ast_to_ty(ast, tenv: dict) -> Ty:
    if ast is None:
        return TermTy()
    if isinstance(ast, TName):
        if ast.name in tenv:
            return tenv[ast.name]
        if ast.name in BUILTIN:
            return BUILTIN[ast.name]
        return TermTy()
    if isinstance(ast, TAtom):
        return atom_lit(ast.name)
    if isinstance(ast, TTuple):
        return TupleTy(tuple(ast_to_ty(e, tenv) for e in ast.elts))
    if isinstance(ast, TUnion):
        return union(ast_to_ty(ast.left, tenv), ast_to_ty(ast.right, tenv))
    if isinstance(ast, TApp):
        arg = ast_to_ty(ast.arg, tenv)
        if ast.name == "list":
            return OpenListTy(arg)
        return TermTy()
    return TermTy()


def build_tenv(prog: Program) -> dict:
    tenv: dict = {}
    for rec in prog.records:
        # placeholder first
        tenv[rec.name] = RecordTy(rec.name, ())
    for rec in prog.records:
        fields = tuple((n, ast_to_ty(t, tenv)) for n, t in rec.fields)
        tenv[rec.name] = RecordTy(rec.name, fields)
    for td in prog.types:
        tenv[td.name] = ast_to_ty(td.body, tenv)
    return tenv


