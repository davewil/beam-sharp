TAG_ORDER = [
    "switch_inexhaustive",
    "unreachable_arm",
    "vacuous_arm",
    "unsatisfiable_arm_guard",
    "rebinding",
    "unbound_variable",
    "return_not_declared",
    "arg_not_accepted",
    "switch_in_guard",
]


# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------

KEYWORDS = {
    "module",
    "type",
    "record",
    "public",
    "when",
    "switch",
    "and",
    "or",
    "true",
    "false",
}

TWO = {
    "->": "ARROW",
    "=>": "FATARROW",
    ">=": "GE",
    "<=": "LE",
    "==": "EQEQ",
    "!=": "NE",
    "..": "DOTDOT",
}


@dataclass
class Tok:
    kind: str
    value: Any = None
    pos: int = 0


def lex(src: str) -> list[Tok]:
    i = 0
    n = len(src)
    out: list[Tok] = []

    def peek(k=0):
        j = i + k
        return src[j] if j < n else ""

    while i < n:
        c = src[i]
        if c in " \t\r\n":
            i += 1
            continue
        if c == "/" and peek(1) == "/":
            while i < n and src[i] != "\n":
                i += 1
            continue
        pos = i
        pair = peek() + peek(1)
        if pair in TWO:
            out.append(Tok(TWO[pair], pair, pos))
            i += 2
            continue
        if c == ":" and (peek(1).isalpha() or peek(1) == "_"):
            i += 1
            j = i
            while j < n and (src[j].isalnum() or src[j] == "_"):
                j += 1
            out.append(Tok("ATOM", src[i:j], pos))
            i = j
            continue
        if c.isalpha() or c == "_":
            j = i + 1
            while j < n and (src[j].isalnum() or src[j] == "_"):
                j += 1
            word = src[i:j]
            i = j
            if word == "_":
                out.append(Tok("WILD", "_", pos))
            elif word in KEYWORDS:
                out.append(Tok(word.upper(), word, pos))
            else:
                out.append(Tok("IDENT", word, pos))
            continue
        if c == '"':
            i += 1
            j = i
            buf = []
            while j < n and src[j] != '"':
                if src[j] == "\\" and j + 1 < n:
                    buf.append(src[j + 1])
                    j += 2
                    continue
                buf.append(src[j])
                j += 1
            out.append(Tok("STRING", "".join(buf), pos))
            i = j + 1 if j < n else j
            continue
        if c.isdigit():
            j = i + 1
            while j < n and src[j].isdigit():
                j += 1
            out.append(Tok("INT", int(src[i:j]), pos))
            i = j
            continue
        singles = {
            "(": "LPAREN",
            ")": "RPAREN",
            "{": "LBRACE",
            "}": "RBRACE",
            "[": "LBRACKET",
            "]": "RBRACKET",
            ",": "COMMA",
            "|": "PIPE",
            "=": "EQ",
            "<": "LT",
            ">": "GT",
            "+": "PLUS",
            "-": "MINUS",
            "*": "STAR",
            ".": "DOT",
            ":": "COLON",
        }
        if c in singles:
            out.append(Tok(singles[c], c, pos))
            i += 1
            continue
        i += 1
    out.append(Tok("EOF", None, n))
    return out


