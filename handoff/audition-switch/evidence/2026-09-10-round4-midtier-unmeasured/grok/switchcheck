class ParseError(Exception):
    pass


class Parser:
    def __init__(self, tokens: list[Tok]):
        self.ts = tokens
        self.i = 0

    def cur(self) -> Tok:
        return self.ts[self.i]

    def kind(self) -> str:
        return self.ts[self.i].kind

    def eat(self, kind=None) -> Tok:
        t = self.ts[self.i]
        if kind is not None and t.kind != kind:
            raise ParseError(f"expected {kind} got {t.kind} at {t.pos}")
        self.i += 1
        return t

    def accept(self, kind) -> Optional[Tok]:
        if self.kind() == kind:
            return self.eat()
        return None

    def parse(self) -> Program:
        types: list[TypeDecl] = []
        records: list[RecordDecl] = []
        sigs: list[Sig] = []
        clauses: list[Clause] = []
        while self.kind() != "EOF":
            k = self.kind()
            if k == "MODULE":
                self.eat("MODULE")
                self.eat("IDENT")
            elif k == "TYPE":
                types.append(self.parse_type_decl())
            elif k == "RECORD":
                records.append(self.parse_record_decl())
            elif k == "PUBLIC":
                sigs.append(self.parse_sig())
            elif k == "IDENT":
                clauses.append(self.parse_clause())
            else:
                raise ParseError(f"unexpected {k} at {self.cur().pos}")
        return Program(types, records, sigs, clauses)

    def parse_type_decl(self) -> TypeDecl:
        self.eat("TYPE")
        name = self.eat("IDENT").value
        self.eat("EQ")
        body = self.parse_type()
        return TypeDecl(name, body)

    def parse_record_decl(self) -> RecordDecl:
        self.eat("RECORD")
        name = self.eat("IDENT").value
        self.eat("LBRACE")
        fields = []
        while self.kind() != "RBRACE":
            fname = self.eat("IDENT").value
            self.eat("COLON")
            fty = self.parse_type()
            fields.append((fname, fty))
            self.accept("COMMA")
        self.eat("RBRACE")
        return RecordDecl(name, fields)

    def parse_sig(self) -> Sig:
        self.eat("PUBLIC")
        ret = self.parse_type()
        name = self.eat("IDENT").value
        self.eat("LPAREN")
        params = []
        if self.kind() != "RPAREN":
            while True:
                ty = self.parse_type()
                pname = self.eat("IDENT").value
                params.append((ty, pname))
                if not self.accept("COMMA"):
                    break
        self.eat("RPAREN")
        return Sig(name, params, ret)

    def parse_clause(self) -> Clause:
        name = self.eat("IDENT").value
        self.eat("LPAREN")
        pats = []
        if self.kind() != "RPAREN":
            while True:
                pats.append(self.parse_pattern())
                if not self.accept("COMMA"):
                    break
        self.eat("RPAREN")
        guard = None
        if self.accept("WHEN"):
            guard = self.parse_expr()
        self.eat("ARROW")
        body = self.parse_expr()
        return Clause(name, pats, guard, body)

    def parse_type(self):
        t = self.parse_type_primary()
        while self.kind() == "PIPE":
            self.eat("PIPE")
            t = TUnion(t, self.parse_type_primary())
        return t

    def parse_type_primary(self):
        k = self.kind()
        if k == "ATOM":
            return TAtom(self.eat("ATOM").value)
        if k == "IDENT":
            name = self.eat("IDENT").value
            if self.kind() == "LT":
                self.eat("LT")
                arg = self.parse_type()
                self.eat("GT")
                return TApp(name, arg)
            return TName(name)
        if k == "LPAREN":
            self.eat("LPAREN")
            if self.kind() == "RPAREN":
                self.eat("RPAREN")
                return TTuple([])
            elts = [self.parse_type()]
            if self.kind() == "COMMA":
                while self.accept("COMMA"):
                    elts.append(self.parse_type())
                self.eat("RPAREN")
                return TTuple(elts)
            self.eat("RPAREN")
            return elts[0]
        if k == "TRUE":
            self.eat("TRUE")
            return TName("bool")
        if k == "FALSE":
            self.eat("FALSE")
            return TName("bool")
        raise ParseError(f"type at {self.cur().pos}")

    def parse_pattern(self):
        return self.parse_pat_or()

    def parse_pat_or(self):
        t = self.parse_pat_and()
        while self.kind() == "OR":
            self.eat("OR")
            t = POr(t, self.parse_pat_and())
        return t

    def parse_pat_and(self):
        t = self.parse_pat_atom()
        while self.kind() == "AND":
            self.eat("AND")
            t = PAnd(t, self.parse_pat_atom())
        return t

    def parse_pat_atom(self):
        k = self.kind()
        if k == "EQEQ":
            self.eat("EQEQ")
            return PMatch(self.eat("IDENT").value)
        if k in ("GE", "LE", "GT", "LT", "NE"):
            op = self.eat().value
            return PRel(op, self.parse_signed_int())
        return self.parse_pat_primary()

    def parse_signed_int(self) -> int:
        sign = 1
        if self.accept("MINUS"):
            sign = -1
        return sign * self.eat("INT").value

    def parse_pat_primary(self):
        k = self.kind()
        if k == "WILD":
            self.eat("WILD")
            return PWild()
        if k == "IDENT":
            return PVar(self.eat("IDENT").value)
        if k == "ATOM":
            return PAtom(self.eat("ATOM").value)
        if k == "INT":
            return PInt(self.eat("INT").value)
        if k == "STRING":
            return PStr(self.eat("STRING").value)
        if k == "MINUS":
            return PInt(self.parse_signed_int())
        if k == "TRUE":
            self.eat("TRUE")
            return PBool(True)
        if k == "FALSE":
            self.eat("FALSE")
            return PBool(False)
        if k == "LPAREN":
            self.eat("LPAREN")
            if self.kind() == "RPAREN":
                self.eat("RPAREN")
                return PTuple([])
            elts = [self.parse_pattern()]
            if self.kind() == "COMMA":
                while self.accept("COMMA"):
                    elts.append(self.parse_pattern())
                self.eat("RPAREN")
                return PTuple(elts)
            self.eat("RPAREN")
            return elts[0]
        if k == "LBRACKET":
            self.eat("LBRACKET")
            elts = []
            rest: Any = None
            if self.kind() != "RBRACKET":
                while True:
                    if self.kind() == "DOTDOT":
                        self.eat("DOTDOT")
                        if self.kind() == "IDENT":
                            rest = self.eat("IDENT").value
                        else:
                            rest = True
                        break
                    elts.append(self.parse_pattern())
                    if not self.accept("COMMA"):
                        break
            self.eat("RBRACKET")
            return PList(elts, rest)
        raise ParseError(f"pattern at {self.cur().pos} {k}")

    def parse_expr(self):
        return self.parse_or()

    def parse_or(self):
        t = self.parse_and()
        while self.kind() == "OR":
            self.eat("OR")
            t = EBin("or", t, self.parse_and())
        return t

    def parse_and(self):
        t = self.parse_cmp()
        while self.kind() == "AND":
            self.eat("AND")
            t = EBin("and", t, self.parse_cmp())
        return t

    def parse_cmp(self):
        t = self.parse_add()
        if self.kind() in ("GE", "LE", "GT", "LT", "EQEQ", "NE"):
            op = self.eat().value
            t = EBin(op, t, self.parse_add())
        return t

    def parse_add(self):
        t = self.parse_postfix()
        while self.kind() in ("PLUS", "MINUS", "STAR"):
            op = self.eat().value
            t = EBin(op, t, self.parse_postfix())
        return t

    def parse_postfix(self):
        t = self.parse_primary_expr()
        while True:
            if self.kind() == "LPAREN" and isinstance(t, EVar):
                self.eat("LPAREN")
                args = []
                if self.kind() != "RPAREN":
                    while True:
                        args.append(self.parse_expr())
                        if not self.accept("COMMA"):
                            break
                self.eat("RPAREN")
                t = ECall(t.name, args)
            elif self.kind() == "DOT":
                self.eat("DOT")
                t = EField(t, self.eat("IDENT").value)
            elif self.kind() == "SWITCH":
                self.eat("SWITCH")
                self.eat("LBRACE")
                arms = []
                while self.kind() != "RBRACE":
                    arms.append(self.parse_arm())
                    self.accept("COMMA")
                self.eat("RBRACE")
                t = ESwitch(t, arms)
            else:
                break
        return t

    def parse_primary_expr(self):
        k = self.kind()
        if k == "INT":
            return EInt(self.eat("INT").value)
        if k == "STRING":
            return EStr(self.eat("STRING").value)
        if k == "MINUS":
            return EInt(self.parse_signed_int())
        if k == "ATOM":
            return EAtom(self.eat("ATOM").value)
        if k == "TRUE":
            self.eat("TRUE")
            return EBool(True)
        if k == "FALSE":
            self.eat("FALSE")
            return EBool(False)
        if k == "IDENT":
            return EVar(self.eat("IDENT").value)
        if k == "LPAREN":
            self.eat("LPAREN")
            if self.kind() == "RPAREN":
                self.eat("RPAREN")
                return ETuple([])
            elts = [self.parse_expr()]
            if self.kind() == "COMMA":
                while self.accept("COMMA"):
                    elts.append(self.parse_expr())
                self.eat("RPAREN")
                return ETuple(elts)
            self.eat("RPAREN")
            return elts[0]
        if k == "LBRACKET":
            self.eat("LBRACKET")
            elts = []
            if self.kind() != "RBRACKET":
                while True:
                    elts.append(self.parse_expr())
                    if not self.accept("COMMA"):
                        break
            self.eat("RBRACKET")
            return EList(elts)
        raise ParseError(f"expr at {self.cur().pos} {k}")

    def parse_arm(self) -> Arm:
        pat = self.parse_pattern()
        guard = None
        if self.accept("WHEN"):
            guard = self.parse_expr()
        self.eat("FATARROW")
        body = self.parse_expr()
        return Arm(pat, guard, body)


