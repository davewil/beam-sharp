NEG_INF = object()
POS_INF = object()


def iv_lo_key(x):
    return -10**18 if x is NEG_INF else x


def iv_hi_key(x):
    return 10**18 if x is POS_INF else x


def iv_norm(ivals):
    items = []
    for lo, hi in ivals:
        if lo is not NEG_INF and hi is not POS_INF and lo > hi:
            continue
        if lo is POS_INF or hi is NEG_INF:
            continue
        items.append((lo, hi))
    items.sort(key=lambda p: (iv_lo_key(p[0]), iv_hi_key(p[1])))
    merged = []
    for lo, hi in items:
        if not merged:
            merged.append([lo, hi])
            continue
        mlo, mhi = merged[-1]
        # adjacent integers merge: mhi + 1 >= lo
        can = False
        if mhi is POS_INF or lo is NEG_INF:
            can = True
        else:
            edge = mhi + 1 if mhi is not POS_INF else lo
            can = iv_lo_key(lo) <= iv_hi_key(mhi) + (0 if mhi is POS_INF else 1)
        if can:
            if iv_hi_key(hi) > iv_hi_key(mhi):
                merged[-1][1] = hi
        else:
            merged.append([lo, hi])
    return [(a, b) for a, b in merged]


def iv_is_empty(ivals):
    return len(iv_norm(ivals)) == 0


def iv_intersect(a, b):
    out = []
    for lo1, hi1 in a:
        for lo2, hi2 in b:
            lo = lo1 if iv_lo_key(lo1) >= iv_lo_key(lo2) else lo2
            hi = hi1 if iv_hi_key(hi1) <= iv_hi_key(hi2) else hi2
            if iv_lo_key(lo) <= iv_hi_key(hi):
                if lo is not NEG_INF and hi is not POS_INF and lo > hi:
                    continue
                out.append((lo, hi))
    return iv_norm(out)


def iv_union(a, b):
    return iv_norm(list(a) + list(b))


def iv_diff(a, b):
    cur = iv_norm(a)
    for lo2, hi2 in iv_norm(b):
        nxt = []
        for lo1, hi1 in cur:
            # left leftover: lo1 .. min(hi1, lo2-1)
            if iv_lo_key(lo1) < iv_lo_key(lo2):
                if lo2 is NEG_INF:
                    pass
                else:
                    left_hi = lo2 - 1
                    if iv_lo_key(lo1) <= iv_hi_key(left_hi) and iv_hi_key(left_hi) <= iv_hi_key(hi1):
                        nxt.append((lo1, left_hi))
                    elif iv_hi_key(hi1) < iv_lo_key(lo2):
                        nxt.append((lo1, hi1))
                        continue
            # right leftover: max(lo1, hi2+1) .. hi1
            if iv_hi_key(hi1) > iv_hi_key(hi2):
                if hi2 is POS_INF:
                    pass
                else:
                    right_lo = hi2 + 1
                    if iv_lo_key(right_lo) <= iv_hi_key(hi1) and iv_lo_key(right_lo) >= iv_lo_key(lo1):
                        nxt.append((right_lo, hi1))
                    elif iv_lo_key(lo1) > iv_hi_key(hi2):
                        nxt.append((lo1, hi1))
                        continue
            # if interval is completely outside b, keep it
            if iv_hi_key(hi1) < iv_lo_key(lo2) or iv_lo_key(lo1) > iv_hi_key(hi2):
                nxt.append((lo1, hi1))
        cur = iv_norm(nxt)
    return cur


def rel_intervals(op: str, n: int):
    if op == ">":
        return [(n + 1, POS_INF)]
    if op == ">=":
        return [(n, POS_INF)]
    if op == "<":
        return [(NEG_INF, n - 1)]
    if op == "<=":
        return [(NEG_INF, n)]
    if op == "==":
        return [(n, n)]
    if op == "!=":
        return [(NEG_INF, n - 1), (n + 1, POS_INF)]
    return [(NEG_INF, POS_INF)]


INT_FULL = ((NEG_INF, POS_INF),)


class Ty:
