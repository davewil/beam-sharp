def is_empty(t: Ty) -> bool:
    t = flatten(t)
    if isinstance(t, EmptyTy):
        return True
    if isinstance(t, IntTy):
        return iv_is_empty(t.ivals)
    if isinstance(t, AtomTy):
        return t.closed and not t.names
    if isinstance(t, StrTy):
        return t.closed and not t.names
    if isinstance(t, BoolTy):
        return not t.has_true and not t.has_false
    if isinstance(t, TupleTy):
        return any(is_empty(e) for e in t.elts)
    if isinstance(t, UnionTy):
        return all(is_empty(p) for p in t.parts)
    if isinstance(t, TermTy):
        return False
    if isinstance(t, NilTy):
        return False
    if isinstance(t, ConsTy):
        return is_empty(t.head) or is_empty(t.tail)
    if isinstance(t, OpenListTy):
        return False
    if isinstance(t, RecordTy):
        return False
    return False


def flatten(t: Ty) -> Ty:
    if isinstance(t, UnionTy):
        acc = []
        for p in t.parts:
            p = flatten(p)
            if isinstance(p, UnionTy):
                acc.extend(p.parts)
            elif not is_empty(p):
                acc.append(p)
        if not acc:
            return EMPTY
        if len(acc) == 1:
            return acc[0]
        return UnionTy(tuple(acc))
    return t


def parts_of(t: Ty) -> list:
    t = flatten(t)
    if isinstance(t, EmptyTy):
        return []
    if isinstance(t, UnionTy):
        return list(t.parts)
    return [t]


def union(*ts: Ty) -> Ty:
    acc = []
    ints = []
    atoms_closed = set()
    atoms_open_excl = None  # None = no open atom part yet
    strs_closed = set()
    strs_open_excl = None
    bool_t = False
    bool_f = False
    has_bool = False
    others = []
    term = None
    for t in ts:
        for p in parts_of(t):
            if isinstance(p, IntTy):
                ints.extend(p.ivals)
            elif isinstance(p, AtomTy):
                if p.closed:
                    atoms_closed |= set(p.names)
                else:
                    if atoms_open_excl is None:
                        atoms_open_excl = set(p.names)
                    else:
                        atoms_open_excl &= set(p.names)
            elif isinstance(p, StrTy):
                if p.closed:
                    strs_closed |= set(p.names)
                else:
                    if strs_open_excl is None:
                        strs_open_excl = set(p.names)
                    else:
                        strs_open_excl &= set(p.names)
            elif isinstance(p, BoolTy):
                has_bool = True
                bool_t = bool_t or p.has_true
                bool_f = bool_f or p.has_false
            elif isinstance(p, TermTy):
                if is_full_term(p):
                    term = p
                elif term is None or len(p.subtracted) < len(term.subtracted):
                    term = p
            else:
                others.append(p)
    if ints:
        acc.append(IntTy(tuple(iv_norm(ints))))
    if atoms_open_excl is not None:
        acc.append(AtomTy(False, frozenset(atoms_open_excl - atoms_closed)))
    elif atoms_closed:
        acc.append(AtomTy(True, frozenset(atoms_closed)))
    if strs_open_excl is not None:
        acc.append(StrTy(False, frozenset(strs_open_excl - strs_closed)))
    elif strs_closed:
        acc.append(StrTy(True, frozenset(strs_closed)))
    if has_bool:
        acc.append(BoolTy(bool_t, bool_f))
    acc.extend(others)
    if term is not None:
        acc.append(term)
    if not acc:
        return EMPTY
    if len(acc) == 1:
        return acc[0]
    return UnionTy(tuple(acc))


def is_full_term(t: Ty) -> bool:
    return isinstance(t, TermTy) and not t.subtracted


def INT() -> IntTy:
    return IntTy(INT_FULL)


def ATOM_OPEN() -> AtomTy:
    return AtomTy(False, frozenset())


def BOOL() -> BoolTy:
    return BoolTy(True, True)


def atom_lit(name: str) -> AtomTy:
    return AtomTy(True, frozenset([name]))


def str_lit(s: str) -> StrTy:
    return StrTy(True, frozenset([s]))


def STR_OPEN() -> StrTy:
    return StrTy(False, frozenset())


def int_lit(n: int) -> IntTy:
    return IntTy(((n, n),))


def bool_lit(v: bool) -> BoolTy:
    return BoolTy(True, False) if v else BoolTy(False, True)


def intersect(a: Ty, b: Ty) -> Ty:
    a = flatten(a)
    b = flatten(b)
    if is_empty(a) or is_empty(b):
        return EMPTY
    if is_full_term(a):
        return b
    if is_full_term(b):
        return a
    if isinstance(a, TermTy):
        r = b
        for s in a.subtracted:
            r = diff(r, s)
        return r
    if isinstance(b, TermTy):
        return intersect(b, a)
    if isinstance(a, UnionTy) or isinstance(b, UnionTy):
        acc = []
        for pa in parts_of(a):
            for pb in parts_of(b):
                acc.append(intersect(pa, pb))
        return union(*acc)
    if isinstance(a, IntTy) and isinstance(b, IntTy):
        iv = iv_intersect(a.ivals, b.ivals)
        return IntTy(tuple(iv)) if iv else EMPTY
    if isinstance(a, AtomTy) and isinstance(b, AtomTy):
        return atom_intersect(a, b)
    if isinstance(a, StrTy) and isinstance(b, StrTy):
        return str_intersect(a, b)
    if isinstance(a, BoolTy) and isinstance(b, BoolTy):
        t = a.has_true and b.has_true
        f = a.has_false and b.has_false
        if not t and not f:
            return EMPTY
        return BoolTy(t, f)
    if isinstance(a, TupleTy) and isinstance(b, TupleTy):
        if len(a.elts) != len(b.elts):
            return EMPTY
        elts = []
        for x, y in zip(a.elts, b.elts):
            z = intersect(x, y)
            if is_empty(z):
                return EMPTY
            elts.append(z)
        return TupleTy(tuple(elts))
    if isinstance(a, (OpenListTy, ConsTy, NilTy)) and isinstance(
        b, (OpenListTy, ConsTy, NilTy)
    ):
        return list_intersect(a, b)
    if isinstance(a, RecordTy) and isinstance(b, RecordTy):
        if a.name == b.name:
            return a
        return EMPTY
    return EMPTY


def str_intersect(a: StrTy, b: StrTy) -> Ty:
    if a.closed and b.closed:
        names = a.names & b.names
        return StrTy(True, names) if names else EMPTY
    if a.closed and not b.closed:
        names = a.names - b.names
        return StrTy(True, names) if names else EMPTY
    if not a.closed and b.closed:
        names = b.names - a.names
        return StrTy(True, names) if names else EMPTY
    return StrTy(False, a.names | b.names)


def str_diff(a: StrTy, b: StrTy) -> Ty:
    if not b.closed and not b.names:
        return EMPTY
    if a.closed and b.closed:
        names = a.names - b.names
        return StrTy(True, names) if names else EMPTY
    if not a.closed and b.closed:
        return StrTy(False, a.names | b.names)
    if a.closed and not b.closed:
        names = a.names & b.names
        return StrTy(True, names) if names else EMPTY
    return EMPTY


def cons_diff(a: ConsTy, b: ConsTy) -> Ty:
    return tuple_diff(TupleTy((a.head, a.tail)), TupleTy((b.head, b.tail)))


def as_cons(ty: Ty) -> Ty:
    if isinstance(ty, ConsTy):
        return ty
    if isinstance(ty, OpenListTy):
        return ConsTy(ty.elem, ty)
    return EMPTY


def list_intersect(a: Ty, b: Ty) -> Ty:
    if isinstance(a, NilTy) and isinstance(b, NilTy):
        return a
    if isinstance(a, NilTy) and isinstance(b, OpenListTy):
        return a
    if isinstance(a, OpenListTy) and isinstance(b, NilTy):
        return b
    if isinstance(a, NilTy) or isinstance(b, NilTy):
        return EMPTY
    if isinstance(a, OpenListTy) and isinstance(b, OpenListTy):
        e = intersect(a.elem, b.elem)
        if is_empty(e):
            return NilTy()
        return OpenListTy(e)
    if isinstance(a, OpenListTy) and isinstance(b, ConsTy):
        return list_intersect(as_cons(a), b)
    if isinstance(a, ConsTy) and isinstance(b, OpenListTy):
        return list_intersect(a, as_cons(b))
    if isinstance(a, ConsTy) and isinstance(b, ConsTy):
        h = intersect(a.head, b.head)
        t = intersect(a.tail, b.tail)
        if is_empty(h) or is_empty(t):
            return EMPTY
        return ConsTy(h, t)
    return EMPTY


def list_diff(a: Ty, b: Ty) -> Ty:
    if isinstance(a, NilTy) and isinstance(b, NilTy):
        return EMPTY
    if isinstance(a, NilTy) and isinstance(b, OpenListTy):
        return EMPTY
    if isinstance(a, NilTy) and isinstance(b, ConsTy):
        return a
    if isinstance(a, ConsTy) and isinstance(b, NilTy):
        return a
    if isinstance(a, ConsTy) and isinstance(b, ConsTy):
        d = cons_diff(a, b)
        return _tuple_as_cons(d)
    if isinstance(a, ConsTy) and isinstance(b, OpenListTy):
        return list_diff(a, as_cons(b))
    if isinstance(a, OpenListTy) and isinstance(b, NilTy):
        return ConsTy(a.elem, a)
    if isinstance(a, OpenListTy) and isinstance(b, ConsTy):
        return union(NilTy(), list_diff(as_cons(a), b))
    if isinstance(a, OpenListTy) and isinstance(b, OpenListTy):
        de = diff(a.elem, b.elem)
        if is_empty(de) and is_empty(diff(b.elem, a.elem)):
            return EMPTY
        if is_empty(de):
            return EMPTY
        return OpenListTy(de)
    return a


def _tuple_as_cons(t: Ty) -> Ty:
    t = flatten(t)
    if isinstance(t, EmptyTy):
        return EMPTY
    if isinstance(t, UnionTy):
        return union(*(_tuple_as_cons(p) for p in t.parts))
    if isinstance(t, TupleTy) and len(t.elts) == 2:
        return ConsTy(t.elts[0], t.elts[1])
    return t


def atom_intersect(a: AtomTy, b: AtomTy) -> Ty:
    if a.closed and b.closed:
        names = a.names & b.names
        return AtomTy(True, names) if names else EMPTY
    if a.closed and not b.closed:
        names = a.names - b.names
        return AtomTy(True, names) if names else EMPTY
    if not a.closed and b.closed:
        names = b.names - a.names
        return AtomTy(True, names) if names else EMPTY
    # both open: exclusions union
    return AtomTy(False, a.names | b.names)


def atom_diff(a: AtomTy, b: AtomTy) -> Ty:
    if not b.closed and not b.names:
        return EMPTY
    if a.closed and b.closed:
        names = a.names - b.names
        return AtomTy(True, names) if names else EMPTY
    if not a.closed and b.closed:
        return AtomTy(False, a.names | b.names)
    if a.closed and not b.closed:
        names = a.names & b.names
        return AtomTy(True, names) if names else EMPTY
    # both open: a remaining after removing (all - b.excl) ≈ a.excl without those
    return EMPTY


def tuple_diff(a: TupleTy, b: TupleTy) -> Ty:
    if len(a.elts) != len(b.elts):
        return a
    n = len(a.elts)
    acc = []
    prefix = []
    for i in range(n):
        left = diff(a.elts[i], b.elts[i])
        if not is_empty(left):
            elts = prefix + [left] + list(a.elts[i + 1 :])
            acc.append(TupleTy(tuple(elts)))
        inter = intersect(a.elts[i], b.elts[i])
        if is_empty(inter):
            break
        prefix.append(inter)
    if not acc:
        return EMPTY
    return union(*acc)


def diff(a: Ty, b: Ty) -> Ty:
    a = flatten(a)
    b = flatten(b)
    if is_empty(a):
        return EMPTY
    if is_empty(b):
        return a
    if is_full_term(b):
        return EMPTY
    if isinstance(a, TermTy):
        return TermTy(a.subtracted + (b,))
    if isinstance(b, TermTy):
        r = a
        # a - (Term - sub) = a ∩ union(sub) if Term is top minus sub
        # remaining of a that lies in subtracted parts of b
        if not b.subtracted:
            return EMPTY
        kept = []
        for s in b.subtracted:
            kept.append(intersect(a, s))
        return union(*kept)
    if isinstance(a, UnionTy):
        return union(*(diff(p, b) for p in a.parts))
    if isinstance(b, UnionTy):
        r = a
        for p in b.parts:
            r = diff(r, p)
        return r
    if isinstance(a, IntTy) and isinstance(b, IntTy):
        iv = iv_diff(a.ivals, b.ivals)
        return IntTy(tuple(iv)) if iv else EMPTY
    if isinstance(a, AtomTy) and isinstance(b, AtomTy):
        return atom_diff(a, b)
    if isinstance(a, StrTy) and isinstance(b, StrTy):
        return str_diff(a, b)
    if isinstance(a, BoolTy) and isinstance(b, BoolTy):
        t = a.has_true and not b.has_true
        f = a.has_false and not b.has_false
        if not t and not f:
            return EMPTY
        return BoolTy(t, f)
    if isinstance(a, TupleTy) and isinstance(b, TupleTy):
        return tuple_diff(a, b)
    if isinstance(a, (OpenListTy, ConsTy, NilTy)) and isinstance(
        b, (OpenListTy, ConsTy, NilTy)
    ):
        return list_diff(a, b)
    if isinstance(a, RecordTy) and isinstance(b, RecordTy) and a.name == b.name:
        return EMPTY
    return a


def is_subtype(a: Ty, b: Ty) -> bool:
    if is_empty(a):
        return True
    if is_full_term(b):
        return True
    return is_empty(diff(a, b))


