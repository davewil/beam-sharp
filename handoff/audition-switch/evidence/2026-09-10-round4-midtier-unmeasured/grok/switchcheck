class Checker:
    def __init__(self, prog: Program):
        self.prog = prog
        self.tags: set[str] = set()
        self.tenv = build_tenv(prog)
        self.funcs: dict[str, tuple[list[Ty], Ty]] = {}
        for sig in prog.sigs:
            params = [ast_to_ty(t, self.tenv) for t, _ in sig.params]
            ret = ast_to_ty(sig.ret, self.tenv)
            self.funcs[sig.name] = (params, ret)
        self.sig_by_name = {s.name: s for s in prog.sigs}

    def run(self) -> set[str]:
        for cl in self.prog.clauses:
            self.check_clause(cl)
        return self.tags

    def check_clause(self, cl: Clause):
        sig = self.sig_by_name.get(cl.name)
        env: dict[str, Ty] = {}
        if sig is not None:
            for (ty_ast, pname), pat in zip(sig.params, cl.pats):
                pty = ast_to_ty(ty_ast, self.tenv)
                env.update(bind_pattern(pat, pty))
                # also bind signature name if the pattern is that var or always?
                if isinstance(pat, PVar):
                    env[pat.name] = pty
                else:
                    env.update(bind_pattern(pat, pty))
            # if fewer patterns? zip handles
            if not cl.pats and sig.params:
                for ty_ast, pname in sig.params:
                    env[pname] = ast_to_ty(ty_ast, self.tenv)
        else:
            for pat in cl.pats:
                env.update(bind_pattern(pat, TermTy()))
        if cl.guard:
            self.check_expr(cl.guard, env, in_guard=True)
        expected = self.funcs[cl.name][1] if cl.name in self.funcs else None
        self.check_expr(cl.body, env, expected=expected)

    def check_expr(
        self,
        e,
        env: dict[str, Ty],
        *,
        in_guard: bool = False,
        expected: Optional[Ty] = None,
        check_args: bool = True,
    ) -> Ty:
        if e is None:
            return TermTy()
        if isinstance(e, EInt):
            return int_lit(e.value)
        if isinstance(e, EStr):
            return str_lit(e.value)
        if isinstance(e, EAtom):
            return atom_lit(e.name)
        if isinstance(e, EBool):
            return bool_lit(e.value)
        if isinstance(e, EVar):
            if e.name not in env:
                self.tags.add("unbound_variable")
                return TermTy()
            return env[e.name]
        if isinstance(e, ETuple):
            elts = [
                self.check_expr(x, env, in_guard=in_guard, check_args=check_args)
                for x in e.elts
            ]
            return TupleTy(tuple(elts))
        if isinstance(e, EList):
            elts = [
                self.check_expr(x, env, in_guard=in_guard, check_args=check_args)
                for x in e.elts
            ]
            elem = union(*elts) if elts else TermTy()
            return OpenListTy(elem)
        if isinstance(e, EField):
            obj = self.check_expr(e.obj, env, in_guard=in_guard, check_args=check_args)
            for p in parts_of(obj):
                if isinstance(p, RecordTy):
                    for n, t in p.fields:
                        if n == e.field:
                            return t
            return TermTy()
        if isinstance(e, EBin):
            l = self.check_expr(e.left, env, in_guard=in_guard, check_args=check_args)
            r = self.check_expr(e.right, env, in_guard=in_guard, check_args=check_args)
            if e.op in (">", "<", ">=", "<=", "==", "!=", "and", "or"):
                return BOOL()
            return INT()
        if isinstance(e, ECall):
            args_ty = [
                self.check_expr(a, env, in_guard=in_guard, check_args=check_args)
                for a in e.args
            ]
            if e.name in self.funcs:
                params, ret = self.funcs[e.name]
                if check_args and not in_guard:
                    for at, pt in zip(args_ty, params):
                        if not is_subtype(at, pt):
                            self.tags.add("arg_not_accepted")
                return ret
            # unknown function: not a variable use
            return TermTy()
        if isinstance(e, ESwitch):
            if in_guard:
                self.tags.add("switch_in_guard")
            return self.analyze_switch(
                e, env, expected=None if in_guard else expected, in_guard=in_guard
            )
        return TermTy()

    def analyze_switch(
        self, sw: ESwitch, env: dict[str, Ty], expected: Optional[Ty], in_guard: bool
    ) -> Ty:
        subject_ty = self.check_expr(sw.subject, env, in_guard=in_guard)
        if in_guard:
            # The construct is refused; don't also grade its arms as a set.
            for arm in sw.arms:
                binds = bind_pattern(arm.pat, subject_ty)
                arm_env = dict(env)
                arm_env.update(binds)
                self._check_match_names(arm.pat, env)
                if arm.guard:
                    self.check_expr(arm.guard, arm_env, in_guard=True)
                self.check_expr(arm.body, arm_env, in_guard=True)
            return BOOL()
        residual = subject_ty
        body_types = []
        tags_before = set(self.tags)
        pending_unreachable = False
        for arm in sw.arms:
            if check_rebinding(arm.pat, set(env.keys())):
                self.tags.add("rebinding")
            binds = bind_pattern(arm.pat, subject_ty)
            arm_env = dict(env)
            arm_env.update(binds)

            # == name: if name unbound, tag
            self._check_match_names(arm.pat, env)

            matched = pattern_matched(arm.pat, subject_ty)
            if is_pure_match_name(arm.pat):
                # membership: overlap of subject with the named value's type
                nm = arm.pat.name
                if nm in env:
                    if is_empty(intersect(subject_ty, env[nm])):
                        matched = EMPTY
                    # else matched stays subject for vacuous check, but no credit
                else:
                    matched = EMPTY

            refined = refine_guard(matched, arm.pat, arm.guard)
            readable = refined != "unread"
            if not readable:
                refined_ty = matched
            else:
                refined_ty = refined

            vacuous = is_empty(matched) and not is_pure_match_name(arm.pat)
            if is_pure_match_name(arm.pat):
                vacuous = is_empty(matched)

            unsat = (
                (not vacuous)
                and readable
                and arm.guard is not None
                and is_empty(refined_ty)
            )

            credits_coverage = (
                readable
                and not is_pure_match_name(arm.pat)
                and not pattern_has_match(arm.pat)
            )
            if credits_coverage:
                credited = refined_ty
            else:
                credited = EMPTY

            overlap = intersect(
                refined_ty if readable and not is_pure_match_name(arm.pat) else matched,
                residual,
            )
            if is_pure_match_name(arm.pat) or pattern_has_match(arm.pat):
                # == name credits nothing; only dead if residual is already empty
                live = not is_empty(residual) and not vacuous
            else:
                live = not is_empty(overlap) and not vacuous and not unsat

            if vacuous:
                self.tags.add("vacuous_arm")
            elif unsat:
                self.tags.add("unsatisfiable_arm_guard")
            elif not live and not vacuous and not unsat:
                # earlier arms already cover this pattern (or its guard-refined set)
                if not is_empty(matched):
                    pending_unreachable = True

            if not is_empty(credited):
                residual = diff(residual, credited)

            if arm.guard:
                self.check_expr(arm.guard, arm_env, in_guard=True)

            body_ty = self.check_expr(
                arm.body,
                arm_env,
                in_guard=in_guard,
                expected=None,
                check_args=live and not in_guard,
            )
            if live and expected is not None and not in_guard:
                if not is_subtype(body_ty, expected):
                    self.tags.add("return_not_declared")
            if live:
                body_types.append(body_ty)

        # Binding errors vs coverage: the spec's Pick example (rebinding catch-all
        # then `_`) and Bad example (unbound name, uncovered `term`) each name
        # only the binding tag. A rebinding name still matches like a fresh
        # introduction, so `_` would look unreachable; an unbound use does not
        # cover `term`. Report the binding tag, not the coverage consequence.
        new_tags = self.tags - tags_before
        if pending_unreachable and "rebinding" not in new_tags:
            self.tags.add("unreachable_arm")
        if not is_empty(residual) and "unbound_variable" not in new_tags:
            self.tags.add("switch_inexhaustive")

        if body_types:
            return union(*body_types)
        return TermTy()

    def _check_match_names(self, pat, env):
        if isinstance(pat, PMatch):
            if pat.name not in env:
                self.tags.add("unbound_variable")
        elif isinstance(pat, PTuple):
            for e in pat.elts:
                self._check_match_names(e, env)
        elif isinstance(pat, PList):
            for e in pat.elts:
                self._check_match_names(e, env)
        elif isinstance(pat, (PAnd, POr)):
            self._check_match_names(pat.left, env)
            self._check_match_names(pat.right, env)


def check_source(src: str) -> set[str]:
    try:
        prog = Parser(lex(src)).parse()
    except ParseError:
        return set()
    return Checker(prog).run()


def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    path = sys.argv[1]
    with open(path, "r", encoding="utf-8") as f:
        src = f.read()
    tags = check_source(src)
    for t in TAG_ORDER:
        if t in tags:
            print(t)


if __name__ == "__main__":
    main()
