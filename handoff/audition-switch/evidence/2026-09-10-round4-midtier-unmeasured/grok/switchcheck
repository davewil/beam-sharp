# Pattern helpers
# ---------------------------------------------------------------------------

def pattern_introduces(pat) -> list[str]:
    if isinstance(pat, PVar):
        return [pat.name]
    if isinstance(pat, PTuple):
        acc = []
        for e in pat.elts:
            acc.extend(pattern_introduces(e))
        return acc
    if isinstance(pat, PList):
        acc = []
        for e in pat.elts:
            acc.extend(pattern_introduces(e))
        if isinstance(pat.rest, str):
            acc.append(pat.rest)
        return acc
    if isinstance(pat, (PAnd, POr)):
        return pattern_introduces(pat.left) + pattern_introduces(pat.right)
    return []


def check_rebinding(pat, scope: set[str]) -> bool:
    seen = set(scope)
    found = False

    def walk(p):
        nonlocal found
        if isinstance(p, PVar):
            if p.name in seen:
                found = True
            else:
                seen.add(p.name)
        elif isinstance(p, PTuple):
            for e in p.elts:
                walk(e)
        elif isinstance(p, PList):
            for e in p.elts:
                walk(e)
            if isinstance(p.rest, str):
                if p.rest in seen:
                    found = True
                else:
                    seen.add(p.rest)
        elif isinstance(p, (PAnd, POr)):
            walk(p.left)
            walk(p.right)
        elif isinstance(p, PMatch):
            pass

    walk(pat)
    return found


def extract_shape(ty: Ty, n: int) -> Ty:
    """Project an n-tuple shape out of ty."""
    if is_empty(ty):
        return EMPTY
    if isinstance(ty, TermTy):
        tup = TupleTy(tuple(TermTy() for _ in range(n)))
        return intersect(ty, tup)
    if isinstance(ty, TupleTy):
        return ty if len(ty.elts) == n else EMPTY
    if isinstance(ty, UnionTy):
        return union(*(extract_shape(p, n) for p in ty.parts))
    return EMPTY


def pattern_matched(pat, subject: Ty) -> Ty:
    if isinstance(pat, (PWild, PVar)):
        return subject
    if isinstance(pat, PMatch):
        # coverage credits nothing; membership handled separately
        return subject
    if isinstance(pat, PAtom):
        return intersect(subject, atom_lit(pat.name))
    if isinstance(pat, PInt):
        return intersect(subject, int_lit(pat.value))
    if isinstance(pat, PStr):
        return intersect(subject, str_lit(pat.value))
    if isinstance(pat, PBool):
        return intersect(subject, bool_lit(pat.value))
    if isinstance(pat, PRel):
        return intersect(subject, IntTy(tuple(rel_intervals(pat.op, pat.value))))
    if isinstance(pat, PAnd):
        return intersect(pattern_matched(pat.left, subject), pattern_matched(pat.right, subject))
    if isinstance(pat, POr):
        return union(pattern_matched(pat.left, subject), pattern_matched(pat.right, subject))
    if isinstance(pat, PTuple):
        n = len(pat.elts)
        shape = extract_shape(subject, n)
        if is_empty(shape):
            return EMPTY
        return match_tuple_pat(pat, shape)
    if isinstance(pat, PList):
        return match_list_pat(pat.elts, pat.rest, subject)
    return EMPTY


def list_elem(ty: Ty) -> Ty:
    ty = flatten(ty)
    if isinstance(ty, OpenListTy):
        return ty.elem
    if isinstance(ty, ConsTy):
        return union(ty.head, list_elem(ty.tail))
    if isinstance(ty, UnionTy):
        return union(*(list_elem(p) for p in ty.parts))
    if isinstance(ty, TermTy):
        return TermTy()
    return TermTy()


def match_list_pat(elts, rest, subject: Ty) -> Ty:
    subject = flatten(subject)
    if isinstance(subject, UnionTy):
        return union(*(match_list_pat(elts, rest, p) for p in subject.parts))
    if isinstance(subject, TermTy):
        return match_list_pat(elts, rest, OpenListTy(TermTy()))
    if not isinstance(subject, (OpenListTy, ConsTy, NilTy)):
        return EMPTY
    if not elts:
        if rest is None:
            return intersect(subject, NilTy())
        return subject
    cons = as_cons(subject)
    if is_empty(cons) or not isinstance(cons, ConsTy):
        return EMPTY
    h = pattern_matched(elts[0], cons.head)
    if is_empty(h):
        return EMPTY
    t = match_list_pat(elts[1:], rest, cons.tail)
    if is_empty(t):
        return EMPTY
    return ConsTy(h, t)


def match_tuple_pat(pat: PTuple, shape: Ty) -> Ty:
    if isinstance(shape, UnionTy):
        return union(*(match_tuple_pat(pat, p) for p in shape.parts))
    if not isinstance(shape, TupleTy) or len(shape.elts) != len(pat.elts):
        return EMPTY
    elts = []
    for p, t in zip(pat.elts, shape.elts):
        m = pattern_matched(p, t)
        if is_empty(m):
            return EMPTY
        elts.append(m)
    return TupleTy(tuple(elts))


def is_pure_match_name(pat) -> bool:
    return isinstance(pat, PMatch)


def pattern_has_match(pat) -> bool:
    """True if any `== name` occurs in the pattern. Those positions credit
    nothing toward coverage (the bound value is unknown at compile time)."""
    if isinstance(pat, PMatch):
        return True
    if isinstance(pat, PTuple):
        return any(pattern_has_match(e) for e in pat.elts)
    if isinstance(pat, PList):
        return any(pattern_has_match(e) for e in pat.elts)
    if isinstance(pat, (PAnd, POr)):
        return pattern_has_match(pat.left) or pattern_has_match(pat.right)
    return False


def bind_pattern(pat, subject: Ty) -> dict:
    env = {}

    def walk(p, ty):
        if isinstance(p, PVar):
            env[p.name] = ty
        elif isinstance(p, PTuple):
            n = len(p.elts)
            shape = extract_shape(ty, n)
            if isinstance(shape, UnionTy):
                # bind as union of components
                for i, sp in enumerate(p.elts):
                    cols = []
                    for part in parts_of(shape):
                        if isinstance(part, TupleTy) and i < len(part.elts):
                            cols.append(part.elts[i])
                    walk(sp, union(*cols) if cols else EMPTY)
            elif isinstance(shape, TupleTy):
                for sp, st in zip(p.elts, shape.elts):
                    walk(sp, st)
            else:
                for sp in p.elts:
                    walk(sp, TermTy())
        elif isinstance(p, PList):
            elem = list_elem(ty)
            for sp in p.elts:
                walk(sp, elem)
            if isinstance(p.rest, str):
                env[p.rest] = (
                    OpenListTy(elem) if not isinstance(flatten(ty), TermTy) else TermTy()
                )
        elif isinstance(p, PAnd):
            walk(p.left, ty)
            walk(p.right, ty)
        elif isinstance(p, POr):
            walk(p.left, ty)
            walk(p.right, ty)

    walk(pat, subject)
    return env


def guard_is_readable(g) -> bool:
    if g is None:
        return True
    if isinstance(g, EBin) and g.op in ("and", "or"):
        return guard_is_readable(g.left) and guard_is_readable(g.right)
    if isinstance(g, EBin) and g.op in (">", "<", ">=", "<=", "==", "!="):
        return cmp_is_readable(g)
    return False


def is_int_lit_expr(e) -> Optional[int]:
    if isinstance(e, EInt):
        return e.value
    return None


def is_atom_lit_expr(e) -> Optional[str]:
    if isinstance(e, EAtom):
        return e.name
    return None


def is_bool_lit_expr(e) -> Optional[bool]:
    if isinstance(e, EBool):
        return e.value
    return None


def cmp_is_readable(g: EBin) -> bool:
    l, r = g.left, g.right
    # var vs literal, or literal vs var
    def is_var(e):
        return isinstance(e, EVar)

    def is_lit(e):
        return isinstance(e, (EInt, EAtom, EBool, EStr))

    return (is_var(l) and is_lit(r)) or (is_lit(l) and is_var(r))


def flip_op(op: str) -> str:
    return {
        ">": "<",
        "<": ">",
        ">=": "<=",
        "<=": ">=",
        "==": "==",
        "!=": "!=",
    }[op]


def normalize_cmp(g: EBin):
    """Return (var_name, op, literal_expr) with var on the left."""
    if isinstance(g.left, EVar) and isinstance(g.right, (EInt, EAtom, EBool, EStr)):
        return g.left.name, g.op, g.right
    if isinstance(g.right, EVar) and isinstance(g.left, (EInt, EAtom, EBool, EStr)):
        return g.right.name, flip_op(g.op), g.left
    return None


def refine_var_in(pat, ty: Ty, var: str, fn) -> Ty:
    if isinstance(ty, UnionTy):
        return union(*(refine_var_in(pat, p, var, fn) for p in ty.parts))
    if isinstance(pat, PVar) and pat.name == var:
        return fn(ty)
    if isinstance(pat, PTuple) and isinstance(ty, TupleTy) and len(pat.elts) == len(ty.elts):
        elts = [refine_var_in(p, t, var, fn) for p, t in zip(pat.elts, ty.elts)]
        if any(is_empty(e) for e in elts):
            return EMPTY
        return TupleTy(tuple(elts))
    if isinstance(pat, PAnd):
        ty = refine_var_in(pat.left, ty, var, fn)
        return refine_var_in(pat.right, ty, var, fn)
    if isinstance(pat, POr):
        return union(
            refine_var_in(pat.left, ty, var, fn),
            refine_var_in(pat.right, ty, var, fn),
        )
    if isinstance(pat, PList) and isinstance(ty, ListTy):
        # refine element vars only
        return ty
    return ty


def constraint_ty(op: str, lit) -> Optional[Ty]:
    if isinstance(lit, EInt):
        return IntTy(tuple(rel_intervals(op, lit.value)))
    if isinstance(lit, EAtom):
        if op == "==":
            return atom_lit(lit.name)
        if op == "!=":
            # all atoms except this one — open atom excluding name
            return AtomTy(False, frozenset([lit.name]))
        return None
    if isinstance(lit, EBool):
        if op == "==":
            return bool_lit(lit.value)
        if op == "!=":
            return bool_lit(not lit.value)
        return None
    if isinstance(lit, EStr):
        if op == "==":
            return str_lit(lit.value)
        if op == "!=":
            return StrTy(False, frozenset([lit.value]))
        return None
    return None


def refine_guard(matched: Ty, pat, guard) -> Any:
    """Return a Ty, or the string 'unread'."""
    if guard is None:
        return matched
    if not guard_is_readable(guard):
        return "unread"
    return _refine_guard(matched, pat, guard)


def _refine_guard(matched: Ty, pat, guard) -> Ty:
    if isinstance(guard, EBin) and guard.op == "and":
        return intersect(
            _refine_guard(matched, pat, guard.left),
            _refine_guard(matched, pat, guard.right),
        )
    if isinstance(guard, EBin) and guard.op == "or":
        return union(
            _refine_guard(matched, pat, guard.left),
            _refine_guard(matched, pat, guard.right),
        )
    if isinstance(guard, EBin) and guard.op in (">", "<", ">=", "<=", "==", "!="):
        norm = normalize_cmp(guard)
        if norm is None:
            return matched
        var, op, lit = norm
        ct = constraint_ty(op, lit)
        if ct is None:
            return matched

        def fn(ty):
            return intersect(ty, ct)

        return refine_var_in(pat, matched, var, fn)
    return matched


def names_in_expr(e) -> set[str]:
    s: set[str] = set()

    def walk(x):
        if isinstance(x, EVar):
            s.add(x.name)
        elif isinstance(x, ETuple):
            for a in x.elts:
                walk(a)
        elif isinstance(x, EList):
            for a in x.elts:
                walk(a)
        elif isinstance(x, ECall):
            for a in x.args:
                walk(a)
        elif isinstance(x, EField):
            walk(x.obj)
        elif isinstance(x, EBin):
            walk(x.left)
            walk(x.right)
        elif isinstance(x, ESwitch):
            walk(x.subject)
            for arm in x.arms:
                # names in patterns are bindings, not uses
                if arm.guard:
                    walk(arm.guard)
                walk(arm.body)

    walk(e)
    return s


