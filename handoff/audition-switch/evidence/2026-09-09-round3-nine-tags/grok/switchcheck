#!/usr/bin/env python3
"""Exhaustiveness checker for switch expressions (.bs)."""

from __future__ import annotations

import sys
from dataclasses import dataclass
from typing import Any, Optional


TAGS = (
    "switch_inexhaustive",
    "unreachable_arm",
    "vacuous_arm",
    "unsatisfiable_arm_guard",
    "rebinding",
    "unbound_variable",
    "return_not_declared",
    "arg_not_accepted",
    "switch_in_guard",
)


# ---------------------------------------------------------------------------
# Lexer
# ---------------------------------------------------------------------------

KEYWORDS = {
    "module",
    "type",
    "record",
    "public",
    "when",
    "switch",
    "and",
    "or",
}

BOOLS = {"true": True, "false": False}

TWOCHAR = {
    "->": "ARROW",
    "=>": "FATARROW",
    ">=": "GE",
    "<=": "LE",
    "==": "EQEQ",
    "!=": "NE",
    "..": "DOTDOT",
}


@dataclass
class Tok:
    kind: str
    value: Any
    pos: int


class Lexer:
    def __init__(self, src: str):
        self.src = src
        self.n = len(src)
        self.i = 0

    def peek(self) -> str:
        return self.src[self.i] if self.i < self.n else ""

    def advance(self) -> str:
        ch = self.src[self.i]
        self.i += 1
        return ch

    def skip_ws_and_comments(self) -> None:
        while self.i < self.n:
            ch = self.peek()
            if ch.isspace():
                self.advance()
                continue
            if ch == "#" or (
                ch == "/" and self.i + 1 < self.n and self.src[self.i + 1] == "/"
            ):
                while self.i < self.n and self.peek() != "\n":
                    self.advance()
                continue
            if self.src.startswith("<!--", self.i):
                end = self.src.find("-->", self.i + 4)
                self.i = self.n if end < 0 else end + 3
                continue
            break

    def tokenize(self) -> list[Tok]:
        out: list[Tok] = []
        while True:
            self.skip_ws_and_comments()
            if self.i >= self.n:
                out.append(Tok("EOF", None, self.i))
                break
            pos = self.i
            ch = self.peek()
            pair = self.src[self.i : self.i + 2]
            if pair in TWOCHAR:
                out.append(Tok(TWOCHAR[pair], pair, pos))
                self.i += 2
                continue
            if ch == ":":
                self.advance()
                if self.peek().isalpha() or self.peek() == "_":
                    name = self._ident()
                    out.append(Tok("ATOM", name, pos))
                else:
                    out.append(Tok("COLON", ":", pos))
                continue
            if ch.isalpha() or ch == "_":
                name = self._ident()
                if name == "_":
                    out.append(Tok("UNDERSCORE", "_", pos))
                elif name in BOOLS:
                    out.append(Tok("BOOL", BOOLS[name], pos))
                elif name in KEYWORDS:
                    out.append(Tok(name.upper(), name, pos))
                else:
                    out.append(Tok("IDENT", name, pos))
                continue
            if ch.isdigit():
                out.append(Tok("INT", self._number(), pos))
                continue
            singles = {
                "(": "LPAREN",
                ")": "RPAREN",
                "{": "LBRACE",
                "}": "RBRACE",
                "[": "LBRACKET",
                "]": "RBRACKET",
                ",": "COMMA",
                "|": "PIPE",
                ".": "DOT",
                ">": "GT",
                "<": "LT",
                "+": "PLUS",
                "-": "MINUS",
                "*": "STAR",
                "/": "SLASH",
                "=": "EQ",
            }
            if ch in singles:
                self.advance()
                out.append(Tok(singles[ch], ch, pos))
                continue
            self.advance()
        return out

    def _ident(self) -> str:
        start = self.i
        while self.i < self.n and (self.src[self.i].isalnum() or self.src[self.i] == "_"):
            self.i += 1
        return self.src[start : self.i]

    def _number(self) -> int:
        start = self.i
        while self.i < self.n and self.src[self.i].isdigit():
            self.i += 1
        return int(self.src[start : self.i])


