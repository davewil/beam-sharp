f.text[self.pos]\n            if c.isspace():\n                self.pos += 1\n                continue\n            if c.isalpha():\n                start = self.pos\n                while self.pos < len(self.text) and self.text[self.pos].isalnum():\n                    self.pos +=  1\n                word = self.text[start:self.pos]\n                if word in KEYWORDS:\n                    if word == \"case\":\n                        self.tokens.append(Token(T_CASE))\n                    elif word == \"default\":\n                        self.tokens.append(Token(T_DEFAULT))\n                    elif word == \"and\":\n                        self.tokens.append(Token(T_AND))\n elif word == \"or\":\n                        self.tokens.append(Token(T_OR))\n                    elif word == \"when\":\n                        self.tokens.append(Token(T_EQ))  # when is comparison in guard\n                    else:\n                        self.tokens.append(Token(T_ID, word))\n                else:\n                    self.tokens.append(Token(T_ID, word))\n                continue\n            if c.isdigit():\n                start = self.pos\n                while self.pos < len(self.text) and self.text[self.pos].isdigit():\n                    self.pos += 1\n                self.tokens.append(Token(T_LIT, int(self.text[start:self.pos])))\n                continue\n            if c == \":\":\n                self.tokens.append(Token(T_COLON))\n                 self.pos += 1\n                 continue\n            if c == \"=\":\n                if self.pos + 1 < len(self.text) and self.text[self.pos + 1] == \">\":\n                    self.tokens.append(Token(T_ARROW))\n                    self.pos += 2\n                    continue # fat arrow\n                self.tokens.append(Token(T_EQ))\n                self.pos += 1\n                continue\n            if c == \">\":\n                if self.pos + 1 < len(self.text) and self.text[self.pos + 1] == \"=\":\n    