+class Parser:
+    def __init__(self, source):
+        self.tokens = [m.group() for m in TOKEN.finditer(source)
+                       if not m.group().startswith(('//', '/*'))]
+        self.i = 0
+        self.aliases = {}
+        self.signatures = {}
+        self.clauses = []
+
+    def peek(self):
+        return self.tokens[self.i] if self.i < len(self.tokens) else ''
+
+    def take(self, expected=None):
+        token = self.peek()
+        if not token or expected is not None and token != expected:
+            raise ValueError('unexpected token')
+        self.i += 1
+        return token
+
+    def accept(self, token):
+        if self.peek() == token:
+            self.i += 1
+            return True
+        return False
+
+    def sequence(self, end, reader):
+        parts = []
+        if not self.accept(end):
+            while True:
+                parts.append(reader())
+                if self.accept(end):
+                    break
+                self.take(',')
+                if self.accept(end):
+                    break
+        return parts
+
+    def type_expr(self):
+        parts = [self.type_one()]
+        while self.accept('|'):
+            parts.append(self.type_one())
+        return ('union', parts) if len(parts) > 1 else parts[0]
+
+    def type_one(self):
+        token = self.take()
+        if token == '(':
+            return ('product', self.sequence(')', self.type_expr))
+        if self.accept('<'):
+            return ('generic', token, self.sequence('>', self.type_expr))
+        return ('type', token)
