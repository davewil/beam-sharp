+#!/usr/bin/env python3
+"""Specification-based switch checking, with symbolic value-space subtraction."""
+import re
+import sys
+
+
+ANY = ('any',)
+INT = ('int', float('-inf'), float('inf'))
+ATOM = ('atom', None, frozenset())
+STRING = ('string', None, frozenset())
+BOOL = [('bool', False), ('bool', True)]
+
+
+def intersection(a, b):
+    if a == ANY:
+        return [b]
+    if b == ANY:
+        return [a]
+    if a[0] != b[0]:
+        return []
+    kind = a[0]
+    if kind == 'int':
+        lo, hi = max(a[1], b[1]), min(a[2], b[2])
+        return [('int', lo, hi)] if lo <= hi else []
+    if kind in ('atom', 'string'):
+        if a[1] is not None:
+            return [a] if (a[1] == b[1] or b[1] is None and a[1] not in b[2]) else []
+        if b[1] is not None:
+            return intersection(b, a)
+        return [(kind, None, a[2] | b[2])]
+    if kind == 'tuple':
+        if len(a[1]) != len(b[1]):
+            return []
+        parts = [intersect(x, y) for x, y in zip(a[1], b[1])]
+        return [('tuple', tuple(parts))] if all(parts) else []
+    if kind == 'list':
+        return [('list', intersect(a[1], b[1]))]
+    if kind == 'cons':
+        head, tail = intersect(a[1], b[1]), intersect(a[2], b[2])
+        return [('cons', head, tail)] if head and tail else []
+    return [a] if a == b else []
+
+
+def expand_list(a):
+    return [('nil',), ('cons', a[1], [a])] if a[1] else [('nil',)]
+
+
+def intersect(xs, ys):
+    out = []
+    for a in xs:
+        for b in ys:
+            if a[0] == 'list' and b[0] in ('nil', 'cons'):
+                out.extend(intersect(expand_list(a), [b]))
+            elif b[0] == 'list' and a[0] in ('nil', 'cons'):
+                out.extend(intersect([a], expand_list(b)))
+            else:
+                out.extend(intersection(a, b))
+    return out
+
+
+def difference(a, b):
+    if b == ANY or a == b:
+        return []
+    if a[0] == 'list' and b[0] in ('nil', 'cons'):
+        return subtract(expand_list(a), [b])
+    if b[0] == 'list' and a[0] in ('nil', 'cons'):
+        return subtract([a], expand_list(b))
+    if not intersect([a], [b]):
+        return [a]
+    if a == ANY:
+        # An unrestricted term remains open after a shape-specific arm.
+        return [a]
+    kind = a[0]
+    if kind == 'int':
+        out = []
+        if a[1] < b[1]:
+            out.append(('int', a[1], b[1] - 1))
+        if b[2] < a[2]:
+            out.append(('int', b[2] + 1, a[2]))
+        return out
+    if kind in ('atom', 'string'):
+        if a[1] is not None:
+            return []
+        if b[1] is not None:
+            return [(kind, None, a[2] | {b[1]})]
+        return [(kind, v, frozenset()) for v in b[2] - a[2]]
+    if kind in ('tuple', 'cons'):
+        ap = a[1] if kind == 'tuple' else a[1:]
+        bp = b[1] if kind == 'tuple' else b[1:]
+        out, prefix = [], []
+        for i, (x, y) in enumerate(zip(ap, bp)):
+            missing = subtract(x, y)
+            if missing:
+                parts = tuple(prefix + [missing] + list(ap[i + 1:]))
+                out.append(('tuple', parts) if kind == 'tuple' else ('cons', *parts))
+            common = intersect(x, y)
+            if not common:
+                break
+            prefix.append(common)
+        return out
+    if kind == 'list':
+        return [] if not subtract(a[1], b[1]) else [a]
+    return []
+
+
+def subtract(xs, ys):
+    for b in ys:
+        xs = [part for a in xs for part in difference(a, b)]
+    return xs
+
+
+def literal(value):
+    if value in ('true', 'false'):
+        return [('bool', value == 'true')]
+    if value.startswith(':'):
+        return [('atom', value[1:], frozenset())]
+    if value.startswith('"'):
+        return [('string', value, frozenset())]
+    if re.fullmatch(r'-?\d+', value):
+        return [('int', int(value), int(value))]
+    return None
