+
+TOKEN = re.compile(r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|:[A-Za-z_]\w*|\d+|[A-Za-z_]\w*|=>|->|>=|<=|==|!=|\.\.|[^\s]')
