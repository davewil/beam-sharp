+#!/usr/bin/env python3
+"""Specification-based switch checking, with symbolic value-space subtraction."""
+import re
+import sys
+
+
+ANY = ('any',)
+INT = ('int', float('-inf'), float('inf'))
+ATOM = ('atom', None, frozenset())
+STRING = ('string', None, frozenset())
+BOOL = [('bool', False), ('bool', True)]
+
+
+def intersection(a, b):
+    if a == ANY:
+        return [b]
+    if b == ANY:
+        return [a]
+    if a[0] != b[0]:
+        return []
+    kind = a[0]
+    if kind == 'int':
+        lo, hi = max(a[1], b[1]), min(a[2], b[2])
+        return [('int', lo, hi)] if lo <= hi else []
+    if kind in ('atom', 'string'):
+        if a[1] is not None:
+            return [a] if (a[1] == b[1] or b[1] is None and a[1] not in b[2]) else []
+        if b[1] is not None:
+            return intersection(b, a)
+        return [(kind, None, a[2] | b[2])]
+    if kind == 'tuple':
+        if len(a[1]) != len(b[1]):
+            return []
+        parts = [intersect(x, y) for x, y in zip(a[1], b[1])]
+        return [('tuple', tuple(parts))] if all(parts) else []
+    if kind == 'record':
+        if a[1] is not None and b[1] is not None and a[1] != b[1]:
+            return []
+        af, bf = dict(a[2]), dict(b[2])
+        fields = tuple((key, intersect(af.get(key, [ANY]), bf.get(key, [ANY])))
+                       for key in sorted(af.keys() | bf.keys()))
+        return [('record', a[1] or b[1], fields)] if all(v for _, v in fields) else []
+    if kind == 'list':
+        return [('list', intersect(a[1], b[1]))]
+    if kind == 'cons':
+        head, tail = intersect(a[1], b[1]), intersect(a[2], b[2])
+        return [('cons', head, tail)] if head and tail else []
+    return [a] if a == b else []
+
+
+def expand_list(a):
+    return [('nil',), ('cons', a[1], [a])] if a[1] else [('nil',)]
+
+
+def intersect(xs, ys):
+    out = []
+    for a in xs:
+        for b in ys:
+            if a[0] == 'list' and b[0] in ('nil', 'cons'):
+                out.extend(intersect(expand_list(a), [b]))
+            elif b[0] == 'list' and a[0] in ('nil', 'cons'):
+                out.extend(intersect([a], expand_list(b)))
+            else:
+                out.extend(intersection(a, b))
+    return out
+
+
+def difference(a, b):
+    if b == ANY or a == b:
+        return []
+    if a[0] == 'list' and b[0] in ('nil', 'cons'):
+        return subtract(expand_list(a), [b])
+    if b[0] == 'list' and a[0] in ('nil', 'cons'):
+        return subtract([a], expand_list(b))
+    if not intersect([a], [b]):
+        return [a]
+    if a == ANY:
+        # An unrestricted term remains open after a shape-specific arm.
+        return [a]
+    kind = a[0]
+    if kind == 'int':
+        out = []
+        if a[1] < b[1]:
+            out.append(('int', a[1], b[1] - 1))
+        if b[2] < a[2]:
+            out.append(('int', b[2] + 1, a[2]))
+        return out
+    if kind in ('atom', 'string'):
+        if a[1] is not None:
+            return []
+        if b[1] is not None:
+            return [(kind, None, a[2] | {b[1]})]
+        return [(kind, v, frozenset()) for v in b[2] - a[2]]
+    if kind in ('tuple', 'cons'):
+        ap = a[1] if kind == 'tuple' else a[1:]
+        bp = b[1] if kind == 'tuple' else b[1:]
+        out, prefix = [], []
+        for i, (x, y) in enumerate(zip(ap, bp)):
+            missing = subtract(x, y)
+            if missing:
+                parts = tuple(prefix + [missing] + list(ap[i + 1:]))
+                out.append(('tuple', parts) if kind == 'tuple' else ('cons', *parts))
+            common = intersect(x, y)
+            if not common:
+                break
+            prefix.append(common)
+        return out
+    if kind == 'record':
+        af, bf = dict(a[2]), dict(b[2])
+        keys = sorted(af.keys() | bf.keys())
+        ap = ('tuple', tuple(af.get(key, [ANY]) for key in keys))
+        bp = ('tuple', tuple(bf.get(key, [ANY]) for key in keys))
+        return [('record', a[1], tuple(zip(keys, cell[1])))
+                for cell in difference(ap, bp)]
+    if kind == 'list':
+        return [] if not subtract(a[1], b[1]) else [a]
+    return []
+
+
+def subtract(xs, ys):
+    for b in ys:
+        xs = [part for a in xs for part in difference(a, b)]
+    return xs
+
+
+def literal(value):
+    if value in ('true', 'false'):
+        return [('bool', value == 'true')]
+    if value.startswith(':'):
+        return [('atom', value[1:], frozenset())]
+    if value.startswith('"'):
+        return [('string', value, frozenset())]
+    if re.fullmatch(r'-?\d+', value):
+        return [('int', int(value), int(value))]
+    return None
+
+
+TOKEN = re.compile(r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|(?<![A-Za-z0-9_]):[A-Za-z_]\w*|\d+|[A-Za-z_]\w*|=>|->|>=|<=|==|!=|\.\.|[^\s]')
+
+
+class Parser:
+    def __init__(self, source):
+        self.tokens = [m.group() for m in TOKEN.finditer(source)
+                       if not m.group().startswith(('//', '/*'))]
+        self.i = 0
+        self.aliases = {}
+        self.signatures = {}
+        self.clauses = []
+
+    def peek(self):
+        return self.tokens[self.i] if self.i < len(self.tokens) else ''
+
+    def take(self, expected=None):
+        token = self.peek()
+        if not token or expected is not None and token != expected:
+            raise ValueError('unexpected token')
+        self.i += 1
+        return token
+
+    def accept(self, token):
+        if self.peek() == token:
+            self.i += 1
+            return True
+        return False
+
+    def sequence(self, end, reader):
+        parts = []
+        if not self.accept(end):
+            while True:
+                parts.append(reader())
+                if self.accept(end):
+                    break
+                self.take(',')
+                if self.accept(end):
+                    break
+        return parts
+
+    def type_expr(self):
+        parts = [self.type_one()]
+        while self.accept('|'):
+            parts.append(self.type_one())
+        return ('union', parts) if len(parts) > 1 else parts[0]
+
+    def type_one(self):
+        token = self.take()
+        if token == '(':
+            return ('product', self.sequence(')', self.type_expr))
+        if self.accept('<'):
+            return ('generic', token, self.sequence('>', self.type_expr))
+        return ('type', token)
+
+    def program(self):
+        while self.peek():
+            if self.accept('module'):
+                self.take()
+            elif self.accept('type'):
+                name = self.take()
+                self.take('=')
+                self.aliases[name] = self.type_expr()
+            elif self.accept('record'):
+                name = self.take()
+                self.take('{')
+                fields = []
+                while not self.accept('}'):
+                    key = self.take()
+                    self.take(':')
+                    fields.append((key, self.type_expr()))
+                    self.accept(',')
+                    self.accept(';')
+                self.aliases[name] = ('record', fields)
+            elif self.peek() in ('public', 'private'):
+                self.take()
+                result = self.type_expr()
+                name = self.take()
+                self.take('(')
+                def parameter():
+                    ty = self.type_expr()
+                    self.take()
+                    return ty
+                self.signatures[name] = (result, self.sequence(')', parameter))
+            else:
+                name = self.take()
+                self.take('(')
+                patterns = self.sequence(')', self.pattern)
+                guard = self.expr() if self.accept('when') else None
+                self.take('->')
+                body = self.expr()
+                self.clauses.append((name, patterns, guard, body))
+            self.accept(';')
+        return self
+
+    def pattern(self, minimum=0):
+        token = self.take()
+        if token == '(':
+            node = ('tuple', self.sequence(')', self.pattern))
+        elif token == '{' or self.peek() == '{':
+            record_name = None if token == '{' else token
+            if record_name is not None:
+                self.take('{')
+            def field():
+                key = self.take()
+                self.take(':')
+                return key, self.pattern()
+            node = ('record', record_name, self.sequence('}', field))
+        elif token == '[':
+            parts, rest = [], None
+            if not self.accept(']'):
+                while True:
+                    if self.accept('..'):
+                        rest = self.take() if self.peek() not in (']', ',') else '_'
+                        self.accept(',')
+                        self.take(']')
+                        break
+                    parts.append(self.pattern())
+                    if self.accept(']'):
+                        break
+                    self.take(',')
+            node = ('list', parts, rest)
+        elif token in ('<', '<=', '>', '>='):
+            sign = '-' if self.accept('-') else ''
+            node = ('relation', token, int(sign + self.take()))
+        elif token == '==':
+            node = ('match', self.take())
+        elif token == '-':
+            node = ('lit', '-' + self.take())
+        elif literal(token) is not None:
+            node = ('lit', token)
+        else:
+            node = ('bind', token)
+        while self.peek() in ('and', 'or'):
+            op = self.peek()
+            priority = 2 if op == 'and' else 1
+            if priority < minimum:
+                break
+            self.take()
+            node = (op, node, self.pattern(priority + 1))
+        return node
+
+    def expr(self, minimum=0):
+        token = self.take()
+        if token == '(':
+            parts = self.sequence(')', self.expr)
+            node = parts[0] if len(parts) == 1 else ('tuple', parts)
+        elif token == '[':
+            node = ('list', self.sequence(']', self.expr))
+        elif token == '-':
+            node = ('negative', self.expr(7))
+        elif literal(token) is not None:
+            node = ('lit', token)
+        else:
+            node = ('var', token)
+        precedence = {'or': 1, 'and': 2, '==': 3, '!=': 3,
+                      '>': 4, '<': 4, '>=': 4, '<=': 4,
+                      '+': 5, '-': 5, '*': 6, '/': 6, '%': 6}
+        while True:
+            op = self.peek()
+            if op == '(' and node[0] == 'var':
+                self.take()
+                node = ('call', node[1], self.sequence(')', self.expr))
+            elif op == '.':
+                self.take()
+                node = ('field', node, self.take())
+            elif op == 'switch' and minimum == 0:
+                self.take()
+                self.take('{')
+                arms = []
+                while not self.accept('}'):
+                    pattern = self.pattern()
+                    guard = self.expr() if self.accept('when') else None
+                    self.take('=>')
+                    body = self.expr()
+                    arms.append((pattern, guard, body))
+                    if not self.accept(','):
+                        self.take('}')
+                        break
+                node = ('switch', node, arms)
+            elif op in precedence and precedence[op] >= minimum:
+                self.take()
+                node = ('binary', op, node, self.expr(precedence[op] + 1))
+            else:
+                break
+        return node
+
+
+def relation(op, number):
+    if op == '<':
+        return [('int', float('-inf'), number - 1)]
+    if op == '<=':
+        return [('int', float('-inf'), number)]
+    if op == '>':
+        return [('int', number + 1, float('inf'))]
+    return [('int', number, float('inf'))]
+
+
+def project(space, path):
+    if not path:
+        return space
+    out = []
+    for cell in space:
+        if cell == ANY:
+            out.extend(project([ANY], path[1:]))
+        elif cell[0] == 'tuple':
+            out.extend(project(cell[1][path[0]], path[1:]))
+        elif cell[0] == 'cons':
+            out.extend(project(cell[path[0] + 1], path[1:]))
