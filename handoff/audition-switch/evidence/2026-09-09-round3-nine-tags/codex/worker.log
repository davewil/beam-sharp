+            return env.get(node[1], [ANY]), False
+        if kind == 'lit':
+            return literal(node[1]), True
+        if kind == 'relation':
+            return relation(node[1], node[2]), True
+        if kind in ('and', 'or'):
+            left, lc = self.pattern_space(node[1], env, paths, path)
+            right, rc = self.pattern_space(node[2], env, paths, path)
+            return (intersect(left, right) if kind == 'and' else left + right), lc and rc
+        if kind == 'tuple':
+            parts = [self.pattern_space(p, env, paths, path + (i,)) for i, p in enumerate(node[1])]
+            return [('tuple', tuple(p for p, _ in parts))], all(c for _, c in parts)
+        if kind == 'record':
+            fields = [(key, self.pattern_space(p, env, paths, path + (key,)))
+                      for key, p in node[2]]
+            return [('record', node[1], tuple((key, value) for key, (value, _) in fields))], all(
+                certain for _, (_, certain) in fields)
+        if kind == 'list':
+            parts = [self.pattern_space(p, env, paths, path + (1,) * i + (0,))
+                     for i, p in enumerate(node[1])]
+            tail = [('nil',)] if node[2] is None else [('list', [ANY])]
+            if node[2] is not None:
+                self.pattern_space(('bind', node[2]), env, paths, path + (1,) * len(parts))
+            for p, _ in reversed(parts):
+                tail = [('cons', p, tail)]
+            return tail, all(c for _, c in parts)
+        return [ANY], False
+
+    def guard_space(self, node, space, paths, env):
+        if node[0] == 'lit' and node[1] in ('true', 'false'):
+            return space if node[1] == 'true' else []
+        if node[0] != 'binary':
+            return None
+        op, left, right = node[1:]
+        if op in ('and', 'or'):
+            a = self.guard_space(left, space, paths, env)
+            b = self.guard_space(right, space, paths, env)
+            if a is None or b is None:
+                return None
+            return intersect(a, b) if op == 'and' else a + b
+        if right[0] == 'var' and left[0] in ('lit', 'negative'):
+            left, right = right, left
+            op = {'<': '>', '>': '<', '<=': '>=', '>=': '<='}.get(op, op)
+        if left[0] != 'var' or right[0] not in ('lit', 'negative'):
+            return None
+        if right[0] == 'negative' and right[1][0] == 'lit':
+            value = literal('-' + right[1][1])
+        elif right[0] == 'lit':
+            value = literal(right[1])
+        else:
+            return None
+        if value is None:
+            return None
+        name = left[1]
+        path = paths.get(name)
+        base = project(space, path) if path is not None else env.get(name, [ANY])
+        if op in ('<', '<=', '>', '>=') and value[0][0] == 'int':
+            allowed = intersect(base, relation(op, value[0][1]))
+        elif op == '==':
+            allowed = intersect(base, value)
+        elif op == '!=':
+            allowed = subtract(base, value)
+        else:
+            return None
+        if path is None:
+            if not allowed:
+                return []
+            return space if not subtract(base, allowed) else None
+        return restrict(space, path, allowed)
+
+    def expression(self, node, env, in_guard=False):
+        kind = node[0]
+        if kind == 'lit':
+            return literal(node[1])
+        if kind == 'var':
+            if node[1] not in env:
+                self.tags.add('unbound_variable')
+            return env.get(node[1], [])
+        if kind == 'tuple':
+            parts = tuple(self.expression(p, env, in_guard) for p in node[1])
+            return [('tuple', parts)] if all(parts) else []
+        if kind == 'list':
+            tail = [('nil',)]
+            for part in reversed(node[1]):
+                tail = [('cons', self.expression(part, env, in_guard), tail)]
+            return tail
+        if kind == 'negative':
+            value = self.expression(node[1], env, in_guard)
+            return [('int', -c[2], -c[1]) for c in value if c[0] == 'int']
+        if kind == 'binary':
+            left = self.expression(node[2], env, in_guard)
+            right = self.expression(node[3], env, in_guard)
+            if not left or not right:
+                return []
+            return BOOL if node[1] in ('and', 'or', '<', '<=', '>', '>=', '==', '!=') else [INT]
+        if kind == 'call':
+            args = [self.expression(a, env, in_guard) for a in node[2]]
+            signature = self.signatures.get(node[1])
+            if signature:
+                for actual, expected in zip(args, signature[1]):
+                    if subtract(actual, expected):
+                        self.tags.add('arg_not_accepted')
+                return signature[0]
+            return [ANY]
+        if kind == 'field':
+            records = self.expression(node[1], env, in_guard)
+            return [value for record in records if record[0] == 'record'
+                    for value in dict(record[2]).get(node[2], [])]
+        if kind == 'switch':
+            if in_guard:
+                self.tags.add('switch_in_guard')
+            subject = self.expression(node[1], env, in_guard)
+            covered, result = [], []
+            for pattern, guard, body in node[2]:
+                paths = {}
+                shape, certain = self.pattern_space(pattern, env, paths)
+                possible = intersect(subject, shape)
+                branch = dict(env)
+                branch.update({name: project(possible, path) for name, path in paths.items()})
+                refined = possible
+                readable = True
+                if guard is not None:
+                    self.expression(guard, branch, True)
+                    refined = self.guard_space(guard, possible, paths, branch)
+                    readable = refined is not None
+                    if not readable:
+                        refined = possible
+                if not possible:
+                    self.tags.add('vacuous_arm')
+                elif not refined:
+                    self.tags.add('unsatisfiable_arm_guard')
+                elif not subtract(refined, covered):
+                    self.tags.add('unreachable_arm')
+                branch.update({name: project(refined, path) for name, path in paths.items()})
+                result.extend(self.expression(body, branch, in_guard))
+                if certain and readable:
+                    covered.extend(refined)
+            if subtract(subject, covered):
+                self.tags.add('switch_inexhaustive')
+            return result
+        return [ANY]
+
+    def run(self):
+        for name, patterns, guard, body in self.program.clauses:
+            signature = self.signatures.get(name)
+            if signature is None:
+                continue
+            result, arguments = signature
+            env, paths = {}, {}
+            shape, _ = self.pattern_space(('tuple', patterns), env, paths)
+            matched = intersect([('tuple', tuple(arguments))], shape)
+            env.update({key: project(matched, path) for key, path in paths.items()})
+            if guard is not None:
+                self.expression(guard, env, True)
+                refined = self.guard_space(guard, matched, paths, env)
+                if refined is not None:
+                    env.update({key: project(refined, path) for key, path in paths.items()})
+            actual = self.expression(body, env)
+            if subtract(actual, result):
+                self.tags.add('return_not_declared')
+        return self.tags
+
+
+def main():
+    with open(sys.argv[1], encoding='utf-8') as source:
+        program = Parser(source.read()).program()
+    for tag in sorted(Checker(program).run()):
+        print(tag)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/test_switchcheck.py b/test_switchcheck.py
new file mode 100644
index 0000000000000000000000000000000000000000..5a1ea1994c4e85d783d45aea766e5c3c63d08757
--- /dev/null
+++ b/test_switchcheck.py
@@ -0,0 +1,200 @@
+#!/usr/bin/env python3
+"""Exercise the executable's public contract; never edit supplied cases."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parent
+
+
+class SwitchcheckTests(unittest.TestCase):
+    def check_file(self, path, expected):
+        completed = subprocess.run([str(ROOT / 'switchcheck'), str(path)],
+                                   capture_output=True, text=True)
+        self.assertEqual(completed.returncode, 0, completed.stderr)
+        self.assertEqual(completed.stderr, '')
+        self.assertEqual(set(completed.stdout.splitlines()), set(expected))
+        self.assertTrue(all(line.strip() == line and line.islower()
+                            for line in completed.stdout.splitlines()))
+
+    def check_source(self, source, expected=()):
+        with tempfile.TemporaryDirectory(dir=ROOT) as directory:
+            path = Path(directory) / 'example.bs'
+            path.write_text(source)
+            self.check_file(path, expected)
+
+    def test_supplied_cases(self):
+        expected = {
+            'c01': (), 'c02': (), 'c03': ('switch_inexhaustive',),
+            'c04': ('unreachable_arm',), 'c05': (),
+            'c06': ('switch_inexhaustive',), 'c07': ('rebinding',),
+            'c08': ('return_not_declared',), 'c09': ('arg_not_accepted',),
+            'c10': ('switch_in_guard',),
+            'c11': ('unbound_variable', 'switch_inexhaustive'),
+            'c12': ('vacuous_arm',), 'c13': ('unsatisfiable_arm_guard',),
+        }
+        cases = sorted((ROOT / 'cases').rglob('*.bs'))
+        self.assertEqual(len(cases), 13)
+        for path in cases:
+            with self.subTest(case=path.relative_to(ROOT)):
+                self.check_file(path, expected[path.relative_to(ROOT / 'cases').parts[0][:3]])
+
+    def test_integer_partition(self):
+        self.check_source('''
+            public atom F(int n)
+            F(n) -> n switch {
+                >= 4 and <= 7 => :reserved,
+                <= -1 => :negative,
+                >= 0 and <= 3 => :low,
+                >= 8 => :high
+            }
+        ''')
+
+    def test_integer_gap(self):
+        self.check_source('''
+            public atom F(int n)
+            F(n) -> n switch { < 4 => :low, > 4 => :high }
+        ''', ('switch_inexhaustive',))
+
+    def test_tuple_guard_partition(self):
+        self.check_source('''
+            public atom F(bool b, int n)
+            F(b, n) -> (b, n) switch {
+                (true, x) when x < 0 => :a,
+                (true, x) when x >= 0 => :b,
+                (false, _) => :c
+            }
+        ''')
+
+    def test_opaque_guard_does_not_cover(self):
+        self.check_source('''
+            public atom F(int n, int limit)
+            F(n, limit) -> n switch { x when x < limit => :small }
+        ''', ('switch_inexhaustive',))
+
+    def test_match_name_does_not_cover(self):
+        self.check_source('''
+            public atom F(int n, int expected)
+            F(n, expected) -> n switch { ==expected => :same }
+        ''', ('switch_inexhaustive',))
+
+    def test_match_name_with_fallback(self):
+        self.check_source('''
+            public atom F(int n, int expected)
+            F(n, expected) -> n switch { == expected => :same, _ => :other }
+        ''')
+
+    def test_bare_rebinding_without_guard(self):
+        self.check_source('''
+            public atom F(int n)
+            F(n) -> n switch { n => :all }
+        ''', ('rebinding',))
+
+    def test_interval_shadow(self):
+        self.check_source('''
+            public atom F(int n)
+            F(n) -> n switch { < 10 => :a, < 5 => :b, >= 10 => :c }
+        ''', ('unreachable_arm',))
+
+    def test_guard_or_partition(self):
+        self.check_source('''
+            public atom F(int n)
+            F(n) -> n switch {
+                x when x < 0 or x > 0 => :nonzero,
+                0 => :zero
+            }
+        ''')
+
+    def test_repeated_bindings_in_pattern(self):
+        self.check_source('''
+            public atom F(int n, int m)
+            F(n, m) -> (n, m) switch { (x, x) => :pair }
+        ''', ('rebinding',))
+
+    def test_list_length_partition(self):
+        self.check_source('''
+            public atom F(list<int> xs)
+            F(xs) -> xs switch {
+                [] => :empty,
+                [x] => :one,
+                [x, y, ..tail] => :many
+            }
+        ''')
+
+    def test_list_length_gap(self):
+        self.check_source('''
+            public atom F(list<bool> xs)
+            F(xs) -> xs switch { [] => :empty, [x, y, ..] => :many }
+        ''', ('switch_inexhaustive',))
+
+    def test_list_elements_partition(self):
+        self.check_source('''
+            public atom F(list<bool> xs)
+            F(xs) -> xs switch {
+                [] => :empty,
+                [true, ..] => :yes,
+                [false, ..] => :no
+            }
+        ''')
+
+    def test_nested_switch(self):
+        self.check_source('''
+            public atom F(bool b, bool c)
+            F(b, c) -> b switch {
+                true => c switch { true => :a },
+                false => :b
+            }
+        ''', ('switch_inexhaustive',))
+
+    def test_arm_scopes_are_independent(self):
+        self.check_source('''
+            public int F((:a, int) | (:b, int) pair)
+            F(pair) -> pair switch { (:a, x) => x, (:b, x) => x }
+        ''')
+
+    def test_atom_equality_guard_partition(self):
+        self.check_source('''
+            public atom F(atom a)
+            F(a) -> a switch { x when x != :yes => :no, :yes => :yes }
+        ''')
+
+    def test_no_switch_valid_function(self):
+        self.check_source('public int Identity(int n) Identity(n) -> n')
+
+    def test_outer_guard_is_not_complete_coverage(self):
+        self.check_source('''
+            public atom F(int n, bool b)
+            F(n, b) -> n switch { x when b == true => :yes }
+        ''', ('switch_inexhaustive',))
+
+    def test_record_fields_belong_to_subject_type(self):
+        self.check_source('''
+            record A { Value:int }
+            record B { Value:atom }
+            public int F(A a)
+            F(a) -> a.Value switch { x => x }
+        ''')
+
+    def test_record_pattern_guard_partition(self):
+        self.check_source('''
+            record Reading { Count:int, Ready:bool }
+            public atom F(Reading reading)
+            F(reading) -> reading switch {
+                { Count:n, Ready:true } when n >= 0 => :a,
+                { Count:n, Ready:true } when n < 0 => :b,
+                { Ready:false } => :c
+            }
+        ''')
+
+    def test_record_pattern_gap(self):
+        self.check_source('''
+            record Reading { Count:int, Ready:bool }
+            public atom F(Reading reading)
+            F(reading) -> reading switch { { Ready:true } => :a }
+        ''', ('switch_inexhaustive',))
+
+
+if __name__ == '__main__':
+    unittest.main()

