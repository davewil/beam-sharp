+                arms = []
+                while not self.accept('}'):
+                    pattern = self.pattern()
+                    guard = self.expr() if self.accept('when') else None
+                    self.take('=>')
+                    body = self.expr()
+                    arms.append((pattern, guard, body))
+                    if not self.accept(','):
