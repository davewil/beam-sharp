{"type":"tool_use","timestamp":1788993763492,"sessionID":"ses_f77ade3feffeYe56P6hqdU6Mjz","part":{"type":"tool","tool":"write","callID":"toolu_01FXbYXJu1mm4tTqxEVssVgM","state":{"status":"completed","input":{"filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py","content":"#!/usr/bin/env python3\n\"\"\"\nswitchcheck: a clean-room exhaustiveness/well-formedness checker for the\nswitch-based language described in PACKET.md.\n\nReads one .bs source file and prints diagnostic tags (one per line) to stdout.\n\"\"\"\nimport sys\nimport re\nimport itertools\n\nTAGS = [\n    \"switch_inexhaustive\",\n    \"unreachable_arm\",\n    \"vacuous_arm\",\n    \"unsatisfiable_arm_guard\",\n    \"rebinding\",\n    \"unbound_variable\",\n    \"return_not_declared\",\n    \"arg_not_accepted\",\n    \"switch_in_guard\",\n]\n\n\ndef depth_aware_split(s, sep):\n    \"\"\"Split s on top-level occurrences of sep (a string), respecting\n    (), {}, [] nesting depth.\"\"\"\n    parts = []\n    depth = 0\n    i = 0\n    n = len(s)\n    start = 0\n    seplen = len(sep)\n    while i < n:\n        c = s[i]\n        if c in '([{':\n            depth += 1\n            i += 1\n            continue\n        if c in ')]}':\n            depth -= 1\n            i += 1\n            continue\n        if depth == 0 and s[i:i+seplen] == sep:\n            parts.append(s[start:i])\n            i += seplen\n            start = i\n            continue\n        i += 1\n    parts.append(s[start:])\n    return parts\n\n\ndef find_top_level(s, sep):\n    \"\"\"Return index of first top-level occurrence of sep, or -1.\"\"\"\n    depth = 0\n    i = 0\n    n = len(s)\n    seplen = len(sep)\n    while i < n:\n        c = s[i]\n        if c in '([{':\n            depth += 1\n            i += 1\n            continue\n        if c in ')]}':\n            depth -= 1\n            i += 1\n            continue\n        if depth == 0 and s[i:i+seplen] == sep:\n            return i\n        i += 1\n    return -1\n\n\ndef matching_paren(s, open_idx):\n    \"\"\"s[open_idx] must be '('. Return index of matching ')'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(s)\n    while i < n:\n        if s[i] == '(':\n            depth += 1\n        elif s[i] == ')':\n            depth -= 1\n            if depth == 0:\n                return i\n        i += 1\n    return -1\n\n\nclass Func:\n    def __init__(self, name, ret_type, params):\n        self.name = name\n        self.ret_type = ret_type\n        self.params = params  # list of (type, name)\n        self.clauses = []  # list of (args_str, guard_text_or_None, body_text)\n\n\ndef parse_types(text):\n    \"\"\"Parse `type Name = variant | variant | ...` where variants are atom\n    literals (\":x\"). Returns dict name -> set(atoms).\"\"\"\n    types = {}\n    for m in re.finditer(r'(?m)^\\s*type\\s+(\\w+)\\s*=\\s*(.+?)\\s*$', text):\n        name = m.group(1)\n        rhs = m.group(2)\n        variants = [v.strip() for v in rhs.split('|')]\n        atoms = set()\n        ok = True\n        for v in variants:\n            if v.startswith(':'):\n                atoms.add(v)\n            else:\n                ok = False\n        if ok:\n            types[name] = atoms\n    return types\n\n\ndef parse_functions(text):\n    \"\"\"Parse function signatures and their clause bodies.\"\"\"\n    sig_re = re.compile(r'(?m)^\\s*public\\s+([\\w<>]+)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*$')\n    sigs = list(sig_re.finditer(text))\n    funcs = {}\n    order = []\n    for idx, m in enumerate(sigs):\n        ret_type = m.group(1)\n        name = m.group(2)\n        params_str = m.group(3).strip()\n        params = []\n        if params_str:\n            for p in params_str.split(','):\n                p = p.strip()\n                if not p:\n                    continue\n                parts = p.split()\n                ptype = parts[0]\n                pname = parts[1] if len(parts) > 1 else None\n                params.append((ptype, pname))\n        f = Func(name, ret_type, params)\n        funcs[name] = f\n        order.append((m.end(), name))\n\n    # For each function, the body text runs from end of its signature to the\n    # start of the next signature (or EOF).\n    for i, (end_pos, name) in enumerate(order):\n        start = end_pos\n        end = sigs[i + 1].start() if i + 1 < len(sigs) else len(text)\n        body_text = text[start:end]\n        parse_clauses(funcs[name], body_text)\n    return funcs\n\n\ndef parse_clauses(func, body_text):\n    name = func.name\n    # Find all top-of-line occurrences of \"Name(\" as clause heads.\n    starts = [m.start() for m in re.finditer(r'(?m)^\\s*' + re.escape(name) + r'\\s*\\(', body_text)]\n    if not starts:\n        return\n    for i, s in enumerate(starts):\n        e = starts[i + 1] if i + 1 < len(starts) else len(body_text)\n        seg = body_text[s:e]\n        clause = parse_one_clause(name, seg)\n        if clause is not None:\n            func.clauses.append(clause)\n\n\ndef parse_one_clause(name, seg):\n    # seg starts with whitespace then Name(\n    m = re.match(r'\\s*' + re.escape(name) + r'\\s*\\(', seg)\n    if not m:\n        return None\n    open_paren = seg.index('(', m.start())\n    close_paren = matching_paren(seg, open_paren)\n    if close_paren == -1:\n        return None\n    args_str = seg[open_paren + 1:close_paren]\n    rest = seg[close_paren + 1:]\n    rest_stripped = rest.lstrip()\n    guard_text = None\n    if rest_stripped.startswith('when'):\n        after_when = rest_stripped[4:]\n        arrow_idx = find_top_level(after_when, '->')\n        if arrow_idx == -1:\n            return None\n        guard_text = after_when[:arrow_idx].strip()\n        body_text = after_when[arrow_idx + 2:]\n    else:\n        arrow_idx = find_top_level(rest_stripped, '->')\n        if arrow_idx == -1:\n            return None\n        body_text = rest_stripped[arrow_idx + 2:]\n    body_text = body_text.strip()\n    # strip a single trailing comma if present (shouldn't normally happen)\n    return (args_str.strip(), guard_text, body_text)\n\n\n# ---------------- Pattern representation ----------------\n\nclass Pat:\n    ATOM = 'atom'       # literal atom, value = string like \":x\"\n    BOOL = 'bool'       # literal bool, value = True/False\n    WILDCARD = 'wild'   # _\n    NAME = 'name'       # bare identifier binding, value = name\n    EQNAME = 'eqname'   # == name\n    REL = 'rel'         # relational pattern, value = (op, number)\n    TUPLE = 'tuple'     # tuple pattern, value = list of Pat\n    INT = 'int'         # literal integer\n    OTHER = 'other'\n\n    def __init__(self, kind, value=None):\n        self.kind = kind\n        self.value = value\n\n    def __repr__(self):\n        return f'Pat({self.kind},{self.value})'\n\n\nREL_OPS = ['>=', '<=', '==', '!=', '>', '<']\n\n\ndef parse_pattern(text):\n    text = text.strip()\n    if text == '_':\n        return Pat(Pat.WILDCARD)\n    if text.startswith('(') and text.endswith(')'):\n        inner = text[1:-1]\n        parts = depth_aware_split(inner, ',')\n        subs = [parse_pattern(p) for p in parts]\n        return Pat(Pat.TUPLE, subs)\n    if text.startswith(':'):\n        return Pat(Pat.ATOM, text)\n    if text in ('true', 'false'):\n        return Pat(Pat.BOOL, text == 'true')\n    if text.startswith('=='):\n        rest = text[2:].strip()\n        return Pat(Pat.EQNAME, rest)\n    for op in REL_OPS:\n        if text.startswith(op):\n            rest = text[len(op):].strip()\n            try:\n                num = float(rest) if ('.' in rest) else int(rest)\n            except ValueError:\n                num = rest\n            return Pat(Pat.REL, (op, num))\n    if re.match(r'^-?\\d+$', text):\n        return Pat(Pat.INT, int(text))\n    if re.match(r'^[A-Za-z_]\\w*$', text):\n        return Pat(Pat.NAME, text)\n    return Pat(Pat.OTHER, text)\n\n\n# ---------------- Guard representation ----------------\n\ndef split_guard_conjunctions(guard_text):\n    \"\"\"Split on top-level 'and'/'or'. Returns (op, list_of_atoms) where op\n    is 'and', 'or', or None if a single atom. Only handles a single flat\n    level (no mixed and/or, no parens) which is all the spec's grammar\n    supports.\"\"\"\n    # try and first\n    and_parts = depth_aware_split(guard_text, ' and ')\n    if len(and_parts) > 1:\n        return ('and', [p.strip() for p in and_parts])\n    or_parts = depth_aware_split(guard_text, ' or ')\n    if len(or_parts) > 1:\n        return ('or', [p.strip() for p in or_parts])\n    return (None, [guard_text.strip()])\n\n\ndef parse_relational_atom(text, varname):\n    \"\"\"Try to read `text` as `<varname> <op> <literal>` or `<op> <literal>`\n    (relational atom). Returns (op, number) or None if unreadable.\"\"\"\n    text = text.strip()\n    # form: name op literal\n    m = re.match(r'^([A-Za-z_]\\w*)\\s*(>=|<=|==|!=|>|<)\\s*(-?\\d+(?:\\.\\d+)?)\\s*$', text)\n    if m:\n        if m.group(1) != varname:\n            return None\n        op = m.group(2)\n        num = m.group(3)\n        num = float(num) if '.' in num else int(num)\n        return (op, num)\n    return None\n\n\ndef interval_from_atoms(atoms_ops, combine):\n    \"\"\"Given list of (op, num), combine via 'and' (intersection) or 'or'\n    (union approximated as a list of intervals). Returns list of (lo, hi)\n    inclusive-inclusive using +/-inf, or None if any atom unreadable.\"\"\"\n    intervals = []\n    for op, num in atoms_ops:\n        if op == '>':\n            intervals.append((num + 1, float('inf')))\n        elif op == '>=':\n            intervals.append((num, float('inf')))\n        elif op == '<':\n            intervals.append((float('-inf'), num - 1))\n        elif op == '<=':\n            intervals.append((float('-inf'), num))\n        elif op == '==':\n            intervals.append((num, num))\n        elif op == '!=':\n            # not directly a single interval; represent specially\n            return None\n        else:\n            return None\n    if combine == 'and':\n        lo = max(iv[0] for iv in intervals)\n        hi = min(iv[1] for iv in intervals)\n        return [(lo, hi)]\n    else:\n        return intervals\n\n\ndef guard_readable_interval(guard_text, varname):\n    \"\"\"Return list of (lo,hi) intervals this guard represents on varname,\n    or None if guard is not readable (contains a call, compares two vars,\n    uses != in a combo we can't represent simply, or refers to a\n    different / no variable).\"\"\"\n    if guard_text is None:\n        return [(float('-inf'), float('inf'))]\n    combine, atoms_text = split_guard_conjunctions(guard_text)\n    atoms_ops = []\n    for a in atoms_text:\n        r = parse_relational_atom(a, varname)\n        if r is None:\n            return None\n        atoms_ops.append(r)\n    return interval_from_atoms(atoms_ops, combine if combine else 'and')\n\n\ndef guard_is_unsatisfiable(guard_text, varname):\n    \"\"\"Return True if guard is readable and represents an empty set.\"\"\"\n    ivs = guard_readable_interval(guard_text, varname)\n    if ivs is None:\n        return False\n    for lo, hi in ivs:\n        if lo <= hi:\n            return False\n    return True\n\n\n# ---------------- Type helpers ----------------\n\nBOOL_VALUES = [True, False]\n\n\ndef resolve_type_domain(type_name, types):\n    \"\"\"Return ('closed', list_of_values) or ('open', None) for a scalar\n    type name. Values for atom-union closed types are the atom-literal\n    strings (\":x\"); for bool, True/False.\"\"\"\n    if type_name in types:\n        return ('closed', sorted(types[type_name]))\n    if type_name == 'bool':\n        return ('closed', BOOL_VALUES)\n    # atom, int, term, string, list<...> etc: open (unbounded / cannot\n    # enumerate all members practically for this checker)\n    return ('open', None)\n\n\ndef pattern_matches_value(pat, value):\n    \"\"\"For scalar (non-tuple) patterns against a concrete enumerated value\n    (atom-literal string or bool).\"\"\"\n    if pat.kind == Pat.WILDCARD or pat.kind == Pat.NAME:\n        return True\n    if pat.kind == Pat.ATOM:\n        return pat.value == value\n    if pat.kind == Pat.BOOL:\n        return pat.value == value\n    return False\n\n\ndef pattern_is_member_of_domain(pat, domain_kind, domain_values, type_name):\n    \"\"\"Vacuous-arm check: is this pattern shape even possibly a member of\n    the subject type? For closed atom/bool domains, only atom/bool/\n    wildcard/name patterns are members; a tuple pattern against an\n    atom-only union is not. For open/unknown types we can't be sure, so\n    assume it *could* be a member (never flag vacuous defensively).\"\"\"\n    if domain_kind == 'closed':\n        if all(isinstance(v, str) for v in domain_values):\n            # atom union\n            if pat.kind in (Pat.WILDCARD, Pat.NAME):\n                return True\n            if pat.kind == Pat.ATOM:\n                return pat.value in domain_values\n            return False\n        if all(isinstance(v, bool) for v in domain_values):\n            if pat.kind in (Pat.WILDCARD, Pat.NAME):\n                return True\n            if pat.kind == Pat.BOOL:\n                return True\n            return False\n    return True\n\n\n# ---------------- Main diagnostic engine ----------------\n\nclass Checker:\n    def __init__(self, types, funcs):\n        self.types = types\n        self.funcs = funcs\n        self.diagnostics = set()\n\n    def emit(self, tag):\n        self.diagnostics.add(tag)\n\n    def run(self):\n        for fname, f in self.funcs.items():\n            for (args_str, guard_text, body_text) in f.clauses:\n                if guard_text and re.search(r'\\bswitch\\b', guard_text):\n                    self.emit('switch_in_guard')\n                    # don't try to analyze further inside an illegal guard\n                    continue\n                # bind parameter names for this clause\n                param_names = set(p[1] for p in f.params if p[1])\n                self.check_body(f, body_text, param_names)\n\n    def check_body(self, f, body_text, bound_names):\n        sw = self.match_switch(body_text)\n        if sw is None:\n            return\n        subject_text, arms_text = sw\n        self.check_switch(f, subject_text, arms_text, bound_names)\n\n    def match_switch(self, text):\n        text = text.strip()\n        idx = find_top_level(text, ' switch ')\n        # find last top-level '{' ... need brace matching\n        m = re.search(r'\\{', text)\n        if ' switch' not in text:\n            return None\n        sw_idx = text.find('switch')\n        # ensure this switch is at top level relative to text start\n        subject_text = text[:sw_idx].strip()\n        rest = text[sw_idx + len('switch'):].strip()\n        if not rest.startswith('{'):\n            return None\n        # find matching closing brace\n        depth = 0\n        i = 0\n        n = len(rest)\n        end = -1\n        for i in range(n):\n            if rest[i] == '{':\n                depth += 1\n            elif rest[i] == '}':\n                depth -= 1\n                if depth == 0:\n                    end = i\n                    break\n        if end == -1:\n            return None\n        arms_text = rest[1:end]\n        return (subject_text, arms_text)\n\n    def resolve_subject_type(self, f, subject_text, bound_names_types):\n        \"\"\"bound_names_types: dict name->type_name for names in scope\n        (function params). Returns a description:\n        ('scalar', type_name) or ('tuple', [type_name,...]) or None if\n        unknown (e.g. subject is not a simple name/tuple of names).\"\"\"\n        subject_text = subject_text.strip()\n        if subject_text.startswith('(') and subject_text.endswith(')'):\n            inner = subject_text[1:-1]\n            names = [p.strip() for p in depth_aware_split(inner, ',')]\n            types_list = []\n            for nm in names:\n                t = bound_names_types.get(nm)\n                if t is None:\n                    return None\n                types_list.append(t)\n            return ('tuple', types_list)\n        if re.match(r'^[A-Za-z_]\\w*$', subject_text):\n            t = bound_names_types.get(subject_text)\n            if t is None:\n                return None\n            return ('scalar', t)\n        return None\n\n    def parse_arms(self, arms_text):\n        arm_strs = [a.strip() for a in depth_aware_split(arms_text, ',') if a.strip() != '']\n        arms = []\n        for a in arm_strs:\n            idx = find_top_level(a, '=>')\n            if idx == -1:\n                continue\n            head = a[:idx].strip()\n            value = a[idx + 2:].strip()\n            widx = find_top_level(head, ' when ')\n            if widx != -1:\n                pattern_text = head[:widx].strip()\n                guard_text = head[widx + len(' when '):].strip()\n            else:\n                pattern_text = head\n                guard_text = None\n            arms.append((pattern_text, guard_text, value))\n        return arms\n\n    def check_switch(self, f, subject_text, arms_text, bound_names_names):\n        bound_names_types = {}\n        for (ptype, pname) in f.params:\n            if pname:\n                bound_names_types[pname] = ptype\n        subj = self.resolve_subject_type(f, subject_text, bound_names_types)\n        arms = self.parse_arms(arms_text)\n\n        parsed_arms = []\n        for (pattern_text, guard_text, value_text) in arms:\n            if subj is not None and subj[0] == 'tuple':\n                pat = parse_pattern(pattern_text)\n            else:\n                pat = parse_pattern(pattern_text)\n            parsed_arms.append({\n                'pattern_text': pattern_text,\n                'pattern': pat,\n                'guard_text': guard_text,\n                'value_text': value_text,\n            })\n\n        # ---- rebinding check ----\n        # An arm's bare-name pattern that duplicates an already-bound name\n        # (a function parameter, since arms don't see siblings) is\n        # rebinding.\n        outer_names = set(bound_names_types.keys())\n        for arm in parsed_arms:\n            pat = arm['pattern']\n            names_here = set()\n            self.collect_bare_names(pat, names_here)\n            for nm in names_here:\n                if nm in outer_names:\n                    self.emit('rebinding')\n\n        # ---- guard: unreadable calls -> unsatisfiable check only when\n        # readable; unbound_variable in guard skipped (not in scope) ----\n\n        # ---- vacuous_arm & unsatisfiable_arm_guard & coverage ----\n        if subj is not None and subj[0] == 'scalar':\n            self.check_scalar_switch(f, subj[1], parsed_arms)\n        elif subj is not None and subj[0] == 'tuple':\n            self.check_tuple_switch(f, subj[1], parsed_arms)\n        # if subj is None (can't resolve, e.g. subject is a complex expr):\n        # don't guess; skip exhaustiveness/vacuous checks defensively.\n\n        # ---- unbound_variable & return_not_declared & arg_not_accepted ----\n        for arm in parsed_arms:\n            arm_bound = set()\n            self.collect_bare_names(arm['pattern'], arm_bound)\n            # names bound by guard (fresh names used in relational atoms\n            # are already bound by pattern typically; guard doesn't\n            # introduce new bindings in this language)\n            self.check_value_expr(f, arm['value_text'], arm_bound | outer_names)\n\n    def collect_bare_names(self, pat, out):\n        if pat.kind == Pat.NAME:\n            out.add(pat.value)\n        elif pat.kind == Pat.TUPLE:\n            for sub in pat.value:\n                self.collect_bare_names(sub, out)\n\n    def check_scalar_switch(self, f, type_name, parsed_arms):\n        domain_kind, domain_values = resolve_type_domain(type_name, self.types)\n        is_int = (type_name == 'int')\n\n        if domain_kind == 'closed':\n            remaining = set(domain_values)\n            has_catchall_or_full_wild = False\n            for i, arm in enumerate(parsed_arms):\n                pat = arm['pattern']\n                guard_text = arm['guard_text']\n                # vacuous check\n                if not pattern_is_member_of_domain(pat, domain_kind, domain_values, type_name):\n                    self.emit('vacuous_arm')\n                    continue\n                if pat.kind in (Pat.WILDCARD, Pat.NAME):\n                    covered_now = set(remaining)\n                elif pat.kind == Pat.ATOM:\n                    covered_now = {pat.value} if pat.value in remaining else set()\n                elif pat.kind == Pat.BOOL:\n                    covered_now = {pat.value} if pat.value in remaining else set()\n                else:\n                    covered_now = set()\n                # guard readability affects whether covered_now truly counts\n                if guard_text is not None:\n                    # can't generally evaluate non-int guards; treat as\n                    # crediting nothing towards coverage (conservative,\n                    # matches \"credits nothing\" semantics for unreadable\n                    # guards) -- but check unsatisfiable only for int-style\n                    # relational guards, not applicable here (non-int\n                    # domain), so skip.\n                    if covered_now and covered_now.issubset(remaining) and covered_now:\n                        pass\n                    covered_now = set()  # guarded arm doesn't guarantee coverage\n                if covered_now and covered_now.issubset(remaining) is False:\n                    pass\n                if covered_now:\n                    if covered_now.issubset(set()) is False and covered_now.issubset(remaining) and len(covered_now) > 0 and covered_now <= (set(domain_values) - remaining):\n                        pass\n                # unreachable: if the arm's pattern covers nothing new\n                if guard_text is None:\n                    new_coverage = covered_now - (set(domain_values) - remaining)\n                    already_fully_covered = pat.kind in (Pat.WILDCARD, Pat.NAME, Pat.ATOM, Pat.BOOL) and covered_now and covered_now.issubset(set(domain_values) - remaining)\n                    if covered_now and covered_now.issubset(set(domain_values) - remaining):\n                        self.emit('unreachable_arm')\n                    remaining -= covered_now\n            if remaining:\n                self.emit('switch_inexhaustive')\n        else:\n            # open domain (atom, term, string, or int without full guard\n            # analysis): only handle int with relational-pattern arms\n            # doing interval subtraction; otherwise assume exhaustive if a\n            # catch-all (wildcard/bare name with no guard, or bare name\n            # with guard) exists, matching the spec's \"open -> catch-all\n            # legal\" rule. Don't guess beyond that.\n            if is_int:\n                self.check_int_switch(f, parsed_arms)\n            else:\n                has_full_catchall = False\n                for arm in parsed_arms:\n                    pat = arm['pattern']\n                    if pat.kind in (Pat.WILDCARD, Pat.NAME) and arm['guard_text'] is None:\n                        has_full_catchall = True\n                # vacuous check doesn't really apply (open type, any shape\n                # could conceivably belong depending on type); skip.\n                if not has_full_catchall:\n                    # can't prove exhaustiveness without enumeration;\n                    # since domain is open we can't say inexhaustive\n                    # either without more info. Be conservative: don't\n                    # flag.\n                    pass\n\n    def check_int_switch(self, f, parsed_arms):\n        remaining = [(float('-inf'), float('inf'))]\n\n        def subtract(intervals, iv):\n            lo, hi = iv\n            out = []\n            for a, b in intervals:\n                if hi < a or lo > b:\n                    out.append((a, b))\n                    continue\n                if lo > a:\n                    out.append((a, lo - 1))\n                if hi < b:\n                    out.append((hi + 1, b))\n            return out\n\n        def intersect_nonempty(intervals, iv):\n            lo, hi = iv\n            for a, b in intervals:\n                nlo, nhi = max(a, lo), min(b, hi)\n                if nlo <= nhi:\n                    return True\n            return False\n\n        for arm in parsed_arms:\n            pat = arm['pattern']\n            guard_text = arm['guard_text']\n            varname = None\n            if pat.kind == Pat.NAME:\n                varname = pat.value\n            if pat.kind == Pat.REL:\n                op, num = pat.value\n                iv = interval_from_atoms([(op, num)], 'and')[0]\n            elif pat.kind in (Pat.WILDCARD, Pat.NAME):\n                if guard_text is not None and varname is not None:\n                    ivs = guard_readable_interval(guard_text, varname)\n                    if ivs is None:\n                        # unreadable guard: credits nothing\n                        continue\n                    if guard_is_unsatisfiable(guard_text, varname):\n                        self.emit('unsatisfiable_arm_guard')\n                        continue\n                    covered_any = False\n                    for iv in ivs:\n                        if intersect_nonempty(remaining, iv):\n                            covered_any = True\n                            remaining = subtract(remaining, iv)\n                    if not covered_any:\n                        self.emit('unreachable_arm')\n                    continue\n                else:\n                    iv = (float('-inf'), float('inf'))\n            elif pat.kind == Pat.INT:\n                iv = (pat.value, pat.value)\n            else:\n                continue\n\n            if guard_text is not None and pat.kind not in (Pat.WILDCARD, Pat.NAME):\n                # e.g. relational pattern with an extra guard: rare; skip\n                pass\n\n            if not intersect_nonempty(remaining, iv):\n                self.emit('unreachable_arm')\n            else:\n                remaining = subtract(remaining, iv)\n\n        if remaining:\n            self.emit('switch_inexhaustive')\n\n    def check_tuple_switch(self, f, type_names, parsed_arms):\n        domains = []\n        all_closed = True\n        for tn in type_names:\n            kind, vals = resolve_type_domain(tn, self.types)\n            if kind != 'closed':\n                all_closed = False\n                break\n            domains.append(vals)\n        if not all_closed:\n            return  # open somewhere: don't guess\n        all_combos = set(itertools.product(*domains))\n        remaining = set(all_combos)\n\n        def pattern_matches_combo(pat_tuple_values, combo):\n            for p, v in zip(pat_tuple_values, combo):\n                if p.kind in (Pat.WILDCARD, Pat.NAME):\n                    continue\n                elif p.kind == Pat.ATOM:\n                    if p.value != v:\n                        return False\n                elif p.kind == Pat.BOOL:\n                    if p.value != v:\n                        return False\n                else:\n                    return False\n            return True\n\n        for arm in parsed_arms:\n            pat = arm['pattern']\n            guard_text = arm['guard_text']\n            if pat.kind == Pat.WILDCARD or pat.kind == Pat.NAME:\n                sub_pats = [Pat(Pat.WILDCARD)] * len(type_names)\n            elif pat.kind == Pat.TUPLE:\n                sub_pats = pat.value\n                if len(sub_pats) != len(type_names):\n                    self.emit('vacuous_arm')\n                    continue\n            else:\n                self.emit('vacuous_arm')\n                continue\n\n            matched = {c for c in all_combos if pattern_matches_combo(sub_pats, c)}\n            if guard_text is not None:\n                matched = set()  # unreadable/guarded: credit nothing\n            new_matches = matched & remaining\n            if matched and not new_matches:\n                self.emit('unreachable_arm')\n            remaining -= matched\n\n        if remaining:\n            self.emit('switch_inexhaustive')\n\n    # ---- expression checks: unbound_variable, return_not_declared,\n    # arg_not_accepted ----\n\n    def check_value_expr(self, f, expr, bound_names):\n        # unbound_variable: find bare identifiers used (not atom literals,\n        # not keywords, not function names, not numbers) and check binding\n        self.check_unbound(f, expr, bound_names)\n        self.check_return_type(f, expr)\n        self.check_calls(f, expr, bound_names)\n\n    def check_unbound(self, f, expr, bound_names):\n        # collect identifiers not immediately preceded by ':' and not\n        # followed by '(' (those are calls, checked separately) and not\n        # function names.\n        for m in re.finditer(r'(?<!:)\\b([A-Za-z_]\\w*)\\b', expr):\n            name = m.group(1)\n            start = m.start()\n            if start > 0 and expr[start - 1] == ':':\n                continue\n            after = expr[m.end():m.end() + 1]\n            if after == '(':\n                continue  # it's a function call name\n            if name in ('true', 'false'):\n                continue\n            if name in self.funcs:\n                continue\n            if name in bound_names:\n                continue\n            self.emit('unbound_variable')\n\n    def check_return_type(self, f, expr):\n        expr = expr.strip()\n        ret_t = f.ret_type\n        # only handle the case where expr is a simple literal (atom, int,\n        # bool) directly returned by the arm -- more complex expressions\n        # (calls, names) we don't try to type-check defensively.\n        if re.match(r'^:[A-Za-z_]\\w*$', expr):\n            if ret_t not in ('atom', 'term') and ret_t not in self.types:\n                self.emit('return_not_declared')\n            elif ret_t in self.types:\n                if expr not in self.types[ret_t]:\n                    self.emit('return_not_declared')\n            return\n        if re.match(r'^-?\\d+$', expr):\n            if ret_t not in ('int', 'term'):\n                self.emit('return_not_declared')\n            return\n        if expr in ('true', 'false'):\n            if ret_t not in ('bool', 'term'):\n                self.emit('return_not_declared')\n            return\n        # calls / names / other expressions: skip (would require full type\n        # inference we can't do safely without guessing).\n\n    def check_calls(self, f, expr, bound_names):\n        # find calls Name(args) where Name is a known function; check each\n        # argument's inferred type against callee's declared param type.\n        for m in re.finditer(r'\\b([A-Za-z_]\\w*)\\s*\\(', expr):\n            name = m.group(1)\n            if name not in self.funcs:\n                continue\n            open_idx = m.end() - 1\n            close_idx = matching_paren(expr, open_idx)\n            if close_idx == -1:\n                continue\n            args_str = expr[open_idx + 1:close_idx]\n            args = [a.strip() for a in depth_aware_split(args_str, ',') if a.strip() != '']\n            callee = self.funcs[name]\n            for i, arg in enumerate(args):\n                if i >= len(callee.params):\n                    continue\n                ptype, pname = callee.params[i]\n                arg_type = self.infer_expr_type(f, arg, bound_names)\n                if arg_type is None:\n                    continue\n                if not self.type_compatible(arg_type, ptype):\n                    self.emit('arg_not_accepted')\n\n    def infer_expr_type(self, f, expr, bound_names):\n        expr = expr.strip()\n        if re.match(r'^:[A-Za-z_]\\w*$', expr):\n            return 'atom'\n        if re.match(r'^-?\\d+$', expr):\n            return 'int'\n        if expr in ('true', 'false'):\n            return 'bool'\n        if re.match(r'^[A-Za-z_]\\w*$', expr):\n            # a bound name: look up its declared param type if it's a\n            # function parameter\n            for (ptype, pname) in f.params:\n                if pname == expr:\n                    return ptype\n            return None\n        return None\n\n    def type_compatible(self, arg_type, param_type):\n        if arg_type == param_type:\n            return True\n        if param_type == 'term':\n            return True\n        if param_type in self.types:\n            # closed atom-union: an 'atom' typed value can't be verified\n            # further, but a plain 'atom' arg is compatible only if it's a\n            # literal member (checked elsewhere); treat generically\n            # compatible if arg_type == 'atom'\n            return arg_type == 'atom'\n        return False\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.exit(0)\n    path = sys.argv[1]\n    with open(path) as fh:\n        text = fh.read()\n    types = parse_types(text)\n    funcs = parse_functions(text)\n    checker = Checker(types, funcs)\n    checker.run()\n    for tag in TAGS:\n        if tag in checker.diagnostics:\n            print(tag)\n\n\nif __name__ == '__main__':\n    main()\n"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py","exists":false,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py","time":{"start":1788993763285,"end":1788993763461}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_088551571001YKoWkhtchb4XW7","sessionID":"ses_f77ade3feffeYe56P6hqdU6Mjz","messageID":"msg_088550d7d001MnaMZnUiDqfW47"}}
