{"type":"step_start","timestamp":1788993903393,"sessionID":"ses_f77a782a6ffe8fH6ZzELpGeegI","part":{"id":"prt_088589b1a001j2xMaVJChql2Va","messageID":"msg_088589724001Wnunt9NBzcE0ST","sessionID":"ses_f77a782a6ffe8fH6ZzELpGeegI","type":"step-start"}}
{"type":"tool_use","timestamp":1788993905666,"sessionID":"ses_f77a782a6ffe8fH6ZzELpGeegI","part":{"type":"tool","tool":"read","callID":"toolu_01FfyDb6PBTbqoywS3LjpuL5","state":{"status":"completed","input":{"filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py"},"output":"<path>/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env python3\n2: \"\"\"\n3: switchcheck: a clean-room exhaustiveness/well-formedness checker for the\n4: switch-based language described in PACKET.md.\n5: \n6: Reads one .bs source file and prints diagnostic tags (one per line) to stdout.\n7: \"\"\"\n8: import sys\n9: import re\n10: import itertools\n11: \n12: TAGS = [\n13:     \"switch_inexhaustive\",\n14:     \"unreachable_arm\",\n15:     \"vacuous_arm\",\n16:     \"unsatisfiable_arm_guard\",\n17:     \"rebinding\",\n18:     \"unbound_variable\",\n19:     \"return_not_declared\",\n20:     \"arg_not_accepted\",\n21:     \"switch_in_guard\",\n22: ]\n23: \n24: \n25: def depth_aware_split(s, sep):\n26:     \"\"\"Split s on top-level occurrences of sep (a string), respecting\n27:     (), {}, [] nesting depth.\"\"\"\n28:     parts = []\n29:     depth = 0\n30:     i = 0\n31:     n = len(s)\n32:     start = 0\n33:     seplen = len(sep)\n34:     while i < n:\n35:         c = s[i]\n36:         if c in '([{':\n37:             depth += 1\n38:             i += 1\n39:             continue\n40:         if c in ')]}':\n41:             depth -= 1\n42:             i += 1\n43:             continue\n44:         if depth == 0 and s[i:i+seplen] == sep:\n45:             parts.append(s[start:i])\n46:             i += seplen\n47:             start = i\n48:             continue\n49:         i += 1\n50:     parts.append(s[start:])\n51:     return parts\n52: \n53: \n54: def find_top_level(s, sep):\n55:     \"\"\"Return index of first top-level occurrence of sep, or -1.\"\"\"\n56:     depth = 0\n57:     i = 0\n58:     n = len(s)\n59:     seplen = len(sep)\n60:     while i < n:\n61:         c = s[i]\n62:         if c in '([{':\n63:             depth += 1\n64:             i += 1\n65:             continue\n66:         if c in ')]}':\n67:             depth -= 1\n68:             i += 1\n69:             continue\n70:         if depth == 0 and s[i:i+seplen] == sep:\n71:             return i\n72:         i += 1\n73:     return -1\n74: \n75: \n76: def matching_paren(s, open_idx):\n77:     \"\"\"s[open_idx] must be '('. Return index of matching ')'.\"\"\"\n78:     depth = 0\n79:     i = open_idx\n80:     n = len(s)\n81:     while i < n:\n82:         if s[i] == '(':\n83:             depth += 1\n84:         elif s[i] == ')':\n85:             depth -= 1\n86:             if depth == 0:\n87:                 return i\n88:         i += 1\n89:     return -1\n90: \n91: \n92: class Func:\n93:     def __init__(self, name, ret_type, params):\n94:         self.name = name\n95:         self.ret_type = ret_type\n96:         self.params = params  # list of (type, name)\n97:         self.clauses = []  # list of (args_str, guard_text_or_None, body_text)\n98: \n99: \n100: def parse_types(text):\n101:     \"\"\"Parse `type Name = variant | variant | ...` where variants are atom\n102:     literals (\":x\"). Returns dict name -> set(atoms).\"\"\"\n103:     types = {}\n104:     for m in re.finditer(r'(?m)^\\s*type\\s+(\\w+)\\s*=\\s*(.+?)\\s*$', text):\n105:         name = m.group(1)\n106:         rhs = m.group(2)\n107:         variants = [v.strip() for v in rhs.split('|')]\n108:         atoms = set()\n109:         ok = True\n110:         for v in variants:\n111:             if v.startswith(':'):\n112:                 atoms.add(v)\n113:             else:\n114:                 ok = False\n115:         if ok:\n116:             types[name] = atoms\n117:     return types\n118: \n119: \n120: def parse_functions(text):\n121:     \"\"\"Parse function signatures and their clause bodies.\"\"\"\n122:     sig_re = re.compile(r'(?m)^\\s*public\\s+([\\w<>]+)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*$')\n123:     sigs = list(sig_re.finditer(text))\n124:     funcs = {}\n125:     order = []\n126:     for idx, m in enumerate(sigs):\n127:         ret_type = m.group(1)\n128:         name = m.group(2)\n129:         params_str = m.group(3).strip()\n130:         params = []\n131:         if params_str:\n132:             for p in params_str.split(','):\n133:                 p = p.strip()\n134:                 if not p:\n135:                     continue\n136:                 parts = p.split()\n137:                 ptype = parts[0]\n138:                 pname = parts[1] if len(parts) > 1 else None\n139:                 params.append((ptype, pname))\n140:         f = Func(name, ret_type, params)\n141:         funcs[name] = f\n142:         order.append((m.end(), name))\n143: \n144:     # For each function, the body text runs from end of its signature to the\n145:     # start of the next signature (or EOF).\n146:     for i, (end_pos, name) in enumerate(order):\n147:         start = end_pos\n148:         end = sigs[i + 1].start() if i + 1 < len(sigs) else len(text)\n149:         body_text = text[start:end]\n150:         parse_clauses(funcs[name], body_text)\n151:     return funcs\n152: \n153: \n154: def parse_clauses(func, body_text):\n155:     name = func.name\n156:     # Find all top-of-line occurrences of \"Name(\" as clause heads.\n157:     starts = [m.start() for m in re.finditer(r'(?m)^\\s*' + re.escape(name) + r'\\s*\\(', body_text)]\n158:     if not starts:\n159:         return\n160:     for i, s in enumerate(starts):\n161:         e = starts[i + 1] if i + 1 < len(starts) else len(body_text)\n162:         seg = body_text[s:e]\n163:         clause = parse_one_clause(name, seg)\n164:         if clause is not None:\n165:             func.clauses.append(clause)\n166: \n167: \n168: def parse_one_clause(name, seg):\n169:     # seg starts with whitespace then Name(\n170:     m = re.match(r'\\s*' + re.escape(name) + r'\\s*\\(', seg)\n171:     if not m:\n172:         return None\n173:     open_paren = seg.index('(', m.start())\n174:     close_paren = matching_paren(seg, open_paren)\n175:     if close_paren == -1:\n176:         return None\n177:     args_str = seg[open_paren + 1:close_paren]\n178:     rest = seg[close_paren + 1:]\n179:     rest_stripped = rest.lstrip()\n180:     guard_text = None\n181:     if rest_stripped.startswith('when'):\n182:         after_when = rest_stripped[4:]\n183:         arrow_idx = find_top_level(after_when, '->')\n184:         if arrow_idx == -1:\n185:             return None\n186:         guard_text = after_when[:arrow_idx].strip()\n187:         body_text = after_when[arrow_idx + 2:]\n188:     else:\n189:         arrow_idx = find_top_level(rest_stripped, '->')\n190:         if arrow_idx == -1:\n191:             return None\n192:         body_text = rest_stripped[arrow_idx + 2:]\n193:     body_text = body_text.strip()\n194:     # strip a single trailing comma if present (shouldn't normally happen)\n195:     return (args_str.strip(), guard_text, body_text)\n196: \n197: \n198: # ---------------- Pattern representation ----------------\n199: \n200: class Pat:\n201:     ATOM = 'atom'       # literal atom, value = string like \":x\"\n202:     BOOL = 'bool'       # literal bool, value = True/False\n203:     WILDCARD = 'wild'   # _\n204:     NAME = 'name'       # bare identifier binding, value = name\n205:     EQNAME = 'eqname'   # == name\n206:     REL = 'rel'         # relational pattern, value = (op, number)\n207:     TUPLE = 'tuple'     # tuple pattern, value = list of Pat\n208:     INT = 'int'         # literal integer\n209:     OTHER = 'other'\n210: \n211:     def __init__(self, kind, value=None):\n212:         self.kind = kind\n213:         self.value = value\n214: \n215:     def __repr__(self):\n216:         return f'Pat({self.kind},{self.value})'\n217: \n218: \n219: REL_OPS = ['>=', '<=', '==', '!=', '>', '<']\n220: \n221: \n222: def parse_pattern(text):\n223:     text = text.strip()\n224:     if text == '_':\n225:         return Pat(Pat.WILDCARD)\n226:     if text.startswith('(') and text.endswith(')'):\n227:         inner = text[1:-1]\n228:         parts = depth_aware_split(inner, ',')\n229:         subs = [parse_pattern(p) for p in parts]\n230:         return Pat(Pat.TUPLE, subs)\n231:     if text.startswith(':'):\n232:         return Pat(Pat.ATOM, text)\n233:     if text in ('true', 'false'):\n234:         return Pat(Pat.BOOL, text == 'true')\n235:     if text.startswith('=='):\n236:         rest = text[2:].strip()\n237:         return Pat(Pat.EQNAME, rest)\n238:     for op in REL_OPS:\n239:         if text.startswith(op):\n240:             rest = text[len(op):].strip()\n241:             try:\n242:                 num = float(rest) if ('.' in rest) else int(rest)\n243:             except ValueError:\n244:                 num = rest\n245:             return Pat(Pat.REL, (op, num))\n246:     if re.match(r'^-?\\d+$', text):\n247:         return Pat(Pat.INT, int(text))\n248:     if re.match(r'^[A-Za-z_]\\w*$', text):\n249:         return Pat(Pat.NAME, text)\n250:     return Pat(Pat.OTHER, text)\n251: \n252: \n253: # ---------------- Guard representation ----------------\n254: \n255: def split_guard_conjunctions(guard_text):\n256:     \"\"\"Split on top-level 'and'/'or'. Returns (op, list_of_atoms) where op\n257:     is 'and', 'or', or None if a single atom. Only handles a single flat\n258:     level (no mixed and/or, no parens) which is all the spec's grammar\n259:     supports.\"\"\"\n260:     # try and first\n261:     and_parts = depth_aware_split(guard_text, ' and ')\n262:     if len(and_parts) > 1:\n263:         return ('and', [p.strip() for p in and_parts])\n264:     or_parts = depth_aware_split(guard_text, ' or ')\n265:     if len(or_parts) > 1:\n266:         return ('or', [p.strip() for p in or_parts])\n267:     return (None, [guard_text.strip()])\n268: \n269: \n270: def parse_relational_atom(text, varname):\n271:     \"\"\"Try to read `text` as `<varname> <op> <literal>` or `<op> <literal>`\n272:     (relational atom). Returns (op, number) or None if unreadable.\"\"\"\n273:     text = text.strip()\n274:     # form: name op literal\n275:     m = re.match(r'^([A-Za-z_]\\w*)\\s*(>=|<=|==|!=|>|<)\\s*(-?\\d+(?:\\.\\d+)?)\\s*$', text)\n276:     if m:\n277:         if m.group(1) != varname:\n278:             return None\n279:         op = m.group(2)\n280:         num = m.group(3)\n281:         num = float(num) if '.' in num else int(num)\n282:         return (op, num)\n283:     return None\n284: \n285: \n286: def interval_from_atoms(atoms_ops, combine):\n287:     \"\"\"Given list of (op, num), combine via 'and' (intersection) or 'or'\n288:     (union approximated as a list of intervals). Returns list of (lo, hi)\n289:     inclusive-inclusive using +/-inf, or None if any atom unreadable.\"\"\"\n290:     intervals = []\n291:     for op, num in atoms_ops:\n292:         if op == '>':\n293:             intervals.append((num + 1, float('inf')))\n294:         elif op == '>=':\n295:             intervals.append((num, float('inf')))\n296:         elif op == '<':\n297:             intervals.append((float('-inf'), num - 1))\n298:         elif op == '<=':\n299:             intervals.append((float('-inf'), num))\n300:         elif op == '==':\n301:             intervals.append((num, num))\n302:         elif op == '!=':\n303:             # not directly a single interval; represent specially\n304:             return None\n305:         else:\n306:             return None\n307:     if combine == 'and':\n308:         lo = max(iv[0] for iv in intervals)\n309:         hi = min(iv[1] for iv in intervals)\n310:         return [(lo, hi)]\n311:     else:\n312:         return intervals\n313: \n314: \n315: def guard_readable_interval(guard_text, varname):\n316:     \"\"\"Return list of (lo,hi) intervals this guard represents on varname,\n317:     or None if guard is not readable (contains a call, compares two vars,\n318:     uses != in a combo we can't represent simply, or refers to a\n319:     different / no variable).\"\"\"\n320:     if guard_text is None:\n321:         return [(float('-inf'), float('inf'))]\n322:     combine, atoms_text = split_guard_conjunctions(guard_text)\n323:     atoms_ops = []\n324:     for a in atoms_text:\n325:         r = parse_relational_atom(a, varname)\n326:         if r is None:\n327:             return None\n328:         atoms_ops.append(r)\n329:     return interval_from_atoms(atoms_ops, combine if combine else 'and')\n330: \n331: \n332: def guard_is_unsatisfiable(guard_text, varname):\n333:     \"\"\"Return True if guard is readable and represents an empty set.\"\"\"\n334:     ivs = guard_readable_interval(guard_text, varname)\n335:     if ivs is None:\n336:         return False\n337:     for lo, hi in ivs:\n338:         if lo <= hi:\n339:             return False\n340:     return True\n341: \n342: \n343: # ---------------- Type helpers ----------------\n344: \n345: BOOL_VALUES = [True, False]\n346: \n347: \n348: def resolve_type_domain(type_name, types):\n349:     \"\"\"Return ('closed', list_of_values) or ('open', None) for a scalar\n350:     type name. Values for atom-union closed types are the atom-literal\n351:     strings (\":x\"); for bool, True/False.\"\"\"\n352:     if type_name in types:\n353:         return ('closed', sorted(types[type_name]))\n354:     if type_name == 'bool':\n355:         return ('closed', BOOL_VALUES)\n356:     # atom, int, term, string, list<...> etc: open (unbounded / cannot\n357:     # enumerate all members practically for this checker)\n358:     return ('open', None)\n359: \n360: \n361: def pattern_matches_value(pat, value):\n362:     \"\"\"For scalar (non-tuple) patterns against a concrete enumerated value\n363:     (atom-literal string or bool).\"\"\"\n364:     if pat.kind == Pat.WILDCARD or pat.kind == Pat.NAME:\n365:         return True\n366:     if pat.kind == Pat.ATOM:\n367:         return pat.value == value\n368:     if pat.kind == Pat.BOOL:\n369:         return pat.value == value\n370:     return False\n371: \n372: \n373: def pattern_is_member_of_domain(pat, domain_kind, domain_values, type_name):\n374:     \"\"\"Vacuous-arm check: is this pattern shape even possibly a member of\n375:     the subject type? For closed atom/bool domains, only atom/bool/\n376:     wildcard/name patterns are members; a tuple pattern against an\n377:     atom-only union is not. For open/unknown types we can't be sure, so\n378:     assume it *could* be a member (never flag vacuous defensively).\"\"\"\n379:     if domain_kind == 'closed':\n380:         if all(isinstance(v, str) for v in domain_values):\n381:             # atom union\n382:             if pat.kind in (Pat.WILDCARD, Pat.NAME):\n383:                 return True\n384:             if pat.kind == Pat.ATOM:\n385:                 return pat.value in domain_values\n386:             return False\n387:         if all(isinstance(v, bool) for v in domain_values):\n388:             if pat.kind in (Pat.WILDCARD, Pat.NAME):\n389:                 return True\n390:             if pat.kind == Pat.BOOL:\n391:                 return True\n392:             return False\n393:     return True\n394: \n395: \n396: # ---------------- Main diagnostic engine ----------------\n397: \n398: class Checker:\n399:     def __init__(self, types, funcs):\n400:         self.types = types\n401:         self.funcs = funcs\n402:         self.diagnostics = set()\n403: \n404:     def emit(self, tag):\n405:         self.diagnostics.add(tag)\n406: \n407:     def run(self):\n408:         for fname, f in self.funcs.items():\n409:             for (args_str, guard_text, body_text) in f.clauses:\n410:                 if guard_text and re.search(r'\\bswitch\\b', guard_text):\n411:                     self.emit('switch_in_guard')\n412:                     # don't try to analyze further inside an illegal guard\n413:                     continue\n414:                 # map this clause's own argument names (which may differ\n415:                 # from the signature's parameter names) positionally to\n416:                 # the declared parameter types.\n417:                 clause_args = [a.strip() for a in depth_aware_split(args_str, ',') if a.strip() != '']\n418:                 bound_types = {}\n419:                 for i, arg_name in enumerate(clause_args):\n420:                     if i < len(f.params) and re.match(r'^[A-Za-z_]\\w*$', arg_name):\n421:                         ptype = f.params[i][0]\n422:                         bound_types[arg_name] = ptype\n423:                 self.check_body(f, body_text, bound_types)\n424: \n425:     def check_body(self, f, body_text, bound_types):\n426:         sw = self.match_switch(body_text)\n427:         if sw is None:\n428:             return\n429:         subject_text, arms_text = sw\n430:         self.check_switch(f, subject_text, arms_text, bound_types)\n431: \n432:     def match_switch(self, text):\n433:         text = text.strip()\n434:         idx = find_top_level(text, ' switch ')\n435:         # find last top-level '{' ... need brace matching\n436:         m = re.search(r'\\{', text)\n437:         if ' switch' not in text:\n438:             return None\n439:         sw_idx = text.find('switch')\n440:         # ensure this switch is at top level relative to text start\n441:         subject_text = text[:sw_idx].strip()\n442:         rest = text[sw_idx + len('switch'):].strip()\n443:         if not rest.startswith('{'):\n444:             return None\n445:         # find matching closing brace\n446:         depth = 0\n447:         i = 0\n448:         n = len(rest)\n449:         end = -1\n450:         for i in range(n):\n451:             if rest[i] == '{':\n452:                 depth += 1\n453:             elif rest[i] == '}':\n454:                 depth -= 1\n455:                 if depth == 0:\n456:                     end = i\n457:                     break\n458:         if end == -1:\n459:             return None\n460:         arms_text = rest[1:end]\n461:         return (subject_text, arms_text)\n462: \n463:     def resolve_subject_type(self, f, subject_text, bound_names_types):\n464:         \"\"\"bound_names_types: dict name->type_name for names in scope\n465:         (function params). Returns a description:\n466:         ('scalar', type_name) or ('tuple', [type_name,...]) or None if\n467:         unknown (e.g. subject is not a simple name/tuple of names).\"\"\"\n468:         subject_text = subject_text.strip()\n469:         if subject_text.startswith('(') and subject_text.endswith(')'):\n470:             inner = subject_text[1:-1]\n471:             names = [p.strip() for p in depth_aware_split(inner, ',')]\n472:             types_list = []\n473:             for nm in names:\n474:                 t = bound_names_types.get(nm)\n475:                 if t is None:\n476:                     return None\n477:                 types_list.append(t)\n478:             return ('tuple', types_list)\n479:         if re.match(r'^[A-Za-z_]\\w*$', subject_text):\n480:             t = bound_names_types.get(subject_text)\n481:             if t is None:\n482:                 return None\n483:             return ('scalar', t)\n484:         return None\n485: \n486:     def parse_arms(self, arms_text):\n487:         arm_strs = [a.strip() for a in depth_aware_split(arms_text, ',') if a.strip() != '']\n488:         arms = []\n489:         for a in arm_strs:\n490:             idx = find_top_level(a, '=>')\n491:             if idx == -1:\n492:                 continue\n493:             head = a[:idx].strip()\n494:             value = a[idx + 2:].strip()\n495:             widx = find_top_level(head, ' when ')\n496:             if widx != -1:\n497:                 pattern_text = head[:widx].strip()\n498:                 guard_text = head[widx + len(' when '):].strip()\n499:             else:\n500:                 pattern_text = head\n501:                 guard_text = None\n502:             arms.append((pattern_text, guard_text, value))\n503:         return arms\n504: \n505:     def check_switch(self, f, subject_text, arms_text, bound_names_types):\n506:         subj = self.resolve_subject_type(f, subject_text, bound_names_types)\n507:         arms = self.parse_arms(arms_text)\n508: \n509:         parsed_arms = []\n510:         for (pattern_text, guard_text, value_text) in arms:\n511:             pat = parse_pattern(pattern_text)\n512:             parsed_arms.append({\n513:                 'pattern_text': pattern_text,\n514:                 'pattern': pat,\n515:                 'guard_text': guard_text,\n516:                 'value_text': value_text,\n517:             })\n518: \n519:         # ---- rebinding check ----\n520:         # An arm's bare-name pattern that duplicates an already-bound name\n521:         # (a function parameter, since arms don't see siblings) is\n522:         # rebinding.\n523:         outer_names = set(bound_names_types.keys())\n524:         for arm in parsed_arms:\n525:             pat = arm['pattern']\n526:             names_here = set()\n527:             self.collect_bare_names(pat, names_here)\n528:             for nm in names_here:\n529:                 if nm in outer_names:\n530:                     self.emit('rebinding')\n531: \n532:         # ---- guard: unreadable calls -> unsatisfiable check only when\n533:         # readable; unbound_variable in guard skipped (not in scope) ----\n534: \n535:         # ---- vacuous_arm & unsatisfiable_arm_guard & coverage ----\n536:         if subj is not None and subj[0] == 'scalar':\n537:             self.check_scalar_switch(f, subj[1], parsed_arms)\n538:         elif subj is not None and subj[0] == 'tuple':\n539:             self.check_tuple_switch(f, subj[1], parsed_arms)\n540:         # if subj is None (can't resolve, e.g. subject is a complex expr):\n541:         # don't guess; skip exhaustiveness/vacuous checks defensively.\n542: \n543:         # ---- unbound_variable & return_not_declared & arg_not_accepted ----\n544:         for arm in parsed_arms:\n545:             arm_bound = {}\n546:             self.collect_bare_name_types(arm['pattern'], subj, arm_bound)\n547:             local_types = dict(bound_names_types)\n548:             local_types.update(arm_bound)\n549:             arm_bound_names = arm_bound.keys() | outer_names\n550:             self.check_value_expr(f, arm['value_text'], arm_bound_names, local_types)\n551: \n552:     def collect_bare_names(self, pat, out):\n553:         if pat.kind == Pat.NAME:\n554:             out.add(pat.value)\n555:         elif pat.kind == Pat.TUPLE:\n556:             for sub in pat.value:\n557:                 self.collect_bare_names(sub, out)\n558: \n559:     def collect_bare_name_types(self, pat, subj, out):\n560:         \"\"\"Record the type each bare-name pattern binds, based on the\n561:         subject's type (scalar) or component types (tuple).\"\"\"\n562:         if subj is None:\n563:             self.collect_bare_names(pat, set())\n564:             return\n565:         if subj[0] == 'scalar':\n566:             if pat.kind == Pat.NAME:\n567:                 out[pat.value] = subj[1]\n568:             elif pat.kind == Pat.TUPLE:\n569:                 # a tuple pattern against a scalar subject is vacuous, but\n570:                 # still introduces bindings for the names it writes so\n571:                 # that binding-scope checks (unbound_variable) don't\n572:                 # spuriously fire independent of the vacuous-arm finding.\n573:                 for sub in pat.value:\n574:                     if sub.kind == Pat.NAME:\n575:                         out[sub.value] = None\n576:         elif subj[0] == 'tuple':\n577:             if pat.kind == Pat.NAME:\n578:                 # bare name for the whole tuple: type unknown generically\n579:                 return\n580:             if pat.kind == Pat.TUPLE:\n581:                 for sub, tn in zip(pat.value, subj[1]):\n582:                     if sub.kind == Pat.NAME:\n583:                         out[sub.value] = tn\n584: \n585:     def check_scalar_switch(self, f, type_name, parsed_arms):\n586:         domain_kind, domain_values = resolve_type_domain(type_name, self.types)\n587:         is_int = (type_name == 'int')\n588: \n589:         if domain_kind == 'closed':\n590:             full_domain = set(domain_values)\n591:             remaining = set(domain_values)\n592:             for i, arm in enumerate(parsed_arms):\n593:                 pat = arm['pattern']\n594:                 guard_text = arm['guard_text']\n595:                 # vacuous check\n596:                 if not pattern_is_member_of_domain(pat, domain_kind, domain_values, type_name):\n597:                     self.emit('vacuous_arm')\n598:                     continue\n599:                 # matched: the full set of values this pattern (ignoring\n600:                 # any guard) would match, independent of what's already\n601:                 # covered.\n602:                 if pat.kind in (Pat.WILDCARD, Pat.NAME):\n603:                     matched = set(full_domain)\n604:                 elif pat.kind == Pat.ATOM:\n605:                     matched = {pat.value} if pat.value in full_domain else set()\n606:                 elif pat.kind == Pat.BOOL:\n607:                     matched = {pat.value} if pat.value in full_domain else set()\n608:                 else:\n609:                     matched = set()\n610: \n611:                 if guard_text is not None:\n612:                     # An unreadable (non-int) guard credits nothing\n613:                     # towards coverage, but also can't be shown dead, so\n614:                     # don't flag unreachable for it either.\n615:                     continue\n616: \n617:                 new_coverage = matched & remaining\n618:                 if matched and not new_coverage:\n619:                     self.emit('unreachable_arm')\n620:                 remaining -= matched\n621:             if remaining:\n622:                 self.emit('switch_inexhaustive')\n623:         else:\n624:             # open domain (atom, term, string, or int without full guard\n625:             # analysis): only handle int with relational-pattern arms\n626:             # doing interval subtraction; otherwise assume exhaustive if a\n627:             # catch-all (wildcard/bare name with no guard, or bare name\n628:             # with guard) exists, matching the spec's \"open -> catch-all\n629:             # legal\" rule. Don't guess beyond that.\n630:             if is_int:\n631:                 self.check_int_switch(f, parsed_arms)\n632:             else:\n633:                 has_full_catchall = False\n634:                 for arm in parsed_arms:\n635:                     pat = arm['pattern']\n636:                     if pat.kind in (Pat.WILDCARD, Pat.NAME) and arm['guard_text'] is None:\n637:                         has_full_catchall = True\n638:                 # vacuous check doesn't really apply (open type, any shape\n639:                 # could conceivably belong depending on type); skip.\n640:                 if not has_full_catchall:\n641:                     # can't prove exhaustiveness without enumeration;\n642:                     # since domain is open we can't say inexhaustive\n643:                     # either without more info. Be conservative: don't\n644:                     # flag.\n645:                     pass\n646: \n647:     def check_int_switch(self, f, parsed_arms):\n648:         remaining = [(float('-inf'), float('inf'))]\n649: \n650:         def subtract(intervals, iv):\n651:             lo, hi = iv\n652:             out = []\n653:             for a, b in intervals:\n654:                 if hi < a or lo > b:\n655:                     out.append((a, b))\n656:                     continue\n657:                 if lo > a:\n658:                     out.append((a, lo - 1))\n659:                 if hi < b:\n660:                     out.append((hi + 1, b))\n661:             return out\n662: \n663:         def intersect_nonempty(intervals, iv):\n664:             lo, hi = iv\n665:             for a, b in intervals:\n666:                 nlo, nhi = max(a, lo), min(b, hi)\n667:                 if nlo <= nhi:\n668:                     return True\n669:             return False\n670: \n671:         for arm in parsed_arms:\n672:             pat = arm['pattern']\n673:             guard_text = arm['guard_text']\n674:             varname = None\n675:             if pat.kind == Pat.NAME:\n676:                 varname = pat.value\n677:             if pat.kind == Pat.REL:\n678:                 op, num = pat.value\n679:                 iv = interval_from_atoms([(op, num)], 'and')[0]\n680:             elif pat.kind in (Pat.WILDCARD, Pat.NAME):\n681:                 if guard_text is not None and varname is not None:\n682:                     ivs = guard_readable_interval(guard_text, varname)\n683:                     if ivs is None:\n684:                         # unreadable guard: credits nothing\n685:                         continue\n686:                     if guard_is_unsatisfiable(guard_text, varname):\n687:                         self.emit('unsatisfiable_arm_guard')\n688:                         continue\n689:                     covered_any = False\n690:                     for iv in ivs:\n691:                         if intersect_nonempty(remaining, iv):\n692:                             covered_any = True\n693:                             remaining = subtract(remaining, iv)\n694:                     if not covered_any:\n695:                         self.emit('unreachable_arm')\n696:                     continue\n697:                 else:\n698:                     iv = (float('-inf'), float('inf'))\n699:             elif pat.kind == Pat.INT:\n700:                 iv = (pat.value, pat.value)\n701:             else:\n702:                 continue\n703: \n704:             if guard_text is not None and pat.kind not in (Pat.WILDCARD, Pat.NAME):\n705:                 # e.g. relational pattern with an extra guard: rare; skip\n706:                 pass\n707: \n708:             if not intersect_nonempty(remaining, iv):\n709:                 self.emit('unreachable_arm')\n710:             else:\n711:                 remaining = subtract(remaining, iv)\n712: \n713:         if remaining:\n714:             self.emit('switch_inexhaustive')\n715: \n716:     def check_tuple_switch(self, f, type_names, parsed_arms):\n717:         domains = []\n718:         all_closed = True\n719:         for tn in type_names:\n720:             kind, vals = resolve_type_domain(tn, self.types)\n721:             if kind != 'closed':\n722:                 all_closed = False\n723:                 break\n724:             domains.append(vals)\n725:         if not all_closed:\n726:             return  # open somewhere: don't guess\n727:         all_combos = set(itertools.product(*domains))\n728:         remaining = set(all_combos)\n729: \n730:         def pattern_matches_combo(pat_tuple_values, combo):\n731:             for p, v in zip(pat_tuple_values, combo):\n732:                 if p.kind in (Pat.WILDCARD, Pat.NAME):\n733:                     continue\n734:                 elif p.kind == Pat.ATOM:\n735:                     if p.value != v:\n736:                         return False\n737:                 elif p.kind == Pat.BOOL:\n738:                     if p.value != v:\n739:                         return False\n740:                 else:\n741:                     return False\n742:             return True\n743: \n744:         for arm in parsed_arms:\n745:             pat = arm['pattern']\n746:             guard_text = arm['guard_text']\n747:             if pat.kind == Pat.WILDCARD or pat.kind == Pat.NAME:\n748:                 sub_pats = [Pat(Pat.WILDCARD)] * len(type_names)\n749:             elif pat.kind == Pat.TUPLE:\n750:                 sub_pats = pat.value\n751:                 if len(sub_pats) != len(type_names):\n752:                     self.emit('vacuous_arm')\n753:                     continue\n754:             else:\n755:                 self.emit('vacuous_arm')\n756:                 continue\n757: \n758:             matched = {c for c in all_combos if pattern_matches_combo(sub_pats, c)}\n759:             if guard_text is not None:\n760:                 matched = set()  # unreadable/guarded: credit nothing\n761:             new_matches = matched & remaining\n762:             if matched and not new_matches:\n763:                 self.emit('unreachable_arm')\n764:             remaining -= matched\n765: \n766:         if remaining:\n767:             self.emit('switch_inexhaustive')\n768: \n769:     # ---- expression checks: unbound_variable, return_not_declared,\n770:     # arg_not_accepted ----\n771: \n772:     def check_value_expr(self, f, expr, bound_names, local_types):\n773:         # unbound_variable: find bare identifiers used (not atom literals,\n774:         # not keywords, not function names, not numbers) and check binding\n775:         self.check_unbound(f, expr, bound_names)\n776:         self.check_return_type(f, expr)\n777:         self.check_calls(f, expr, bound_names, local_types)\n778: \n779:     def check_unbound(self, f, expr, bound_names):\n780:         # collect identifiers not immediately preceded by ':' and not\n781:         # followed by '(' (those are calls, checked separately) and not\n782:         # function names.\n783:         for m in re.finditer(r'(?<!:)\\b([A-Za-z_]\\w*)\\b', expr):\n784:             name = m.group(1)\n785:             start = m.start()\n786:             if start > 0 and expr[start - 1] == ':':\n787:                 continue\n788:             after = expr[m.end():m.end() + 1]\n789:             if after == '(':\n790:                 continue  # it's a function call name\n791:             if name in ('true', 'false'):\n792:                 continue\n793:             if name in self.funcs:\n794:                 continue\n795:             if name in bound_names:\n796:                 continue\n797:             self.emit('unbound_variable')\n798: \n799:     def check_return_type(self, f, expr):\n800:         expr = expr.strip()\n801:         ret_t = f.ret_type\n802:         # only handle the case where expr is a simple literal (atom, int,\n803:         # bool) directly returned by the arm -- more complex expressions\n804:         # (calls, names) we don't try to type-check defensively.\n805:         if re.match(r'^:[A-Za-z_]\\w*$', expr):\n806:             if ret_t not in ('atom', 'term') and ret_t not in self.types:\n807:                 self.emit('return_not_declared')\n808:             elif ret_t in self.types:\n809:                 if expr not in self.types[ret_t]:\n810:                     self.emit('return_not_declared')\n811:             return\n812:         if re.match(r'^-?\\d+$', expr):\n813:             if ret_t not in ('int', 'term'):\n814:                 self.emit('return_not_declared')\n815:             return\n816:         if expr in ('true', 'false'):\n817:             if ret_t not in ('bool', 'term'):\n818:                 self.emit('return_not_declared')\n819:             return\n820:         # calls / names / other expressions: skip (would require full type\n821:         # inference we can't do safely without guessing).\n822: \n823:     def check_calls(self, f, expr, bound_names, local_types):\n824:         # find calls Name(args) where Name is a known function; check each\n825:         # argument's inferred type against callee's declared param type.\n826:         for m in re.finditer(r'\\b([A-Za-z_]\\w*)\\s*\\(', expr):\n827:             name = m.group(1)\n828:             if name not in self.funcs:\n829:                 continue\n830:             open_idx = m.end() - 1\n831:             close_idx = matching_paren(expr, open_idx)\n832:             if close_idx == -1:\n833:                 continue\n834:             args_str = expr[open_idx + 1:close_idx]\n835:             args = [a.strip() for a in depth_aware_split(args_str, ',') if a.strip() != '']\n836:             callee = self.funcs[name]\n837:             for i, arg in enumerate(args):\n838:                 if i >= len(callee.params):\n839:                     continue\n840:                 ptype, pname = callee.params[i]\n841:                 arg_type = self.infer_expr_type(f, arg, local_types)\n842:                 if arg_type is None:\n843:                     continue\n844:                 if not self.type_compatible(arg_type, ptype):\n845:                     self.emit('arg_not_accepted')\n846: \n847:     def infer_expr_type(self, f, expr, local_types):\n848:         expr = expr.strip()\n849:         if re.match(r'^:[A-Za-z_]\\w*$', expr):\n850:             return 'atom'\n851:         if re.match(r'^-?\\d+$', expr):\n852:             return 'int'\n853:         if expr in ('true', 'false'):\n854:             return 'bool'\n855:         if re.match(r'^[A-Za-z_]\\w*$', expr):\n856:             return local_types.get(expr)\n857:         return None\n858: \n859:     def type_compatible(self, arg_type, param_type):\n860:         if arg_type == param_type:\n861:             return True\n862:         if param_type == 'term':\n863:             return True\n864:         if param_type in self.types:\n865:             # closed atom-union: an 'atom' typed value can't be verified\n866:             # further, but a plain 'atom' arg is compatible only if it's a\n867:             # literal member (checked elsewhere); treat generically\n868:             # compatible if arg_type == 'atom'\n869:             return arg_type == 'atom'\n870:         return False\n871: \n872: \n873: def main():\n874:     if len(sys.argv) != 2:\n875:         sys.exit(0)\n876:     path = sys.argv[1]\n877:     with open(path) as fh:\n878:         text = fh.read()\n879:     types = parse_types(text)\n880:     funcs = parse_functions(text)\n881:     checker = Checker(types, funcs)\n882:     checker.run()\n883:     for tag in TAGS:\n884:         if tag in checker.diagnostics:\n885:             print(tag)\n886: \n887: \n888: if __name__ == '__main__':\n889:     main()\n\n(End of file - total 889 lines)\n</content>","metadata":{"preview":"#!/usr/bin/env python3\n\"\"\"\nswitchcheck: a clean-room exhaustiveness/well-formedness checker for the\nswitch-based language described in PACKET.md.\n\nReads one .bs source file and prints diagnostic tags (one per line) to stdout.\n\"\"\"\nimport sys\nimport re\nimport itertools\n\nTAGS = [\n    \"switch_inexhaustive\",\n    \"unreachable_arm\",\n    \"vacuous_arm\",\n    \"unsatisfiable_arm_guard\",\n    \"rebinding\",\n    \"unbound_variable\",\n    \"return_not_declared\",\n    \"arg_not_accepted\",","truncated":false,"loaded":[],"display":{"type":"file","path":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py","text":"#!/usr/bin/env python3\n\"\"\"\nswitchcheck: a clean-room exhaustiveness/well-formedness checker for the\nswitch-based language described in PACKET.md.\n\nReads one .bs source file and prints diagnostic tags (one per line) to stdout.\n\"\"\"\nimport sys\nimport re\nimport itertools\n\nTAGS = [\n    \"switch_inexhaustive\",\n    \"unreachable_arm\",\n    \"vacuous_arm\",\n    \"unsatisfiable_arm_guard\",\n    \"rebinding\",\n    \"unbound_variable\",\n    \"return_not_declared\",\n    \"arg_not_accepted\",\n    \"switch_in_guard\",\n]\n\n\ndef depth_aware_split(s, sep):\n    \"\"\"Split s on top-level occurrences of sep (a string), respecting\n    (), {}, [] nesting depth.\"\"\"\n    parts = []\n    depth = 0\n    i = 0\n    n = len(s)\n    start = 0\n    seplen = len(sep)\n    while i < n:\n        c = s[i]\n        if c in '([{':\n            depth += 1\n            i += 1\n            continue\n        if c in ')]}':\n            depth -= 1\n            i += 1\n            continue\n        if depth == 0 and s[i:i+seplen] == sep:\n            parts.append(s[start:i])\n            i += seplen\n            start = i\n            continue\n        i += 1\n    parts.append(s[start:])\n    return parts\n\n\ndef find_top_level(s, sep):\n    \"\"\"Return index of first top-level occurrence of sep, or -1.\"\"\"\n    depth = 0\n    i = 0\n    n = len(s)\n    seplen = len(sep)\n    while i < n:\n        c = s[i]\n        if c in '([{':\n            depth += 1\n            i += 1\n            continue\n        if c in ')]}':\n            depth -= 1\n            i += 1\n            continue\n        if depth == 0 and s[i:i+seplen] == sep:\n            return i\n        i += 1\n    return -1\n\n\ndef matching_paren(s, open_idx):\n    \"\"\"s[open_idx] must be '('. Return index of matching ')'.\"\"\"\n    depth = 0\n    i = open_idx\n    n = len(s)\n    while i < n:\n        if s[i] == '(':\n            depth += 1\n        elif s[i] == ')':\n            depth -= 1\n            if depth == 0:\n                return i\n        i += 1\n    return -1\n\n\nclass Func:\n    def __init__(self, name, ret_type, params):\n        self.name = name\n        self.ret_type = ret_type\n        self.params = params  # list of (type, name)\n        self.clauses = []  # list of (args_str, guard_text_or_None, body_text)\n\n\ndef parse_types(text):\n    \"\"\"Parse `type Name = variant | variant | ...` where variants are atom\n    literals (\":x\"). Returns dict name -> set(atoms).\"\"\"\n    types = {}\n    for m in re.finditer(r'(?m)^\\s*type\\s+(\\w+)\\s*=\\s*(.+?)\\s*$', text):\n        name = m.group(1)\n        rhs = m.group(2)\n        variants = [v.strip() for v in rhs.split('|')]\n        atoms = set()\n        ok = True\n        for v in variants:\n            if v.startswith(':'):\n                atoms.add(v)\n            else:\n                ok = False\n        if ok:\n            types[name] = atoms\n    return types\n\n\ndef parse_functions(text):\n    \"\"\"Parse function signatures and their clause bodies.\"\"\"\n    sig_re = re.compile(r'(?m)^\\s*public\\s+([\\w<>]+)\\s+(\\w+)\\s*\\(([^)]*)\\)\\s*$')\n    sigs = list(sig_re.finditer(text))\n    funcs = {}\n    order = []\n    for idx, m in enumerate(sigs):\n        ret_type = m.group(1)\n        name = m.group(2)\n        params_str = m.group(3).strip()\n        params = []\n        if params_str:\n            for p in params_str.split(','):\n                p = p.strip()\n                if not p:\n                    continue\n                parts = p.split()\n                ptype = parts[0]\n                pname = parts[1] if len(parts) > 1 else None\n                params.append((ptype, pname))\n        f = Func(name, ret_type, params)\n        funcs[name] = f\n        order.append((m.end(), name))\n\n    # For each function, the body text runs from end of its signature to the\n    # start of the next signature (or EOF).\n    for i, (end_pos, name) in enumerate(order):\n        start = end_pos\n        end = sigs[i + 1].start() if i + 1 < len(sigs) else len(text)\n        body_text = text[start:end]\n        parse_clauses(funcs[name], body_text)\n    return funcs\n\n\ndef parse_clauses(func, body_text):\n    name = func.name\n    # Find all top-of-line occurrences of \"Name(\" as clause heads.\n    starts = [m.start() for m in re.finditer(r'(?m)^\\s*' + re.escape(name) + r'\\s*\\(', body_text)]\n    if not starts:\n        return\n    for i, s in enumerate(starts):\n        e = starts[i + 1] if i + 1 < len(starts) else len(body_text)\n        seg = body_text[s:e]\n        clause = parse_one_clause(name, seg)\n        if clause is not None:\n            func.clauses.append(clause)\n\n\ndef parse_one_clause(name, seg):\n    # seg starts with whitespace then Name(\n    m = re.match(r'\\s*' + re.escape(name) + r'\\s*\\(', seg)\n    if not m:\n        return None\n    open_paren = seg.index('(', m.start())\n    close_paren = matching_paren(seg, open_paren)\n    if close_paren == -1:\n        return None\n    args_str = seg[open_paren + 1:close_paren]\n    rest = seg[close_paren + 1:]\n    rest_stripped = rest.lstrip()\n    guard_text = None\n    if rest_stripped.startswith('when'):\n        after_when = rest_stripped[4:]\n        arrow_idx = find_top_level(after_when, '->')\n        if arrow_idx == -1:\n            return None\n        guard_text = after_when[:arrow_idx].strip()\n        body_text = after_when[arrow_idx + 2:]\n    else:\n        arrow_idx = find_top_level(rest_stripped, '->')\n        if arrow_idx == -1:\n            return None\n        body_text = rest_stripped[arrow_idx + 2:]\n    body_text = body_text.strip()\n    # strip a single trailing comma if present (shouldn't normally happen)\n    return (args_str.strip(), guard_text, body_text)\n\n\n# ---------------- Pattern representation ----------------\n\nclass Pat:\n    ATOM = 'atom'       # literal atom, value = string like \":x\"\n    BOOL = 'bool'       # literal bool, value = True/False\n    WILDCARD = 'wild'   # _\n    NAME = 'name'       # bare identifier binding, value = name\n    EQNAME = 'eqname'   # == name\n    REL = 'rel'         # relational pattern, value = (op, number)\n    TUPLE = 'tuple'     # tuple pattern, value = list of Pat\n    INT = 'int'         # literal integer\n    OTHER = 'other'\n\n    def __init__(self, kind, value=None):\n        self.kind = kind\n        self.value = value\n\n    def __repr__(self):\n        return f'Pat({self.kind},{self.value})'\n\n\nREL_OPS = ['>=', '<=', '==', '!=', '>', '<']\n\n\ndef parse_pattern(text):\n    text = text.strip()\n    if text == '_':\n        return Pat(Pat.WILDCARD)\n    if text.startswith('(') and text.endswith(')'):\n        inner = text[1:-1]\n        parts = depth_aware_split(inner, ',')\n        subs = [parse_pattern(p) for p in parts]\n        return Pat(Pat.TUPLE, subs)\n    if text.startswith(':'):\n        return Pat(Pat.ATOM, text)\n    if text in ('true', 'false'):\n        return Pat(Pat.BOOL, text == 'true')\n    if text.startswith('=='):\n        rest = text[2:].strip()\n        return Pat(Pat.EQNAME, rest)\n    for op in REL_OPS:\n        if text.startswith(op):\n            rest = text[len(op):].strip()\n            try:\n                num = float(rest) if ('.' in rest) else int(rest)\n            except ValueError:\n                num = rest\n            return Pat(Pat.REL, (op, num))\n    if re.match(r'^-?\\d+$', text):\n        return Pat(Pat.INT, int(text))\n    if re.match(r'^[A-Za-z_]\\w*$', text):\n        return Pat(Pat.NAME, text)\n    return Pat(Pat.OTHER, text)\n\n\n# ---------------- Guard representation ----------------\n\ndef split_guard_conjunctions(guard_text):\n    \"\"\"Split on top-level 'and'/'or'. Returns (op, list_of_atoms) where op\n    is 'and', 'or', or None if a single atom. Only handles a single flat\n    level (no mixed and/or, no parens) which is all the spec's grammar\n    supports.\"\"\"\n    # try and first\n    and_parts = depth_aware_split(guard_text, ' and ')\n    if len(and_parts) > 1:\n        return ('and', [p.strip() for p in and_parts])\n    or_parts = depth_aware_split(guard_text, ' or ')\n    if len(or_parts) > 1:\n        return ('or', [p.strip() for p in or_parts])\n    return (None, [guard_text.strip()])\n\n\ndef parse_relational_atom(text, varname):\n    \"\"\"Try to read `text` as `<varname> <op> <literal>` or `<op> <literal>`\n    (relational atom). Returns (op, number) or None if unreadable.\"\"\"\n    text = text.strip()\n    # form: name op literal\n    m = re.match(r'^([A-Za-z_]\\w*)\\s*(>=|<=|==|!=|>|<)\\s*(-?\\d+(?:\\.\\d+)?)\\s*$', text)\n    if m:\n        if m.group(1) != varname:\n            return None\n        op = m.group(2)\n        num = m.group(3)\n        num = float(num) if '.' in num else int(num)\n        return (op, num)\n    return None\n\n\ndef interval_from_atoms(atoms_ops, combine):\n    \"\"\"Given list of (op, num), combine via 'and' (intersection) or 'or'\n    (union approximated as a list of intervals). Returns list of (lo, hi)\n    inclusive-inclusive using +/-inf, or None if any atom unreadable.\"\"\"\n    intervals = []\n    for op, num in atoms_ops:\n        if op == '>':\n            intervals.append((num + 1, float('inf')))\n        elif op == '>=':\n            intervals.append((num, float('inf')))\n        elif op == '<':\n            intervals.append((float('-inf'), num - 1))\n        elif op == '<=':\n            intervals.append((float('-inf'), num))\n        elif op == '==':\n            intervals.append((num, num))\n        elif op == '!=':\n            # not directly a single interval; represent specially\n            return None\n        else:\n            return None\n    if combine == 'and':\n        lo = max(iv[0] for iv in intervals)\n        hi = min(iv[1] for iv in intervals)\n        return [(lo, hi)]\n    else:\n        return intervals\n\n\ndef guard_readable_interval(guard_text, varname):\n    \"\"\"Return list of (lo,hi) intervals this guard represents on varname,\n    or None if guard is not readable (contains a call, compares two vars,\n    uses != in a combo we can't represent simply, or refers to a\n    different / no variable).\"\"\"\n    if guard_text is None:\n        return [(float('-inf'), float('inf'))]\n    combine, atoms_text = split_guard_conjunctions(guard_text)\n    atoms_ops = []\n    for a in atoms_text:\n        r = parse_relational_atom(a, varname)\n        if r is None:\n            return None\n        atoms_ops.append(r)\n    return interval_from_atoms(atoms_ops, combine if combine else 'and')\n\n\ndef guard_is_unsatisfiable(guard_text, varname):\n    \"\"\"Return True if guard is readable and represents an empty set.\"\"\"\n    ivs = guard_readable_interval(guard_text, varname)\n    if ivs is None:\n        return False\n    for lo, hi in ivs:\n        if lo <= hi:\n            return False\n    return True\n\n\n# ---------------- Type helpers ----------------\n\nBOOL_VALUES = [True, False]\n\n\ndef resolve_type_domain(type_name, types):\n    \"\"\"Return ('closed', list_of_values) or ('open', None) for a scalar\n    type name. Values for atom-union closed types are the atom-literal\n    strings (\":x\"); for bool, True/False.\"\"\"\n    if type_name in types:\n        return ('closed', sorted(types[type_name]))\n    if type_name == 'bool':\n        return ('closed', BOOL_VALUES)\n    # atom, int, term, string, list<...> etc: open (unbounded / cannot\n    # enumerate all members practically for this checker)\n    return ('open', None)\n\n\ndef pattern_matches_value(pat, value):\n    \"\"\"For scalar (non-tuple) patterns against a concrete enumerated value\n    (atom-literal string or bool).\"\"\"\n    if pat.kind == Pat.WILDCARD or pat.kind == Pat.NAME:\n        return True\n    if pat.kind == Pat.ATOM:\n        return pat.value == value\n    if pat.kind == Pat.BOOL:\n        return pat.value == value\n    return False\n\n\ndef pattern_is_member_of_domain(pat, domain_kind, domain_values, type_name):\n    \"\"\"Vacuous-arm check: is this pattern shape even possibly a member of\n    the subject type? For closed atom/bool domains, only atom/bool/\n    wildcard/name patterns are members; a tuple pattern against an\n    atom-only union is not. For open/unknown types we can't be sure, so\n    assume it *could* be a member (never flag vacuous defensively).\"\"\"\n    if domain_kind == 'closed':\n        if all(isinstance(v, str) for v in domain_values):\n            # atom union\n            if pat.kind in (Pat.WILDCARD, Pat.NAME):\n                return True\n            if pat.kind == Pat.ATOM:\n                return pat.value in domain_values\n            return False\n        if all(isinstance(v, bool) for v in domain_values):\n            if pat.kind in (Pat.WILDCARD, Pat.NAME):\n                return True\n            if pat.kind == Pat.BOOL:\n                return True\n            return False\n    return True\n\n\n# ---------------- Main diagnostic engine ----------------\n\nclass Checker:\n    def __init__(self, types, funcs):\n        self.types = types\n        self.funcs = funcs\n        self.diagnostics = set()\n\n    def emit(self, tag):\n        self.diagnostics.add(tag)\n\n    def run(self):\n        for fname, f in self.funcs.items():\n            for (args_str, guard_text, body_text) in f.clauses:\n                if guard_text and re.search(r'\\bswitch\\b', guard_text):\n                    self.emit('switch_in_guard')\n                    # don't try to analyze further inside an illegal guard\n                    continue\n                # map this clause's own argument names (which may differ\n                # from the signature's parameter names) positionally to\n                # the declared parameter types.\n                clause_args = [a.strip() for a in depth_aware_split(args_str, ',') if a.strip() != '']\n                bound_types = {}\n                for i, arg_name in enumerate(clause_args):\n                    if i < len(f.params) and re.match(r'^[A-Za-z_]\\w*$', arg_name):\n                        ptype = f.params[i][0]\n                        bound_types[arg_name] = ptype\n                self.check_body(f, body_text, bound_types)\n\n    def check_body(self, f, body_text, bound_types):\n        sw = self.match_switch(body_text)\n        if sw is None:\n            return\n        subject_text, arms_text = sw\n        self.check_switch(f, subject_text, arms_text, bound_types)\n\n    def match_switch(self, text):\n        text = text.strip()\n        idx = find_top_level(text, ' switch ')\n        # find last top-level '{' ... need brace matching\n        m = re.search(r'\\{', text)\n        if ' switch' not in text:\n            return None\n        sw_idx = text.find('switch')\n        # ensure this switch is at top level relative to text start\n        subject_text = text[:sw_idx].strip()\n        rest = text[sw_idx + len('switch'):].strip()\n        if not rest.startswith('{'):\n            return None\n        # find matching closing brace\n        depth = 0\n        i = 0\n        n = len(rest)\n        end = -1\n        for i in range(n):\n            if rest[i] == '{':\n                depth += 1\n            elif rest[i] == '}':\n                depth -= 1\n                if depth == 0:\n                    end = i\n                    break\n        if end == -1:\n            return None\n        arms_text = rest[1:end]\n        return (subject_text, arms_text)\n\n    def resolve_subject_type(self, f, subject_text, bound_names_types):\n        \"\"\"bound_names_types: dict name->type_name for names in scope\n        (function params). Returns a description:\n        ('scalar', type_name) or ('tuple', [type_name,...]) or None if\n        unknown (e.g. subject is not a simple name/tuple of names).\"\"\"\n        subject_text = subject_text.strip()\n        if subject_text.startswith('(') and subject_text.endswith(')'):\n            inner = subject_text[1:-1]\n            names = [p.strip() for p in depth_aware_split(inner, ',')]\n            types_list = []\n            for nm in names:\n                t = bound_names_types.get(nm)\n                if t is None:\n                    return None\n                types_list.append(t)\n            return ('tuple', types_list)\n        if re.match(r'^[A-Za-z_]\\w*$', subject_text):\n            t = bound_names_types.get(subject_text)\n            if t is None:\n                return None\n            return ('scalar', t)\n        return None\n\n    def parse_arms(self, arms_text):\n        arm_strs = [a.strip() for a in depth_aware_split(arms_text, ',') if a.strip() != '']\n        arms = []\n        for a in arm_strs:\n            idx = find_top_level(a, '=>')\n            if idx == -1:\n                continue\n            head = a[:idx].strip()\n            value = a[idx + 2:].strip()\n            widx = find_top_level(head, ' when ')\n            if widx != -1:\n                pattern_text = head[:widx].strip()\n                guard_text = head[widx + len(' when '):].strip()\n            else:\n                pattern_text = head\n                guard_text = None\n            arms.append((pattern_text, guard_text, value))\n        return arms\n\n    def check_switch(self, f, subject_text, arms_text, bound_names_types):\n        subj = self.resolve_subject_type(f, subject_text, bound_names_types)\n        arms = self.parse_arms(arms_text)\n\n        parsed_arms = []\n        for (pattern_text, guard_text, value_text) in arms:\n            pat = parse_pattern(pattern_text)\n            parsed_arms.append({\n                'pattern_text': pattern_text,\n                'pattern': pat,\n                'guard_text': guard_text,\n                'value_text': value_text,\n            })\n\n        # ---- rebinding check ----\n        # An arm's bare-name pattern that duplicates an already-bound name\n        # (a function parameter, since arms don't see siblings) is\n        # rebinding.\n        outer_names = set(bound_names_types.keys())\n        for arm in parsed_arms:\n            pat = arm['pattern']\n            names_here = set()\n            self.collect_bare_names(pat, names_here)\n            for nm in names_here:\n                if nm in outer_names:\n                    self.emit('rebinding')\n\n        # ---- guard: unreadable calls -> unsatisfiable check only when\n        # readable; unbound_variable in guard skipped (not in scope) ----\n\n        # ---- vacuous_arm & unsatisfiable_arm_guard & coverage ----\n        if subj is not None and subj[0] == 'scalar':\n            self.check_scalar_switch(f, subj[1], parsed_arms)\n        elif subj is not None and subj[0] == 'tuple':\n            self.check_tuple_switch(f, subj[1], parsed_arms)\n        # if subj is None (can't resolve, e.g. subject is a complex expr):\n        # don't guess; skip exhaustiveness/vacuous checks defensively.\n\n        # ---- unbound_variable & return_not_declared & arg_not_accepted ----\n        for arm in parsed_arms:\n            arm_bound = {}\n            self.collect_bare_name_types(arm['pattern'], subj, arm_bound)\n            local_types = dict(bound_names_types)\n            local_types.update(arm_bound)\n            arm_bound_names = arm_bound.keys() | outer_names\n            self.check_value_expr(f, arm['value_text'], arm_bound_names, local_types)\n\n    def collect_bare_names(self, pat, out):\n        if pat.kind == Pat.NAME:\n            out.add(pat.value)\n        elif pat.kind == Pat.TUPLE:\n            for sub in pat.value:\n                self.collect_bare_names(sub, out)\n\n    def collect_bare_name_types(self, pat, subj, out):\n        \"\"\"Record the type each bare-name pattern binds, based on the\n        subject's type (scalar) or component types (tuple).\"\"\"\n        if subj is None:\n            self.collect_bare_names(pat, set())\n            return\n        if subj[0] == 'scalar':\n            if pat.kind == Pat.NAME:\n                out[pat.value] = subj[1]\n            elif pat.kind == Pat.TUPLE:\n                # a tuple pattern against a scalar subject is vacuous, but\n                # still introduces bindings for the names it writes so\n                # that binding-scope checks (unbound_variable) don't\n                # spuriously fire independent of the vacuous-arm finding.\n                for sub in pat.value:\n                    if sub.kind == Pat.NAME:\n                        out[sub.value] = None\n        elif subj[0] == 'tuple':\n            if pat.kind == Pat.NAME:\n                # bare name for the whole tuple: type unknown generically\n                return\n            if pat.kind == Pat.TUPLE:\n                for sub, tn in zip(pat.value, subj[1]):\n                    if sub.kind == Pat.NAME:\n                        out[sub.value] = tn\n\n    def check_scalar_switch(self, f, type_name, parsed_arms):\n        domain_kind, domain_values = resolve_type_domain(type_name, self.types)\n        is_int = (type_name == 'int')\n\n        if domain_kind == 'closed':\n            full_domain = set(domain_values)\n            remaining = set(domain_values)\n            for i, arm in enumerate(parsed_arms):\n                pat = arm['pattern']\n                guard_text = arm['guard_text']\n                # vacuous check\n                if not pattern_is_member_of_domain(pat, domain_kind, domain_values, type_name):\n                    self.emit('vacuous_arm')\n                    continue\n                # matched: the full set of values this pattern (ignoring\n                # any guard) would match, independent of what's already\n                # covered.\n                if pat.kind in (Pat.WILDCARD, Pat.NAME):\n                    matched = set(full_domain)\n                elif pat.kind == Pat.ATOM:\n                    matched = {pat.value} if pat.value in full_domain else set()\n                elif pat.kind == Pat.BOOL:\n                    matched = {pat.value} if pat.value in full_domain else set()\n                else:\n                    matched = set()\n\n                if guard_text is not None:\n                    # An unreadable (non-int) guard credits nothing\n                    # towards coverage, but also can't be shown dead, so\n                    # don't flag unreachable for it either.\n                    continue\n\n                new_coverage = matched & remaining\n                if matched and not new_coverage:\n                    self.emit('unreachable_arm')\n                remaining -= matched\n            if remaining:\n                self.emit('switch_inexhaustive')\n        else:\n            # open domain (atom, term, string, or int without full guard\n            # analysis): only handle int with relational-pattern arms\n            # doing interval subtraction; otherwise assume exhaustive if a\n            # catch-all (wildcard/bare name with no guard, or bare name\n            # with guard) exists, matching the spec's \"open -> catch-all\n            # legal\" rule. Don't guess beyond that.\n            if is_int:\n                self.check_int_switch(f, parsed_arms)\n            else:\n                has_full_catchall = False\n                for arm in parsed_arms:\n                    pat = arm['pattern']\n                    if pat.kind in (Pat.WILDCARD, Pat.NAME) and arm['guard_text'] is None:\n                        has_full_catchall = True\n                # vacuous check doesn't really apply (open type, any shape\n                # could conceivably belong depending on type); skip.\n                if not has_full_catchall:\n                    # can't prove exhaustiveness without enumeration;\n                    # since domain is open we can't say inexhaustive\n                    # either without more info. Be conservative: don't\n                    # flag.\n                    pass\n\n    def check_int_switch(self, f, parsed_arms):\n        remaining = [(float('-inf'), float('inf'))]\n\n        def subtract(intervals, iv):\n            lo, hi = iv\n            out = []\n            for a, b in intervals:\n                if hi < a or lo > b:\n                    out.append((a, b))\n                    continue\n                if lo > a:\n                    out.append((a, lo - 1))\n                if hi < b:\n                    out.append((hi + 1, b))\n            return out\n\n        def intersect_nonempty(intervals, iv):\n            lo, hi = iv\n            for a, b in intervals:\n                nlo, nhi = max(a, lo), min(b, hi)\n                if nlo <= nhi:\n                    return True\n            return False\n\n        for arm in parsed_arms:\n            pat = arm['pattern']\n            guard_text = arm['guard_text']\n            varname = None\n            if pat.kind == Pat.NAME:\n                varname = pat.value\n            if pat.kind == Pat.REL:\n                op, num = pat.value\n                iv = interval_from_atoms([(op, num)], 'and')[0]\n            elif pat.kind in (Pat.WILDCARD, Pat.NAME):\n                if guard_text is not None and varname is not None:\n                    ivs = guard_readable_interval(guard_text, varname)\n                    if ivs is None:\n                        # unreadable guard: credits nothing\n                        continue\n                    if guard_is_unsatisfiable(guard_text, varname):\n                        self.emit('unsatisfiable_arm_guard')\n                        continue\n                    covered_any = False\n                    for iv in ivs:\n                        if intersect_nonempty(remaining, iv):\n                            covered_any = True\n                            remaining = subtract(remaining, iv)\n                    if not covered_any:\n                        self.emit('unreachable_arm')\n                    continue\n                else:\n                    iv = (float('-inf'), float('inf'))\n            elif pat.kind == Pat.INT:\n                iv = (pat.value, pat.value)\n            else:\n                continue\n\n            if guard_text is not None and pat.kind not in (Pat.WILDCARD, Pat.NAME):\n                # e.g. relational pattern with an extra guard: rare; skip\n                pass\n\n            if not intersect_nonempty(remaining, iv):\n                self.emit('unreachable_arm')\n            else:\n                remaining = subtract(remaining, iv)\n\n        if remaining:\n            self.emit('switch_inexhaustive')\n\n    def check_tuple_switch(self, f, type_names, parsed_arms):\n        domains = []\n        all_closed = True\n        for tn in type_names:\n            kind, vals = resolve_type_domain(tn, self.types)\n            if kind != 'closed':\n                all_closed = False\n                break\n            domains.append(vals)\n        if not all_closed:\n            return  # open somewhere: don't guess\n        all_combos = set(itertools.product(*domains))\n        remaining = set(all_combos)\n\n        def pattern_matches_combo(pat_tuple_values, combo):\n            for p, v in zip(pat_tuple_values, combo):\n                if p.kind in (Pat.WILDCARD, Pat.NAME):\n                    continue\n                elif p.kind == Pat.ATOM:\n                    if p.value != v:\n                        return False\n                elif p.kind == Pat.BOOL:\n                    if p.value != v:\n                        return False\n                else:\n                    return False\n            return True\n\n        for arm in parsed_arms:\n            pat = arm['pattern']\n            guard_text = arm['guard_text']\n            if pat.kind == Pat.WILDCARD or pat.kind == Pat.NAME:\n                sub_pats = [Pat(Pat.WILDCARD)] * len(type_names)\n            elif pat.kind == Pat.TUPLE:\n                sub_pats = pat.value\n                if len(sub_pats) != len(type_names):\n                    self.emit('vacuous_arm')\n                    continue\n            else:\n                self.emit('vacuous_arm')\n                continue\n\n            matched = {c for c in all_combos if pattern_matches_combo(sub_pats, c)}\n            if guard_text is not None:\n                matched = set()  # unreadable/guarded: credit nothing\n            new_matches = matched & remaining\n            if matched and not new_matches:\n                self.emit('unreachable_arm')\n            remaining -= matched\n\n        if remaining:\n            self.emit('switch_inexhaustive')\n\n    # ---- expression checks: unbound_variable, return_not_declared,\n    # arg_not_accepted ----\n\n    def check_value_expr(self, f, expr, bound_names, local_types):\n        # unbound_variable: find bare identifiers used (not atom literals,\n        # not keywords, not function names, not numbers) and check binding\n        self.check_unbound(f, expr, bound_names)\n        self.check_return_type(f, expr)\n        self.check_calls(f, expr, bound_names, local_types)\n\n    def check_unbound(self, f, expr, bound_names):\n        # collect identifiers not immediately preceded by ':' and not\n        # followed by '(' (those are calls, checked separately) and not\n        # function names.\n        for m in re.finditer(r'(?<!:)\\b([A-Za-z_]\\w*)\\b', expr):\n            name = m.group(1)\n            start = m.start()\n            if start > 0 and expr[start - 1] == ':':\n                continue\n            after = expr[m.end():m.end() + 1]\n            if after == '(':\n                continue  # it's a function call name\n            if name in ('true', 'false'):\n                continue\n            if name in self.funcs:\n                continue\n            if name in bound_names:\n                continue\n            self.emit('unbound_variable')\n\n    def check_return_type(self, f, expr):\n        expr = expr.strip()\n        ret_t = f.ret_type\n        # only handle the case where expr is a simple literal (atom, int,\n        # bool) directly returned by the arm -- more complex expressions\n        # (calls, names) we don't try to type-check defensively.\n        if re.match(r'^:[A-Za-z_]\\w*$', expr):\n            if ret_t not in ('atom', 'term') and ret_t not in self.types:\n                self.emit('return_not_declared')\n            elif ret_t in self.types:\n                if expr not in self.types[ret_t]:\n                    self.emit('return_not_declared')\n            return\n        if re.match(r'^-?\\d+$', expr):\n            if ret_t not in ('int', 'term'):\n                self.emit('return_not_declared')\n            return\n        if expr in ('true', 'false'):\n            if ret_t not in ('bool', 'term'):\n                self.emit('return_not_declared')\n            return\n        # calls / names / other expressions: skip (would require full type\n        # inference we can't do safely without guessing).\n\n    def check_calls(self, f, expr, bound_names, local_types):\n        # find calls Name(args) where Name is a known function; check each\n        # argument's inferred type against callee's declared param type.\n        for m in re.finditer(r'\\b([A-Za-z_]\\w*)\\s*\\(', expr):\n            name = m.group(1)\n            if name not in self.funcs:\n                continue\n            open_idx = m.end() - 1\n            close_idx = matching_paren(expr, open_idx)\n            if close_idx == -1:\n                continue\n            args_str = expr[open_idx + 1:close_idx]\n            args = [a.strip() for a in depth_aware_split(args_str, ',') if a.strip() != '']\n            callee = self.funcs[name]\n            for i, arg in enumerate(args):\n                if i >= len(callee.params):\n                    continue\n                ptype, pname = callee.params[i]\n                arg_type = self.infer_expr_type(f, arg, local_types)\n                if arg_type is None:\n                    continue\n                if not self.type_compatible(arg_type, ptype):\n                    self.emit('arg_not_accepted')\n\n    def infer_expr_type(self, f, expr, local_types):\n        expr = expr.strip()\n        if re.match(r'^:[A-Za-z_]\\w*$', expr):\n            return 'atom'\n        if re.match(r'^-?\\d+$', expr):\n            return 'int'\n        if expr in ('true', 'false'):\n            return 'bool'\n        if re.match(r'^[A-Za-z_]\\w*$', expr):\n            return local_types.get(expr)\n        return None\n\n    def type_compatible(self, arg_type, param_type):\n        if arg_type == param_type:\n            return True\n        if param_type == 'term':\n            return True\n        if param_type in self.types:\n            # closed atom-union: an 'atom' typed value can't be verified\n            # further, but a plain 'atom' arg is compatible only if it's a\n            # literal member (checked elsewhere); treat generically\n            # compatible if arg_type == 'atom'\n            return arg_type == 'atom'\n        return False\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.exit(0)\n    path = sys.argv[1]\n    with open(path) as fh:\n        text = fh.read()\n    types = parse_types(text)\n    funcs = parse_functions(text)\n    checker = Checker(types, funcs)\n    checker.run()\n    for tag in TAGS:\n        if tag in checker.diagnostics:\n            print(tag)\n\n\nif __name__ == '__main__':\n    main()","lineStart":1,"lineEnd":889,"totalLines":889,"truncated":false}},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-sonnet5/switchcheck.py","time":{"start":1788993905618,"end":1788993905636}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_088589fd2001d1dgVPFBD6f6Bm","sessionID":"ses_f77a782a6ffe8fH6ZzELpGeegI","messageID":"msg_088589724001Wnunt9NBzcE0ST"}}
