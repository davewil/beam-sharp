/Scopes/in.bs\ncases/c12-vacuous-arm/Scored/in.bs\ncases/c13-unsatisfiable-guard/Graded/in.bs\ncases\ncases/c13-unsatisfiable-guard\ncases/c13-unsatisfiable-guard/Graded\ncases/c01-exhaustive-closed\ncases/c01-exhaustive-closed/Verdict\ncases/c11-unbound-variable\ncases/c11-unbound-variable/Scopes\ncases/c05-tuple-exhaustive\ncases/c05-tuple-exhaustive/Decide\ncases/c09-arg-not-accepted\ncases/c09-arg-not-accepted/Calls\ncases/c06-tuple-inexhaustive\ncases/c06-tuple-inexhaustive/Partial\ncases/c10-switch-in-guard\ncases/c10-switch-in-guard/Guarded\ncases/c08-wrong-return\ncases/c08-wrong-return/Wrong\ncases/c04-unreachable\ncases/c04-unreachable/Shadowed\ncases/c07-guarded\ncases/c07-guarded/Retry\ncases/c02-catchall-open\ncases/c02-catchall-open/Open\ncases/c03-inexhaustive\ncases/c03-inexhaustive/Missing\ncases/c12-vacuous-arm\ncases/c12-vacuous-arm/Scored\n","exit":0,"truncated":false},"title":"find cases -type f | sort; find cases -type d","time":{"start":1788993490807,"end":1788993490814}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_088524df100180Ji8Rnpv6Gps7","sessionID":"ses_f77ade3feffeYe56P6hqdU6Mjz","messageID":"msg_088524859001N8mvg536SmQjPE"}}
