{"type":"tool_use","timestamp":1788993624253,"sessionID":"ses_f77ade3dcffeRFa5D7H8svAwTg","part":{"type":"tool","tool":"write","callID":"toolu_01Gj4m6k1m2YHYrQ13FhMgoL","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"\nExhaustiveness checker for switch statements.\n\"\"\"\n\nimport sys\nimport re\nfrom dataclasses import dataclass\nfrom typing import Dict, List, Set, Tuple, Optional, Union\n\n\n@dataclass\nclass Type:\n    \"\"\"Type information.\"\"\"\n    name: str\n    is_closed: bool  # True if enumerated, False if unbounded\n    cases: Optional[Set[str]] = None  # For closed types\n\n\nclass Checker:\n    def __init__(self, source: str):\n        self.source = source\n        self.lines = source.split('\\n')\n        self.errors: Set[str] = set()\n        \n        # Parse type definitions and function signatures\n        self.types: Dict[str, Type] = self._init_types()\n        self.functions: Dict[str, Tuple[List[str], str]] = {}  # name -> (param_types, return_type)\n        self.function_bodies: Dict[str, List[str]] = {}  # name -> lines of body\n        \n        self._parse_definitions()\n    \n    def _init_types(self) -> Dict[str, Type]:\n        \"\"\"Initialize built-in and user-defined types.\"\"\"\n        return {\n            'atom': Type('atom', False),\n            'int': Type('int', False),\n            'term': Type('term', False),\n            'bool': Type('bool', True, {':true', ':false'}),  # bool might be treated as atom\n        }\n    \n    def _parse_definitions(self):\n        \"\"\"Parse type and function definitions.\"\"\"\n        i = 0\n        while i < len(self.lines):\n            line = self.lines[i].strip()\n            \n            if line.startswith('type '):\n                self._parse_type(line)\n            elif line.startswith('public '):\n                self._parse_function(line)\n            \n            i += 1\n    \n    def _parse_type(self, line: str):\n        \"\"\"Parse: type Name = :case1 | :case2\"\"\"\n        match = re.match(r'type\\s+(\\w+)\\s*=\\s*(.*)', line)\n        if match:\n            type_name = match.group(1)\n            cases_str = match.group(2)\n            \n            cases = set()\n            for case in cases_str.split('|'):\n                case = case.strip()\n                if case.startswith(':'):\n                    cases.add(case)\n            \n            self.types[type_name] = Type(type_name, True, cases)\n    \n    def _parse_function(self, line: str):\n        \"\"\"Parse: public ReturnType Name(ParamType p1, ...)\"\"\"\n        match = re.match(r'public\\s+(\\w+)\\s+(\\w+)\\s*\\((.*?)\\)', line)\n        if match:\n            return_type = match.group(1)\n            func_name = match.group(2)\n            params_str = match.group(3)\n            \n            param_types = []\n            if params_str.strip():\n                for param in params_str.split(','):\n                    parts = param.strip().split()\n                    if parts:\n                        param_types.append(parts[0])\n            \n            self.functions[func_name] = (param_types, return_type)\n    \n    def check(self) -> List[str]:\n        \"\"\"Analyze and return error tags.\"\"\"\n        self._check_switches()\n        self._check_guards()\n        self._check_variables()\n        self._check_returns()\n        self._check_args()\n        \n        return sorted(self.errors)\n    \n    def _check_switches(self):\n        \"\"\"Check switch statements for exhaustiveness and arm validity.\"\"\"\n        for i, line in enumerate(self.lines):\n            if 'switch {' in line:\n                self._analyze_switch(line, i)\n    \n    def _analyze_switch(self, line: str, line_idx: int):\n        \"\"\"Analyze a single switch statement.\"\"\"\n        # Extract subject type and arms\n        \n        # Find subject: pattern before \"switch\"\n        before_switch = line[:line.find('switch')].strip()\n        \n        # Remove \"-> \" prefix\n        if ' -> ' in before_switch:\n            before_switch = before_switch.split(' -> ')[-1]\n        \n        # Get last identifier as subject\n        subject = re.findall(r'\\b(\\w+)\\b', before_switch)[-1] if before_switch else ''\n        \n        # Determine subject type\n        subject_type = self._infer_subject_type(subject, line)\n        \n        # Extract arms\n        arms = self._extract_arms(line, line_idx)\n        \n        if not subject_type or not arms:\n            return\n        \n        # Analyze arms\n        self._check_arm_exhaustiveness(arms, subject_type)\n        self._check_arm_reachability(arms, subject_type)\n        self._check_arm_patterns(arms, subject_type)\n    \n    def _infer_subject_type(self, subject: str, line: str) -> Optional[Type]:\n        \"\"\"Infer type of subject variable.\"\"\"\n        # Try to find type in function signature\n        for func_name, (param_types, _) in self.functions.items():\n            # Look for function clause with this subject\n            for fline in self.lines:\n                if f'{func_name}' in fline and subject in fline:\n                    # Extract type from clause pattern\n                    # This is a simplified heuristic\n                    pass\n        \n        # Check for explicit type casts or patterns\n        if '(' in line and ':' in line:\n            # Might be a tuple of atoms\n            pass\n        \n        return None\n    \n    def _extract_arms(self, line: str, line_idx: int) -> List[Tuple[str, str]]:\n        \"\"\"Extract arm patterns and bodies from switch.\"\"\"\n        arms = []\n        \n        # Simple parsing: look for => separators\n        if '=>' in line:\n            # Extract all arms from this line\n            # Format: pattern => body, pattern => body, ...\n            \n            # Find all => occurrences\n            current_pos = 0\n            arm_num = 0\n            \n            while True:\n                arrow_pos = line.find('=>', current_pos)\n                if arrow_pos == -1:\n                    break\n                \n                # Extract pattern (from previous comma or start)\n                comma_pos = line.rfind(',', 0, arrow_pos)\n                if comma_pos == -1:\n                    pattern_start = line.rfind('{', 0, arrow_pos) + 1\n                else:\n                    pattern_start = comma_pos + 1\n                \n                pattern = line[pattern_start:arrow_pos].strip()\n                \n                # Extract body (until next comma or closing brace)\n                body_start = arrow_pos + 2\n                comma_pos = line.find(',', body_start)\n                close_pos = line.find('}', body_start)\n                \n                if comma_pos == -1:\n                    body_end = close_pos\n                elif close_pos == -1:\n                    body_end = comma_pos\n                else:\n                    body_end = min(comma_pos, close_pos)\n                \n                body = line[body_start:body_end].strip()\n                \n                arms.append((pattern, body))\n                arm_num += 1\n                current_pos = body_end\n        \n        return arms\n    \n    def _check_arm_exhaustiveness(self, arms: List[Tuple[str, str]], subject_type: Type):\n        \"\"\"Check if arms cover all cases of subject type.\"\"\"\n        if not subject_type.is_closed:\n            # Open type: check for catch-all\n            patterns = [p for p, _ in arms]\n            if not any('_' in p for p in patterns):\n                self.errors.add('switch_inexhaustive')\n            return\n        \n        # Closed type: check for full coverage\n        if not subject_type.cases:\n            return\n        \n        covered = set()\n        for pattern, _ in arms:\n            # Extract literals from pattern\n            literals = re.findall(r':(\\w+)', pattern)\n            for lit in literals:\n                covered.add(f':{lit}')\n            \n            # Also check for direct patterns\n            if pattern.startswith(':'):\n                covered.add(pattern)\n        \n        if not subject_type.cases.issubset(covered):\n            self.errors.add('switch_inexhaustive')\n    \n    def _check_arm_reachability(self, arms: List[Tuple[str, str]], subject_type: Type):\n        \"\"\"Check for unreachable and vacuous arms.\"\"\"\n        seen_patterns = set()\n        \n        for i, (pattern, _) in enumerate(arms):\n            pattern = pattern.strip()\n            \n            # Extract main pattern\n            if pattern.startswith('('):\n                # Tuple pattern\n                pass\n            elif pattern.startswith(':'):\n                # Literal pattern\n                if pattern in seen_patterns:\n                    self.errors.add('unreachable_arm')\n                seen_patterns.add(pattern)\n            elif pattern == '_':\n                # Wildcard\n                if seen_patterns:\n                    self.errors.add('unreachable_arm')\n            else:\n                # Check if it's a name pattern\n                if subject_type.is_closed and subject_type.cases:\n                    # A name pattern against a closed type is always vacuous or covered\n                    pass\n    \n    def _check_arm_patterns(self, arms: List[Tuple[str, str]], subject_type: Type):\n        \"\"\"Check if patterns are valid for the type.\"\"\"\n        if not subject_type.is_closed or not subject_type.cases:\n            return\n        \n        for i, (pattern, _) in enumerate(arms):\n            # Check for vacuous patterns\n            # e.g., (:pass, n) when subject type is :pass | :fail\n            \n            if pattern.startswith('('):\n                # Tuple pattern - check if it matches the type\n                # If type is not a tuple type, it's vacuous\n                if subject_type.cases and all(not c.startswith('(') for c in subject_type.cases):\n                    self.errors.add('vacuous_arm')\n    \n    def _check_guards(self):\n        \"\"\"Check for switches in guards and unsatisfiable guards.\"\"\"\n        for i, line in enumerate(self.lines):\n            # Switch in guard\n            if ' when ' in line and 'switch' in line:\n                when_idx = line.find(' when ')\n                switch_idx = line.find('switch')\n                if switch_idx > when_idx:\n                    self.errors.add('switch_in_guard')\n            \n            # Unsatisfiable guard\n            if ' when ' in line and 'switch {' not in line:\n                guard = line.split(' when ')[-1].split('=>')[0]\n                if self._is_unsatisfiable_guard(guard):\n                    self.errors.add('unsatisfiable_arm_guard')\n    \n    def _is_unsatisfiable_guard(self, guard: str) -> bool:\n        \"\"\"Check if a guard is obviously unsatisfiable.\"\"\"\n        # Look for patterns like: x > 5 and x < 3\n        if ' and ' in guard:\n            parts = [p.strip() for p in guard.split(' and ')]\n            # Extract bounds\n            bounds = {}\n            for part in parts:\n                match = re.match(r'(\\w+)\\s*([><]=?)\\s*(\\d+)', part)\n                if match:\n                    var = match.group(1)\n                    op = match.group(2)\n                    val = int(match.group(3))\n                    \n                    if var not in bounds:\n                        bounds[var] = {'<': float('inf'), '<=': float('inf'), '>': float('-inf'), '>=': float('-inf')}\n                    \n                    if op == '<':\n                        bounds[var]['<'] = min(bounds[var]['<'], val)\n                    elif op == '<=':\n                        bounds[var]['<='] = min(bounds[var]['<='], val)\n                    elif op == '>':\n                        bounds[var]['>'] = max(bounds[var]['>'], val)\n                    elif op == '>=':\n                        bounds[var]['>='] = max(bounds[var]['>='], val)\n            \n            # Check for contradictions\n            for var, b in bounds.items():\n                if b['<'] != float('inf') and b['>='] != float('-inf'):\n                    if b['>='] >= b['<']:\n                        return True\n                if b['<='] != float('inf') and b['>'] != float('-inf'):\n                    if b['>'] >= b['<=']:\n                        return True\n        \n        return False\n    \n    def _check_variables(self):\n        \"\"\"Check for rebinding and unbound variables.\"\"\"\n        for i, line in enumerate(self.lines):\n            # Look for switch arms\n            if '=>' in line:\n                self._check_arm_variables(line, i)\n    \n    def _check_arm_variables(self, line: str, line_idx: int):\n        \"\"\"Check variable bindings in an arm.\"\"\"\n        # Extract pattern and body\n        parts = line.split('=>')\n        if len(parts) < 2:\n            return\n        \n        pattern_part = parts[0]\n        body_part = parts[1]\n        \n        # Extract pattern variables\n        pattern_vars = re.findall(r'\\b([a-z_]\\w*)\\b', pattern_part)\n        \n        # Find enclosing function\n        func_name = None\n        for j in range(line_idx, -1, -1):\n            if re.match(r'\\w+\\(', self.lines[j]):\n                match = re.search(r'(\\w+)\\(', self.lines[j])\n                if match:\n                    func_name = match.group(1)\n                    break\n        \n        # Get function parameters\n        func_params = set()\n        if func_name and func_name in self.functions:\n            # Extract param names from function clauses\n            for fline in self.lines:\n                if f'{func_name}(' in fline:\n                    match = re.search(r'\\(([^)]*)\\)', fline)\n                    if match:\n                        param_str = match.group(1)\n                        params = [p.strip().split()[-1] for p in param_str.split(',') if p.strip()]\n                        func_params.update(params)\n        \n        # Check for rebinding\n        for var in pattern_vars:\n            if var in func_params and var != '_':\n                self.errors.add('rebinding')\n        \n        # Check for unbound variables in body\n        body_vars = re.findall(r'\\b([a-z_]\\w*)\\b', body_part)\n        \n        bound_vars = set(pattern_vars) | func_params\n        for var in body_vars:\n            if var not in bound_vars and var not in self.functions:\n                self.errors.add('unbound_variable')\n    \n    def _check_returns(self):\n        \"\"\"Check return type validity.\"\"\"\n        for func_name, (params, ret_type) in self.functions.items():\n            # Find function body and check return values\n            for i, line in enumerate(self.lines):\n                if f'{func_name}(' in line:\n                    # Look at following lines for returns\n                    for j in range(i, min(i + 20, len(self.lines))):\n                        if '=>' in self.lines[j]:\n                            self._check_return_value(self.lines[j], ret_type)\n    \n    def _check_return_value(self, line: str, expected_type: str):\n        \"\"\"Check if returned value matches expected type.\"\"\"\n        # Extract return value\n        parts = line.split('=>')\n        if len(parts) < 2:\n            return\n        \n        body = parts[-1].strip().rstrip(',}').strip()\n        \n        # Infer return type\n        if body.startswith(':'):\n            returned_type = 'atom'\n        elif body.isdigit() or (body.startswith('-') and body[1:].isdigit()):\n            returned_type = 'int'\n        else:\n            return  # Can't infer\n        \n        # Check type compatibility\n        if expected_type not in ['term', returned_type]:\n            self.errors.add('return_not_declared')\n    \n    def _check_args(self):\n        \"\"\"Check function argument validity.\"\"\"\n        for func_name, (params, ret_type) in self.functions.items():\n            # Look for calls to this function\n            for i, line in enumerate(self.lines):\n                if f'{func_name}(' in line and '=>' in line:\n                    self._check_function_call(line, func_name, params)\n    \n    def _check_function_call(self, line: str, func_name: str, expected_params: List[str]):\n        \"\"\"Check if function call arguments match expected types.\"\"\"\n        # Extract function call\n        match = re.search(rf'{func_name}\\s*\\(([^)]*)\\)', line)\n        if not match:\n            return\n        \n        args = match.group(1)\n        arg_list = [a.strip() for a in args.split(',')]\n        \n        # Check each argument\n        for i, arg in enumerate(arg_list):\n            if i < len(expected_params):\n                expected_type = expected_params[i]\n                \n                # Infer argument type\n                if arg.startswith(':'):\n                    arg_type = 'atom'\n                elif arg.isdigit() or (arg.startswith('-') and arg[1:].isdigit()):\n                    arg_type = 'int'\n                else:\n                    # Check if it's a variable with known type\n                    arg_type = self._infer_var_type(arg)\n                \n                if arg_type and expected_type and arg_type != expected_type:\n                    self.errors.add('arg_not_accepted')\n    \n    def _infer_var_type(self, var: str) -> Optional[str]:\n        \"\"\"Infer type of a variable.\"\"\"\n        # Look in function signatures\n        # This is very simplified\n        return None\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"Usage: switchcheck <path-to-.bs-file>\\n\")\n        sys.exit(1)\n    \n    try:\n        with open(sys.argv[1], 'r') as f:\n            source = f.read()\n    except Exception as e:\n        sys.stderr.write(f\"Error: {e}\\n\")\n        sys.exit(1)\n    \n    checker = Checker(source)\n    errors = checker.check()\n    \n    for error in errors:\n        print(error)\n\n\nif __name__ == '__main__':\n    main()\n","filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","exists":true,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","time":{"start":1788993624006,"end":1788993624202}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_08853b676001hfIi8Xhkj5RmNy","sessionID":"ses_f77ade3dcffeRFa5D7H8svAwTg","messageID":"msg_08853b223001dLM1flbfmGv5us"}}
