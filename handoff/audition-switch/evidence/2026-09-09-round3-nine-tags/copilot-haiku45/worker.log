idx: int) -> Tuple[Optional[str], List[str], List[str], str]:\n        \"\"\"Find the function that contains this switch.\"\"\"\n        # Search backwards for a clause head pattern\n        for i in range(switch_line_idx, -1, -1):\n            line = self.lines[i].strip()\n            \n            # Match pattern: FunctionName(params) -> or FunctionName(params) when ...\n            m = re.match(r'^(\\w+)\\s*\\((.*?)\\)(\\s+when\\s+.*)?\\s*->', line)\n            if m:\n                func_name = m.group(1)\n                params_str = m.group(2)\n                \n                # Extract parameter names from clause\n                param_names = [p.strip() for p in params_str.split(',') if p.strip()]\n                \n                # Look up in functions\n                if func_name in self.functions:\n                    param_types, return_type, _ = self.functions[func_name]","lineStart":145,"lineEnd":174,"totalLines":466,"truncated":true}},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","time":{"start":1788994515088,"end":1788994515097}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_08861eed3001I7p3eyfIKX3A2L","sessionID":"ses_f77a0a10bffeFUJZZsTQ59ZTrI","messageID":"msg_08861e4b8001JlDtbq6vGv0XrQ"}}
