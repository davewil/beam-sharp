                    \n                            if arg_type and expected and arg_type != expected:\n                                self.errors.add('arg_not_accepted')\n    \n    def _infer_type_in_context(self, expr: str, line_idx: int, pattern_part: str) -> Optional[str]:\n        \"\"\"Infer type of expression in context of a switch arm.\"\"\"\n        expr = expr.strip()\n        \n        # Literal types\n        if expr.startswith(':'):\n            return 'atom'\n        elif expr.isdigit() or (expr.startswith('-') and expr[1:].isdigit()):\n            return 'int'\n        elif expr in ['true', 'false']:\n            return 'bool'\n        \n        # Variable - try to infer from pattern\n        # For now, if it's a name binding in a numeric pattern, it's an int\n        # This is a simplification; ideally we'd infer from subject type\n        \n        return None","oldString":"    def _check_calls(self):\n        \"\"\"Check function call arguments.\"\"\"\n        for func_name, (param_types, _, _) in self.functions.items():\n            for line in self.lines:\n                if '=>' not in line:\n                    continue\n                \n                m = re.search(rf'{func_name}\\s*\\(([^)]*)\\)', line)\n                if not m:\n                    continue\n                \n                args_str = m.group(1)\n                args = [a.strip() for a in args_str.split(',') if a.strip()]\n                \n                for i, arg in enumerate(args):\n                    if i < len(param_types):\n                        expected = param_types[i]\n                        arg_type = self._infer_type(arg)\n                        \n                        if arg_type and expected and arg_type != expected:\n                            self.errors.add('arg_not_accepted')"},"output":"Edit applied successfully.","metadata":{"diagnostics":{},"diff":"Index: /Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45