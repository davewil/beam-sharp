{"type":"tool_use","timestamp":1788994479637,"sessionID":"ses_f77a0a10bffeFUJZZsTQ59ZTrI","part":{"type":"tool","tool":"write","callID":"toolu_01XTy3wMwad5Nng3wWZpNwUk","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"\nExhaustiveness checker for switch statements in the .bs language.\n\"\"\"\n\nimport sys\nimport re\nfrom typing import Dict, List, Set, Tuple, Optional\n\nclass Checker:\n    def __init__(self, source: str):\n        self.source = source\n        self.lines = source.split('\\n')\n        self.errors: Set[str] = set()\n        \n        # Builtin types: name -> (is_closed, cases_set)\n        self.types: Dict[str, Tuple[bool, Optional[Set[str]]]] = {\n            'atom': (False, None),\n            'int': (False, None),\n            'term': (False, None),\n            'bool': (True, {':true', ':false'}),\n        }\n        \n        # Functions: name -> (param_types, return_type, param_names)\n        self.functions: Dict[str, Tuple[List[str], str, List[str]]] = {}\n        \n        self._parse_types_and_functions()\n        self._check_all_switches()\n    \n    def _parse_types_and_functions(self):\n        \"\"\"Parse type and function declarations.\"\"\"\n        i = 0\n        while i < len(self.lines):\n            line = self.lines[i]\n            stripped = line.strip()\n            \n            # Parse type declarations\n            if stripped.startswith('type '):\n                m = re.match(r'type\\s+(\\w+)\\s*=\\s*(.*)', stripped)\n                if m:\n                    type_name = m.group(1)\n                    cases_str = m.group(2)\n                    cases = set()\n                    for case in cases_str.split('|'):\n                        case = case.strip()\n                        if case.startswith(':'):\n                            cases.add(case)\n                    self.types[type_name] = (True, cases)\n            \n            # Parse function signatures\n            elif stripped.startswith('public '):\n                m = re.match(r'public\\s+(\\w+)\\s+(\\w+)\\s*\\((.*?)\\)', stripped)\n                if m:\n                    return_type = m.group(1)\n                    func_name = m.group(2)\n                    params_str = m.group(3)\n                    \n                    # Parse parameter types and names\n                    param_types = []\n                    param_names = []\n                    for param in params_str.split(','):\n                        param = param.strip()\n                        if param:\n                            parts = param.split()\n                            if len(parts) >= 2:\n                                param_type = parts[0]\n                                param_name = parts[1]\n                                param_types.append(param_type)\n                                param_names.append(param_name)\n                    \n                    self.functions[func_name] = (param_types, return_type, param_names)\n            \n            i += 1\n    \n    def _check_all_switches(self):\n        \"\"\"Find and check all switch statements.\"\"\"\n        i = 0\n        while i < len(self.lines):\n            line = self.lines[i]\n            if 'switch' in line and '{' in line:\n                self._check_switch_at_line(i)\n            i += 1\n    \n    def _check_switch_at_line(self, line_idx: int):\n        \"\"\"Check a switch starting at the given line.\"\"\"\n        line = self.lines[line_idx]\n        \n        # Check for switch in guard (before the ->)\n        if '->' in line:\n            arrow_pos = line.find('->')\n            if 'when' in line[:arrow_pos]:\n                guard_part = line[:arrow_pos]\n                if 'switch' in guard_part:\n                    self.errors.add('switch_in_guard')\n                    return\n        \n        # Find the function this switch belongs to\n        func_name, param_names, param_types, return_type = self._find_enclosing_function(line_idx)\n        if not func_name:\n            return\n        \n        # Extract the subject type from the switch line\n        subject_type_name = self._extract_subject_type(line)\n        is_closed_type, type_cases = self.types.get(subject_type_name, (False, None))\n        \n        # Collect all arms\n        start_idx, end_idx = self._find_switch_bounds(line_idx)\n        arms = self._extract_arms(start_idx, end_idx)\n        \n        if not arms:\n            return\n        \n        # Build variable context: clause parameters\n        var_context = dict(zip(param_names, param_types))\n        \n        # Check each arm\n        seen_literal_patterns = set()\n        \n        for arm_idx, arm in enumerate(arms):\n            pattern_part, guard_part, body_part = arm\n            \n            # Extract base pattern and any guard\n            base_pattern = pattern_part.strip()\n            \n            # 1. Check rebinding: pattern that shadows a clause parameter\n            self._check_rebinding(base_pattern, var_context, param_names)\n            \n            # 2. Check vacuous: pattern impossible for subject type\n            self._check_vacuous(base_pattern, is_closed_type, type_cases, arm_idx + 1)\n            \n            # 3. Check unreachable: duplicate literal pattern\n            if self._is_literal_pattern(base_pattern):\n                if base_pattern in seen_literal_patterns:\n                    self.errors.add('unreachable_arm')\n                else:\n                    seen_literal_patterns.add(base_pattern)\n            \n            # 4. Check unsatisfiable guard\n            if guard_part:\n                self._check_unsatisfiable_guard(guard_part, arm_idx + 1)\n            \n            # 5. Check unbound variables in body\n            # Get variables bound by this arm\n            arm_vars = dict(var_context)\n            self._collect_pattern_variables(base_pattern, arm_vars)\n            self._check_unbound_in_body(body_part, arm_vars, func_name)\n            \n            # 6. Check return type\n            self._check_return_type(body_part, return_type)\n            \n            # 7. Check function calls\n            self._check_function_calls_in_body(body_part, arm_vars)\n        \n        # 8. Check exhaustiveness\n        self._check_exhaustiveness(arms, is_closed_type, type_cases, param_names, var_context)\n    \n    def _find_enclosing_function(self, switch_line_idx: int) -> Tuple[Optional[str], List[str], List[str], str]:\n        \"\"\"Find the function that contains this switch.\"\"\"\n        # Search backwards for a clause head pattern\n        for i in range(switch_line_idx, -1, -1):\n            line = self.lines[i].strip()\n            \n            # Match pattern: FunctionName(params) -> or FunctionName(params) when ...\n            m = re.match(r'^(\\w+)\\s*\\((.*?)\\)(\\s+when\\s+.*)?\\s*->', line)\n            if m:\n                func_name = m.group(1)\n                params_str = m.group(2)\n                \n                # Extract parameter names from clause\n                param_names = [p.strip() for p in params_str.split(',') if p.strip()]\n                \n                # Look up in functions\n                if func_name in self.functions:\n                    param_types, return_type, _ = self.functions[func_name]\n                    return func_name, param_names, param_types, return_type\n        \n        return None, [], [], 'term'\n    \n    def _extract_subject_type(self, switch_line: str) -> str:\n        \"\"\"Extract the type name of the switch subject.\"\"\"\n        # Match: X switch { or (X) switch { or (X, Y) switch {\n        \n        # First try: simple parameter name\n        m = re.search(r'->\\s*(\\w+)\\s+switch\\s*\\{', switch_line)\n        if m:\n            subject = m.group(1)\n            # Look up this variable's type in context\n            # For now, try to infer from nearby type declarations\n            return self._infer_type_from_context(subject)\n        \n        # Try tuple\n        m = re.search(r'->\\s*\\((.*?)\\)\\s+switch\\s*\\{', switch_line)\n        if m:\n            return 'tuple'\n        \n        return 'term'\n    \n    def _infer_type_from_context(self, varname: str) -> str:\n        \"\"\"Try to infer the type of a variable from the context.\"\"\"\n        # For now, default to term\n        return 'term'\n    \n    def _find_switch_bounds(self, start_line: int) -> Tuple[int, int]:\n        \"\"\"Find the start and end line indices of a switch block.\"\"\"\n        start_idx = start_line\n        end_idx = start_line\n        \n        # Count braces to find the closing brace\n        brace_depth = 0\n        found_opening = False\n        \n        for i in range(start_line, len(self.lines)):\n            line = self.lines[i]\n            \n            for char in line:\n                if char == '{':\n                    brace_depth += 1\n                    found_opening = True\n                elif char == '}':\n                    brace_depth -= 1\n                    if found_opening and brace_depth == 0:\n                        end_idx = i\n                        return start_idx, end_idx\n        \n        return start_idx, end_idx\n    \n    def _extract_arms(self, start_line: int, end_line: int) -> List[Tuple[str, str, str]]:\n        \"\"\"Extract switch arms as (pattern, guard, body) tuples.\"\"\"\n        # Collect all lines\n        all_text = '\\n'.join(self.lines[start_line:end_line+1])\n        \n        # Find content between { and }\n        open_pos = all_text.find('{')\n        close_pos = all_text.rfind('}')\n        if open_pos < 0 or close_pos < 0:\n            return []\n        \n        content = all_text[open_pos+1:close_pos]\n        \n        # Split by => to find arms\n        arms = []\n        # Split carefully to preserve the patterns\n        \n        # Use regex to split on => (but not in strings)\n        parts = re.split(r'=>', content)\n        \n        for i in range(len(parts) - 1):\n            # Get pattern from end of current part\n            pattern_text = parts[i].rstrip()\n            # Body from start of next part\n            body_text = parts[i+1].lstrip()\n            \n            # Split pattern and body by comma (body ends at comma)\n            # The body ends at the comma before the next pattern\n            body_lines = body_text.split('\\n')\n            first_line = body_lines[0]\n            \n            # Extract body up to comma\n            comma_pos = first_line.find(',')\n            if comma_pos > 0:\n                body = first_line[:comma_pos].strip()\n            else:\n                body = first_line.strip()\n            \n            # Extract pattern (handle \"pattern when guard\")\n            # Last line(s) of pattern\n            pattern_lines = pattern_text.split('\\n')\n            full_pattern = pattern_lines[-1].strip() if pattern_lines else \"\"\n            \n            # Split pattern and guard\n            guard = \"\"\n            if ' when ' in full_pattern:\n                full_pattern, guard = full_pattern.split(' when ', 1)\n                guard = guard.strip()\n            \n            if full_pattern:\n                arms.append((full_pattern.strip(), guard, body))\n        \n        return arms\n    \n    def _is_literal_pattern(self, pattern: str) -> bool:\n        \"\"\"Check if pattern is a literal (atom, number, etc).\"\"\"\n        # Atom literal\n        if re.match(r'^:\\w+$', pattern):\n            return True\n        # Integer literal\n        if re.match(r'^\\d+$', pattern):\n            return True\n        return False\n    \n    def _check_rebinding(self, pattern: str, var_context: Dict[str, str], clause_params: List[str]):\n        \"\"\"Check if pattern rebinds a clause parameter.\"\"\"\n        # Simple name that matches an existing clause param\n        if re.match(r'^\\w+$', pattern) and pattern != '_':\n            if pattern in var_context:\n                self.errors.add('rebinding')\n    \n    def _check_vacuous(self, pattern: str, is_closed: bool, cases: Optional[Set[str]], arm_num: int):\n        \"\"\"Check if pattern is impossible for the type.\"\"\"\n        # Pattern is vacuous if it's not a member of the type\n        \n        # Only check closed types\n        if not is_closed or cases is None:\n            return\n        \n        # Tuple pattern is vacuous if subject isn't a tuple type\n        if pattern.startswith('('):\n            # Subjects are not tuple types in these examples\n            # Actually, looking at c12: the subject is Verdict = :pass | :fail\n            # And pattern (:pass, n) is vacuous\n            self.errors.add('vacuous_arm')\n            return\n        \n        # Atom literal pattern\n        if re.match(r'^:\\w+', pattern):\n            atom = re.match(r'^(:\\w+)', pattern).group(1)\n            if atom not in cases:\n                self.errors.add('vacuous_arm')\n            return\n    \n    def _check_unsatisfiable_guard(self, guard: str, arm_num: int):\n        \"\"\"Check if guard condition is impossible.\"\"\"\n        # Patterns like: x > 5 and x < 3, etc.\n        \n        # Match \"VAR > NUM and VAR < NUM2\" where NUM >= NUM2\n        m = re.match(r'(\\w+)\\s*>\\s*(\\d+)\\s+and\\s+(\\w+)\\s*<\\s*(\\d+)', guard)\n        if m:\n            var1, num1_str, var2, num2_str = m.groups()\n            if var1 == var2:\n                num1, num2 = int(num1_str), int(num2_str)\n                if num1 >= num2:\n                    self.errors.add('unsatisfiable_arm_guard')\n    \n    def _collect_pattern_variables(self, pattern: str, var_context: Dict[str, str]):\n        \"\"\"Add variables bound by this pattern to the context.\"\"\"\n        # Simple name\n        if re.match(r'^\\w+$', pattern) and pattern != '_':\n            if pattern not in var_context:\n                var_context[pattern] = 'term'\n        \n        # Tuple (a, b, c)\n        m = re.match(r'^\\((.*)\\)$', pattern)\n        if m:\n            parts = [p.strip() for p in m.group(1).split(',')]\n            for part in parts:\n                if re.match(r'^\\w+$', part) and part != '_':\n                    if part not in var_context:\n                        var_context[part] = 'term'\n            return\n        \n        # Compound like (:ok, v)\n        m = re.match(r'^\\(:?\\w+,\\s*(\\w+)\\)', pattern)\n        if m:\n            var = m.group(1)\n            if var not in var_context:\n                var_context[var] = 'term'\n    \n    def _check_unbound_in_body(self, body: str, var_context: Dict[str, str], func_name: str):\n        \"\"\"Check if body uses undefined variables.\"\"\"\n        # Extract identifiers\n        identifiers = set(re.findall(r'\\b([a-zA-Z_]\\w*)\\b', body))\n        \n        for ident in identifiers:\n            # Skip function names\n            if ident == func_name or ident in self.functions:\n                continue\n            \n            # Skip keywords\n            if ident in ('true', 'false'):\n                continue\n            \n            # Check if it's in context\n            if ident not in var_context:\n                self.errors.add('unbound_variable')\n                break\n    \n    def _check_return_type(self, body: str, expected_type: str):\n        \"\"\"Check if body returns the correct type.\"\"\"\n        body = body.strip()\n        \n        # Atom return value\n        if body.startswith(':'):\n            if expected_type not in ('atom', 'term'):\n                self.errors.add('return_not_declared')\n            return\n        \n        # Integer return value\n        if re.match(r'^\\d+$', body):\n            if expected_type not in ('int', 'term'):\n                self.errors.add('return_not_declared')\n            return\n    \n    def _check_function_calls_in_body(self, body: str, var_context: Dict[str, str]):\n        \"\"\"Check function calls in body have correct argument types.\"\"\"\n        # Find calls: FUNC(args)\n        for m in re.finditer(r'(\\w+)\\s*\\(([^)]*)\\)', body):\n            func_name = m.group(1)\n            args_str = m.group(2)\n            \n            if func_name in self.functions:\n                param_types, _, _ = self.functions[func_name]\n                args = [a.strip() for a in args_str.split(',') if a.strip()]\n                \n                # Check each argument type\n                for idx, arg in enumerate(args):\n                    if idx >= len(param_types):\n                        break\n                    \n                    expected_type = param_types[idx]\n                    actual_type = var_context.get(arg, 'term')\n                    \n                    # Check compatibility\n                    if actual_type != expected_type and actual_type != 'term' and expected_type != 'term':\n                        self.errors.add('arg_not_accepted')\n                        return\n    \n    def _check_exhaustiveness(self, arms: List[Tuple[str, str, str]], \n                             is_closed: bool, cases: Optional[Set[str]],\n                             param_names: List[str], var_context: Dict[str, str]):\n        \"\"\"Check if switch is exhaustive.\"\"\"\n        # Only check if subject is closed type\n        if not is_closed or cases is None:\n            return\n        \n        # Check if any arm is a catch-all _\n        has_catchall = any(pattern.strip() == '_' for pattern, _, _ in arms)\n        \n        if has_catchall:\n            # Catch-all only legal on open types\n            self.errors.add('switch_inexhaustive')\n            return\n        \n        # Collect all literal patterns covered\n        covered = set()\n        for pattern, guard, _ in arms:\n            pattern = pattern.strip()\n            if re.match(r'^:\\w+$', pattern):\n                covered.add(pattern)\n        \n        # Check if all cases are covered\n        if covered != cases:\n            self.errors.add('switch_inexhaustive')\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.exit(1)\n    \n    try:\n        with open(sys.argv[1], 'r') as f:\n            source = f.read()\n    except:\n        sys.exit(1)\n    \n    checker = Checker(source)\n    \n    # Output errors\n    for error in sorted(checker.errors):\n        print(error)\n\nif __name__ == '__main__':\n    main()\n","filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","exists":true,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","time":{"start":1788994479429,"end":1788994479611}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_08860b8bc0018MSH6ea0IqFvgm","sessionID":"ses_f77a0a10bffeFUJZZsTQ59ZTrI","messageID":"msg_08860b2d1001YTxiDk719CHiOt"}}
