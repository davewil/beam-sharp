{"type":"tool_use","timestamp":1788993895477,"sessionID":"ses_f77ade3dcffeRFa5D7H8svAwTg","part":{"type":"tool","tool":"write","callID":"toolu_01W9XAUT13Rhd6aLsUtYjZAo","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"\nExhaustiveness checker for switch statements.\n\"\"\"\n\nimport sys\nimport re\nfrom typing import Dict, List, Set, Tuple, Optional, Union\n\n\nclass Checker:\n    def __init__(self, source: str):\n        self.source = source\n        self.lines = source.split('\\n')\n        self.errors: Set[str] = set()\n        \n        # Type registry\n        self.types: Dict[str, Tuple[bool, Optional[Set[str]]]] = {\n            'atom': (False, None),\n            'int': (False, None),\n            'term': (False, None),\n            'bool': (False, None),\n        }\n        \n        # Functions: name -> (param_types, return_type, param_names)\n        self.functions: Dict[str, Tuple[List[str], str, List[str]]] = {}\n        self.function_lines: Dict[str, int] = {}\n        \n        self._parse()\n    \n    def _parse(self):\n        \"\"\"Parse types and functions.\"\"\"\n        i = 0\n        while i < len(self.lines):\n            line = self.lines[i].strip()\n            \n            if line.startswith('type '):\n                self._parse_type(line)\n            elif line.startswith('public '):\n                self._parse_function(line, i)\n            \n            i += 1\n    \n    def _parse_type(self, line: str):\n        \"\"\"Parse type definition.\"\"\"\n        m = re.match(r'type\\s+(\\w+)\\s*=\\s*(.*)', line)\n        if m:\n            type_name = m.group(1)\n            cases_str = m.group(2)\n            \n            cases = set()\n            for case in cases_str.split('|'):\n                case = case.strip()\n                if case and case.startswith(':'):\n                    cases.add(case)\n            \n            self.types[type_name] = (True, cases)\n    \n    def _parse_function(self, line: str, line_idx: int):\n        \"\"\"Parse function signature.\"\"\"\n        m = re.match(r'public\\s+(\\w+)\\s+(\\w+)\\s*\\((.*?)\\)', line)\n        if not m:\n            return\n        \n        return_type = m.group(1)\n        func_name = m.group(2)\n        params_str = m.group(3)\n        \n        param_types = []\n        param_names = []\n        \n        if params_str.strip():\n            parts = params_str.split(',')\n            for part in parts:\n                tokens = part.strip().split()\n                if tokens:\n                    if len(tokens) >= 2:\n                        param_types.append(tokens[0])\n                        param_names.append(tokens[1])\n                    else:\n                        param_types.append(tokens[0])\n        \n        self.functions[func_name] = (param_types, return_type, param_names)\n        self.function_lines[func_name] = line_idx\n    \n    def check(self) -> List[str]:\n        \"\"\"Run all checks.\"\"\"\n        self._check_switches()\n        self._check_guards()\n        self._check_variables()\n        self._check_returns()\n        self._check_calls()\n        \n        return sorted(self.errors)\n    \n    def _check_switches(self):\n        \"\"\"Check switch statements.\"\"\"\n        i = 0\n        while i < len(self.lines):\n            if 'switch {' in self.lines[i]:\n                switch_text = self._collect_switch(i)\n                self._analyze_switch(switch_text, i)\n                i += switch_text.count('\\n')\n            i += 1\n    \n    def _collect_switch(self, start_idx: int) -> str:\n        \"\"\"Collect multi-line switch.\"\"\"\n        lines = [self.lines[start_idx]]\n        i = start_idx + 1\n        brace_depth = lines[0].count('{') - lines[0].count('}')\n        \n        while i < len(self.lines) and brace_depth > 0:\n            lines.append(self.lines[i])\n            brace_depth += self.lines[i].count('{') - self.lines[i].count('}')\n            i += 1\n        \n        return '\\n'.join(lines)\n    \n    def _analyze_switch(self, switch_text: str, line_idx: int):\n        \"\"\"Analyze a switch statement.\"\"\"\n        # Extract subject\n        m = re.search(r'(\\S+)\\s+switch\\s*\\{', switch_text)\n        if not m:\n            return\n        \n        subject = m.group(1)\n        \n        # Get enclosing function\n        func_name = self._find_enclosing_function(line_idx)\n        if not func_name or func_name not in self.functions:\n            return\n        \n        # Determine subject type\n        subject_type = self._infer_subject_type(func_name, subject)\n        if not subject_type:\n            return\n        \n        # Extract arms\n        arms = self._extract_arms(switch_text)\n        if not arms:\n            return\n        \n        # Check guards first\n        for pattern, guard, _ in arms:\n            if guard and self._is_unsatisfiable(guard):\n                self.errors.add('unsatisfiable_arm_guard')\n        \n        # Analyze each arm for validity and reachability\n        seen_patterns: Set[str] = set()\n        \n        for pattern, guard, body in arms:\n            # Check for vacuous pattern\n            if self._is_vacuous(pattern, subject_type):\n                self.errors.add('vacuous_arm')\n                continue\n            \n            # Extract patterns this arm covers\n            patterns = self._extract_patterns(pattern)\n            \n            # Check for unreachable (only if previous arms were not guards)\n            # An arm is unreachable only if it's fully covered by previous reachable arms\n            if patterns and patterns <= seen_patterns:\n                # Only report unreachable if we haven't seen unsatisfiable guards\n                # (unsatisfiable guards don't contribute to coverage)\n                self.errors.add('unreachable_arm')\n                continue\n            \n            seen_patterns.update(patterns)\n        \n        # Check exhaustiveness\n        is_closed, cases = subject_type\n        if is_closed and cases:\n            # Check if all cases covered\n            all_patterns = set()\n            for pattern, guard, _ in arms:\n                # Only count arms with satisfiable guards\n                if guard and self._is_unsatisfiable(guard):\n                    continue\n                all_patterns.update(self._extract_patterns(pattern))\n            \n            all_patterns.discard('_')\n            \n            if not cases.issubset(all_patterns):\n                self.errors.add('switch_inexhaustive')\n    \n    def _find_enclosing_function(self, line_idx: int) -> Optional[str]:\n        \"\"\"Find function containing line_idx.\"\"\"\n        best_func = None\n        best_line = -1\n        \n        for func_name, func_line in self.function_lines.items():\n            if func_line < line_idx and func_line > best_line:\n                best_func = func_name\n                best_line = func_line\n        \n        return best_func\n    \n    def _infer_subject_type(self, func_name: str, subject: str) -> Optional[Tuple[bool, Optional[Set[str]]]]:\n        \"\"\"Infer type of subject variable/expression.\"\"\"\n        if func_name not in self.functions:\n            return None\n        \n        param_types, _, param_names = self.functions[func_name]\n        \n        # Case 1: subject is a single parameter\n        if subject in param_names:\n            idx = param_names.index(subject)\n            if idx < len(param_types):\n                param_type = param_types[idx]\n                return self.types.get(param_type, (False, None))\n        \n        # Case 2: subject is a tuple expression like (o, p)\n        if subject.startswith('(') and subject.endswith(')'):\n            # Extract variables\n            inner = subject[1:-1]\n            vars = [v.strip() for v in inner.split(',')]\n            \n            # Get types of each variable\n            var_types = []\n            for var in vars:\n                if var in param_names:\n                    idx = param_names.index(var)\n                    if idx < len(param_types):\n                        var_types.append(param_types[idx])\n            \n            if len(var_types) == len(vars):\n                # All vars found, create tuple type\n                # Generate all combinations\n                # For now, return (True, combinations)\n                combinations = self._generate_tuple_combinations(var_types)\n                if combinations:\n                    return (True, combinations)\n        \n        return None\n    \n    def _generate_tuple_combinations(self, types: List[str]) -> Optional[Set[str]]:\n        \"\"\"Generate all tuples combinations for given types.\"\"\"\n        # For bool types, generate all (bool, bool) combinations\n        if all(t == 'bool' for t in types):\n            n = len(types)\n            if n == 2:\n                return {\n                    '(true,true)',\n                    '(true,false)',\n                    '(false,true)',\n                    '(false,false)',\n                }\n            elif n == 3:\n                return {\n                    '(true,true,true)',\n                    '(true,true,false)',\n                    '(true,false,true)',\n                    '(true,false,false)',\n                    '(false,true,true)',\n                    '(false,true,false)',\n                    '(false,false,true)',\n                    '(false,false,false)',\n                }\n        \n        return None\n    \n    def _extract_arms(self, switch_text: str) -> List[Tuple[str, Optional[str], str]]:\n        \"\"\"Extract arms from switch.\"\"\"\n        arms = []\n        \n        pos = 0\n        while True:\n            arrow = switch_text.find('=>', pos)\n            if arrow == -1:\n                break\n            \n            # Find pattern start\n            pattern_start = switch_text.rfind(',', 0, arrow)\n            if pattern_start == -1:\n                pattern_start = switch_text.find('{', 0, arrow) + 1\n            else:\n                pattern_start += 1\n            \n            pattern_str = switch_text[pattern_start:arrow].strip()\n            \n            # Split guard\n            guard = None\n            if ' when ' in pattern_str:\n                pattern_str, guard = pattern_str.split(' when ', 1)\n                pattern_str = pattern_str.strip()\n                guard = guard.strip()\n            \n            # Find body end\n            body_start = arrow + 2\n            body_end = len(switch_text)\n            \n            for end_char in [',', '}']:\n                idx = switch_text.find(end_char, body_start)\n                if idx != -1:\n                    body_end = min(body_end, idx)\n            \n            body = switch_text[body_start:body_end].strip()\n            \n            arms.append((pattern_str, guard, body))\n            pos = body_end + 1\n        \n        return arms\n    \n    def _extract_patterns(self, pattern: str) -> Set[str]:\n        \"\"\"Extract literal patterns from pattern string.\"\"\"\n        patterns = set()\n        \n        pattern = pattern.strip()\n        \n        # Wildcard\n        if pattern == '_':\n            patterns.add('_')\n            return patterns\n        \n        # Tuple pattern\n        if pattern.startswith('(') and pattern.endswith(')'):\n            # Normalize for comparison\n            patterns.add(self._normalize_tuple(pattern))\n        elif ':' in pattern:\n            # Atom patterns\n            for m in re.finditer(r':\\w+', pattern):\n                patterns.add(m.group())\n        else:\n            # Name binding treats as wildcard\n            patterns.add('_')\n        \n        return patterns\n    \n    def _normalize_tuple(self, tup: str) -> str:\n        \"\"\"Normalize tuple pattern for comparison.\"\"\"\n        # (true,  _) -> (true,_)\n        inner = tup[1:-1]\n        parts = [p.strip() for p in inner.split(',')]\n        return '(' + ','.join(parts) + ')'\n    \n    def _is_vacuous(self, pattern: str, subject_type: Tuple[bool, Optional[Set[str]]]) -> bool:\n        \"\"\"Check if pattern is not in subject type.\"\"\"\n        is_closed, cases = subject_type\n        \n        if not is_closed or not cases:\n            return False\n        \n        # Check if pattern is a tuple when type expects atoms\n        if pattern.startswith('('):\n            # Tuple pattern\n            if cases and all(not c.startswith('(') for c in cases):\n                return True\n        else:\n            # Check if atoms are in type\n            for m in re.finditer(r':(\\w+)', pattern):\n                atom = m.group()\n                if atom not in cases:\n                    return True\n        \n        return False\n    \n    def _is_unsatisfiable(self, guard: str) -> bool:\n        \"\"\"Check if guard is unsatisfiable.\"\"\"\n        if ' and ' not in guard:\n            return False\n        \n        parts = [p.strip() for p in guard.split(' and ')]\n        \n        # Look for contradictions like x > 5 and x < 3\n        bounds = {}\n        for part in parts:\n            m = re.match(r'(\\w+)\\s*([><]=?)\\s*(-?\\d+)', part)\n            if m:\n                var = m.group(1)\n                op = m.group(2)\n                val = int(m.group(3))\n                \n                if var not in bounds:\n                    bounds[var] = {'lo': None, 'hi': None}\n                \n                if op == '>':\n                    if bounds[var]['lo'] is None or val > bounds[var]['lo']:\n                        bounds[var]['lo'] = val\n                elif op == '>=':\n                    if bounds[var]['lo'] is None or val > bounds[var]['lo']:\n                        bounds[var]['lo'] = val - 1\n                elif op == '<':\n                    if bounds[var]['hi'] is None or val < bounds[var]['hi']:\n                        bounds[var]['hi'] = val\n                elif op == '<=':\n                    if bounds[var]['hi'] is None or val < bounds[var]['hi']:\n                        bounds[var]['hi'] = val + 1\n        \n        # Check for contradictions\n        for var, b in bounds.items():\n            if b['lo'] is not None and b['hi'] is not None:\n                if b['lo'] >= b['hi']:\n                    return True\n        \n        return False\n    \n    def _check_guards(self):\n        \"\"\"Check for switches in guards.\"\"\"\n        for line in self.lines:\n            if ' when ' in line:\n                when_idx = line.find(' when ')\n                switch_idx = line.find('switch', when_idx)\n                if switch_idx != -1:\n                    self.errors.add('switch_in_guard')\n    \n    def _check_variables(self):\n        \"\"\"Check variable binding and scoping.\"\"\"\n        for i, line in enumerate(self.lines):\n            if '=>' in line:\n                self._check_arm_vars(line, i)\n    \n    def _check_arm_vars(self, line: str, line_idx: int):\n        \"\"\"Check variables in an arm.\"\"\"\n        # Don't check guards (those aren't arm bodies)\n        if ' when ' in line:\n            before_when = line.split(' when ')[0]\n            if '=>' not in before_when:\n                # This is a clause guard, not an arm\n                return\n        \n        # Find enclosing function\n        func_name = self._find_enclosing_function(line_idx)\n        if not func_name or func_name not in self.functions:\n            return\n        \n        _, _, param_names = self.functions[func_name]\n        param_set = set(param_names)\n        \n        # Extract pattern and body\n        parts = line.split('=>')\n        if len(parts) < 2:\n            return\n        \n        pattern_part = parts[0]\n        body_part = parts[1]\n        \n        # Extract pattern variables\n        pattern_vars = self._extract_vars_from_pattern(pattern_part)\n        \n        # Check for rebinding\n        for var in pattern_vars:\n            if var in param_set:\n                self.errors.add('rebinding')\n        \n        # Arm-bound variables\n        arm_bound = pattern_vars | param_set\n        \n        # Check body for undefined variables\n        body_vars = self._extract_vars(body_part)\n        for var in body_vars:\n            if var not in arm_bound and var not in self.functions:\n                self.errors.add('unbound_variable')\n    \n    def _extract_vars_from_pattern(self, pattern_str: str) -> Set[str]:\n        \"\"\"Extract variables bound in pattern.\"\"\"\n        # Remove guard\n        if ' when ' in pattern_str:\n            pattern_str = pattern_str.split(' when ')[0].strip()\n        \n        vars = set()\n        for m in re.finditer(r'\\b([a-z_]\\w*)\\b', pattern_str):\n            var = m.group(1)\n            start = m.start()\n            # Skip atom names\n            if start > 0 and pattern_str[start-1] == ':':\n                continue\n            if var not in ['when', 'and', 'or', 'true', 'false']:\n                vars.add(var)\n        \n        return vars\n    \n    def _extract_vars(self, code_str: str) -> Set[str]:\n        \"\"\"Extract variables from code.\"\"\"\n        vars = set()\n        for m in re.finditer(r'\\b([a-z_]\\w*)\\b', code_str):\n            var = m.group(1)\n            start = m.start()\n            if start > 0 and code_str[start-1] == ':':\n                continue\n            if var not in ['when', 'and', 'or', 'true', 'false']:\n                vars.add(var)\n        return vars\n    \n    def _check_returns(self):\n        \"\"\"Check return type validity.\"\"\"\n        for func_name, (_, return_type, _) in self.functions.items():\n            func_start = self.function_lines.get(func_name, -1)\n            if func_start < 0:\n                continue\n            \n            # Check arms in this function\n            for i in range(func_start, len(self.lines)):\n                if i > func_start and self.lines[i].strip().startswith('public '):\n                    break\n                \n                if '=>' in self.lines[i]:\n                    self._check_return_value(self.lines[i], return_type)\n    \n    def _check_return_value(self, line: str, expected_type: str):\n        \"\"\"Check if return value matches expected type.\"\"\"\n        parts = line.split('=>')\n        if len(parts) < 2:\n            return\n        \n        body = parts[-1].strip().rstrip(',}').strip()\n        \n        # Infer type\n        if body.startswith(':'):\n            ret_type = 'atom'\n        elif body.isdigit() or (body.startswith('-') and body[1:].isdigit()):\n            ret_type = 'int'\n        else:\n            return\n        \n        if expected_type not in ['term', ret_type] and expected_type != ret_type:\n            self.errors.add('return_not_declared')\n    \n    def _check_calls(self):\n        \"\"\"Check function call arguments.\"\"\"\n        for func_name, (param_types, _, _) in self.functions.items():\n            for line in self.lines:\n                if '=>' not in line:\n                    continue\n                \n                m = re.search(rf'{func_name}\\s*\\(([^)]*)\\)', line)\n                if not m:\n                    continue\n                \n                args_str = m.group(1)\n                args = [a.strip() for a in args_str.split(',') if a.strip()]\n                \n                for i, arg in enumerate(args):\n                    if i < len(param_types):\n                        expected = param_types[i]\n                        arg_type = self._infer_type(arg)\n                        \n                        if arg_type and expected and arg_type != expected:\n                            self.errors.add('arg_not_accepted')\n    \n    def _infer_type(self, expr: str) -> Optional[str]:\n        \"\"\"Infer type of expression.\"\"\"\n        expr = expr.strip()\n        \n        if expr.startswith(':'):\n            return 'atom'\n        elif expr.isdigit() or (expr.startswith('-') and expr[1:].isdigit()):\n            return 'int'\n        elif expr in ['true', 'false']:\n            return 'bool'\n        \n        return None\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"Usage: switchcheck <file.bs>\\n\")\n        sys.exit(1)\n    \n    try:\n        with open(sys.argv[1], 'r') as f:\n            source = f.read()\n    except Exception as e:\n        sys.stderr.write(f\"Error: {e}\\n\")\n        sys.exit(1)\n    \n    checker = Checker(source)\n    errors = checker.check()\n    \n    for error in errors:\n        print(error)\n\n\nif __name__ == '__main__':\n    main()\n","filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","exists":true,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","time":{"start":1788993895187,"end":1788993895422}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_08857c510001zCXnV9kROH6SmM","sessionID":"ses_f77ade3dcffeRFa5D7H8svAwTg","messageID":"msg_08857be81001AqKtBsez8HzmpM"}}
