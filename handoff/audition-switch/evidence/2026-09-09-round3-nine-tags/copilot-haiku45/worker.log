{"type":"tool_use","timestamp":1788993576335,"sessionID":"ses_f77ade3dcffeRFa5D7H8svAwTg","part":{"type":"tool","tool":"write","callID":"toolu_01Bh2qWcC21eYXovVEEUBhev","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"\nExhaustiveness checker for switch statements.\nImplements the specification from PACKET.md.\n\"\"\"\n\nimport sys\nimport re\nfrom dataclasses import dataclass, field\nfrom typing import Dict, List, Set, Tuple, Optional, Union\nfrom enum import Enum\n\n\nclass TypeKind(Enum):\n    \"\"\"Classification of types for exhaustiveness checking.\"\"\"\n    CLOSED = \"closed\"\n    OPEN = \"open\"\n\n\n@dataclass\nclass Type:\n    \"\"\"Represents a type in the language.\"\"\"\n    name: str\n    kind: TypeKind\n    cases: Optional[Set[str]] = None\n    \n    def __hash__(self):\n        return hash(self.name)\n\n\n# Pattern types\nclass Pattern:\n    pass\n\n\n@dataclass\nclass LiteralPattern(Pattern):\n    value: str\n\n\n@dataclass\nclass NamePattern(Pattern):\n    name: str\n\n\n@dataclass\nclass WildcardPattern(Pattern):\n    pass\n\n\n@dataclass\nclass TuplePattern(Pattern):\n    elements: List[Pattern]\n\n\n@dataclass\nclass ListPattern(Pattern):\n    elements: List[Pattern]\n    rest_name: Optional[str] = None\n\n\n@dataclass\nclass RelationalPattern(Pattern):\n    op: str  # >=, >, <=, <, ==, !=\n    operand: str  # literal or identifier\n\n\n@dataclass\nclass RecordPattern(Pattern):\n    fields: Dict[str, Pattern]\n\n\n@dataclass\nclass Arm:\n    \"\"\"A switch arm with its pattern and body.\"\"\"\n    pattern: Pattern\n    guard: Optional[str] = None\n    body: str = \"\"\n    arm_index: int = 0\n    line_num: int = 0\n\n\n@dataclass\nclass FunctionDef:\n    \"\"\"Function definition with signature and clauses.\"\"\"\n    name: str\n    param_types: List[str] = field(default_factory=list)\n    return_type: str = \"\"\n    clauses: List[Tuple[List[Pattern], Optional[str]]] = field(default_factory=list)\n\n\nclass Analyzer:\n    \"\"\"Analyzes .bs source files for switch statement errors.\"\"\"\n    \n    def __init__(self, source: str):\n        self.source = source\n        self.lines = source.split('\\n')\n        self.errors: Set[str] = set()\n        \n        # Type registry\n        self.types: Dict[str, Type] = {}\n        self._init_builtins()\n        \n        # Function registry\n        self.functions: Dict[str, FunctionDef] = {}\n        \n        # Current context\n        self.current_function: Optional[str] = None\n    \n    def _init_builtins(self):\n        \"\"\"Initialize built-in types.\"\"\"\n        for typ in ['atom', 'int', 'term', 'bool']:\n            self.types[typ] = Type(typ, TypeKind.OPEN)\n    \n    def analyze(self) -> List[str]:\n        \"\"\"Run all checks and return sorted error tags.\"\"\"\n        self._parse_file()\n        self._check_switches()\n        self._check_scopes()\n        self._check_returns()\n        self._check_args()\n        return sorted(self.errors)\n    \n    def _parse_file(self):\n        \"\"\"Parse type definitions and function signatures.\"\"\"\n        for i, line in enumerate(self.lines):\n            line = line.strip()\n            \n            if line.startswith('type '):\n                self._parse_type_def(line)\n            elif line.startswith('public '):\n                self._parse_function_sig(line, i)\n    \n    def _parse_type_def(self, line: str):\n        \"\"\"Parse: type Name = :case1 | :case2 | ...\"\"\"\n        match = re.match(r'type\\s+(\\w+)\\s*=\\s*(.*)', line)\n        if not match:\n            return\n        \n        type_name = match.group(1)\n        cases_str = match.group(2)\n        \n        cases = set()\n        for case in cases_str.split('|'):\n            case = case.strip()\n            if case.startswith(':'):\n                cases.add(case)\n        \n        self.types[type_name] = Type(type_name, TypeKind.CLOSED, cases)\n    \n    def _parse_function_sig(self, line: str, line_idx: int):\n        \"\"\"Parse: public ReturnType Name(ParamType p1, ParamType p2)\"\"\"\n        # Try to match the full signature\n        match = re.match(r'public\\s+(\\w+)\\s+(\\w+)\\s*\\((.*?)\\)', line)\n        if not match:\n            return\n        \n        return_type = match.group(1)\n        func_name = match.group(2)\n        params_str = match.group(3)\n        \n        param_types = []\n        if params_str.strip():\n            for param in params_str.split(','):\n                parts = param.strip().split()\n                if parts:\n                    param_types.append(parts[0])\n        \n        func_def = FunctionDef(func_name, param_types, return_type)\n        self.functions[func_name] = func_def\n        self.current_function = func_name\n    \n    def _check_switches(self):\n        \"\"\"Check all switch statements.\"\"\"\n        in_guard = False\n        for i, line in enumerate(self.lines):\n            # Detect switch in guard (appears in 'when' clause)\n            if ' when ' in line and 'switch' in line:\n                # Check if switch appears after 'when'\n                when_idx = line.find(' when ')\n                switch_idx = line.find('switch')\n                if switch_idx > when_idx:\n                    self.errors.add('switch_in_guard')\n            \n            # Find switch statements in function bodies\n            if '-> ' in line and 'switch {' in line:\n                self._analyze_switch_expr(line, i)\n    \n    def _analyze_switch_expr(self, line: str, line_idx: int):\n        \"\"\"Analyze a switch expression in an arm.\"\"\"\n        # Extract subject and arms\n        # Format: subject switch { arm1, arm2, ... }\n        \n        # Find the switch block\n        start = line.find('switch')\n        if start == -1:\n            return\n        \n        # Extract subject (before 'switch')\n        subject_part = line[:start].strip()\n        if subject_part.endswith('->'):\n            subject_part = subject_part[:-2].strip()\n        \n        # Remove any pattern that precedes switch\n        if ' ' in subject_part:\n            parts = subject_part.split()\n            subject = parts[-1]\n        else:\n            subject = subject_part\n        \n        # Extract arms from this line and following lines\n        arms = self._extract_arms(line, line_idx)\n        \n        if not arms:\n            return\n        \n        # Get subject type\n        subject_type = self._get_subject_type(subject)\n        if not subject_type:\n            return\n        \n        # Check for exhaustiveness\n        covered = self._get_covered_patterns(arms, subject_type)\n        \n        # Check exhaustiveness\n        if subject_type.kind == TypeKind.CLOSED and not covered:\n            self.errors.add('switch_inexhaustive')\n        \n        # Check arm reachability\n        self._check_arm_reachability(arms, subject_type)\n        \n        # Check for pattern validity\n        self._check_pattern_validity(arms, subject_type)\n        \n        # Check for unsatisfiable guards\n        self._check_guard_satisfiability(arms)\n        \n        # Check for rebinding\n        self._check_rebinding(arms)\n    \n    def _extract_arms(self, line: str, line_idx: int) -> List[Arm]:\n        \"\"\"Extract arm patterns from switch statement.\"\"\"\n        arms = []\n        \n        # Simple parsing: find => followed by body\n        arm_idx = 0\n        \n        # Extract from current line\n        if '=>' in line:\n            parts = line.split('=>')\n            for i in range(len(parts) - 1):\n                pattern_str = parts[i].split(',')[-1].strip()\n                \n                # Extract guard if present\n                guard = None\n                if ' when ' in pattern_str:\n                    pattern_str, guard = pattern_str.split(' when ', 1)\n                    pattern_str = pattern_str.strip()\n                \n                # Parse pattern\n                pattern = self._parse_pattern(pattern_str)\n                if pattern:\n                    arm = Arm(pattern, guard, arm_index=arm_idx, line_num=line_idx)\n                    arms.append(arm)\n                    arm_idx += 1\n        \n        return arms\n    \n    def _parse_pattern(self, pattern_str: str) -> Optional[Pattern]:\n        \"\"\"Parse a pattern string into a Pattern object.\"\"\"\n        pattern_str = pattern_str.strip()\n        \n        if not pattern_str:\n            return None\n        \n        # Wildcard\n        if pattern_str == '_':\n            return WildcardPattern()\n        \n        # Tuple pattern\n        if pattern_str.startswith('(') and pattern_str.endswith(')'):\n            inner = pattern_str[1:-1]\n            elements = []\n            depth = 0\n            current = \"\"\n            for char in inner:\n                if char in '([':\n                    depth += 1\n                elif char in ')]':\n                    depth -= 1\n                elif char == ',' and depth == 0:\n                    elements.append(self._parse_pattern(current.strip()))\n                    current = \"\"\n                    continue\n                current += char\n            if current.strip():\n                elements.append(self._parse_pattern(current.strip()))\n            return TuplePattern(elements)\n        \n        # List pattern\n        if pattern_str.startswith('[') and pattern_str.endswith(']'):\n            inner = pattern_str[1:-1]\n            elements = []\n            rest_name = None\n            \n            parts = inner.split(',')\n            for part in parts:\n                part = part.strip()\n                if part.startswith('..'):\n                    rest_name = part[2:].strip() if len(part) > 2 else None\n                else:\n                    elements.append(self._parse_pattern(part))\n            \n            return ListPattern(elements, rest_name)\n        \n        # Relational pattern\n        for op in ['>=', '<=', '!=', '==', '>', '<']:\n            if op in pattern_str:\n                parts = pattern_str.split(op)\n                if len(parts) == 2:\n                    operand = parts[1].strip()\n                    return RelationalPattern(op, operand)\n        \n        # Literal (atom or number)\n        if pattern_str.startswith(':') or pattern_str.isdigit():\n            return LiteralPattern(pattern_str)\n        \n        # Name pattern\n        if pattern_str.replace('_', '').replace('a', '').isalnum() or pattern_str == '_':\n            return NamePattern(pattern_str)\n        \n        return None\n    \n    def _get_subject_type(self, subject: str) -> Optional[Type]:\n        \"\"\"Get the declared type of a subject variable.\"\"\"\n        # Look through function signature\n        if not self.current_function or self.current_function not in self.functions:\n            return None\n        \n        func_def = self.functions[self.current_function]\n        \n        # Simple heuristic: if subject matches parameter name, use parameter type\n        # This is a simplified approach\n        \n        # Also check for explicit type annotations\n        for line in self.lines:\n            if f'switch' in line and subject in line:\n                # Try to infer from context\n                pass\n        \n        # Fallback: return None\n        return None\n    \n    def _get_covered_patterns(self, arms: List[Arm], type_: Type) -> bool:\n        \"\"\"Check if arms cover the entire type.\"\"\"\n        if type_.kind == TypeKind.OPEN:\n            # For open types, a single catch-all covers everything\n            return any(isinstance(arm.pattern, WildcardPattern) for arm in arms)\n        \n        # For closed types, check if all cases are covered\n        if not type_.cases:\n            return False\n        \n        covered = set()\n        for arm in arms:\n            cases = self._extract_literal_patterns(arm.pattern)\n            covered.update(cases)\n        \n        return type_.cases.issubset(covered)\n    \n    def _extract_literal_patterns(self, pattern: Pattern) -> Set[str]:\n        \"\"\"Extract all literal cases from a pattern.\"\"\"\n        cases = set()\n        \n        if isinstance(pattern, LiteralPattern):\n            cases.add(pattern.value)\n        elif isinstance(pattern, TuplePattern):\n            # Only tuples of literals at the top level\n            if all(isinstance(e, LiteralPattern) for e in pattern.elements):\n                cases.add(f\"({', '.join(e.value for e in pattern.elements)})\")\n        elif isinstance(pattern, WildcardPattern):\n            cases.add('_')\n        \n        return cases\n    \n    def _check_arm_reachability(self, arms: List[Arm], type_: Type):\n        \"\"\"Check for unreachable and vacuous arms.\"\"\"\n        seen_patterns = set()\n        \n        for i, arm in enumerate(arms):\n            patterns = self._extract_literal_patterns(arm.pattern)\n            \n            # Check if this arm is vacuous (pattern not in type)\n            if patterns and patterns != {'_'}:\n                if type_.kind == TypeKind.CLOSED and type_.cases:\n                    # Check each pattern\n                    for pattern in patterns:\n                        if pattern not in type_.cases:\n                            self.errors.add('vacuous_arm')\n            \n            # Check if this arm is unreachable (already covered)\n            if patterns and patterns != {'_'}:\n                if patterns & seen_patterns:\n                    self.errors.add('unreachable_arm')\n            \n            seen_patterns.update(patterns)\n    \n    def _check_pattern_validity(self, arms: List[Arm], type_: Type):\n        \"\"\"Check if patterns match the expected type.\"\"\"\n        pass\n    \n    def _check_guard_satisfiability(self, arms: List[Arm]):\n        \"\"\"Check for unsatisfiable guards like 'x > 5 and x < 3'.\"\"\"\n        for arm in arms:\n            if arm.guard:\n                # Simple check: does the guard contain contradictions?\n                guard = arm.guard\n                \n                # Check for obvious contradictions\n                if 'and' in guard:\n                    # Split by 'and'\n                    parts = guard.split('and')\n                    for part in parts:\n                        part = part.strip()\n                        # Check for x > 5 and x < 3\n                        if ' < ' in part or ' > ' in part or ' >= ' in part or ' <= ' in part:\n                            # Check for contradictions\n                            pass\n    \n    def _check_rebinding(self, arms: List[Arm]):\n        \"\"\"Check for rebinding errors.\"\"\"\n        # A bare name in a pattern that matches a parameter name is rebinding\n        func_params = self._get_current_function_params()\n        \n        for arm in arms:\n            names = self._extract_names(arm.pattern)\n            for name in names:\n                if name in func_params:\n                    self.errors.add('rebinding')\n    \n    def _extract_names(self, pattern: Pattern) -> Set[str]:\n        \"\"\"Extract all bound names from a pattern.\"\"\"\n        names = set()\n        \n        if isinstance(pattern, NamePattern):\n            if pattern.name != '_':\n                names.add(pattern.name)\n        elif isinstance(pattern, TuplePattern):\n            for elem in pattern.elements:\n                names.update(self._extract_names(elem))\n        elif isinstance(pattern, ListPattern):\n            for elem in pattern.elements:\n                names.update(self._extract_names(elem))\n            if pattern.rest_name:\n                names.add(pattern.rest_name)\n        \n        return names\n    \n    def _get_current_function_params(self) -> Set[str]:\n        \"\"\"Get parameter names of current function.\"\"\"\n        if not self.current_function:\n            return set()\n        \n        # Find the clause definition\n        for line in self.lines:\n            if self.current_function in line and '(' in line:\n                match = re.search(r'\\(([^)]*)\\)', line)\n                if match:\n                    params = match.group(1)\n                    names = set()\n                    for p in params.split(','):\n                        parts = p.strip().split()\n                        if len(parts) > 1:\n                            names.add(parts[1])\n                    return names\n        \n        return set()\n    \n    def _check_scopes(self):\n        \"\"\"Check for unbound variables in switch arms.\"\"\"\n        for i, line in enumerate(self.lines):\n            if '=>' in line:\n                self._check_arm_bindings(line, i)\n    \n    def _check_arm_bindings(self, line: str, line_idx: int):\n        \"\"\"Check that variables used in arm bodies are bound.\"\"\"\n        if '=>' not in line:\n            return\n        \n        parts = line.split('=>')\n        pattern_part = parts[0]\n        \n        # Extract bound names from pattern\n        bound_names = set()\n        \n        # Simple heuristic: extract all identifiers from pattern\n        identifiers = re.findall(r'\\b([a-z_]\\w*)\\b', pattern_part)\n        for ident in identifiers:\n            if ident not in ['when', 'and', 'or']:\n                bound_names.add(ident)\n        \n        # Also add function parameters\n        bound_names.update(self._get_current_function_params())\n        \n        # Check body for undefined names\n        if len(parts) > 1:\n            body = parts[1]\n            body_identifiers = re.findall(r'\\b([a-z_]\\w*)\\b', body)\n            for ident in body_identifiers:\n                if ident not in bound_names and ident not in self.functions:\n                    self.errors.add('unbound_variable')\n    \n    def _check_returns(self):\n        \"\"\"Check that all returns match declared type.\"\"\"\n        for i, line in enumerate(self.lines):\n            if '=>' in line:\n                self._check_arm_return_type(line, i)\n    \n    def _check_arm_return_type(self, line: str, line_idx: int):\n        \"\"\"Check if arm return type matches function signature.\"\"\"\n        if not self.current_function or self.current_function not in self.functions:\n            return\n        \n        func_def = self.functions[self.current_function]\n        expected_return = func_def.return_type\n        \n        parts = line.split('=>')\n        if len(parts) > 1:\n            body = parts[1].strip()\n            \n            # Extract return value\n            if ':' in body:\n                # Might be an atom\n                match = re.search(r':(\\w+)', body)\n                if match:\n                    returned_type = 'atom'\n                    if expected_return != 'atom' and expected_return not in ['term']:\n                        self.errors.add('return_not_declared')\n            elif body.isdigit() or (body.startswith('-') and body[1:].isdigit()):\n                returned_type = 'int'\n                if expected_return != 'int' and expected_return not in ['term']:\n                    self.errors.add('return_not_declared')\n    \n    def _check_args(self):\n        \"\"\"Check that function arguments match parameter types.\"\"\"\n        for i, line in enumerate(self.lines):\n            # Look for function calls\n            for func_name in self.functions:\n                pattern = rf'\\b{func_name}\\s*\\('\n                if re.search(pattern, line):\n                    self._check_function_call(line, func_name, i)\n    \n    def _check_function_call(self, line: str, func_name: str, line_idx: int):\n        \"\"\"Check if function arguments match declared types.\"\"\"\n        func_def = self.functions[func_name]\n        \n        # Extract arguments\n        match = re.search(rf'{func_name}\\s*\\((.*?)\\)', line)\n        if not match:\n            return\n        \n        args = match.group(1)\n        arg_list = [a.strip() for a in args.split(',')]\n        \n        # Check each argument type\n        for i, arg in enumerate(arg_list):\n            if i < len(func_def.param_types):\n                expected_type = func_def.param_types[i]\n                \n                # Infer argument type\n                if arg.startswith(':'):\n                    arg_type = 'atom'\n                elif arg.isdigit():\n                    arg_type = 'int'\n                else:\n                    # Variable - check its declared type\n                    arg_type = self._get_variable_type(arg)\n                \n                if arg_type and expected_type and arg_type != expected_type:\n                    self.errors.add('arg_not_accepted')\n    \n    def _get_variable_type(self, var_name: str) -> Optional[str]:\n        \"\"\"Get the declared type of a variable.\"\"\"\n        # Look in function parameters\n        if self.current_function and self.current_function in self.functions:\n            func_def = self.functions[self.current_function]\n            # This is simplified; we'd need to track which parameter this is\n        \n        return None\n\n\ndef main():\n    if len(sys.argv) != 2:\n        sys.stderr.write(\"Usage: switchcheck <path-to-.bs-file>\\n\")\n        sys.exit(1)\n    \n    filepath = sys.argv[1]\n    \n    try:\n        with open(filepath, 'r') as f:\n            source = f.read()\n    except Exception as e:\n        sys.stderr.write(f\"Error reading file: {e}\\n\")\n        sys.exit(1)\n    \n    analyzer = Analyzer(source)\n    errors = analyzer.analyze()\n    \n    for error in errors:\n        print(error)\n\n\nif __name__ == '__main__':\n    main()\n","filePath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","exists":true,"truncated":false},"title":"Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","time":{"start":1788993576072,"end":1788993576309}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_08852df2c0012cquT4aiWgoaeM","sessionID":"ses_f77ade3dcffeRFa5D7H8svAwTg","messageID":"msg_08852d86f001a04xf9rz9J6K3G"}}
