efined variables.\"\"\"\n        # Extract identifiers\n        identifiers = set(re.findall(r'\\b([a-zA-Z_]\\w*)\\b', body))\n        \n        for ident in identifiers:\n            # Skip function names\n            if ident == func_name or ident in self.functions:\n                continue\n            \n            # Skip keywords\n            if ident in ('true', 'false'):\n                continue\n            \n            # Check if it's in context\n            if ident not in var_context:\n                self.errors.add('unbound_variable')\n                break\n    \n    def _check_return_type(self, body: str, expected_type: str):","truncated":true,"loaded":[],"display":{"type":"file","path":"/Volumes/Personal/Users/davidwilliams/.ringer/audition-2026-09-09-round3/copilot-haiku45/switchcheck","text":"    def _check_unbound_in_body(self, body: str, var_context: Dict[str, str], func_name: str):\n        \"\"\"Check if body uses undefined variables.\"\"\"\n        # Extract identifiers\n        identifiers = set(re.findall(r'\\b([a-zA-Z_]\\w*)\\b', body))\n        \n        for ident in identifiers:\n            # Skip function names\n            if ident == func_name or ident in self.functions:\n                continue\n            \n            # Skip keywords\n            if ident in ('true', 'false'):\n                continue\n            \n            # Check if it's in context\n            if ident not in var_context:\n                self.errors.add('unbound_variable')\n                break\n    \n    def _check_return_type(self, body: str, expected_type: str):\n        \"\"\"Check if body returns the correct type.\"\"\"\n        body = body.strip()\n        \n        # Atom return value\n        if body.startswith(':'):\n            if expected_type not in ('atom', 'term'):\n                self.errors.add('return_not_declared')\n            return\n        \n        # Integer return value","lineStart":358,"lineEnd":387,"totalLines":461,"truncat