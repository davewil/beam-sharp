{"type":"tool_use","timestamp":1787395847764,"sessionID":"ses_fd6ecf8e7ffeQIAY4RnDqG5Oe6","part":{"type":"tool","tool":"write","callID":"toolu_01AJhP9pSDrSSUtyV83G6zVj","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\nimport re\n\ndef split_pattern_elements(s):\n    elements = []\n    current = []\n    depth = 0\n    \n    for char in s:\n        if char == '(':\n            depth += 1\n            current.append(char)\n        elif char == ')':\n            depth -= 1\n            current.append(char)\n        elif char == ',' and depth == 0:\n            elements.append(''.join(current).strip())\n            current = []\n        else:\n            current.append(char)\n    \n    if current:\n        elements.append(''.join(current).strip())\n    \n    return elements\n\ndef parse_pattern(pattern: str):\n    \"\"\"Parse a pattern and return its normalized form.\"\"\"\n    pattern = pattern.strip()\n    \n    if pattern == '_':\n        return '_'\n    \n    if pattern.startswith('(') and pattern.endswith(')'):\n        # Tuple pattern\n        inner = pattern[1:-1]\n        elements = split_pattern_elements(inner)\n        return ('tuple', [parse_pattern(e) for e in elements])\n    \n    # Check for atom literal\n    if pattern.startswith(':'):\n        return pattern\n    \n    # Check for number literal\n    if re.match(r'^-?\\d+$', pattern):\n        return int(pattern)\n    \n    # Variable/binding\n    return pattern\n\ndef pattern_covers(pattern, value):\n    if pattern == '_':\n        return True\n    \n    if isinstance(pattern, str):\n        # Variable or atom literal\n        if pattern.startswith(':'):\n            # Atom literal - exact match only\n            return pattern == value\n        else:\n            # Variable matches any value (binding)\n            return True\n    \n    if isinstance(pattern, int):\n        # Number literal - exact match\n        return pattern == value\n    \n    if isinstance(pattern, tuple):\n        if pattern[0] == 'tuple':\n            # Tuple pattern\n            if not isinstance(value, tuple):\n                return False\n            patterns = pattern[1]\n            if len(patterns) != len(value):\n                return False\n            return all(pattern_covers(p, v) for p, v in zip(patterns, value))\n    \n    return False\n\n# Test parsing\npattern_str = \"(true,  _,     _)\"\nparsed = parse_pattern(pattern_str)\nprint(f\"Pattern: {pattern_str}\")\nprint(f\"Parsed: {parsed}\")\nprint()\n\n# Test coverage\ntest_cases = [\n    ('true', 'true', 'true'),\n    ('true', 'true', 'false'),\n    ('true', 'false', 'true'),\n    ('true', 'false', 'false'),\n    ('false', 'true', 'true'),\n    ('false', 'true', 'false'),\n    ('false', 'false', 'true'),\n    ('false', 'false', 'false'),\n]\n\nprint(\"Testing coverage:\")\nfor i, case in enumerate(test_cases):\n    covers = pattern_covers(parsed, case)\n    print(f\"  {i}: {case} -> {covers}\")\n","filePath":"/private/var/folders/s9/s1jc1ww94kx0nhb3d33zxqrw0000gn/T/ringer-opencode-scratch.lytjgyAC27/opencode/debug.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"/private/var/folders/s9/s1jc1ww94kx0nhb3d33zxqrw0000gn/T/ringer-opencode-scratch.lytjgyAC27/opencode/debug.py","exists":true,"truncated":false},"title":"private/var/folders/s9/s1jc1ww94kx0nhb3d33zxqrw0000gn/T/ringer-opencode-scratch.lytjgyAC27/opencode/debug.py","time":{"start":1787395847628,"end":1787395847741}},"metadata":{"anthropic":{"caller":{"type":"direct"}}},"id":"prt_029181b3f001EHi6P08Ji62VuL","sessionID":"ses_fd6ecf8e7ffeQIAY4RnDqG5Oe6","messageID":"msg_02918133e00157iy7GiOYy3wZQ"}}
