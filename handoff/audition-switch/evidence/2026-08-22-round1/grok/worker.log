: str):\n      self.name = name\n\nclass RecordType(Type):\n  def __init__(self, name: str, fields: Dict[str, Type]):\n      self.name = name\n      self.fields = fields\n\n# =============================================================================\n# Residuals (for pattern matching)\n# =============================================================================\n\n@dataclass(frozen=True)\nclass Residual:\n    kind: str\n    data # depends on kind\n\nclass IntResidual(Residual):\n    def __init__(self, intervals: List[Tuple[Optional[int], Optional[int]]]):\n        super().__init__('int', intervals)\n\nclass BoolResidual(Residual):\n    def __init__(self, true_only: bool, false_only: bool):\n        super().__init__('bool', (true_only, false_only))\n\nclass AtomClosedResidual(Residual):\n    def __init__(self, atoms: Set[str]):\n        super().__init__('atom_closed', atoms)\n\nclass AtomOpenResidual(Residual):\n    def __init__(self, excluded: Set[str], fully_covered : bool):\n        super().__init__('atom_open', (excluded, fully_covered))\n\nclass TupleResidual(Residual):\n    def __init__(self, alts: List[List[Residual]]):\n        super().__init__('tuple', alts)\n\nclass ListResidual(Residual):\n    def __init__(self, elem : Residual):\n        super().__init__('list', elem)\n\nclass UnionResidual(Residual):\n    def __init__(self, parts: List[Residual]):\n        super().__init__('union', parts)\n\n# =============================================================================\n# Interval helpers\n# =============================================================================\n\nNEG_INF = None\nPOS_INF = None\n\ndef lo_le(a : Optional[int], b: Optional[int]) -> bool:\n    if a is None:\n        return True\n    if b is None:\n        return False\n    return a <= b\n\ndef hi_le(a: Optional[int], b: Optional[int]) -> bool:\n    if a is None:\n        return True\n if b is None:\n        return False\n    return a <= b\n\ndef lo_max(a: Optional[int], b: Opt