=== emitted Erlang (from the .beam abstract code) ===
'Inner'(O) when map_get('Kind', O) =:= 'Priv.Order' ->
    map_get('Total', O).

'Scale'(N) ->
    N * 2.

'Plain'(N) ->
    N + 1.

'Outer'(O) when map_get('Kind', O) =:= 'Priv.Order' ->
    'Inner'(O).

'OuterInt'(N)
    when
        is_integer(N)
        andalso
        N >= 0
        andalso
        N =< 255 ->
    'Scale'(N).

'OuterPlain'(N) when is_integer(N) ->
    'Plain'(N).


