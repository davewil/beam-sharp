'Helper'(N) ->
    N.
'Incr'(N) when is_integer(N) ->
    N + 1.
'Pass'(N) when is_integer(N) ->
    'Helper'(N).
'Ignore'(N, M)
    when
        is_integer(N)
        andalso
        is_integer(M) ->
    M + 1.
'Amount'(O) when map_get('Kind', O) =:= 'An.Order' ->
    map_get('Total', O).
'PassO'(O) when map_get('Kind', O) =:= 'An.Order' ->
    'Amount'(O).

