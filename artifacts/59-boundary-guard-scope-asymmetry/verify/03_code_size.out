=== the emitted guards for the cases, per variant (private function only) ===
--- Rec3 / base
'Inner'(O) when map_get('Kind', O) =:= 'Rec3.Order' ->
    map_get('Total', O).

--- Rec3 / narrow
'Inner'(O) ->
    map_get('Total', O).

--- Rec3 / wide
'Inner'(O) when map_get('Kind', O) =:= 'Rec3.Order' ->
    map_get('Total', O).

--- Rec3 / proj
'Inner'(O) ->
    map_get('Total', O).

--- IntU / base
'Scale'(N) ->
    N * 2.

--- IntU / narrow
'Scale'(N) ->
    N * 2.

--- IntU / wide
'Scale'(N) when is_integer(N) ->
    N * 2.

--- IntU / proj
'Scale'(N) ->
    N * 2.

