-type order() :: {order, integer(), integer()}.
-opaque token() :: {token, integer()}.
-type cart() :: {cart, order(), integer()}.
-spec inner(order()) -> integer().
inner(O) ->
    erlang:element(3, O).
-spec scale(integer()) -> integer().
scale(N) ->
    N * 2.
-spec big(integer()) -> boolean().
big(N) ->
