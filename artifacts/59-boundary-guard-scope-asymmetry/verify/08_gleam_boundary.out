-spec make(integer()) -> token().
make(N) ->
    {token, N}.
-spec unwrap(token()) -> integer().
unwrap(T) ->
    erlang:element(2, T).
-spec add(integer(), integer()) -> integer().
add(A, B) ->
    A + B.
