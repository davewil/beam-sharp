--- id/1  1 guard (body cannot benefit; isolates entry cost) ---

[unguarded v_id_u]
{function, id, 1, 2}.
  {label,1}.
    {line,[{location,"v_id_u.erl",4}]}.
    {func_info,{atom,v_id_u},{atom,id},1}.
  {label,2}.
    return.


