'Big'(_N) ->
'SumAll'([], Acc) ->
    Acc;
'SumAll'([O | Rest], Acc) ->
--- forged calls:
Nested(cart(bad_tag,..))           -> RETURNED 7  (silent)
Nested(cart(no_tag,..))            -> RETURNED 7  (silent)
