################################ variant: wide
--- private functions as emitted:
'Inner'(O) when map_get('Kind', O) =:= 'Forge.Order' ->
    map_get('Total', O).

'Scale'(N) when is_integer(N) ->
    N * 2.

'Big'(N)
    when
        is_integer(N)
'Big'(N) when is_integer(N) ->
    small.

'SumAll'([], Acc) when is_integer(Acc) ->
    Acc;
--- forged calls:
Nested(cart(bad_tag,..))           -> CRASH error:function_clause  in 'Forge':'Inner'/1
Nested(cart(no_tag,..))            -> CRASH error:function_clause  in 'Forge':'Inner'/1
Field(cart(good,1.5))              -> CRASH error:function_clause  in 'Forge':'Scale'/1
Field(cart(good,foo))              -> CRASH error:function_clause  in 'Forge':'Scale'/1
Oct(cart(..,Oct=5))  control       -> RETURNED 10  (silent)
Oct(cart(..,Oct=300))              -> CRASH error:function_clause  in 'Forge':'ScaleO'/1
Oct(cart(..,Oct=1.5))              -> CRASH error:function_clause  in 'Forge':'ScaleO'/1
FieldBig(cart(good,foo))           -> CRASH error:function_clause  in 'Forge':'Big'/1
FieldBig(cart(good,<<>>))          -> CRASH error:function_clause  in 'Forge':'Big'/1
Sum(items=[good,bad_tag])          -> CRASH error:function_clause  in 'Forge':'Inner'/1
SumList([good,bad_tag])            -> CRASH error:function_clause  in 'Forge':'Inner'/1
Mapped([good,bad_tag])             -> CRASH error:function_clause  in 'Forge':'Inner'/1
Compare(cart(good,foo))            -> RETURNED small  (silent)
Compare(cart(good,1.5))            -> RETURNED small  (silent)
