c0_plain   beam= 800B  {gc_bif,'+',{f,0},1,[{x,0},{integer,1}],{x,0}}. {gc_bif,'rem',{f,0},1,[{tr,{x,0},number},{integer,7}],{x,0}}. 

c1_spec    beam= 800B  {gc_bif,'+',{f,0},1,[{x,0},{integer,1}],{x,0}}. {gc_bif,'rem',{f,0},1,[{tr,{x,0},number},{integer,7}],{x,0}}. 

c2_isint   beam= 804B  {test,is_integer,{f,1},[{x,0}]}. {gc_bif,'+',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,1}],{x,0}}. {gc_bif,'rem',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,7}],{x,0}}. 

c3_range   beam= 820B  {test,is_integer,{f,1},[{x,0}]}. {test,is_ge,{f,1},[{tr,{x,0},{t_integer,any}},{integer,0}]}. {test,is_ge,{f,1},[{integer,99},{tr,{x,0},{t_integer,any}}]}. {gc_bif,'+',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,1}],{x,0}}. {gc_bif,'rem',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,7}],{x,0}}. 

c4_both    beam= 820B  {test,is_integer,{f,1},[{x,0}]}. {test,is_ge,{f,1},[{tr,{x,0},{t_integer,any}},{integer,0}]}. {test,is_ge,{f,1},[{integer,99},{tr,{x,0},{t_integer,any}}]}. {gc_bif,'+',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,1}],{x,0}}. {gc_bif,'rem',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,7}],{x,0}}. 

--- to_asm detail for c0 and c3
{function, f, 1, 2}.
  {label,1}.
    {line,[{location,"c0_plain.erl",4}]}.
    {func_info,{atom,c0_plain},{atom,f},1}.
  {label,2}.
    {gc_bif,'+',{f,0},1,[{x,0},{integer,1}],{x,0}}.
    {gc_bif,'rem',{f,0},1,[{tr,{x,0},number},{integer,7}],{x,0}}.
    return.

{function, f, 1, 2}.
  {label,1}.
    {line,[{location,"c3_range.erl",4}]}.
    {func_info,{atom,c3_range},{atom,f},1}.
  {label,2}.
    {test,is_integer,{f,1},[{x,0}]}.
    {test,is_ge,{f,1},[{tr,{x,0},{t_integer,any}},{integer,0}]}.
    {test,is_ge,{f,1},[{integer,99},{tr,{x,0},{t_integer,any}}]}.
    {gc_bif,'+',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,1}],{x,0}}.
    {gc_bif,'rem',{f,0},1,[{tr,{x,0},{t_integer,any}},{integer,7}],{x,0}}.
    return.

