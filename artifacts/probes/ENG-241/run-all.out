## P6 Elixir
== inner/1
inner(#{'__struct__' := 'Elixir.Order'} = _o@1) ->
    case _o@1 of
        #{total := _@1} ->
            _@1;
        _@1 when is_atom(_@1), _@1 =/= nil, _@1 =/= true, _@1 =/= false ->
            _@1:total();
        _@1 ->
            error({badkey, total, _@1})
    end.

== inner_plain/1
inner_plain(_o@1) ->
    case _o@1 of
        #{total := _@1} ->
            _@1;
        _@1 when is_atom(_@1), _@1 =/= nil, _@1 =/= true, _@1 =/= false ->
            _@1:total();
        _@1 ->
            error({badkey, total, _@1})
    end.

== ship/1
ship(#{'__struct__' := 'Elixir.Order'} = _o@1) ->
    inner(_o@1).

== ship_loose/1
ship_loose(_o@1) ->
    inner(_o@1).

