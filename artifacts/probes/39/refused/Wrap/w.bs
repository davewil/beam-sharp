module Wrap

using :erlang {
    int rem(int a, int b)
}

type Digit = int where value >= 0 and value <= 99

// The hot loop of aoc/bench with Spin's first parameter refined to the range Wrap really produces.
private int Wrap(int n)
Wrap(n) -> :erlang.rem(:erlang.rem(n, 100) + 100, 100)

private int Hit(int pos)
Hit(0) -> 1
Hit(n) -> 0

public (int, int) Spin(Digit pos, int step, int left, int zeros)
Spin(pos, step, 0, zeros) -> (pos, zeros)
Spin(pos, step, left, zeros) ->
    var next = Wrap(pos + step)
    Spin(next, step, left - 1, zeros + Hit(next))
