+%% PROTOTYPE (ticket 39 brief): BSC_INLINE=all emits `-compile(inline)`;
+%% BSC_INLINE=private emits `-compile({inline, [private functions]})`.
+inline_attr(Fns, Behaviours) ->
+    case os:getenv("BSC_INLINE") of
+        "all" -> [{attribute, ?A, compile, inline}];
+        "private" ->
+            [{attribute, ?A, compile,
+              {inline, [{name(F, Behaviours), arity(F)} || F <- Fns, not is_public(F)]}}];
+        _ -> []
+    end.
+
