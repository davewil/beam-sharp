-module(m). -export([p/1]). p(2+3) -> a; p(-(1 bsl 2)) -> b; p(_) -> z.
   compiled; calls [{5,a},{-4,b},{7,z}]
-module(m). -export([p/1]). p(N) when N >= 2+3 -> a; p(_) -> z.
   compiled; calls [{5,a},{-4,z},{7,a}]
