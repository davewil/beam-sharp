 comparison(_) ->
     unknown.
 
+%% PROTOTYPE (ticket 57, checker-side fold): a comparand is constant when it is
+%% an integer literal or `-`, `+`, `-`, `*` over constants. `/` and `%` are not
+%% folded (their rounding is ticket 38's, not this fold's).
+const_int({e_int, _, K})            -> {ok, K};
+const_int({e_neg, _, E})            -> neg_ok(const_int(E));
+const_int({e_op, _, Op, A, B}) when Op =:= '+'; Op =:= '-'; Op =:= '*' ->
+    case {const_int(A), const_int(B)} of
+        {{ok, X}, {ok, Y}} -> {ok, case Op of '+' -> X + Y; '-' -> X - Y; '*' -> X * Y end};
+        _                  -> error
+    end;
+const_int(_)                        -> error.
+
+neg_ok({ok, K}) -> {ok, -K};
+neg_ok(error)   -> error.
+
 int_cmp('>',  V, K) -> {V, {include, bs_types:range(K + 1, pos_inf)}};
 int_cmp('>=', V, K) -> {V, {include, bs_types:range(K, pos_inf)}};
 int_cmp('<',  V, K) -> {V, {include, bs_types:range(neg_inf, K - 1)}};
