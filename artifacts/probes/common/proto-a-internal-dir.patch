+%% PROTOTYPE A (ticket 60): a module with an `Internal` path segment is
+%% nameable only from the subtree rooted at that segment's parent. Segment-wise,
+%% never a text prefix: Shop.OrdersExtra is not under Shop.Orders.
+may_name(M, Self) ->
+    %% The LAST `Internal` segment governs, as Go's findInternal does: it is the
+    %% most restrictive requirement on the importer.
+    {_, Rest} = lists:splitwith(fun(S) -> S =/= "Internal" end, lists:reverse(segs(M))),
+    Parent = lists:reverse(tl_or_empty(Rest)),
+    case Rest =:= [] orelse lists:prefix(Parent, segs(Self)) of
+        true  -> true;
+        false -> {false, list_to_atom(lists:flatten(lists:join(".", Parent)))}
+    end.
+
+tl_or_empty([]) -> [];
+tl_or_empty([_ | T]) -> T.
+
+segs(A) -> string:split(atom_to_list(A), ".", all).
+
