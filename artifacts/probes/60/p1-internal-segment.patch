+%% A module with an `Internal` segment may be named only from the subtree that
+%% holds that segment's parent: Shop.Billing.Internal.Ledger <- Shop.Billing.*
+%% (Go's `internal/` rule; Gleam's `internal_modules` default is the same shape).
+visible_to(M, Self) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []}      -> true;
+        {Parent, _}  ->
+            SelfSegs = string:split(atom_to_list(Self), ".", all),
+            lists:prefix(Parent, SelfSegs)
+    end.
+
 children(Prefix, Known) ->
     P = atom_to_list(Prefix) ++ ".",
     [M || M <- Known, lists:prefix(P, atom_to_list(M))].
