+%% PROBE R1: a module whose path has an `Internal` segment is nameable only from
+%% modules under that segment's parent (Go's `internal/` rule, spelled as data).
+visible_to(M, Self) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    visible_segs(Segs, [], atom_to_list(Self)).
+visible_segs([], _Acc, _Self) -> true;
+visible_segs(["Internal" | Rest], Acc, Self) ->
+    Parent = lists:flatten(lists:join(".", lists:reverse(Acc))),
+    (Parent =:= "" orelse Self =:= Parent orelse lists:prefix(Parent ++ ".", Self))
+        andalso visible_segs(Rest, ["Internal" | Acc], Self);
+visible_segs([S | Rest], Acc, Self) -> visible_segs(Rest, [S | Acc], Self).
+
 children(Prefix, Known) ->
     P = atom_to_list(Prefix) ++ ".",
     [M || M <- Known, lists:prefix(P, atom_to_list(M))].
