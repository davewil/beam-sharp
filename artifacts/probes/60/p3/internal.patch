+%% Experimental (ticket 60): `Owner.Internal.X` may be named only from `Owner`
+%% or `Owner.*`.
+guard_internal(M, Self, L) ->
+    internal_ok(M, Self) orelse erlang:error({internal_module, M, internal_owner(M), L}).
+
+internal_ok(M, Self) ->
+    case internal_owner(M) of
+        none  -> true;
+        Owner -> O = atom_to_list(Owner), S = atom_to_list(Self),
+                 S =:= O orelse lists:prefix(O ++ ".", S)
+    end.
+
+internal_owner(M) ->
+    case string:split(atom_to_list(M), ".Internal.") of
+        [Pre, _] -> list_to_atom(Pre);
+        _        -> none
+    end.
+
