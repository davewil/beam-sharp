diff --git a/compiler/src/bs_check.erl b/compiler/src/bs_check.erl
index f62e7a0..1de77f1 100644
--- a/compiler/src/bs_check.erl
+++ b/compiler/src/bs_check.erl
@@ -497,14 +497,32 @@ import_env(Decls, Self, World, Mode) ->
 
 add_import(L, M, Self, World, Known, Mode, Acc) ->
     case maps:is_key(M, World) of
-        true  -> add_module_import(M, World, Acc);
+        true  ->
+            case {reach(M, Self), Mode} of
+                {{hidden, Parent}, strict} -> erlang:error({not_visible, M, Self, Parent, L});
+                _                          -> add_module_import(M, World, Acc)
+            end;
         false ->
             %% Namespaces emit nothing. Exclude `Self`: importing its namespace
             %% must not make a module its own dependency.
             case {children(M, Known) -- [Self], Mode} of
                 {[], strict}  -> erlang:error({unknown_module, M, L});
                 {[], lenient} -> Acc;
-                {Children, _} -> add_namespace_import(M, Children, Acc)
+                {Children, _} -> add_namespace_import(M, [C || C <- Children, reach(C, Self) =:= ok], Acc)
+            end
+    end.
+
+%% PROTOTYPE (ticket 60, option "position"): a module whose path has an
+%% `Internal` segment may be named only by modules under the segment's parent.
+reach(M, Self) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []}     -> ok;
+        {Parent, _} ->
+            Mine = string:split(atom_to_list(Self), ".", all),
+            case lists:prefix(Parent, Mine) of
+                true  -> ok;
+                false -> {hidden, list_to_atom(lists:flatten(lists:join(".", Parent)))}
             end
     end.
 
