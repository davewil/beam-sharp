+%% An `internal` module may be named only from the subtree under its parent.
+visible_to(M, Self, World) ->
+    case maps:get(internal, maps:get(M, World, #{}), false) of
+        false -> true;
+        true  ->
+            Parent = lists:droplast(string:split(atom_to_list(M), ".", all)),
+            lists:prefix(Parent, string:split(atom_to_list(Self), ".", all))
+    end.
+
 children(Prefix, Known) ->
     P = atom_to_list(Prefix) ++ ".",
     [M || M <- Known, lists:prefix(P, atom_to_list(M))].
