+%% PROTOTYPE (ticket 60): a module with an  segment in its name may be
+%% named only from inside the namespace that holds that segment.
+may_name(Self, M) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []}     -> true;
+        {Parent, _} ->
+            P = lists:flatten(lists:join(".", Parent)),
+            SelfS = atom_to_list(Self),
+            SelfS =:= P orelse lists:prefix(P ++ ".", SelfS)
+    end.
