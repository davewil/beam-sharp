+%% PROTOTYPE (ticket 60): a module with an `Internal` path segment may be named
+%% only from modules under the path before that segment.
+module_visible(undefined, _M, _L) -> ok;
+module_visible(Self, M, L) ->
+    case lists:splitwith(fun(S) -> S =/= "Internal" end,
+                         string:split(atom_to_list(M), ".", all)) of
+        {_, []}     -> ok;
+        {Prefix, _} ->
+            case lists:prefix(Prefix, string:split(atom_to_list(Self), ".", all)) of
+                true  -> ok;
+                false -> erlang:error({module_not_visible, M, Self, L})
+            end
+    end.
+
