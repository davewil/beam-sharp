+%% PROTOTYPE (ticket 60): a module with an `Internal` path segment may be named
+%% only from modules under the path before the LAST such segment.
+%% A root-level `Internal` has the empty prefix, so everything is under it.
+%% Applied to a `using` of the module and to the children a namespace `using`
+%% would bring in; `--api` (lenient) does not check.
+visible(undefined, _M) -> true;
+visible(Self, M) ->
+    case lists:splitwith(fun(S) -> S =/= "Internal" end,
+                         lists:reverse(string:split(atom_to_list(M), ".", all))) of
+        {_, []}              -> true;
+        {_, [_ | RevPrefix]} ->
+            lists:prefix(lists:reverse(RevPrefix), string:split(atom_to_list(Self), ".", all))
+    end.
+
+require_visible(Self, M, L, strict) ->
+    case visible(Self, M) of
+        true  -> ok;
+        false -> erlang:error({module_not_visible, M, Self, L})
+    end;
+require_visible(_, _, _, _) -> ok.
+
+visible_children(Children, Self, M, L, strict) ->
+    case [C || C <- Children, visible(Self, C)] of
+        []      -> erlang:error({module_not_visible, M, Self, L});
+        Visible -> Visible
+    end;
+visible_children(Children, _, _, _, _) -> Children.
+
