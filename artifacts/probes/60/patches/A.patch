+%% Who may name a module. Asked where a dependency is formed: every route to a
+%% callee passes a `using` (`qualified_module/3` refuses a call that skips one),
+%% so a module-level rule is one refusal at the `using` line for a module-tier
+%% import, and one memo for a namespace-tier import, read when the short name is
+%% resolved. A rule that only filtered the namespace's children would report
+%% `module_not_imported` to an author who has the `using` -- F12's `unknown` for
+%% `private`, again.
+refuse_unless_visible(L, M, Self, World) ->
+    case visibility(M, Self, World) of
+        visible         -> ok;
+        {hidden, Scope} -> erlang:error({module_not_visible, M, Scope, L})
+    end.
+
+hide(Children, Self, World, Acc) ->
+    Hidden = maps:from_list([{C, S} || C <- Children,
+                                       {hidden, S} <- [visibility(C, Self, World)]]),
+    Acc#{denied => maps:merge(maps:get(denied, Acc, #{}), Hidden)}.
+
+%% A module whose path has a segment `Internal` may be named only from the
+%% segment's parent and what sits under it. Decided from the two atoms alone.
+visibility(M, Self, _World) ->
+    case internal_parent(M) of
+        none   -> visible;
+        Parent -> case under(Self, Parent) of
+                      true  -> visible;
+                      false -> {hidden, Parent}
+                  end
+    end.
+
+internal_parent(M) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case [I || {I, "Internal"} <- lists:zip(lists:seq(1, length(Segs)), Segs), I > 1] of
+        [] -> none;
+        Is -> list_to_atom(lists:flatten(
+                             lists:join(".", lists:sublist(Segs, lists:last(Is) - 1))))
+    end.
+
+%% `Self` is `Parent` or sits under it.
+under(Self, Parent) ->
+    S = atom_to_list(Self), P = atom_to_list(Parent),
+    S =:= P orelse lists:prefix(P ++ ".", S).
+
