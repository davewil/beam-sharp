@@ -503,10 +506,35 @@
             case {children(M, Known) -- [Self], Mode} of
                 {[], strict}  -> erlang:error({unknown_module, M, L});
                 {[], lenient} -> Acc;
-                {Children, _} -> add_namespace_import(M, Children, Acc)
+                {Children0, _} ->
+                    Children = [C || C <- Children0, internal_visible(C, Self)],
+                    add_namespace_import(M, Children, Acc)
             end
     end.
 
+%% PROTOTYPE (ticket 60): the `Internal` path-segment rule.
+internal_ok(M, Self, L) ->
+    case internal_visible(M, Self) of
+        true  -> ok;
+        false -> erlang:error({internal_module, M, internal_parent(M), L})
+    end.
+
+internal_visible(M, Self) ->
+    case internal_parent(M) of
+        none   -> true;
+        Parent -> Self =:= Parent orelse lists:prefix(atom_to_list(Parent) ++ ".", atom_to_list(Self))
+    end.
+
+%% The module path above the FIRST `Internal` segment, `none` when absent or when
+%% `Internal` is the first segment (its parent is the source root: everyone).
+internal_parent(M) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []}      -> none;
+        {[], _}      -> none;
+        {Above, _}   -> list_to_atom(lists:flatten(lists:join(".", Above)))
+    end.
+
