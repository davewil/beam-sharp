+%% PROTOTYPE (ticket 60): who may name module M.
+visible_to(Self, M, World) ->
+    Entry = maps:get(M, World, #{}),
+    Internal = maps:get(internal, Entry, false),
+    Friends = maps:get(friends, Entry, []),
+    Within = maps:get(within, Entry, []),
+    Seg = segment_root(M),
+    case {Internal, Friends, Within, Seg} of
+        {false, [], [], none} -> true;
+        _ ->
+            (Seg =/= none andalso in_subtree(Self, Seg))
+                orelse (Internal andalso in_subtree(Self, parent(M)))
+                orelse lists:member(Self, Friends)
+                orelse lists:any(fun(W) -> in_subtree(Self, W) end, Within)
+    end.
+
+%% Go's rule: a module with an `Internal` path segment is nameable only from the
+%% subtree rooted at the segment's parent. No grammar, no marker.
+segment_root(M) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []}       -> none;
+        {[], _}       -> none;
+        {Before, _}   -> list_to_atom(lists:flatten(lists:join(".", Before)))
+    end.
+
+parent(M) ->
+    case string:split(atom_to_list(M), ".", trailing) of
+        [P, _] -> list_to_atom(P);
+        _      -> none
+    end.
+
+in_subtree(_Self, none) -> true;
+in_subtree(Self, P) ->
+    S = atom_to_list(Self), Ps = atom_to_list(P),
+    S =:= Ps orelse lists:prefix(Ps ++ ".", S).
+
