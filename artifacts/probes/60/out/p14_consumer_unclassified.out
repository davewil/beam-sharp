--- bsc --api, helper is private (F12 default): is Recompute listed?
module Orders
behaviour GenServer
int Apply(int, int)
(:reply, int, int) HandleCall(:get | (:add, int), term, int)
(:noreply, int) HandleCast(:reset | (:add, int), int)
(:ok, int) Init(int)
--- bsc --api, helper made public so a sibling module can call it: any distinction from the client API?
module OrdersPub
behaviour GenServer
int Apply(int, int)
(:reply, int, int) HandleCall(:get | (:add, int), term, int)
(:noreply, int) HandleCast(:reset | (:add, int), int)
(:ok, int) Init(int)
int Recompute(int)
