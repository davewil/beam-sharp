=== abstract form of the aliases in the wrap build (.abstr is the compiler's on-disk Abstract Format) ===
'Which'(_O = #{'Kind' := 'Shop.Order'}) ->
    order;
'Which'(_I = #{'Kind' := 'Shop.Invoice'}) ->
    invoice.
which(Bs@a1) ->
    'Which'(Bs@a1).
'New'(Id) when is_integer(Id) ->
    #{'Kind' => 'Shop.Order', 'Id' => Id, 'Total' => 0}.
new(Bs@a1) ->
    'New'(Bs@a1).
