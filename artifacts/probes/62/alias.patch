 to_abstr(Forms) ->
     iolist_to_binary(["%% coding: latin-1\n"
                       | [io_lib:format("~p.~n", [F]) || F <- Forms]]).
+
+
+%%% ---------------------------------------------------------------------------
+%%% EXPERIMENT (ticket 62, probe 3; never merged). BS_ALIAS=wrapper emits, beside every
+%%% public function `Name/N`, a thin wrapper `snake(Name)/N` that tail-calls it.
+%%% ---------------------------------------------------------------------------
+alias_mode() -> os:getenv("BS_ALIAS").
+
+%% Gleam's rule, as observed in probe 4: every uppercase letter is lowercased and,
+%% unless first, preceded by `_`. Digits are ordinary lowercase characters.
+snake(Atom) ->
+    list_to_atom(snake_(atom_to_list(Atom), true)).
+snake_([], _) -> [];
+snake_([C | T], First) when C >= $A, C =< $Z ->
+    (if First -> []; true -> [$_] end) ++ [C + 32 | snake_(T, false)];
+snake_([C | T], _) -> [C | snake_(T, false)].
+
+alias_pairs(Exports, Fns, Behaviours) ->
+    case alias_mode() of
+        "wrapper" ->
+            Pairs = [{snake(name(F, Behaviours)), name(F, Behaviours), A} || {F, A} <- Exports],
+            Real = [{name(F, Behaviours), arity(F)} || F <- Fns],
+            Keys = [{Al, A} || {Al, _, A} <- Pairs],
+            [begin
+                 Clash = [N || {Al2, N, A2} <- Pairs, Al2 =:= Al, A2 =:= A]
+                         ++ [N || {N, A2} <- Real, N =:= Al, A2 =:= A],
+                 case length(Clash) > 1 of
+                     true -> erlang:error({alias_collision, Al, A, lists:usort(Clash)});
+                     false -> ok
+                 end,
+                 P
+             end || {Al, N, A} = P <- Pairs, Al =/= N, lists:member({Al, A}, Keys)];
+        _ -> []
+    end.
+
+alias_exports(Exports, Fns, Behaviours) ->
+    [{Al, A} || {Al, _, A} <- alias_pairs(Exports, Fns, Behaviours)].
+
+alias_forms(Exports, Fns, Behaviours) ->
+    [begin
+         Vs = [{var, ?A, list_to_atom("A" ++ integer_to_list(I))} || I <- lists:seq(1, A)],
+         {function, ?A, Al, A, [{clause, ?A, Vs, [], [{call, ?A, {atom, ?A, N}, Vs}]}]}
+     end || {Al, N, A} <- alias_pairs(Exports, Fns, Behaviours)].
