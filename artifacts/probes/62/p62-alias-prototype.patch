+%%% PROTOTYPE 62c (scratch copy only; NOT in the repo): snake_case aliases.
+alias_mode() -> case os:getenv("BS_ALIAS") of false -> off; M -> list_to_atom(M) end.
+
+snake(Atom) ->
+    L = atom_to_list(Atom),
+    list_to_atom(string:lowercase(snake1(L, none))).
+snake1([], _) -> [];
+snake1([C | T], Prev) ->
+    Up = C >= $A andalso C =< $Z,
+    NextLow = case T of [N | _] -> N >= $a andalso N =< $z; [] -> false end,
+    PrevLow = Prev =/= none andalso ((Prev >= $a andalso Prev =< $z) orelse (Prev >= $0 andalso Prev =< $9)),
+    PrevUp = Prev =/= none andalso (Prev >= $A andalso Prev =< $Z),
+    Sep = Up andalso (PrevLow orelse (PrevUp andalso NextLow)),
+    (case Sep of true -> [$_]; false -> [] end) ++ [C] ++ snake1(T, C).
+
+alias_for(F, Behaviours) ->
+    N = element(2, F),
+    case emitted_name(N, arity(F), Behaviours) of
+        N -> A = snake(N), case A =:= N of true -> none; false -> {ok, A} end;
+        _ -> none
+    end.
+
+alias_exports(Exports, Behaviours) ->
+    case alias_mode() of
+        off -> [];
+        _ -> lists:usort([{A, Ar} || {F, Ar} <- Exports, {ok, A} <- [alias_for(F, Behaviours)]])
+    end.
+
+alias_forms(F, Env, Behaviours, Ctx) ->
+    case {alias_mode(), is_public(F), alias_for(F, Behaviours)} of
+        {off, _, _} -> [];
+        {_, false, _} -> [];
+        {_, _, none} -> [];
+        {Mode, true, {ok, A}} ->
+            Ar = arity(F),
+            Vars = [{var, ?A, list_to_atom("A" ++ integer_to_list(I))} || I <- lists:seq(1, Ar)],
+            case Mode of
+                dup -> F2 = setelement(2, F, A), [spec_attr(F2, Env, Behaviours), function(F2, Ctx)];
+                deleg -> [delegate(A, element(2, F), Vars)];
+                delegspec -> F2 = setelement(2, F, A), [spec_attr(F2, Env, Behaviours), delegate(A, element(2, F), Vars)]
+            end
+    end.
+
+delegate(A, N, Vars) ->
+    {function, ?A, A, length(Vars), [{clause, ?A, Vars, [], [{call, ?A, {atom, ?A, N}, Vars}]}]}.
+
 %% The checker's note for the node at `L` in the file being emitted, where the
 %% checker leaves one only for some nodes of that form.
 find_note(Kind, L, C) -> maps:find({maps:get(file, C), L}, maps:get(Kind, C)).
