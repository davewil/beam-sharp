+%% PROTOTYPE (ticket 64 probe): run the member-wise absorption check on a polymorphic
+%% call's instantiated return. subst_tpl keeps the template's union members apart until
+%% the substitution, so the same absorbed/2 that F31 uses at the declaration applies.
+inst_collapse(L, Shown, RT, Sub, C) -> inst_collapse1(L, Shown, RT, Sub, C).
+inst_collapse1(L, Shown, {t_union, Ms}, Sub, C) ->
+    Rs = [subst_tpl(M, Sub) || M <- Ms],
+    %% only members written ground in the template (already resolved to algebra
+    %% maps) can be the failure member; a bare variable member is the success side
+    lists:append(
+      [case is_map(M) of
+           false -> [];
+           true ->
+               Others = bs_types:union(Rs -- [R]),
+               case absorbed(R, Others) of
+                   true  ->
+                       Ch = case bs_types:is_subtype(R, bs_types:atom_lit(nothing)) of
+                                true -> nothing; false -> error end,
+                       [{error, L, C#ctx.fname,
+                         {absorbed_member, L, Shown, Ch, R, Others}}];
+                   false -> []
+               end
+       end || {M, R} <- lists:zip(Ms, Rs)]);
+inst_collapse1(_, _, _, _, _) -> [].
+
