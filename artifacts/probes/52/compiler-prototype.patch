diff -ruN a/src/bs_check.erl b/src/bs_check.erl
--- a/src/bs_check.erl	2026-10-05 23:14:05.796816019 +0000
+++ b/src/bs_check.erl	2026-10-05 23:15:35.009004774 +0000
@@ -90,7 +90,38 @@
     %% Unknown-type errors can suggest a `using` from the reachable world.
     with_type_hints(World, fun() -> check_dir1(Sources, World, Expect) end).
 
-check_dir1(Sources0, World, Expect) ->
+check_dir1(Sources00, World, Expect) ->
+    Reqs = lists:append([[R || R <- D, element(1, R) =:= requires]
+                         || {_, D} <- Sources00]),
+    Sources0 = [{P, [X || X <- D, element(1, X) =/= requires]}
+                || {P, D} <- Sources00],
+    _ = [case code:lib_dir(App) of
+             {error, _} -> erlang:error({app_not_on_path, RL, App, RM});
+             LibDir ->
+                 %% PROBE: BS_PROTO_STRONG also demands that the module is
+                 %% found, and found inside the declared application.
+                 case os:getenv("BS_PROTO_STRONG") of
+                     false -> ok;
+                     _ when RM =:= module -> ok;
+                     _ -> case code:which(RM) of
+                              W when is_list(W) ->
+                                  case lists:prefix(LibDir, W) of
+                                      true -> ok;
+                                      false -> erlang:error({app_not_on_path, RL, App, RM})
+                                  end;
+                              _ -> erlang:error({app_not_on_path, RL, App, RM})
+                          end
+                 end
+         end || {requires, RL, App, RM} <- Reqs],
+    %% PROBE HOOK for variant C (no new syntax): refuse any foreign `using` whose
+    %% module is not loadable. Off unless BS_PROTO_CHECK_MODULES is set.
+    _ = case os:getenv("BS_PROTO_CHECK_MODULES") of
+            false -> ok;
+            _ -> [case code:which(FM) of
+                      non_existing -> erlang:error({app_not_on_path, FL, FM, FM});
+                      _ -> ok
+                  end || {foreign, FL, FM, _} <- lists:append([D || {_, D} <- Sources0])]
+        end,
     {Imports, Env} = declared(Sources0, World, Expect, strict),
     %% F64: an `implements` block becomes the function it defines, after
     %% `declared/4` has refused it by kind.
@@ -149,6 +180,7 @@
                          type_vars => lists:usort(lists:append(
                              [Ps || {type_alias, _, _, Ps, _} <- Decls])),
                          behaviours => [B || {behaviour, _, B} <- Decls],
+                         requires => [{A, M} || {requires, _, A, M} <- Reqs],
                          %% The emitter consumes imports resolved at check
                          %% time.
                          imports => resolved_funs(Imports, local_keys(Decls)),
