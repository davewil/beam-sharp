 line(T) -> element(2, T).
 
+app_marks({L, app, Apps}, {foreign, _, Mod, _} = D) ->
+    [{requires, L, A, Mod} || A <- Apps] ++ [D];
+app_marks({L, app, Apps}, {module, _, _} = D) ->
+    [{requires, L, A, module} || A <- Apps] ++ [D];
+app_marks({L, K, _}, _) ->
+    return_error(L, "unknown attribute " ++ atom_to_list(K)).
