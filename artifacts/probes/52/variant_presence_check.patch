diff --git a/src/bs_check.erl b/src/bs_check.erl
index 4494719..38fd648 100644
--- a/src/bs_check.erl
+++ b/src/bs_check.erl
@@ -323,6 +323,7 @@ declared(Sources, World, Expect, Mode) ->
     %% Refuse undecidable foreign returns before `foreign_wrappers/2` calls
     %% `error_members/1`, which requires non-recursive members.
     foreign_rets_decidable(Decls, Env),
+    foreign_modules_present(Decls, World),
     %% Scan bodies for `ToJson<T>` refusals: `--api` does not type bodies.
     to_json_refused(Decls ++ implementation_clauses(Decls), Env),
     %% F64: a block's type arguments resolve here, so `--api` refuses
@@ -628,6 +629,15 @@ callees(Decls, Env, Imports) ->
 %%% `string` with `binary`.
 %%% Rationale: compiler/features/F40-foreign-return-rule.md.
 
+%% A `using :Mod { ... }` names a module the program will call. Refuse one that is
+%% neither compiled in this invocation nor on the code path (nor preloaded).
+foreign_modules_present(Decls, World) ->
+    [case maps:is_key(Mod, World) orelse code:which(Mod) =/= non_existing of
+         true  -> ok;
+         false -> erlang:error({foreign_module_absent, Mod, L})
+     end || {foreign, L, Mod, _Sigs} <- Decls],
+    ok.
+
 foreign_rets_decidable(Decls, Env) ->
     _ = [foreign_ret_decidable(L, Mod, N, R, Env)
          || {foreign, _, Mod, Sigs} <- Decls,
