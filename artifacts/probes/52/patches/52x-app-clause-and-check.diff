+%%% PROTOTYPE 52x: the declared application is checked against the code path.
+%%% BSB_DEP_CHECK=off disables it (to measure the verdict's environment dependence).
+foreign_deps_check(Decls) ->
+    case os:getenv("BSB_DEP_CHECK") of
+        "off" -> ok;
+        "warn" -> ok;
+        _ ->
+            [foreign_dep_check(L, Mod, App) || {foreign, L, Mod, _, App} <- Decls],
+            ok
+    end.
+
+foreign_dep_check(L, Mod, App) ->
+    case code:which(Mod) of
+        non_existing -> erlang:error({foreign_module_absent, L, Mod, App});
+        Beam when App =/= none ->
+            Dir = case code:lib_dir(App) of {error, _} -> none; D -> D end,
+            case Dir =/= none andalso lists:prefix(Dir, Beam) of
+                true  -> ok;
+                false -> erlang:error({foreign_module_not_in_app, L, Mod, App, Beam})
+            end;
+        _ -> ok
+    end.
