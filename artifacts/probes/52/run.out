################ p2_otp_introspection.sh
--- module present on path, app NOT loaded
code:which(fakereq)        = "/tmp/tmp.q0zxuHsufH/lib/fakereq-1.2.3/ebin/fakereq.beam"
code:which(nope)           = non_existing
code:lib_dir(fakereq)      = "/tmp/tmp.q0zxuHsufH/lib/fakereq-1.2.3"
code:lib_dir(nope)         = {error,bad_name}
get_application(fakereq)   = undefined
get_key(fakereq,vsn)       = undefined
--- after application:load(fakereq)
get_key(fakereq,vsn)       = {ok,"1.2.3"}
get_key(fakereq,modules)   = {ok,[fakereq]}
get_application(fakereq)   = {ok,fakereq}
--- module -> app is known to OTP only through a LOADED .app file, and the names differ (Elixir.Logger lives in app logger)
code:which('Elixir.String') = "/usr/lib/elixir/lib/elixir/ebin/Elixir.String.beam"
code:which('Elixir.Logger') = "/usr/lib/elixir/lib/logger/ebin/Elixir.Logger.beam"
get_application('Elixir.String') = {ok,elixir}  (module String lives in app elixir)
get_application('Elixir.Logger') = {ok,logger}  (module Logger lives in app logger)
--- app lookup by file when module is absent but app dir exists with the .app file
code:where_is_file("fakereq.app") = "/tmp/tmp.q0zxuHsufH/lib/fakereq-1.2.3/ebin/fakereq.app"
code:where_is_file("req.app")     = non_existing
--- scan ERL_LIBS-style path for an .app declaring a module (cost, 1 call)
scanned 38 .app files in 4028 us

