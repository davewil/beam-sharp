     %% Scan bodies for `ToJson<T>` and `FromJson<T>` refusals: `--api` does
     %% not type bodies.
     wire_form_refused(Decls ++ implementation_clauses(Decls), Env),
@@ -620,11 +621,43 @@ callees(Decls, Env, Imports) ->
              || {signature, SL, N, R, Ps, _, TV} <- Decls],
     Foreign = [{{f, Mod, N, length(Ps)},
                 at_loc(L, fun() -> sig(Ps, R, Env) end)}
-               || {foreign, _, Mod, Sigs} <- Decls,
+               || {foreign, _, Mod, Sigs, _} <- Decls,
                   {foreign_sig, L, N, R, Ps} <- Sigs],
     maps:merge(maps:get(qual, Imports, #{}),
                maps:from_list(Local ++ Foreign)).
 
+%%% Foreign modules must be on the code path (ticket 52 prototype).
+foreign_modules_available(Decls) ->
+    _ = [foreign_available(L, Mod, App) || {foreign, L, Mod, _Sigs, App} <- Decls],
+    ok.
+
+foreign_available(L, Mod, App) ->
+    case {code:which(Mod), App} of
+        {non_existing, none} ->
+            erlang:error({foreign_module_unavailable, L, Mod});
+        {non_existing, _} ->
+            case code:lib_dir(App) of
+                {error, _} -> erlang:error({foreign_app_unavailable, L, Mod, App});
+                _          -> erlang:error({foreign_module_not_in_app, L, Mod, App, none})
+            end;
+        {_, none} -> ok;
+        {Path, _} ->
+            case owner_app(Path) of
+                App -> ok;
+                unknown -> ok;
+                Other -> erlang:error({foreign_module_not_in_app, L, Mod, App, Other})
+            end
+    end.
+
+%% The owner is the application whose .app file sits beside the beam; a loose
+%% directory with no .app has no owner (`unknown`) and is not refused.
+owner_app(preloaded) -> erts;
+owner_app(Path) when is_list(Path) ->
+    case filelib:wildcard(filename:join(filename:dirname(Path), "*.app")) of
+        [F | _] -> list_to_atom(filename:basename(F, ".app"));
+        []      -> unknown
+    end.
+
 %%% Foreign returns
 %%% A foreign return must be decidable by one O(1) BEAM guard. Parameters are
 %%% established by their producers and are not checked by this pass. Recursive
