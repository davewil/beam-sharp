@@ -1905,6 +1914,24 @@ message(#{tag := foreign_ret_beyond_one_guard, module := Mod, function := Fun,
     {placed(D) ++ "error: ~s.~s returns `~s`, which one guard cannot decide~n~s~s",
      placed_args(D) ++ [Mod, Fun, Type, beyond_why(Why, Name),
                         beyond_edit(Why, At, Type, Name, Fields)]};
+message(#{tag := foreign_module_unavailable, module := Mod} = D) ->
+    {placed(D) ++ "error: the module ~s is not on the code path~n"
