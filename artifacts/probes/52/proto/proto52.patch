+%% ---- PROTOTYPE 52 -----------------------------------------------------------
+%% A 5-tuple foreign decl carries the application. Strip it back to the 4-tuple
+%% every later pass already matches and park {App, Mod, Line} per file.
+bs52_strip(Path, Decls) ->
+    Needs = [{A, M, L} || {foreign, L, M, _, A} <- Decls],
+    put({bs52_needs, Path}, Needs),
+    [case D of {foreign, L, M, S, _} -> {foreign, L, M, S}; _ -> D end || D <- Decls].
+
+bs52_mode() -> case os:getenv("BS52") of "" -> false; "off" -> false; V -> V end.
+bs52_ln({L,_}) -> L; bs52_ln(L) -> L.   %% false | "module" | "app" | "attr"
+
+%% Returns ok | {error, [Msg]}. Messages are prose, printed by the caller.
+bs52_check(Sources) ->
+    Mode = bs52_mode(),
+    Errs = lists:append([bs52_check1(Mode, P, D) || {P, D} <- Sources]),
+    case Errs of [] -> ok; _ -> {error, Errs} end.
+
+bs52_check1(false, _, _) -> [];
+bs52_check1("attr", _, _) -> [];
+bs52_check1(Mode, Path, Decls) ->
+    Needs = case get({bs52_needs, Path}) of undefined -> []; N -> N end,
+    Declared = maps:from_list([{M, {A, L}} || {A, M, L} <- Needs]),
+    lists:append(
+      [begin
+           Where = case Path of P when is_list(P) -> P; _ -> "<string>" end,
+           case {Mode, maps:find(M, Declared)} of
+               {"module", _} -> bs52_mod(Where, L, M);
+               {"app", {ok, {A, _}}} -> bs52_app(Where, L, M, A);
+               {"app", error} -> []
+           end
+       end || {foreign, L, M, _} <- Decls]).
+
+bs52_mod(Where, L, M) ->
+    case code:which(M) of
+        non_existing ->
+            [io_lib:format("~s:~p: error: module '~s' is not on the code path~n"
+                           "  `using :'~s'` promises it; nothing here says which application provides it.~n",
+                           [Where, bs52_ln(L), M, M])];
+        _ -> []
+    end.
+
+bs52_app(Where, L, M, A) ->
+    case code:lib_dir(A) of
+        {error, _} ->
+            [io_lib:format("~s:~p: error: application '~s' (declared for module '~s') is not on the code path~n"
+                           "  put its directory on ERL_LIBS, or fix the name after `in`.~n",
+                           [Where, bs52_ln(L), A, M])];
+        Dir ->
+            case code:which(M) of
+                non_existing ->
+                    [io_lib:format("~s:~p: error: application '~s' is present (~s) but does not contain module '~s'~n",
+                                   [Where, bs52_ln(L), A, Dir, M])];
+                Beam ->
+                    case lists:prefix(Dir ++ "/", Beam) of
+                        true -> [];
+                        false -> [io_lib:format("~s:~p: error: module '~s' resolves to ~s, outside application '~s' (~s)~n",
+                                                [Where, bs52_ln(L), M, Beam, A, Dir])]
+                    end
+            end
+    end.
+
+bs52_attr(Sources) ->
+    lists:usort(lists:append([case get({bs52_needs, P}) of undefined -> []; N -> [{A, M} || {A, M, _} <- N] end
+                              || {P, _} <- Sources])).
+%% ---- END PROTOTYPE 52 -------------------------------------------------------
