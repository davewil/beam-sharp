@@ -947,6 +947,12 @@
 negate(_L, {e_float, FL, F}) -> {e_float, FL, -F};
 negate(L, E)                 -> {e_neg, L, E}.
 
+%% PROTOTYPE (ticket 57, refinement-only fold): rewrite `-<int literal>` to the
+%% literal, but only inside a refinement's own comparison tree.
+fold_refinement({e_op, L, Op, A, B}) -> {e_op, L, Op, fold_refinement(A), fold_refinement(B)};
+fold_refinement({e_neg, _, {e_int, IL, I}}) -> {e_int, IL, -I};
+fold_refinement(E) -> E.
