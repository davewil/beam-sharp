module AssignsB

// STAND-IN for a prelude `found<T>`: a user parametric alias (F31 amendment 2026-10-08 says these compile).
type Found<T> = (:ok, T) | :absent

using :maps {
    map<term, term> from_list(list<(term, term)> pairs)
    (:ok, term) | :error find(term key, map<atom, term> m)    // OTP's real shape
}

// What a lowered `Map.?Get` would have to emit: OTP says `error`, the blessed type says `:absent`.
private Found<term> Fetch(atom key, map<atom, term> m)
Fetch(key, m) -> :maps.find(key, m) switch {
    (:ok, v) => (:ok, v),
    :error   => :absent
}

public map<term, term> Anon()
Anon() -> :maps.from_list([])

public map<term, term> LoggedOut()
LoggedOut() -> :maps.from_list([(:user, :nothing)])

public atom Who(map<term, term> raw)
Who(raw) -> ValidateAs<map<atom, term>>(raw) switch {
    (:error, e) => :not_assigns,
    assigns     => Lookup(assigns)
}

private atom Lookup(map<atom, term> assigns)
Lookup(assigns) -> Fetch(:user, assigns) switch {
    :absent         => :no_assign,
    (:ok, :nothing) => :explicitly_logged_out,
    (:ok, u)        => :has_user
}

public atom RunAnon()
RunAnon() -> Who(Anon())

public atom RunLoggedOut()
RunLoggedOut() -> Who(LoggedOut())
