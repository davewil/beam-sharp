diff -u -r a/compiler/src/bs_check.erl b/compiler/src/bs_check.erl
--- a/compiler/src/bs_check.erl	2026-10-15 23:09:19.518654112 +0000
+++ b/compiler/src/bs_check.erl	2026-10-15 23:09:19.520519056 +0000
@@ -497,17 +497,41 @@
 
 add_import(L, M, Self, World, Known, Mode, Acc) ->
     case maps:is_key(M, World) of
-        true  -> add_module_import(M, World, Acc);
+        true  -> may_name(Self, M, L, Mode),
+                 add_module_import(M, World, Acc);
         false ->
             %% Namespaces emit nothing. Exclude `Self`: importing its namespace
             %% must not make a module its own dependency.
             case {children(M, Known) -- [Self], Mode} of
                 {[], strict}  -> erlang:error({unknown_module, M, L});
                 {[], lenient} -> Acc;
-                {Children, _} -> add_namespace_import(M, Children, Acc)
+                {Children, _} ->
+                    add_namespace_import(M, [C || C <- Children, nameable(Self, C)], Acc)
             end
     end.
 
+%% PROTOTYPE (ticket 60): `P.Internal[.Q]` may be named only from P or below.
+may_name(Self, M, L, strict) ->
+    case nameable(Self, M) of
+        true  -> ok;
+        false -> erlang:error({module_not_visible, M, Self, internal_scope(M), L})
+    end;
+may_name(_, _, _, _) -> ok.
+
+nameable(Self, M) ->
+    case internal_scope(M) of
+        none  -> true;
+        Scope -> Self =:= Scope orelse
+                 lists:prefix(atom_to_list(Scope) ++ ".", atom_to_list(Self))
+    end.
+
+internal_scope(M) ->
+    case string:split(atom_to_list(M), ".Internal", leading) of
+        [Pre, Post] when Pre =/= "", (Post =:= "" orelse hd(Post) =:= $.) ->
+            list_to_atom(Pre);
+        _ -> none
+    end.
+
 %% Local names take precedence over imports at `unqualified_key/4`.
 add_module_import(M, World, Acc) ->
     Entry = maps:get(M, World),
