+%%% PROTOTYPE (ticket 62, option 2): one snake_case alias export per public
+%%% function, a local wrapper that tail-calls the PascalCase function.
+alias_table(Emitted) ->
+    Names = [N || {N, _} <- Emitted],
+    Cands = [{snake(N), A, N} || {N, A} <- Emitted, snake(N) =/= N],
+    Reserved = [{module_info, 0}, {module_info, 1}],
+    Keys = [{Al, A} || {Al, A, _} <- Cands],
+    lists:filter(
+      fun({Al, A, N}) ->
+          Dup = length([x || K <- Keys, K =:= {Al, A}]) > 1,
+          Clash = lists:member({Al, A}, Reserved) orelse lists:member(Al, Names),
+          case Dup orelse Clash of
+              true  -> io:format(standard_error, "bs_alias_collision: ~p/~p from ~p~n", [Al, A, N]), false;
+              false -> true
+          end
+      end, Cands).
+
+alias_form(Al, A, Target) ->
+    Vs = [{var, ?A, list_to_atom("A" ++ integer_to_list(I))} || I <- lists:seq(1, A)],
+    {function, ?A, Al, A, [{clause, ?A, Vs, [], [{call, ?A, {atom, ?A, Target}, Vs}]}]}.
+
+%% PascalCase -> snake_case, acronym-aware (Elixir's Macro.underscore shape):
+%% `_` goes before an upper-case letter that follows a lower-case letter or a
+%% digit, or that starts a word after an upper-case run (`HTTPGet` -> http_get).
+snake(Atom) ->
+    S = atom_to_list(Atom),
+    list_to_atom(snake(S, undefined)).
+snake([], _) -> [];
+snake([C | T], Prev) ->
+    Next = case T of [] -> undefined; [N | _] -> N end,
+    Up = fun(X) -> X =/= undefined andalso X >= $A andalso X =< $Z end,
+    Lo = fun(X) -> X =/= undefined andalso ((X >= $a andalso X =< $z) orelse (X >= $0 andalso X =< $9)) end,
+    Sep = Up(C) andalso Prev =/= undefined andalso Prev =/= $_ andalso
+          (Lo(Prev) orelse (Up(Prev) andalso Next =/= undefined andalso Lo(Next) andalso not (Next >= $0 andalso Next =< $9))),
+    Out = case Up(C) of true -> C + 32; false -> C end,
+    (case Sep of true -> [$_]; false -> [] end) ++ [Out | snake(T, C)].
 
 %% `undefined` is the one-source callers (`compile_string/2`, the REPL) that
 %% have no path to attribute to; no attribute is emitted for them.
