## F. grammar-fix build: D = -10..10, F(<= -1) and F(>= 2) handled -> residual 0..1
a.bs:3:13: error: F is not exhaustive
  no clause matches:
    F(>= 0 and <= 1) -> ...
  pasted:
    F(>= 0 and <= 1) -> :new
  -> pasted program: ACCEPTED

## G. the algebra itself (bs_types), independent of any printer
subtract(-10..10, 0) = #{lists => [],maps => [],
                         atoms => {finite,[]},
                         funs => [],
                         floats => {finite,[]},
                         tuples => [],bins => [],opaques => [],
                         ints => [{-10,-1},{1,10}]}
is_subtype(-10..-1, result) = true ; is_subtype(0..0, result) = false
