module Diff

public int A()
A() -> - -5
public int B()
B() -> -(2 + 3)
public int C()
C() -> 1 - -5
public int D()
D() -> -5 * 3
public int E()
E() -> - 2 * 3
public int F()
F() -> 10 - -5 - -5
public int G(int x)
G(x) -> -x - -5
public int H()
H() -> -0
public atom I(int n)
I(-5) -> :five
I(n) when n >= -4 -> :ge
I(_) -> :lt
