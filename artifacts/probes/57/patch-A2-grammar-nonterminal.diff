   bin_segments bin_segment bin_size
   guard guard_expr
   body binding
@@ -218,7 +218,24 @@ type_decl -> 'type' uident '=' type_expr 'where' refinement :
 %% The predicate is an ordinary expression, read back by the same
 %% `alternatives/1` a guard goes through, so a refinement and a guard cannot
 %% disagree about what `value >= 0` means (F2.5).
-refinement -> expr_low : '$1'.
+%% Patch A2: a dedicated predicate grammar whose comparand is an int_lit.
+refinement -> ref_or : '$1'.
+ref_or -> ref_or 'or' ref_and  : {e_op, line('$2'), 'or', '$1', '$3'}.
+ref_or -> ref_and              : '$1'.
+ref_and -> ref_and 'and' ref_cmp : {e_op, line('$2'), 'and', '$1', '$3'}.
+ref_and -> ref_cmp             : '$1'.
+ref_cmp -> lident ref_op ref_k : {e_op, line('$1'), element(1,'$2'), {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> ref_k ref_op lident : {e_op, line('$3'), element(1,'$2'), '$1', {e_var, line('$3'), value('$3')}}.
+ref_cmp -> '(' ref_or ')'      : '$2'.
+ref_k -> int_lit  : {e_int, 0, '$1'}.
+ref_k -> atom_lit : {e_atom, line('$1'), value('$1')}.
+ref_k -> string_lit : {e_str, line('$1'), value('$1')}.
+ref_op -> '==' : {'==', 0}.
+ref_op -> '!=' : {'!=', 0}.
+ref_op -> '<'  : {'<', 0}.
+ref_op -> '>'  : {'>', 0}.
+ref_op -> '<=' : {'<=', 0}.
+ref_op -> '>=' : {'>=', 0}.
 
