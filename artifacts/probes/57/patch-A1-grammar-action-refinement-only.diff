diff --git a/compiler/src/bs_parser.yrl b/compiler/src/bs_parser.yrl
index 6007624..db2f740 100644
--- a/compiler/src/bs_parser.yrl
+++ b/compiler/src/bs_parser.yrl
@@ -218,7 +218,7 @@ type_decl -> 'type' uident '=' type_expr 'where' refinement :
 %% The predicate is an ordinary expression, read back by the same
 %% `alternatives/1` a guard goes through, so a refinement and a guard cannot
 %% disagree about what `value >= 0` means (F2.5).
-refinement -> expr_low : '$1'.
+refinement -> expr_low : refine_neg('$1').
 
 %% A parametric alias binds its variables here and substitutes them at the
 %% use, so `Pair<int>` resolves to the tuple before `bs_types` sees it. A
@@ -947,6 +947,12 @@ to_param(E) ->
 negate(_L, {e_float, FL, F}) -> {e_float, FL, -F};
 negate(L, E)                 -> {e_neg, L, E}.
 
+%% Patch A1: in a refinement ONLY, a negated integer literal is the literal.
+refine_neg({e_neg, _, {e_int, IL, N}}) -> {e_int, IL, -N};
+refine_neg({e_neg, L, E})              -> {e_neg, L, refine_neg(E)};
+refine_neg({e_op, L, Op, A, B})        -> {e_op, L, Op, refine_neg(A), refine_neg(B)};
+refine_neg(E)                          -> E.
+
 to_param_rest(_L, nil)               -> nil;
 to_param_rest(_L, {e_wild, WL})      -> {p_wild, WL};
 to_param_rest(_L, {e_var, VL, V})    -> {p_var, VL, V};
