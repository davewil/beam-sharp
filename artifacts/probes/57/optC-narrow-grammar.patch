 %% The predicate is an ordinary expression, read back by the same
 %% `alternatives/1` a guard goes through, so a refinement and a guard cannot
 %% disagree about what `value >= 0` means (F2.5).
-refinement -> expr_low : '$1'.
+refinement -> ref_or : '$1'.
+ref_or  -> ref_and 'or' ref_or : {e_op, line('$2'), 'or', '$1', '$3'}.
+ref_or  -> ref_and : '$1'.
+ref_and -> ref_cmp 'and' ref_and : {e_op, line('$2'), 'and', '$1', '$3'}.
+ref_and -> ref_cmp : '$1'.
+ref_cmp -> lident '>='  ref_k : {e_op, line('$2'), '>=', {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> lident '>'   ref_k : {e_op, line('$2'), '>',  {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> lident '<='  ref_k : {e_op, line('$2'), '<=', {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> lident '<'   ref_k : {e_op, line('$2'), '<',  {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> lident '=='  ref_k : {e_op, line('$2'), '==', {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> lident '!='  ref_k : {e_op, line('$2'), '!=', {e_var, line('$1'), value('$1')}, '$3'}.
+ref_cmp -> lident '=='  atom_lit   : {e_op, line('$2'), '==', {e_var, line('$1'), value('$1')}, {e_atom, line('$3'), value('$3')}}.
+ref_cmp -> lident '!='  atom_lit   : {e_op, line('$2'), '!=', {e_var, line('$1'), value('$1')}, {e_atom, line('$3'), value('$3')}}.
+ref_cmp -> lident '=='  string_lit : {e_op, line('$2'), '==', {e_var, line('$1'), value('$1')}, {e_str, line('$3'), value('$3')}}.
+ref_cmp -> lident '!='  string_lit : {e_op, line('$2'), '!=', {e_var, line('$1'), value('$1')}, {e_str, line('$3'), value('$3')}}.
+ref_k -> int_lit : {e_int, 0, '$1'}.
 
