+comparison({e_op, _, Op, {e_var, _, V}, R}) ->
+    case const_int(R) of {ok, K} -> int_cmp(Op, V, K); error -> unknown end;
+comparison({e_op, _, Op, L, {e_var, _, V}}) ->
+    case const_int(L) of {ok, K} -> int_cmp(flip(Op), V, K); error -> unknown end;
 comparison(_) ->
