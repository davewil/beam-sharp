+%% EXPERIMENT B: the constant test reads a folded literal expression.
+const_int({e_int, _, N}) -> {ok, N};
+const_int({e_neg, _, E}) ->
+    case const_int(E) of {ok, N} -> {ok, -N}; error -> error end;
+const_int(_) -> error.
+
 int_cmp('>',  V, K) -> {V, {include, bs_types:range(K + 1, pos_inf)}};
 int_cmp('>=', V, K) -> {V, {include, bs_types:range(K, pos_inf)}};
 int_cmp('<',  V, K) -> {V, {include, bs_types:range(neg_inf, K - 1)}};
