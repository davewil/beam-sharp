 %% The predicate is an ordinary expression, read back by the same
 %% `alternatives/1` a guard goes through, so a refinement and a guard cannot
 %% disagree about what `value >= 0` means (F2.5).
-refinement -> expr_low : '$1'.
+refinement -> refinement 'or'  refinement : {e_op, line('$2'), 'or',  '$1', '$3'}.
+refinement -> refinement 'and' refinement : {e_op, line('$2'), 'and', '$1', '$3'}.
+refinement -> '(' refinement ')'          : '$2'.
+refinement -> lident ref_op int_lit :
+    {e_op, line('$2'), element(1, '$2'), {e_var, line('$1'), value('$1')}, {e_int, line('$2'), '$3'}}.
+refinement -> int_lit ref_op lident :
+    {e_op, line('$2'), element(1, '$2'), {e_int, line('$2'), '$1'}, {e_var, line('$3'), value('$3')}}.
+refinement -> lident '==' atom_lit :
+    {e_op, line('$2'), '==', {e_var, line('$1'), value('$1')}, {e_atom, line('$3'), value('$3')}}.
+refinement -> lident '!=' atom_lit :
+    {e_op, line('$2'), '!=', {e_var, line('$1'), value('$1')}, {e_atom, line('$3'), value('$3')}}.
+ref_op -> '==' : '$1'.
+ref_op -> '!=' : '$1'.
+ref_op -> '<'  : '$1'.
+ref_op -> '>'  : '$1'.
+ref_op -> '<=' : '$1'.
+ref_op -> '>=' : '$1'.
 
