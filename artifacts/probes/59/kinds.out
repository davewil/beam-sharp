== emitter base ==
  DoubleP(1.5)   [exported int, control]         {error,function_clause}
  DoubleP(2)     [control]                       {ok,4}
  Doubled([1.5]) [list elem -> private fun]      {ok,[3.0]}
  Doubled([2])   [control]                       {ok,[4]}
  FromField(#{Level=1.5}) [map field]            {ok,3.0}
  Picker(x)(1.5) [escaped private fun]           {ok,3.0}
  Bands([300]) [out-of-range elem, Octet]        {ok,[high]}
  Bands([-5])  [out-of-range elem, Octet]        {ok,[low]}
  Bands([100]) [control]                         {ok,[high]}
  Bands([foo]) [atom elem]                       {ok,[high]}
