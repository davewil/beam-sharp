     {function, ?A, Name, Arity, [clause(C, Params, Ctx, Public) || C <- Clauses]}.
 
+%% PROTOTYPE (ticket 59, option C): a private function whose name is taken as a
+%% value anywhere in the module (`Free`, `Double/1`) can be called by whoever the
+%% fun is handed to, so it is reachable by an unchecked caller exactly as an
+%% exported one is. `fnames` holds one `{Name, Arity}` per such site.
+escapes(F, #{fnames := FN}) -> lists:member({element(2, F), arity(F)}, maps:values(FN));
+escapes(_, _) -> false.
