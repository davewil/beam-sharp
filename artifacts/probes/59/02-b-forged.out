=================== compiler: wide (PROTOTYPE: kind test also on private fns)
'Classify'(N)
    when
        is_integer(N)
        andalso
        N =< 255
        andalso
        N >= 9 ->
    big;
'Classify'(N)
    when
        is_integer(N)
        andalso
        N >= 0
        andalso
        N =< 255 ->
    small.

  ViaOctets([100.5])  [float via list into PRIVATE int fn]           => {error,function_clause}
  ViaOctets([300])   [out-of-range int via list into PRIVATE fn]     => {error,function_clause}
  ViaOctets([<<"x">>]) [binary via list into PRIVATE fn]             => {error,function_clause}
