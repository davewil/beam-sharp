'PubAmount'(O) when map_get('Kind', O) =:= 'Shop.Order' ->
    map_get('Total', O).

'PrivAmount'(O) when map_get('Kind', O) =:= 'Shop.Order' ->
    map_get('Total', O).

'PubInt'(N) when is_integer(N) ->
    N + 1.

'PrivInt'(N) ->
    N + 1.

'ViaCart'(C) when map_get('Kind', C) =:= 'Shop.Cart' ->
    'PrivAmount'(map_get('Item', C)).

