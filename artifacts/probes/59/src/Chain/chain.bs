module Chain

record Order { Id: int, Total: int }

// exported guarded -> private guarded (pass-through): is the callee's test elided by erlc?
public int Outer(int n)
Outer(n) -> Inner(n) + 1

private int Inner(int n)
Inner(n) -> n * 2

// exported record -> private record (pass-through)
public int Handle(Order o)
Handle(o) -> Tot(o)

private int Tot(Order o)
Tot(o) -> o.Total

// a private recursive loop: the guard sits on every iteration unless erlc proves it away
public int Loop(int n)
Loop(n) -> Go(n, 0)

private int Go(int n, int acc)
Go(n, acc) when n <= 0 -> acc
Go(n, acc) -> Go(n - 1, acc + n)

// private function reached with an UNKNOWN-type argument (list element)
private int Cap(int n)
Cap(n) -> n * 3

public list<int> Many(list<int> xs)
Many(xs) -> List.Map(xs, Cap/1)
