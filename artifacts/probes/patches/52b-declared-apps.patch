 %%% A warning, not an error: `bsc` may compile on a machine that is not the one
 %%% that runs the program. `preloaded` and `cover_compiled` are present.
 foreign_unavailable(Sources) ->
-    [{P, {warning, L, <<"using">>, {foreign_module_unavailable, Mod}}}
-     || {P, Ds} <- Sources, {foreign, L, Mod, _} <- Ds,
-        code:which(Mod) =:= non_existing].
+    Declared = declared_apps(),
+    lists:append(
+      [case code:which(Mod) of
+           non_existing -> [{P, {warning, L, <<"using">>, {foreign_module_unavailable, Mod}}}];
+           Path when is_list(Path), Declared =/= any ->
+               App = owner_app(Path),
+               case App =:= otp orelse lists:member(App, Declared) of
+                   true  -> [];
+                   false -> [{P, {warning, L, <<"using">>, {foreign_app_undeclared, Mod, App}}}]
+               end;
+           _ -> []
+       end || {P, Ds} <- Sources, {foreign, L, Mod, _} <- Ds]).
+
+%% Prototype B: the applications the build declares (rebar.config / .app.src),
+%% handed over as a comma list. `any` when nothing was declared.
+declared_apps() ->
+    case os:getenv("BSC_APPS") of
+        false -> any;
+        S     -> [list_to_atom(A) || A <- string:lexemes(S, ",")]
+    end.
+
+%% `.../req-0.5.0/ebin/Elixir.Req.beam` is application `req`; anything under
+%% the OTP lib directory is `otp`, which is always present.
+owner_app(Path) ->
+    case lists:prefix(code:lib_dir(), Path) of
+        true  -> otp;
+        false ->
+            [_Beam, "ebin", AppDir | _] = lists:reverse(filename:split(Path)),
+            list_to_atom(hd(string:split(AppDir, "-", trailing)))
+    end.
 
