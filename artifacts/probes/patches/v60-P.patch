+%% PROTOTYPE (ticket 60): a module's internals are callable only from inside the subtree rooted at its parent namespace.
+subtree_root(M) ->
+    case string:split(atom_to_list(M), ".", trailing) of
+        [Root, _] -> Root;
+        [Whole]   -> Whole
+    end.
+within(Self, Root) ->
+    S = atom_to_list(Self),
+    S =:= Root orelse lists:prefix(Root ++ ".", S).
+restrict(Self, World) ->
+    maps:map(fun(M, #{internal := Int} = E) when map_size(Int) > 0 ->
+                     case within(Self, subtree_root(M)) of
+                         true  -> E;
+                         false -> E#{exports := maps:without(maps:keys(Int), maps:get(exports, E)),
+                                     private := maps:merge(maps:get(private, E), Int)}
+                     end;
+                (_, E) -> E
