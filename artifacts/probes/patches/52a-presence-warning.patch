+%%% Ticket 52 (prototype): a `using` names a module the build machine cannot load.
+%%% A warning, not an error: `bsc` may compile on a machine that is not the one
+%%% that runs the program. `preloaded` and `cover_compiled` are present.
+foreign_unavailable(Sources) ->
+    [{P, {warning, L, <<"using">>, {foreign_module_unavailable, Mod}}}
+     || {P, Ds} <- Sources, {foreign, L, Mod, _} <- Ds,
+        code:which(Mod) =:= non_existing].
+
