######## C: no declaration (today's source + the module-only warning)
--- [C-machine1] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/Dep ViaExDep
    "HI"
    exit=0
--- [C-machine2] ERL_LIBS=FX/libB:ELIXIR_LIB  bsc bs/Dep ViaExDep
    bsc: warning: line {4,1}: using :'Elixir.ExDep' -- the module is not on the code path of this machine; a call will fail with error:undef (no application is declared)
    bsc: warning: line {8,1}: using :erldep -- the module is not on the code path of this machine; a call will fail with error:undef (no application is declared)
    crashed: error:undef
    exit=1

######## A: per-using declaration
--- [A-machine1] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/DeclA ViaExDep
    "HI"
    exit=0
--- [A-machine2] ERL_LIBS=FX/libB:ELIXIR_LIB  bsc bs/DeclA ViaExDep
    bsc: error: line {4,1}: application `exdep` (for :'Elixir.ExDep') is not on the code path (ERL_LIBS=FX/libB:ELIXIR_LIB)
    bsc: error: line {8,1}: application `erldep` (for :erldep) is not on the code path (ERL_LIBS=FX/libB:ELIXIR_LIB)
    exit=1
--- [A-machine2-pure-fn] ERL_LIBS=FX/libB:ELIXIR_LIB  bsc bs/DeclA Pure
    bsc: error: line {4,1}: application `exdep` (for :'Elixir.ExDep') is not on the code path (ERL_LIBS=FX/libB:ELIXIR_LIB)
    bsc: error: line {8,1}: application `erldep` (for :erldep) is not on the code path (ERL_LIBS=FX/libB:ELIXIR_LIB)
    exit=1
--- [A-wrong-app-name] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/WrongApp ViaExDep
    bsc: error: line {4,1}: application `ex_dep` (for :'Elixir.ExDep') is not on the code path (ERL_LIBS=FX/libA:ELIXIR_LIB)
    exit=1
--- [A-wrong-owner] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/WrongOwner ViaExDep
    bsc: error: line {4,1}: module :'Elixir.ExDep' belongs to application `exdep`, not `erldep`
    exit=1
--- [A-wrong-kind] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/WrongKind Up
    bsc: error: line {4,1}: external: erlang but :'Elixir.String' is an Elixir.* atom
    exit=1

######## B: once per module
--- [B-machine1] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/DeclB ViaExDep
    "HI"
    exit=0
--- [B-machine2] ERL_LIBS=FX/libB:ELIXIR_LIB  bsc bs/DeclB ViaExDep
    bsc: error: line {4,1}: :'Elixir.ExDep' is not on the code path (module-wide apps: [exdep,erldep,elixir])
    bsc: error: line {8,1}: :erldep is not on the code path (module-wide apps: [exdep,erldep,elixir])
    bsc: error: line {2,1}: application `exdep` is not on the code path (ERL_LIBS=FX/libB:ELIXIR_LIB)
    bsc: error: line {2,1}: application `erldep` is not on the code path (ERL_LIBS=FX/libB:ELIXIR_LIB)
    exit=1
-- B with a using whose app the module forgot to list (negative control for B: must be refused)
--- [B-forgot-exdep] ERL_LIBS=FX/libA:ELIXIR_LIB  bsc bs/DeclBforgot ViaErl
    bsc: error: line {4,1}: :'Elixir.ExDep' belongs to application `exdep`, which the module does not list (lists: [erldep,elixir])
    exit=1

