// Option A: provenance on each `using` block.
module DeclA

[external: elixir, app: exdep] using :'Elixir.ExDep' {
    binary shout(binary s)
}

[external: erlang, app: erldep] using :erldep {
    int double(int n)
}

[external: elixir, app: elixir] using :'Elixir.String' {
    binary upcase(binary s)
}

public binary ViaExDep(binary s)
ViaExDep(s) -> :'Elixir.ExDep'.shout(s)

public int ViaErl(int n)
ViaErl(n) -> :erldep.double(n)

public int Pure(int n)
Pure(n) -> n + 1
