// Probe a: three foreign modules, none of them declared as a dependency anywhere.
module Dep

using :'Elixir.ExDep' {
    binary shout(binary s)
}

using :erldep {
    int double(int n)
}

using :'Elixir.String' {
    binary upcase(binary s)
}

public binary ViaExDep(binary s)
ViaExDep(s) -> :'Elixir.ExDep'.shout(s)

public int ViaErl(int n)
ViaErl(n) -> :erldep.double(n)

public binary ViaStdlib(binary s)
ViaStdlib(s) -> :'Elixir.String'.upcase(s)

// Negative control: never touches a foreign module.
public int Pure(int n)
Pure(n) -> n + 1
