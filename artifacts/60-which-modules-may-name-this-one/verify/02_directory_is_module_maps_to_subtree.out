## the layout on disk (F15: a directory is a module; module name == dir path under --src-root)
Acme/Billing/Billing.bs
Acme/Orders/Orders.bs
Acme/Orders/Rules/Rules.bs
Acme/Reports/Reports.bs

## instrumentation diff vs. HEAD
+    io:format(standard_error, "[probe] checking Self=~p expect=~p files=~p~n", [Self, Expect, [P || {P, _} <- Sources]]),
+    io:format(standard_error, "[probe] add_import line=~p using=~p self=~p in_world=~p world=~p~n", [L, M, Self, maps:is_key(M, World), lists:sort(Known)]),

