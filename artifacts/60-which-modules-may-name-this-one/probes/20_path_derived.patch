@@ -473,6 +473,26 @@
     lists:sort([M || {M, Entry} <- maps:to_list(World),
                      maps:is_key(N, maps:get(types, Entry, #{}))]).
 
+%% PROTOTYPE A' (ticket 60): the PATH is the declaration. A module whose dotted name has an
+%% `Internal` segment may be named only by modules at or under the segments before the LAST such
+%% segment (Go's rule for `internal` directories, run in probe 19). No keyword, no World entry.
+internal_root(M) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case [I || {S, I} <- lists:zip(Segs, lists:seq(1, length(Segs))), S =:= "Internal"] of
+        []  -> none;
+        Is  -> case lists:last(Is) of
+                   1 -> none;
+                   I -> list_to_atom(lists:flatten(lists:join(".", lists:sublist(Segs, I - 1))))
+               end
+    end.
+
+visible_to(Self, M) ->
+    case internal_root(M) of
+        none   -> true;
+        Prefix -> S = atom_to_list(Self), P = atom_to_list(Prefix),
+                  S =:= P orelse lists:prefix(P ++ ".", S)
+    end.
+
 private_of(Decls) ->
     maps:from_keys([{N, length(Ps)} || {signature, _, N, _, Ps, V, _} <- Decls,
                                        V =/= public],
@@ -496,14 +516,19 @@
 
 add_import(L, M, Self, World, Known, Mode, Acc) ->
     case maps:is_key(M, World) of
-        true  -> add_module_import(M, World, Acc);
+        true  ->
+            case Mode =:= strict andalso not visible_to(Self, M) of
+                true  -> erlang:error({not_visible_here, M, internal_root(M), Self, L});
+                false -> add_module_import(M, World, Acc)
+            end;
         false ->
             %% Namespaces emit nothing. Exclude `Self`: importing its namespace
             %% must not make a module its own dependency.
             case {children(M, Known) -- [Self], Mode} of
                 {[], strict}  -> erlang:error({unknown_module, M, L});
                 {[], lenient} -> Acc;
-                {Children, _} -> add_namespace_import(M, Children, Acc)
+                {Children, _} ->
+                    add_namespace_import(M, [C || C <- Children, visible_to(Self, C)], Acc)
             end
     end.
 
