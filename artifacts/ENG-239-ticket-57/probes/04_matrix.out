=================== baseline ===================
--- refinement table ---
value >= -5                        {crashed,error,{opaque_refinement,{2,1}}}
value >= -5 and value <= 5         {crashed,error,{opaque_refinement,{2,1}}}
value >= 1 or value <= -1          {crashed,error,{opaque_refinement,{2,1}}}
value <= 3 or value >= 10          accepted
value != 0                         accepted
value != -1                        {crashed,error,{opaque_refinement,{2,1}}}
-5 <= value                        {crashed,error,{opaque_refinement,{2,1}}}
value >= 2 + 3                     {crashed,error,{opaque_refinement,{2,1}}}
value >= 1 - 2                     {crashed,error,{opaque_refinement,{2,1}}}
value >= -(-5)                     {crashed,error,{opaque_refinement,{2,1}}}
value >= 2 * 3                     {crashed,error,{opaque_refinement,{2,1}}}
value >= -2 * 3                    {crashed,error,{opaque_refinement,{2,1}}}
value >= 7 / 2                     {crashed,error,{opaque_refinement,{2,1}}}
value >= 1 / 0                     {crashed,error,{opaque_refinement,{2,1}}}
value >= -5.0                      {crashed,error,{opaque_refinement,{2,1}}}
value >= 0 - 5                     {crashed,error,{opaque_refinement,{2,1}}}
value >= 5 % 3                     {crashed,error,{opaque_refinement,{2,1}}}
--- guards/arms ---
head: n >= 0 / n < 0             accepted
head: n >= -1 / n < -1           {refused,[inexhaustive]}
head: n != -1 / n == -1          {refused,[inexhaustive]}
head: n >= 1 - 2 / n < 1 - 2     {refused,[inexhaustive]}
head: n >= 2 + 3 / n < 2 + 3     {refused,[inexhaustive]}
arm : n >= 0 / n < 0             accepted
arm : n >= -1 / n < -1           {refused,[switch_inexhaustive]}
-- residual interval of the refinement (clauses cover <= 0; residual should be the rest of T) --
value >= -5 and value <= 5           {crashed,error,{opaque_refinement,{2,1}}}
value >= 0 and value <= 5            {residual,[{1,5}]}
value >= -2 * 3 and value <= 2 + 3   {crashed,error,{opaque_refinement,{2,1}}}
value != -1                          {crashed,error,{opaque_refinement,{2,1}}}
value >= -3 and value <= -(-5)       {crashed,error,{opaque_refinement,{2,1}}}
-- a body literal: NonPos F() -> -1 and Neg G() -> -5 (baseline types `-N` as int?) --
NonPos F() -> -1                     {refused,[return_not_declared]}
Pos F() -> 1 (control)               accepted
NonPos F() -> 0 - 1                  {refused,[return_not_declared]}
-- a zero divisor spelled -0 (F26 refuses a provably-zero divisor) --
F(n) -> n / -0                       accepted
F(n) -> n / 0 (control)              {refused,[divide_by_zero]}
-- must not change: a float comparand, a variable comparand, a zero divisor --
value >= -5.0                        {crashed,error,{opaque_refinement,{2,1}}}
value >= value                       {crashed,error,{opaque_refinement,{2,1}}}
value >= 1 / 0                       {crashed,error,{opaque_refinement,{2,1}}}
value >= 1 % 0                       {crashed,error,{opaque_refinement,{2,1}}}
value >= (-5) + value                {crashed,error,{opaque_refinement,{2,1}}}
