+%% SCRATCH (ticket 57 probe): a comparand that is a literal integer expression.
+const_int({e_int, _, K}) -> {ok, K};
+const_int({e_neg, _, E}) -> case const_int(E) of {ok, K} -> {ok, -K}; error -> error end;
+const_int({e_op, _, '+', A, B}) -> bin(fun(X, Y) -> X + Y end, A, B);
+const_int({e_op, _, '-', A, B}) -> bin(fun(X, Y) -> X - Y end, A, B);
+const_int({e_op, _, '*', A, B}) -> bin(fun(X, Y) -> X * Y end, A, B);
+const_int({e_op, _, '/', A, B}) -> bin(fun(X, Y) -> X div Y end, A, B);
+const_int({e_op, _, '%', A, B}) -> bin(fun(X, Y) -> X rem Y end, A, B);
+const_int(_) -> error.
+bin(F, A, B) ->
+    case {const_int(A), const_int(B)} of
+        {{ok, X}, {ok, Y}} -> try {ok, F(X, Y)} catch error:badarith -> error end;   %% a zero divisor stays unreadable
+        _                  -> error
+    end.
