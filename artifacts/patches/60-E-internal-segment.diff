+%% PROTOTYPE 60/E (Go's `internal/` rule): a module path with a segment `Internal` may be
+%% named only by modules under the path before that segment.
+visible_or_error(L, M, Self) ->
+    case visible(M, Self) of true -> ok; false -> erlang:error({not_visible, M, Self, L}) end.
+
+visible(M, Self) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []} -> true;
+        {Before, _} ->
+            Prefix = lists:flatten(lists:join(".", Before)),
+            SelfS = atom_to_list(Self),
+            Prefix =:= "" orelse SelfS =:= Prefix orelse lists:prefix(Prefix ++ ".", SelfS)
+    end.
+
