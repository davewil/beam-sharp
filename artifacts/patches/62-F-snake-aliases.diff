     %% `ToJson<T>` generates does, on a value its validator refused, and the
     %% stack still names the B# function that called it.
     ++ validator_forms(Validators)
+    ++ [snake_form(S, A, P) || {S, A, P} <- snake_aliases(Fns, Behaviours)]
     ++ reserved_forms(Fns).
 
+%% PROTOTYPE 62/F: snake_case alias exports for Elixir callers.
+snake_aliases(Fns, Behaviours) ->
+    Own = sets:from_list([{name(F, Behaviours), arity(F)} || F <- Fns]),
+    lists:usort([{list_to_atom(SL), arity(F), name(F, Behaviours)}
+                 || F <- Fns, is_public(F),
+                    N <- [name(F, Behaviours)],
+                    N =:= element(2, F),                 %% skip callback-renamed
+                    SL <- [snake(atom_to_list(N))], SL =/= atom_to_list(N),
+                    not sets:is_element({list_to_atom(SL), arity(F)}, Own)]
+               ).
+snake_form(S, A, P) ->
+    Vars = [{var, ?A, list_to_atom("A" ++ integer_to_list(I))} || I <- lists:seq(1, A)],
+    {function, ?A, S, A, [{clause, ?A, Vars, [], [{call, ?A, {atom, ?A, P}, Vars}]}]}.
+snake(N) ->
+    S1 = re:replace(N, "([A-Z]+)([A-Z][a-z])", "\\1_\\2", [global, {return, list}]),
+    S2 = re:replace(S1, "([a-z0-9])([A-Z])", "\\1_\\2", [global, {return, list}]),
+    string:lowercase(S2).
+
