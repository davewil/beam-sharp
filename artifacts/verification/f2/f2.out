=== emitted
bs@type_atoms() ->
    ['Id', 'Kind', 'Nested.Order', 'Total'].

'PrivTotal'(O) when map_get('Kind', O) =:= 'Nested.Order' ->
    map_get('Total', O).

'ViaTuple'({O, _N}) ->
    'PrivTotal'(O).

'ViaList'([O | _Rest]) ->
    'PrivTotal'(O);
'ViaList'([]) ->
    0.

'Direct'(O) when map_get('Kind', O) =:= 'Nested.Order' ->
    'PrivTotal'(O).

'Inline'({O, _N}) ->
    map_get('Total', O).

'PrivOctet'(N) ->
    N.

'OctetViaTuple'({N, _K}) ->
    'PrivOctet'(N).

'OctetDirect'(N)
    when
        is_integer(N)
        andalso
        N >= 0
        andalso
        N =< 255 ->
    'PrivOctet'(N).

