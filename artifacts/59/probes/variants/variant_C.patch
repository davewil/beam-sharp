 to_abstr(Forms) ->
     iolist_to_binary(["%% coding: latin-1\n"
                       | [io_lib:format("~p.~n", [F]) || F <- Forms]]).
+
+
+%% VARIANT C. A private function named in value position leaves the module as
+%% a fun, so the fun the BEAM is handed is a one-clause wrapper carrying the
+%% function's boundary guards (the same `guard_one/7` the exported head uses,
+%% asked with `Public = true` and `term` as what the wrapper accepts). A direct
+%% call still goes to the unguarded private function.
+escape_wrapper(Name, Arity, Emitted, L, Ref, C) ->
+    case maps:find({Name, Arity}, maps:get(privfns, C, #{})) of
+        error -> Ref;
+        {ok, F} ->
+            Ctx = C#{env => fn_env(F, maps:get(env, C))},
+            Params = element(5, F),
+            Folded = [guard_one({p_wild, L}, P, bs_types:term(), I, L, Ctx, true)
+                      || {P, I} <- lists:zip(Params, lists:seq(1, Arity))],
+            Tests = [T || {_, Ts} <- Folded, T <- Ts],
+            case Tests of
+                [] -> Ref;
+                _ ->
+                    Pats = [NP || {NP, _} <- Folded],
+                    Used = sets:from_list([V || {p_var, _, V} <- Pats], [{version, 2}]),
+                    Args = [{var, L, var_name(V)} || {p_var, _, V} <- Pats],
+                    {'fun', L, {clauses,
+                        [{clause, L, [pattern(P, Used) || P <- Pats],
+                          guard({guard, fold_and(Tests, L)}, Ctx),
+                          [{call, L, {atom, L, Emitted}, Args}]}]}}
+            end
+    end.
