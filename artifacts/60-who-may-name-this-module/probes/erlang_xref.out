### 2. xref can ANSWER the question, as a post-build query
friends(shop_orders)=[shop_reports] -> violations: [{{elsewhere,poke,1},
                                                     {shop_orders,
                                                      recompute_total,1}},
                                                    {{elsewhere,poke_hidden,1},
                                                     {shop_orders,hidden,1}}]
CONTROL friends(shop_orders)=[shop_reports,elsewhere] -> violations: []
xref undefined_function_calls (finds the non-exported call erlc missed): {ok,
                                                                          [{{elsewhere,
                                                                             poke_hidden,
                                                                             1},
                                                                            {shop_orders,
                                                                             hidden,
                                                                             1}}]}
xref {module_use,shop_orders}: {ok,[elsewhere,shop_orders,shop_reports]}
