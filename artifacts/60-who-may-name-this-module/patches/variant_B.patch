+%% Variant B: no declaration. A module whose path has an `Internal` segment may be
+%% named only from the segment's parent and below.
+allowed(Self, M, _World) ->
+    Segs = string:split(atom_to_list(M), ".", all),
+    case lists:splitwith(fun(S) -> S =/= "Internal" end, Segs) of
+        {_, []}      -> true;
+        {Parent, _}  ->
+            P = string:join(Parent, "."),
+            case Parent =:= [] orelse atom_to_list(Self) =:= P
+                     orelse lists:prefix(P ++ ".", atom_to_list(Self)) of
+                true  -> true;
+                false -> {false, P ++ " and the modules beneath it"}
+            end
     end.
 
