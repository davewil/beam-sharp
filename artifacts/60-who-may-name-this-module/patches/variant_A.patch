+%%% Who may name a module (ticket 60 prototype, variant A: callee lists friends)
+may_name(_L, _M, _Self, _World, lenient) -> ok;
+may_name(L, M, Self, World, strict) ->
+    case allowed(Self, M, World) of
+        true       -> ok;
+        {false, W} -> erlang:error({not_a_friend, M, W, L})
+    end.
+
+nameable(Children, _Self, _World, lenient) -> {Children, []};
+nameable(Children, Self, World, strict) ->
+    Checked = [{C, allowed(Self, C, World)} || C <- Children],
+    {[C || {C, true} <- Checked], [{C, W} || {C, {false, W}} <- Checked]}.
