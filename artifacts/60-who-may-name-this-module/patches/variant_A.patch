+                  true  -> true;
+                  false -> {false, friend_text(Fr)}
+              end
     end.
 
+friend_match({F, exact}, Self)   -> F =:= Self;
+friend_match({F, subtree}, Self) -> Self =:= F orelse lists:prefix(atom_to_list(F) ++ ".", atom_to_list(Self)).
+
+friend_text(Fr) ->
+    string:join([atom_to_list(F) ++ case K of exact -> ""; subtree -> ".*" end || {F, K} <- Fr], ", ").
+
+friends_of(Decls) -> [{F, K} || {friend, _, F, K} <- Decls].
