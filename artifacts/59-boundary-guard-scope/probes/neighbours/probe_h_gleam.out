inner(O) ->
    element(3, O).

entry(B) ->
    inner(element(3, B)).

priv_int(N) ->
    N + 1.

pub_int(N) ->
    priv_int(N).

money(C) ->
    {money, C}.

cents(M) ->
    element(2, M).

pos(N) ->
    case N of
        X when X > 0 ->
            X;
        _ ->
            0
    end.

