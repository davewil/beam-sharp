== forms of Elixir.Order:e/1, p/1, q/1 as the erlang abstract format (heads only) ==
e(#{'__struct__' := 'Elixir.Order'} = _o@1) ->
    p(_o@1).
p(#{'__struct__' := 'Elixir.Order', total := _t@1}) ->
    _t@1.
q(_n@1) when is_integer(_n@1) ->
    _n@1 * 2.
r(_n@1) when is_integer(_n@1) ->
    q(_n@1).

