{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.

{escript_name, bsc}.
{escript_main_app, bsc}.
{escript_incl_apps, [bsc]}.
{escript_emu_args, "%%! -escript main bsc\n"}.

{eunit_opts, [verbose]}.

%% THE ESCRIPT IS BUILT BEFORE THE TESTS, AND THE ORDER IS LOAD-BEARING.
%%
%% Three tests drive `bsc` as a subprocess and resolve it at
%% `_build/default/bin/bsc` — `cli_tests:built_escript_compiles_a_file_test`
%% and two of F9's. `.github/workflows/ci.yml` already sequences `escriptize`
%% before `eunit` and explains why; this hook says the same thing to a plain
%% `rebar3 eunit`, so a fresh clone or a new worktree is green rather than
%% three tests red. Measured: with the escript removed the suite reports
%% `Failed: 3. Passed: 205.`, and it was exactly that on this worktree's
%% first run.
%%
%% CI keeps its explicit step: this hook makes the local path match it, it
%% does not replace it.
{provider_hooks, [{pre, [{eunit, escriptize}]}]}.
