+%% PROTOTYPE for ticket 60 sub-decision 4. Directory-level, not per-function:
+%% every `friend` line this module wrote, or the atom `open` when it wrote
+%% none — which is what makes the feature backward compatible with the 130
+%% `.bs` files in this repo that use no such line today.
+friends_of(Decls) ->
+    case [M || {friend, _, M} <- Decls] of
+        []      -> open;
+        Friends -> Friends
+    end.
