// Probe for ticket 39 sub-decision 1: verbatim copy of Wrap/Hit/Spin from
// aoc/bench/Day01/bench_bs.bs, plus a SpinOnly entry point.
module ProbeBsSpin

using :erlang {
    int rem(int a, int b)
}

private int Wrap(int n)
Wrap(n) -> :erlang.rem(:erlang.rem(n, 100) + 100, 100)

private int Hit(int pos)
Hit(0) -> 1
Hit(n) -> 0

private (int, int) Spin(int pos, int step, int left, int zeros)
Spin(pos, step, 0, zeros) -> (pos, zeros)
Spin(pos, step, left, zeros) ->
    var next = Wrap(pos + step)
    Spin(next, step, left - 1, zeros + Hit(next))

public (int, int) SpinOnly(int step, int left)
SpinOnly(step, left) -> Spin(50, step, left, 0)
