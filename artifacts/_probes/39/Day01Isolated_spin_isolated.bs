// Isolates the Spin/Wrap/Hit hot loop, exactly as
// /tmp/ticket39-scratch/step1/spin_isolated.erl does for Erlang: one call
// with a large Left count instead of many small calls through Clicks.
module Day01Isolated

using :erlang {
    int rem(int a, int b)
}

private int Wrap(int n)
Wrap(n) -> :erlang.rem(:erlang.rem(n, 100) + 100, 100)

private int Hit(int pos)
Hit(0) -> 1
Hit(n) -> 0

private (int, int) Spin(int pos, int step, int left, int zeros)
Spin(pos, step, 0, zeros) -> (pos, zeros)
Spin(pos, step, left, zeros) ->
    var next = Wrap(pos + step)
    Spin(next, step, left - 1, zeros + Hit(next))

public (int, int) Run(int left)
Run(left) -> Spin(50, 1, left, 0)
