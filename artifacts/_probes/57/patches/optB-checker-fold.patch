+%% A literal integer, or a bare unary minus over one -- the constant shapes
+%% ticket 57 asks the checker to read. Deliberately narrow: it does not
+%% recurse into `+`/`-` over two literals, so `2 + 3` and `1 - 2 + 3` stay
+%% unread (see the option-B writeup in the ticket-57 brief for why the
+%% boundary is drawn here rather than further out).
+int_const({e_int, _, K})             -> {ok, K};
+int_const({e_neg, _, {e_int, _, K}}) -> {ok, -K};
+int_const(_)                         -> not_const.
+
