
=== applying patch B ===
 compiler/src/bs_emit.erl | 6 ++----
 1 file changed, 2 insertions(+), 4 deletions(-)
diff --git a/compiler/src/bs_emit.erl b/compiler/src/bs_emit.erl
index e713dbf..7d39a14 100644
--- a/compiler/src/bs_emit.erl
+++ b/compiler/src/bs_emit.erl
@@ -312,7 +312,7 @@ boundary_guards(Patterns, Params, Line, Ctx, Public) ->
 %% The two guards are mutually exclusive by construction rather than by an
 %% ordering choice: a record type has a `maps` part and an integer type does
 %% not, so no parameter is ever a candidate for both.
-guard_one(Pat, {param, TypeExpr, _}, I, Line, Ctx, Public) ->
+guard_one(Pat, {param, TypeExpr, _}, I, Line, Ctx, _Public) ->
     case record_tag(TypeExpr, Ctx) of
         {ok, Tag} ->
             case constrains_kind(Pat) of
@@ -321,10 +321,8 @@ guard_one(Pat, {param, TypeExpr, _}, I, Line, Ctx, Public) ->
                     {Var, Pat1} = ensure_var(Pat, I, Line),
                     {Pat1, [tag_test(Var, Tag, Line)]}
             end;
-        none when Public ->
-            int_guard(Pat, TypeExpr, I, Line, Ctx);
         none ->
-            {Pat, []}
+            int_guard(Pat, TypeExpr, I, Line, Ctx)
     end.
 
