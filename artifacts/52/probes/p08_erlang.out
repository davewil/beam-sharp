--- 1. remote call to a module that is nowhere (erlc)
exit=0
--- 1b. same, through xref (the BEAM tool that does check)
undefined_function_calls: {ok,[{{calls_missing,go,0},{libdep,hello,1}}]}
--- 2. -include_lib("libdep/...") with application libdep absent
inc_missing_app.erl:2:14: can't find include lib "libdep/include/libdep.hrl"
%    2| -include_lib("libdep/include/libdep.hrl").
%     |              ^

exit=1
--- 3. -include_lib("stdlib/...") present
exit=0
