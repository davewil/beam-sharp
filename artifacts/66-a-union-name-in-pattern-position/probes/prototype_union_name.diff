+%% PROTOTYPE (ticket 66): a name that resolves to a union of >=2 records and
+%% nothing else yields its minted tags.
+union_record_tags(Name, Env) ->
+    try bs_types:unfold(resolve({t_ref, Name}, Env)) of
+        #{maps := Ms, atoms := {finite, []}, ints := [], floats := {finite, []},
+          tuples := [], lists := [], bins := [], opaques := [], vars := [],
+          funs := []} when length(Ms) >= 2 ->
+            Tags = [case M of
+                        {closed, Fs} ->
+                            case maps:find('Kind', Fs) of
+                                {ok, #{atoms := {finite, [T]}}} -> T;
+                                _ -> bad
+                            end;
+                        _ -> bad
+                    end || M <- Ms],
+            case lists:member(bad, Tags) of true -> none; false -> {ok, Tags} end;
+        _ -> none
+    catch _:_ -> none
+    end.
