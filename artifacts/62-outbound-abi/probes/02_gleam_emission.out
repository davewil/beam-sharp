atoms:   [shop,new_order,order,parse_url,'maybe',false,true,module_info,
          erlang,get_module_info]
--- abstract code (erl_pp)
-type doc() ::
          {order, integer(), integer()} |
          {invoice, integer()} |
          paid_in_full |
          {http_error, integer()} |
          new_h_t_t_p_thing.
new_order(Id) ->
    {order, Id, 0}.
parse_url(_) ->
    {ok, 1}.
'maybe'(X) ->
    case X of
        true ->
            {ok, 1};
        false ->
            {error, <<"no"/utf8>>}
    end.

