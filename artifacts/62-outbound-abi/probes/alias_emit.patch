 to_abstr(Forms) ->
     iolist_to_binary(["%% coding: latin-1\n"
                       | [io_lib:format("~p.~n", [F]) || F <- Forms]]).
+
+
+%%% ---- EXPERIMENT (ticket 62 probe): snake_case aliases. BS_ALIAS_MODE = none | forward | forward_nospec | dup
+alias_mode() -> case os:getenv("BS_ALIAS_MODE") of false -> none; M -> list_to_atom(M) end.
+
+alias_exports(Exports, Behaviours) ->
+    case alias_mode() of
+        none -> [];
+        _ -> [{snake(name(F, Behaviours)), A} || {F, A} <- Exports]
+    end.
+
+alias_forms(F, Env, Behaviours, Ctx) ->
+    case {alias_mode(), is_public(F)} of
+        {none, _} -> [];
+        {_, false} -> [];
+        {Mode, true} ->
+            N = name(F, Behaviours), Ar = arity(F), Al = snake(N),
+            case Al =:= N of
+                true -> [];
+                false ->
+                    F2 = setelement(2, F, Al),
+                    Spec = spec_attr(F2, Env, []),
+                    Vars = [{var, ?A, list_to_atom("A" ++ integer_to_list(I))} || I <- lists:seq(1, Ar)],
+                    Fwd = {function, ?A, Al, Ar, [{clause, ?A, Vars, [], [{call, ?A, {atom, ?A, N}, Vars}]}]},
+                    case Mode of
+                        forward -> [Spec, Fwd];
+                        forward_nospec -> [Fwd];
+                        dup -> [Spec, function(F2, Ctx)]
+                    end
+            end
+    end.
+
+%% The simplest deterministic rule: '_' before an uppercase letter that follows a lowercase letter or digit; lowercase everything.
+snake(Atom) ->
+    list_to_atom(snake_(atom_to_list(Atom), [], $_)).
+snake_([], Acc, _) -> lists:reverse(Acc);
+snake_([C | T], Acc, Prev) when C >= $A, C =< $Z ->
+    Sep = (Prev >= $a andalso Prev =< $z) orelse (Prev >= $0 andalso Prev =< $9),
+    Acc1 = case Sep of true -> [$_ | Acc]; false -> Acc end,
+    snake_(T, [C + 32 | Acc1], C);
+snake_([C | T], Acc, _) -> snake_(T, [C | Acc], C).
