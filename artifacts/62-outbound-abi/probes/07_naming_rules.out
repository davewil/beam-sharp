-type t() :: new | new_h_t_t_p | parse_u_r_l | h_t_t_p_server | x_m_l_http_request | to_json | o_k_result | v2_parse | parse2_d | parse2d | get_u_r_l_for | new_url | new_u_r_l | i_o_list | id | a | a_b. 

