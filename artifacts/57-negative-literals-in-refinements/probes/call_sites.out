4624:comparison({e_op, _, Op, {e_var, _, V}, {e_int, _, K}}) -> int_cmp(Op, V, K);
4625:comparison({e_op, _, Op, {e_int, _, K}, {e_var, _, V}}) -> int_cmp(flip(Op), V, K);
4626:comparison({e_op, _, '==', {e_var, _, V}, {e_atom, _, A}}) ->
4628:comparison({e_op, _, '!=', {e_var, _, V}, {e_atom, _, A}}) ->
4630:comparison(_) ->
4633:int_cmp('>',  V, K) -> {V, {include, bs_types:range(K + 1, pos_inf)}};
4634:int_cmp('>=', V, K) -> {V, {include, bs_types:range(K, pos_inf)}};
4635:int_cmp('<',  V, K) -> {V, {include, bs_types:range(neg_inf, K - 1)}};
4636:int_cmp('<=', V, K) -> {V, {include, bs_types:range(neg_inf, K)}};
4637:int_cmp('==', V, K) -> {V, {include, bs_types:range(K, K)}};
4638:int_cmp('!=', V, K) -> {V, {exclude, bs_types:range(K, K)}};
4639:int_cmp(_, _, _)    -> unknown.
4641:flip('>')  -> '<';
4642:flip('<')  -> '>';
4643:flip('>=') -> '<=';
4644:flip('<=') -> '>=';
4645:flip(Op)   -> Op.
