== parser productions that build p_int / p_rel / int_lit / e_int / negate
17:  rel_pattern rel_test int_lit refinement
386:pattern -> integer             : {p_int, line('$1'), value('$1')}.
390:pattern -> '-' integer         : {p_int, line('$1'), -value('$2')}.
437:bin_segment -> int_lit ':' integer    : {seg_int,  line('$2'), '$1', value('$3')}.
456:rel_test -> '>=' int_lit : {p_rel, line('$1'), '>=', '$2'}.
457:rel_test -> '>'  int_lit : {p_rel, line('$1'), '>',  '$2'}.
458:rel_test -> '<=' int_lit : {p_rel, line('$1'), '<=', '$2'}.
459:rel_test -> '<'  int_lit : {p_rel, line('$1'), '<',  '$2'}.
464:int_lit -> integer     : value('$1').
465:int_lit -> '-' integer : -value('$2').
577:expr_low -> integer  : {e_int, line('$1'), value('$1')}.
582:%% one, refused. A negated float LITERAL folds to the literal, so `-0.0` is
584:expr_low -> '-' expr_low : negate(line('$1'), '$2').
706:%% is: `bs_lower:pipe_into/3` emits the call node here, so the checker and
708:expr_low -> expr_low '|>' call : bs_lower:pipe_into(line('$2'), '$1', '$3').
845:to_match({e_int, L, N})   -> {p_int, L, N};
893:to_param({e_int, L, N})   -> {p_int, L, N};
905:%% A negated float literal is the literal; anything else is the BEAM's unary
907:negate(_L, {e_float, FL, F}) -> {e_float, FL, -F};
908:negate(L, E)                 -> {e_neg, L, E}.
