+%% SPIKE VARIANT (narrow): recognise ONLY the exact shape the parser produces
+%% for a literal negative integer -- `{e_op,'-',{e_int,0},{e_int,K}}` -- and
+%% nothing else. No general arithmetic folding, so `2 + 3` stays refused.
+const_int({e_int, _, K}) -> {ok, K};
+const_int({e_op, _, '-', {e_int, _, 0}, {e_int, _, K}}) -> {ok, -K};
+const_int(_) -> error.
+
 int_cmp('>',  V, K) -> {V, {include, bs_types:range(K + 1, pos_inf)}};
 int_cmp('>=', V, K) -> {V, {include, bs_types:range(K, pos_inf)}};
 int_cmp('<',  V, K) -> {V, {include, bs_types:range(neg_inf, K - 1)}};
