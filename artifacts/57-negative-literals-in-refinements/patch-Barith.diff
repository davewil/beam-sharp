+%% A comparand that is a constant integer expression, not only a bare literal.
+comparison({e_op, _, Op, {e_var, _, V}, K0}) ->
+    case const_int(K0) of {ok, K} -> int_cmp(Op, V, K); error -> unknown end;
+comparison({e_op, _, Op, K0, {e_var, _, V}}) ->
+    case const_int(K0) of {ok, K} -> int_cmp(flip(Op), V, K); error -> unknown end;
 comparison(_) ->
     unknown.
 
+const_int({e_int, _, N}) -> {ok, N};
+const_int({e_neg, _, E}) -> case const_int(E) of {ok, N} -> {ok, -N}; error -> error end;
+const_int({e_op, _, Op, L, R}) when Op =:= '+'; Op =:= '-'; Op =:= '*' ->
+    case {const_int(L), const_int(R)} of
+        {{ok, A}, {ok, B}} -> {ok, case Op of '+' -> A + B; '-' -> A - B; '*' -> A * B end};
+        _                  -> error
+    end;
+const_int(_)             -> error.
+
 int_cmp('>',  V, K) -> {V, {include, bs_types:range(K + 1, pos_inf)}};
 int_cmp('>=', V, K) -> {V, {include, bs_types:range(K, pos_inf)}};
 int_cmp('<',  V, K) -> {V, {include, bs_types:range(neg_inf, K - 1)}};
