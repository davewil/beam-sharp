+%% SPIKE (ticket 57, checker-side candidate): fold literal integer arithmetic
+%% before asking whether a comparand is constant. `-5` arrives as
+%% `{e_op,'-',{e_int,0},{e_int,5}}` (the parser's uniform lowering of unary
+%% minus, `bs_parser.yrl`), and this recognises that shape and the ordinary
+%% binary +/-/* cases too, so `2 + 3` folds the same way. Anything with a
+%% variable anywhere inside stays `error`, so `value >= n` is untouched.
+const_int({e_int, _, K}) -> {ok, K};
+const_int({e_op, _, '+', L, R}) -> fold2(fun(A, B) -> A + B end, L, R);
+const_int({e_op, _, '-', L, R}) -> fold2(fun(A, B) -> A - B end, L, R);
+const_int({e_op, _, '*', L, R}) -> fold2(fun(A, B) -> A * B end, L, R);
+const_int(_) -> error.
+
+fold2(F, L, R) ->
+    case {const_int(L), const_int(R)} of
+        {{ok, A}, {ok, B}} -> {ok, F(A, B)};
+        _ -> error
+    end.
+
 int_cmp('>',  V, K) -> {V, {include, bs_types:range(K + 1, pos_inf)}};
 int_cmp('>=', V, K) -> {V, {include, bs_types:range(K, pos_inf)}};
 int_cmp('<',  V, K) -> {V, {include, bs_types:range(neg_inf, K - 1)}};
