// The first n Fibonacci numbers.
//
// Genuine recursion, and every recursive call is in TAIL position: the result of
// the call IS the result of the clause, with nothing wrapped around it. The
// naive `[a, ..Series(n - 1, ...)]` is not — the cons happens after the call
// returns, so the stack grows with n. An accumulator plus a reverse keeps it
// flat, which is the ordinary BEAM idiom.
module Fib;

list<int> Fib(int n);

Fib(n) when n <= 0 -> [];
Fib(n) when n > 0  -> Series(n, 0, 1, []);

// The accumulator pair ticket 08 noted defaults cannot express, written out.
list<int> Series(int n, int a, int b, list<int> acc);

Series(n, a, b, acc) when n <= 0 -> Reverse(acc, []);
Series(n, a, b, acc) when n > 0  -> Series(n - 1, b, a + b, [a, ..acc]);

// Exhaustive with no catch-all: `[]` and `[x, ..rest]` partition list<int>.
list<int> Reverse(list<int> xs, list<int> acc);

Reverse([], acc)          -> acc;
Reverse([x, ..rest], acc) -> Reverse(rest, [x, ..acc]);
