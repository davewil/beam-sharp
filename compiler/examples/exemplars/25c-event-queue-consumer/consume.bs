result<Delivery, ConsumeError> Consume(binary)

Consume(raw) -> raw |?> DecodeFrame()
                    |?> DecodeMethod()
                    |?> ValidateAs<OrderPlaced>()

result<Delivery, ConsumeError> Consume(binary)

Consume(raw) -> DecodeFrame(raw) switch {
    (:error, e)                        => (:error, e),
    (Frame { Type = :method } f, rest) =>
