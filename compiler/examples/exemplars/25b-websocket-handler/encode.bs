binary Encode(Opcode, binary)

Encode(op, payload) -> Header(op, ByteSize(payload))
                    |> Binary.Append(payload)

binary Fragments(list<binary>)

Fragments(chunks) -> chunks |> List.Fold("", (acc, c) => Binary.Append(acc, c))

