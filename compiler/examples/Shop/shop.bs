// F3 — records. Ticket 26: a record erases to a map carrying a tag minted from
// its qualified type name, so aggregate identity is in the TERM and a union of
// records is dispatched by an ordinary clause head.
//
//   bsc examples/shop.bs Which '#{Kind => "Shop.Invoice", Id => 2, Total => 9}'
//
module Shop

record Order   { Id: int, Total: int }
record Invoice { Id: int, Total: int }

// Identical field sets. Different tags, so these are two types — which under
// ticket 09 before the minting they would not have been.
type Doc = Order | Invoice

atom Which(Doc d)

Which({ Kind: :'Shop.Order' })   -> :order
Which({ Kind: :'Shop.Invoice' }) -> :invoice

// Drop either clause and the compiler names the case you missed and writes the
// head for you:  Which({ Kind: :'Shop.Invoice' }) -> ...

// The dot projects and is never a call. Legal over the union because BOTH
// members carry `Total`, and it emits one `map_get` whichever arrived.
int Amount(Doc d)

Amount(d) -> d.Total

// Construction supplies EXACTLY the declared field set — no more, and no fewer.
// The tag is not written here and cannot be: it is minted, so `Kind` is the one
// key a construction may not name. Drop `Total` and the compiler names the field
// that is missing rather than building a map that wears an `Order` tag without
// being one.
Order New(int id)

New(id) -> Order{ Id = id, Total = 0 }

// `with` is width-preserving: `:=` updates a key that is already there and
// raises on one that is not, so a record cannot grow through this construct.
// The tag is not among the keys assigned, so it survives untouched.
Order Pay(Order o)

Pay(o) -> o with { Total = 500 }

// A guard over a projected field still refines the clause, so these two are
// exhaustive over `Order` with no catch-all.
atom Band(Order o)

Band({ Total: t }) when t > 0  -> :paid
Band({ Total: t }) when t <= 0 -> :unpaid

// A field named `Total` and a function named `Total` coexist: the dot's
// disambiguation is lexical, so nothing is resolved by type.
int Total(int n)

Total(n) -> n + 1

// A body is bindings followed by one expression. A name is read once and used
// twice, which is the shape neither the clause head nor the pipe can express —
// `o.Total * o.Total` would emit two `map_get`s.
int Squared(Order o)

Squared(o) ->
    var t = o.Total
    t * t

// Bindings compose with everything else: this reads the field once, computes
// once, and updates width-preservingly.
Order Bump(Order o)

Bump(o) ->
    var next = o.Total + 1
    o with { Total = next }
