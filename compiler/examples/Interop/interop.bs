// Calling Erlang from B#.
//
// The module is an ATOM, because on the BEAM a module is an atom — so the call
// site is Elixir's, `:erlang.system_time(:second)`, and nothing is renamed. The
// declaration attaches types to the name Erlang already has, which is why the
// language needs no snake_case/PascalCase mapping anywhere.
module Interop

using :erlang {
    int system_time(atom unit)
    // Was `term bin` until F9, because the language had no word for a binary
    // and `term` was the only thing that would resolve. Ticket 20 §3 is what
    // makes the honest declaration legal: the whole `<<_:M, _:_*N>>` grammar is
    // admissible at a boundary, since deciding it is `byte_size` and
    // `bit_size rem N` — O(1) guard BIFs, measured the same at 8 B and 8 MiB.
    int byte_size(binary b)
}

using :lists {
    // A PARAMETER may be as narrow as you like: the list handed OUT is already
    // established by the signature that produced it, and nothing arrives.
    int sum(list<int> xs)
}

using :ets {
    // A RETURN may promise only what one guard decides in O(1) — ticket 18 §2,
    // and this is its own example. `list<term>` is `is_list`. `list<Order>`
    // would need every element inspected, so it is refused at the declaration;
    // the rows are established where they are used, with `ValidateAs<T>`.
    // Until F40 this file declared `list<int> reverse(list<int> xs)`, which the
    // rule refuses too, and which `List.Reverse` does natively anyway.
    list<term> lookup(atom tab, term key)
}

public int Now()

Now() -> :erlang.system_time(:second)

public int Total(list<int> xs)

Total(xs) -> :lists.sum(xs)

public list<term> Rows(atom tab, term key)

Rows(tab, key) -> :ets.lookup(tab, key)
